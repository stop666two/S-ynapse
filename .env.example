# ============================================================
# S-ynapse 环境变量模板
# 用法：复制为 .env（已在 .gitignore 排除）或写入部署平台的环境变量设置。
# 说明：本文件仅列构建/部署脚本读取的变量；Worker 运行时的 MAINTENANCE 系列
#       在 Cloudflare Dashboard → Workers 环境变量中配置（见文件末注释）。
# ============================================================

# [必需·部署] Cloudflare API Token（Pages 部署与 Worker 发布）
# 类型：字符串（Token）；获取：https://dash.cloudflare.com/profile/api-tokens
# 权限：Pages 部署权限（Workers 发布需 Workers Scripts 权限）
# 示例：cf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CF_API_TOKEN=

# [可选·构建] 构建环境标识
# 类型：字符串；可填：production / development；默认：production
# 作用：影响构建分支与日志详细程度
NODE_ENV=production

# [可选·构建] 站点根 URL 覆盖（优先级高于 site.json5 的 site.url）
# 类型：字符串（URL）；示例：https://blog.example.com
# 何时用：CI 预览、多域名部署；留空则使用 site.json5 中配置的 url
SITE_URL=

# [可选·构建] Cloudflare Web Analytics Token
# 类型：字符串；示例：a1b2c3d4e5f6...
# 作用：site.webAnalytics.enabled=true 且 site.json5 未填 token 时注入统计脚本；
#       留空则跳过注入并在构建日志中输出警告
CF_WEB_ANALYTICS_TOKEN=

# ------------------------------------------------------------
# [可选·Worker 运行时] 维护模式（不在本文件生效，需在 Cloudflare 侧配置）
# MAINTENANCE：字符串；可填：1 / true / 空；默认：空（关闭）
#   设置后 Worker 返回 503 维护页（本地可用 `npm run serve -- --maintenance` 预览）
# MAINTENANCE_MESSAGE：字符串（维护页提示文案，HTML 转义后输出）
#   示例：系统升级中，请稍后再试
# LOG_LEVEL：结构化日志级别；可填：off / error / warn / info / debug；默认：info
#   日志为 JSON Lines（含 ts/level/module/requestId/event），每个响应带 X-Request-Id
#   可对同请求溯源；IP 仅以短哈希入日志，不落明文
# ------------------------------------------------------------
# MAINTENANCE=1
# MAINTENANCE_MESSAGE=
# LOG_LEVEL=info

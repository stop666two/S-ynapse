# Auto detect text files and normalize to LF in the working tree
# 说明: 仓库层统一 LF（规则要求）;Windows 下检出也为 LF,避免 CRLF 混入 diff。
# 例外: *.bat/*.cmd 保持 CRLF（见下）
* text=auto eol=lf

# Batch files - keep CRLF for Windows compatibility
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts - LF
*.sh text eol=lf

# Source files - LF
*.js text eol=lf
*.json text eol=lf
*.json5 text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ejs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf

# Lock file - binary diff
package-lock.json -diff

#!/bin/sh
# Pre-commit hook: prevent AGENTS.md variants from being committed
PATTERNS="AGENTS.md AGENTS.txt AGENT.md AGENT.txt agent-readme.md RULES.md"
STAGED_FILES=$(git diff --cached --name-only 2>/dev/null)
for pattern in $PATTERNS; do
  echo "$STAGED_FILES" | grep -q -i "$pattern"
  if [ $? -eq 0 ]; then
    echo "ERROR: $pattern is in the staged files and must not be committed."
    echo "Add it to .gitignore before committing."
    echo ""
    echo "  echo '$pattern' >> .gitignore"
    echo "  git add .gitignore"
    echo "  git rm --cached $pattern 2>/dev/null"
    exit 1
  fi
done
exit 0

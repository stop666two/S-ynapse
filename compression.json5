// ============================================================================
// compression.json5 —— 构建产物压缩（dist/ 单行化、去注释、合并去重）
// ----------------------------------------------------------------------------
// 这是第 14 个配置文件，只负责构建末尾“压缩阶段”的行为参数（默认开启）。
//
// 生效范围（重要）：
//   · 仅压缩 dist/ 构建产物；exclude 命中的路径按原字节复制，不做任何处理。
//   · vendor（assets/vendor/**）与 build-report.html 默认豁免：
//     前者已自带压缩版，后者必须保持人类可读。
//   · serve / watch 自动关闭：--serve 本地服务与 --watch 监听重建时不启用压缩，
//     本地调试所见即未压缩产物（本文件任何开关都不会拖慢调试）。
//   · 压缩发生在内容哈希（cacheBust）之前：文件名哈希对应压缩后的最终字节，
//     改本文件 → 产物字节变化 → 哈希随之换代，不会出现“哈希未变、内容已变”的脏缓存。
//
// 结构：enabled 总开关；html / css / js / json 分组参数；exclude 豁免名单；
//   verify 无头对比门禁（压缩产物 vs 未压缩副本，失败自动回退）。
//
// 注释模板：作用 / 类型 / 可填值 / 不可填值 / 默认 / 注意
// 文档：docs/config-reference.md §12 compression.json5
// 加载与校验：scripts/lib/compression-config.js（npm run verify:config 结构监守，
//   npm test 覆盖默认合并 / 类型 / 枚举 / glob 语义）；执行：scripts/build/minify.js。
// ============================================================================
{
  // ---------------------------------------------------------------------------
  // 总开关
  // ---------------------------------------------------------------------------

  // 作用：压缩阶段总开关
  // 类型：boolean；可填：true（启用压缩）/ false（整个压缩阶段跳过）
  // 不可填：字符串 / 数字等其它类型（校验报错并终止构建）
  // 默认：true
  // 注意：serve / watch 下被强制视为 false，无需（也无法）通过此处打开
  enabled: true,

  // ---------------------------------------------------------------------------
  // HTML
  // ---------------------------------------------------------------------------
  html: {
    // 作用：HTML 压缩开关
    // 类型：boolean；可填：true / false
    // 默认：true
    // 注意：与 site.build.minifyHTML（既有构建内联压缩）相互独立，互不影响
    enabled: true,

    // 作用：移除 HTML 注释
    // 类型：boolean；可填：true（移除 <!-- --> 注释）/ false（保留）
    // 默认：true
    // 注意：条件注释等特殊注释不保证保留；本站模板未使用，如引入需先关此项
    removeComments: true,

    // 作用：折叠可安全移除的空白
    // 类型：boolean；可填：true / false
    // 默认：true
    // 注意：<pre> / <textarea> 内容与内联元素之间的必要空格由压缩器自动保留，不改变渲染结果
    collapseWhitespace: true,

    // 作用：更激进压缩选项开关（实验性）
    // 类型：boolean；可填：true / false
    // 默认：false
    // 注意：开启后需经无头对比门禁（verify.headless）裁决，门禁失败时回退未压缩产物；
    //   不了解后果前保持 false
    aggressive: false,
  },

  // ---------------------------------------------------------------------------
  // CSS
  // ---------------------------------------------------------------------------
  css: {
    // 作用：CSS 压缩开关（外链 .css 文件）
    // 类型：boolean；可填：true / false
    // 默认：true
    enabled: true,

    // 作用：合并同一页面内的多段 <style> 为一段
    // 类型：boolean；可填：true / false
    // 默认：true
    // 注意：保持原有层叠顺序与 nonce 属性；仅在页面内合并，跨文件不合并
    mergeInlineStyles: true,

    // 作用：去除同一 CSS 文件内完全重复的规则
    // 类型：boolean；可填：true / false
    // 默认：true
    // 注意：仅做精确重复判定，不做语义级合并（不同选择器的同名声明保持不变）
    dedupe: true,
  },

  // ---------------------------------------------------------------------------
  // JS
  // ---------------------------------------------------------------------------
  js: {
    // 作用：JS 压缩开关（厂商目录与豁免名单除外）
    // 类型：boolean；可填：true / false
    // 默认：true
    enabled: true,

    // 作用：Terser 压缩（空白 / 注释 / 死代码 / 局部变量名）
    // 类型：boolean；可填：true / false
    // 默认：true
    minify: true,

    // 混淆（在压缩基础上追加，默认关闭）
    obfuscate: {
      // 作用：JS 混淆开关
      // 类型：boolean；可填：true / false
      // 默认：false
      // 注意：混淆仅作用于自研 bundle，vendor 与豁免名单始终排除；开启会明显增加构建耗时
      enabled: false,

      // 作用：混淆强度预设
      // 类型：string；可填：'low' | 'medium' | 'high'
      // 不可填：其它字符串（校验报错并终止构建）
      // 默认：'medium'
      // 注意：仅在 obfuscate.enabled=true 时生效；档位越高体积与运行开销越大
      preset: 'medium',

      // 作用：混淆随机种子
      // 类型：number；可填：0 或正整数（0 表示每次随机）
      // 不可填：负数 / 小数 / 非数字（校验报错并终止构建）
      // 默认：0
      // 注意：开启混淆时建议填固定正整数，保证每次构建字节一致、内容哈希稳定可复现
      seed: 0,
    },
  },

  // ---------------------------------------------------------------------------
  // JSON
  // ---------------------------------------------------------------------------
  json: {
    // 作用：JSON 产物压缩开关（search-index / 运行时 config / feed 等）
    // 类型：boolean；可填：true / false
    // 默认：true
    // 注意：仅去除结构空白，字符串内容原样保留，输出始终是合法 JSON
    enabled: true,
  },

  // ---------------------------------------------------------------------------
  // 豁免名单
  // ---------------------------------------------------------------------------

  // 作用：压缩豁免名单（相对 dist 根目录的路径 glob，命中即不压缩）
  // 类型：string[]（非空）；不可填：空数组 / 空字符串 / 非字符串（校验报错并终止构建）
  // glob 语义：** 跨目录、* 仅段内、? 单字符；大小写敏感；分隔符用 /（反斜杠会归一化）；
  //   不带 **/ 的模式只匹配 dist 根位置
  // 默认：如下 11 项
  // 注意：自定义时整组替换（不与默认合并）；移除默认项前先确认目标文件是文本且可安全压缩
  exclude: [
    'build-report.html', // 构建报告页：必须保持人类可读（报告阶段生成）
    'assets/vendor/**', // 第三方库 / 字体 / 图标：已自带压缩版，二次压缩收益小且易破坏
    'media/**', // 媒体资产（图片 / 视频）：二进制
    'og/**', // OG 社交卡片图：二进制
    'assets/fonts/**', // 字体目录（含 CJK 子集）：二进制或已子集化
    '**/*.woff2', // 字体：二进制
    '**/*.avif', // 图片：二进制
    '**/*.webp', // 图片：二进制
    '**/*.png', // 图片：二进制
    '**/*.jpg', // 图片：二进制
    '**/*.svg', // 矢量图：可能被外部按原字节引用，保持原样
  ],

  // ---------------------------------------------------------------------------
  // 无头对比门禁
  // ---------------------------------------------------------------------------
  verify: {
    // 作用：压缩后无头对比门禁开关
    // 类型：boolean；可填：true（对比压缩 / 未压缩产物的 DOM、采样计算样式、控制台错误与关键交互）/ false（跳过）
    // 默认：true
    // 注意：需要可用的无头浏览器环境；Chrome 探测/启动失败时跳过并告警（构建不失败，结果标注 skipped）；
    //   测试/隔离构建可用环境变量 SYNAPSE_COMPRESSION_VERIFY=off 显式关闭
    headless: true,

    // 作用：门禁失败时的回退策略
    // 类型：boolean；可填：true（回退未压缩产物 + 非阻断告警，构建继续）/ false（不回退、保留压缩产物并以非零码失败告警）
    // 默认：true
    // 注意：回退发生在 cacheBust（内容哈希）之前，回退产物照常参与哈希（哈希=最终字节）；
    //   回退后执行逐字节复核，复核不一致升级为阻断失败；验证结果写入 .cache/compression-verify/last.json
    fallbackOnFailure: true,
  },
}

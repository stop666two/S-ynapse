// =====================================================================
// content-policy.json5 — 内容策略（media/ videos/ assets/ 三目录白黑名单）
// ---------------------------------------------------------------------
// 作用: 控制在构建时哪些文件允许进入 dist/ 发布线
// 判定优先级（高 → 低）: 文件名黑名单 > 可执行扩展名 > 渲染型文档 > 目录白名单
// 被拦截文件: 不复制进 dist（线上 404）,并在 build-report 中逐条列出
// 格式: JSON5;生效: 修改后需重新构建
// 说明: 本文件为可选项;删除后构建使用代码内建的同款默认策略
// 注释模板: 作用 / 类型 / 可填值及含义 / 不可填值及原因 / 推荐 / 注意
// =====================================================================
{
  // 策略总开关
  // 作用: false 时三目录策略整体停用（内容照常复制,不做白黑名单判定）
  // 类型: boolean | 可填: true(推荐,启用防护)/false(仅限本地调试)
  // 注意: media 的图片优化管线不受此开关影响
  enabled: true,

  // ================================================================
  // media/ 图片目录 — 白名单制（除白名单外一律 404）
  // ================================================================

  // 允许的图片扩展名
  // 类型: string[]（小写扩展名,不含点） | 可填: 常见位图与矢量格式
  // 不可填: 可执行/脚本类扩展名（会被 blockedExts 优先拦截,写了也无效）
  // 推荐: 保持默认 13 种;新增格式（如 jxl）再追加
  mediaExts: [
    'jpg', 'jpeg', 'png', 'gif', 'webp', 'avif', 'bmp', 'ico',
    'svg', 'tiff', 'tif', 'heic', 'heif'
  ],

  // ================================================================
  // videos/ 视频目录 — 排除制（除黑名单与渲染型文档外均放行）
  // ================================================================

  // 视频目录判定模式
  // 作用: 'deny-list' 表示只拦黑名单与渲染型文档,其余视频格式放行
  // 类型: string（目前仅支持 'deny-list'）
  // 可填: 'deny-list'（推荐,避免冷门视频格式被误杀）
  // 不可填: 'allow-list'（未实现;需先扩展代码再启用）
  videoMode: 'deny-list',

  // ================================================================
  // assets/ 素材目录 — 白名单制
  // ================================================================

  // 允许的素材扩展名（按类别分组,便于维护）
  // 类型: string[] | 可填: 文本/办公/压缩包/音频/字体等下载型资源
  // 不可填: 可执行与脚本源码（blockedExts 优先拦截）
  // 推荐: 保持默认;删除某类即禁止该类文件发布
  assetExts: [
    // 纯文本与数据
    'txt', 'csv', 'json', 'yml', 'yaml', 'toml', 'ini', 'log', 'conf',
    // 办公文档与 PDF
    'pdf', 'doc', 'docx', 'ppt', 'pptx', 'xls', 'xlsx', 'epub', 'rtf', 'odt', 'ods', 'odp',
    // 压缩包(下载型)
    'zip', '7z', 'rar', 'gz', 'tgz', 'tar', 'bz2', 'xz', 'zst',
    // 音频
    'mp3', 'wav', 'm4a', 'ogg', 'flac', 'aac', 'opus',
    // 字体
    'woff', 'woff2', 'ttf', 'otf', 'eot'
  ],

  // ================================================================
  // 全局可执行/脚本黑名单（优先级最高:无论放哪个目录都 404）
  // ================================================================

  // 禁止发布的扩展名
  // 类型: string[] | 可填: 可执行/库/脚本/源码类扩展名
  // 不可填: 从列表中移除高风险项（等于放行可执行文件,严重安全风险）
  // 推荐: 保持默认全集;如站点确需提供下载,请评估风险后单独加白名机制
  blockedExts: [
    // Windows 可执行/库/脚本
    'exe', 'dll', 'sys', 'ocx', 'drv', 'com', 'scr', 'pif', 'cpl', 'msi', 'msp', 'msu', 'mst',
    'bat', 'cmd', 'com', 'reg', 'lnk', 'url', 'hta', 'wsc', 'wsf', 'wsh', 'vbs', 'vbe', 'js', 'jse',
    'ps1', 'psd1', 'psm1', 'msix', 'msixbundle', 'appx', 'appxbundle', 'jse',
    // 跨平台可执行与容器
    'appimage', 'dmg', 'pkg', 'mpkg', 'jar', 'jnlp', 'apk', 'ipa', 'deb', 'rpm',
    // Linux 可执行与脚本
    'sh', 'bash', 'zsh', 'fish', 'bin', 'run', 'elf', 'so', 'o', 'ko', 'snap',
    // 解释器脚本源码(即使作为文本下载也不放行)
    'py', 'pyw', 'pyc', 'pl', 'pm', 'php', 'phtml', 'rb', 'lua', 'tcl', 'r', 'jl',
    'java', 'class', 'go', 'rs', 'cs', 'c', 'cpp', 'h', 'hpp', 'm', 'scala', 'kt', 'swift', 'cr',
    'ts', 'tsx', 'jsx', 'mjs', 'cjs'
  ],

  // ================================================================
  // 渲染型文档（可携带活动内容,默认拦截防同源内容注入）
  // ================================================================

  // 渲染型文档扩展名
  // 作用: 这些格式以文档方式打开可执行脚本/XSLT 处理,除 media 下经消毒的 SVG 外一律拦截
  // 类型: string[] | 可填: 保持默认
  // 不可填: 从列表移除（等于允许 HTML/XML 注入攻击面）
  // 推荐: 默认;确需发布 XML 时请评估后调整
  documentRenderedTypes: ['html', 'htm', 'xhtml', 'xml', 'xsl', 'xslt', 'dtd', 'svg', 'shtml'],

  // ================================================================
  // 文件名黑名单（精确匹配;系统生成物）
  // ================================================================

  // 禁止发布的文件名（小写精确匹配）
  // 类型: string[] | 可填: 系统噪音文件名 | 推荐: 保持默认
  blockedFilenames: ['.ds_store', 'thumbs.db', 'desktop.ini', '.gitkeep'],

  // ================================================================
  // SVG 消毒
  // ================================================================

  // 是否对 media/ 下的 SVG 做消毒检查
  // 作用: 含 <script>/on* 事件属性/外部引用的 SVG 将被拒绝发布（404 + 报告）
  // 类型: boolean | 可填: true(推荐)/false(不建议,等于放行可执行 SVG)
  // 注意: 判定为保守策略;纯图形 SVG（如 og-image.svg）不受影响
  svgSanitize: true
}

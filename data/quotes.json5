// 每日一言数据文件（构建期读取；features.dailyQuote.dataFile 默认指向本文件）
// ---------------------------------------------------------------------------
// 格式：JSON5 数组；每条为对象，字段语义：
//   text       中文字段 / 中文站展示文本。中文经典为原文；西方经典为原文（英文）；
//              本项目原创短句为中文原文。必填、全文唯一。
//   textEn     英文字段 / 英文站展示文本。中文经典与本项目原创短句的英译为**本项目提供**
//              （对应条目 sourceEn 以 “· trans. S-ynapse” / “Original by S-ynapse” 标注）；
//              西方公版经典 textEn 与 text 相同（英文原文，不另作翻译）。
//   author     中文站作者名（西方作者的通用中文译名）；无名/原创条目可省略。
//   authorEn   英文站作者名（中文作者用通行罗马字）；有 author 时必填，两者同时省略。
//   source     中文站出处（如《论语·学而》）；原创条目为 “S-ynapse 原创”。必填。
//   sourceEn   英文站出处（如 The Analects · Xue Er）；中文条目附英译标注。必填。
//   tags       标签数组，取值仅限下列 9 个枚举（中文站口径；英文站暂不展示标签）：
//              哲思 / 励志 / 自然 / 时间 / 读书 / 自由 / 智慧 / 幽默 / 情感
//
// 版权说明：所选文本均为公有领域作品（中国古典、莎士比亚/培根/梭罗/爱默生/王尔德等
// 逝世满版权保护期的西方作者、1611 年钦定版《圣经》），或由本项目原创；中文经典的英译
// 为本项目自译，随项目以 MIT 许可证提供。**严禁**收录来源不明或网络误传的名句。
// ---------------------------------------------------------------------------
[
  // ---- 论语及先秦儒家 ----
  {
    text: "学而时习之，不亦说乎？",
    textEn: "To learn, and in due time to practise what one has learned — is that not a joy?",
    author: "孔子",
    authorEn: "Confucius",
    source: "《论语·学而》",
    sourceEn: "The Analects · Xue Er · trans. S-ynapse",
    tags: ["读书", "智慧"]
  },
  {
    text: "学而不思则罔，思而不学则殆。",
    textEn: "Learning without thought ends in bewilderment; thought without learning ends in peril.",
    author: "孔子",
    authorEn: "Confucius",
    source: "《论语·为政》",
    sourceEn: "The Analects · Wei Zheng · trans. S-ynapse",
    tags: ["读书", "哲思"]
  },
  {
    text: "知之为知之，不知为不知，是知也。",
    textEn: "To know what you know, and to know what you do not know — that is true knowledge.",
    author: "孔子",
    authorEn: "Confucius",
    source: "《论语·为政》",
    sourceEn: "The Analects · Wei Zheng · trans. S-ynapse",
    tags: ["智慧", "读书"]
  },
  {
    text: "温故而知新，可以为师矣。",
    textEn: "Review the old and learn the new: then you may be a teacher.",
    author: "孔子",
    authorEn: "Confucius",
    source: "《论语·为政》",
    sourceEn: "The Analects · Wei Zheng · trans. S-ynapse",
    tags: ["读书"]
  },
  {
    text: "工欲善其事，必先利其器。",
    textEn: "A craftsman who would do his work well must first sharpen his tools.",
    author: "孔子",
    authorEn: "Confucius",
    source: "《论语·卫灵公》",
    sourceEn: "The Analects · Wei Ling Gong · trans. S-ynapse",
    tags: ["智慧"]
  },
  {
    text: "见贤思齐焉，见不贤而内自省也。",
    textEn: "On seeing a person of worth, think of equalling them; on seeing one unworthy, look within.",
    author: "孔子",
    authorEn: "Confucius",
    source: "《论语·里仁》",
    sourceEn: "The Analects · Li Ren · trans. S-ynapse",
    tags: ["励志", "智慧"]
  },
  {
    text: "己所不欲，勿施于人。",
    textEn: "Do not impose on others what you yourself do not want.",
    author: "孔子",
    authorEn: "Confucius",
    source: "《论语·卫灵公》",
    sourceEn: "The Analects · Wei Ling Gong · trans. S-ynapse",
    tags: ["智慧", "情感"]
  },
  {
    text: "逝者如斯夫，不舍昼夜。",
    textEn: "It passes on like this, never resting, day or night.",
    author: "孔子",
    authorEn: "Confucius",
    source: "《论语·子罕》",
    sourceEn: "The Analects · Zi Han · trans. S-ynapse",
    tags: ["时间", "哲思"]
  },
  {
    text: "岁寒，然后知松柏之后凋也。",
    textEn: "Only when the cold comes do we know that the pine and cypress are the last to wither.",
    author: "孔子",
    authorEn: "Confucius",
    source: "《论语·子罕》",
    sourceEn: "The Analects · Zi Han · trans. S-ynapse",
    tags: ["自然", "励志"]
  },
  {
    text: "知者行之始，行者知之成。",
    textEn: "Knowing is the beginning of action; action is the completion of knowing.",
    author: "王阳明",
    authorEn: "Wang Yangming",
    source: "《传习录》",
    sourceEn: "Instructions for Practical Living · trans. S-ynapse",
    tags: ["读书", "智慧"]
  },
  {
    // ---- 道家 ----
    text: "道可道，非常道；名可名，非常名。",
    textEn: "The Way that can be told is not the constant Way; the name that can be named is not the constant name.",
    author: "老子",
    authorEn: "Laozi",
    source: "《道德经·第一章》",
    sourceEn: "Dao De Jing · Chapter 1 · trans. S-ynapse",
    tags: ["哲思"]
  },
  {
    text: "千里之行，始于足下。",
    textEn: "A journey of a thousand li begins under one's feet.",
    author: "老子",
    authorEn: "Laozi",
    source: "《道德经·第六十四章》",
    sourceEn: "Dao De Jing · Chapter 64 · trans. S-ynapse",
    tags: ["励志"]
  },
  {
    text: "知人者智，自知者明。",
    textEn: "To know others is cleverness; to know oneself is clarity.",
    author: "老子",
    authorEn: "Laozi",
    source: "《道德经·第三十三章》",
    sourceEn: "Dao De Jing · Chapter 33 · trans. S-ynapse",
    tags: ["智慧"]
  },
  {
    text: "上善若水，水善利万物而不争。",
    textEn: "The highest good is like water: it benefits all things and does not contend.",
    author: "老子",
    authorEn: "Laozi",
    source: "《道德经·第八章》",
    sourceEn: "Dao De Jing · Chapter 8 · trans. S-ynapse",
    tags: ["哲思", "自然"]
  },
  {
    text: "知足不辱，知止不殆。",
    textEn: "Those who know contentment are not disgraced; those who know when to stop are not endangered.",
    author: "老子",
    authorEn: "Laozi",
    source: "《道德经·第四十四章》",
    sourceEn: "Dao De Jing · Chapter 44 · trans. S-ynapse",
    tags: ["智慧"]
  },
  {
    text: "吾生也有涯，而知也无涯。",
    textEn: "My life has a limit; knowledge has none.",
    author: "庄子",
    authorEn: "Zhuangzi",
    source: "《庄子·养生主》",
    sourceEn: "Zhuangzi · The Secret of Caring for Life · trans. S-ynapse",
    tags: ["读书", "哲思"]
  },
  {
    text: "君子之交淡若水。",
    textEn: "The friendship of true gentlemen is as clear as water.",
    author: "庄子",
    authorEn: "Zhuangzi",
    source: "《庄子·山木》",
    sourceEn: "Zhuangzi · The Tree on the Mountain · trans. S-ynapse",
    tags: ["情感"]
  },
  {
    text: "相濡以沫，不如相忘于江湖。",
    textEn: "Rather than moisten each other in a dried-up pool, better to forget each other in the rivers and lakes.",
    author: "庄子",
    authorEn: "Zhuangzi",
    source: "《庄子·大宗师》",
    sourceEn: "Zhuangzi · The Great and Venerable Teacher · trans. S-ynapse",
    tags: ["自由", "情感"]
  },
  // ---- 孟子 ----
  {
    text: "生于忧患，死于安乐。",
    textEn: "We thrive amid hardship and perish amid comfort.",
    author: "孟子",
    authorEn: "Mencius",
    source: "《孟子·告子下》",
    sourceEn: "Mencius · Gaozi II · trans. S-ynapse",
    tags: ["励志"]
  },
  {
    text: "富贵不能淫，贫贱不能移，威武不能屈。",
    textEn: "Neither wealth nor rank can corrupt him; neither poverty nor obscurity can move him; neither power nor might can bend him.",
    author: "孟子",
    authorEn: "Mencius",
    source: "《孟子·滕文公下》",
    sourceEn: "Mencius · Teng Wen Gong II · trans. S-ynapse",
    tags: ["自由", "励志"]
  },
  {
    text: "民为贵，社稷次之，君为轻。",
    textEn: "The people are the most precious; the state comes next; the ruler is the least.",
    author: "孟子",
    authorEn: "Mencius",
    source: "《孟子·尽心下》",
    sourceEn: "Mencius · Jin Xin II · trans. S-ynapse",
    tags: ["自由", "智慧"]
  },
  // ---- 礼记 / 大学 / 周易 / 左传 ----
  {
    text: "学然后知不足，教然后知困。",
    textEn: "Through learning we discover our inadequacy; through teaching we discover our perplexity.",
    source: "《礼记·学记》",
    sourceEn: "The Book of Rites · On Learning · trans. S-ynapse",
    tags: ["读书"]
  },
  {
    text: "博学之，审问之，慎思之，明辨之，笃行之。",
    textEn: "Study it widely, inquire into it carefully, reflect on it earnestly, distinguish it clearly, and practise it faithfully.",
    source: "《礼记·中庸》",
    sourceEn: "The Book of Rites · The Doctrine of the Mean · trans. S-ynapse",
    tags: ["读书", "智慧"]
  },
  {
    text: "大道之行也，天下为公。",
    textEn: "When the Great Way prevails, the world belongs to all.",
    source: "《礼记·礼运》",
    sourceEn: "The Book of Rites · Li Yun · trans. S-ynapse",
    tags: ["自由", "智慧"]
  },
  {
    text: "苟日新，日日新，又日新。",
    textEn: "If you can renew yourself one day, renew yourself every day, and renew yourself again.",
    source: "《大学》",
    sourceEn: "The Great Learning · trans. S-ynapse",
    tags: ["励志", "时间"]
  },
  {
    text: "天行健，君子以自强不息。",
    textEn: "As heaven moves with vigour, the gentleman strives without cease.",
    source: "《周易·乾》",
    sourceEn: "I Ching · Qian · trans. S-ynapse",
    tags: ["励志"]
  },
  {
    text: "居安思危，思则有备，有备无患。",
    textEn: "In times of safety, think of danger; thinking brings readiness, and readiness brings freedom from harm.",
    author: "左丘明",
    authorEn: "Zuo Qiuming",
    source: "《左传·襄公十一年》",
    sourceEn: "Zuo Zhuan · Duke Xiang, Year 11 · trans. S-ynapse",
    tags: ["智慧"]
  },
  // ---- 菜根谭 ----
  {
    text: "宠辱不惊，闲看庭前花开花落。",
    textEn: "Undisturbed by favour or disgrace, one calmly watches the flowers bloom and fall before the courtyard.",
    author: "洪应明",
    authorEn: "Hong Yingming",
    source: "《菜根谭》",
    sourceEn: "Vegetable Roots Discourse · trans. S-ynapse",
    tags: ["哲思"]
  },
  // ---- 楚辞 / 魏晋 ----
  {
    text: "路漫漫其修远兮，吾将上下而求索。",
    textEn: "The road ahead is long and distant; I shall search high and low.",
    author: "屈原",
    authorEn: "Qu Yuan",
    source: "《离骚》",
    sourceEn: "Li Sao · trans. S-ynapse",
    tags: ["励志"]
  },
  {
    text: "采菊东篱下，悠然见南山。",
    textEn: "Picking chrysanthemums by the eastern hedge, I look up and see the southern hills, at ease.",
    author: "陶渊明",
    authorEn: "Tao Yuanming",
    source: "《饮酒·其五》",
    sourceEn: "Drinking Wine, No. 5 · trans. S-ynapse",
    tags: ["自然", "哲思"]
  },
  {
    text: "盛年不重来，一日难再晨。",
    textEn: "The prime of life never returns; a single day has but one morning.",
    author: "陶渊明",
    authorEn: "Tao Yuanming",
    source: "《杂诗》",
    sourceEn: "Miscellaneous Poems · trans. S-ynapse",
    tags: ["时间", "励志"]
  },
  // ---- 唐诗文 ----
  {
    text: "海内存知己，天涯若比邻。",
    textEn: "If a true friend is near at heart, the far ends of the earth are neighbours.",
    author: "王勃",
    authorEn: "Wang Bo",
    source: "《送杜少府之任蜀州》",
    sourceEn: "Farewell to Prefect Du · trans. S-ynapse",
    tags: ["情感"]
  },
  {
    text: "落霞与孤鹜齐飞，秋水共长天一色。",
    textEn: "The falling clouds and a lone duck fly together; autumn waters share one hue with the vast sky.",
    author: "王勃",
    authorEn: "Wang Bo",
    source: "《滕王阁序》",
    sourceEn: "Preface to the Pavilion of Prince Teng · trans. S-ynapse",
    tags: ["自然"]
  },
  {
    text: "欲穷千里目，更上一层楼。",
    textEn: "To see a thousand li, climb one more storey.",
    author: "王之涣",
    authorEn: "Wang Zhihuan",
    source: "《登鹳雀楼》",
    sourceEn: "On the Stork Tower · trans. S-ynapse",
    tags: ["励志"]
  },
  {
    text: "长风破浪会有时，直挂云帆济沧海。",
    textEn: "A time will come to ride the long wind and break the waves; I shall hoist my cloud-white sail and cross the sea.",
    author: "李白",
    authorEn: "Li Bai",
    source: "《行路难》",
    sourceEn: "Hard Is the Road · trans. S-ynapse",
    tags: ["励志", "自由"]
  },
  {
    text: "天生我材必有用，千金散尽还复来。",
    textEn: "Heaven gave me talents that must be of use; a thousand pieces of gold, once spent, will come again.",
    author: "李白",
    authorEn: "Li Bai",
    source: "《将进酒》",
    sourceEn: "Bring in the Wine · trans. S-ynapse",
    tags: ["励志"]
  },
  {
    text: "会当凌绝顶，一览众山小。",
    textEn: "I shall stand on the summit, and all the other mountains will seem small.",
    author: "杜甫",
    authorEn: "Du Fu",
    source: "《望岳》",
    sourceEn: "Gazing at Mount Tai · trans. S-ynapse",
    tags: ["励志"]
  },
  {
    text: "随风潜入夜，润物细无声。",
    textEn: "With the wind it steals into the night, moistening all things in silence.",
    author: "杜甫",
    authorEn: "Du Fu",
    source: "《春夜喜雨》",
    sourceEn: "Happy Rain on a Spring Night · trans. S-ynapse",
    tags: ["自然"]
  },
  {
    text: "山不在高，有仙则名；水不在深，有龙则灵。",
    textEn: "A mountain need not be high — a spirit makes it famous; water need not be deep — a dragon makes it sacred.",
    author: "刘禹锡",
    authorEn: "Liu Yuxi",
    source: "《陋室铭》",
    sourceEn: "The Inscription of My Humble Room · trans. S-ynapse",
    tags: ["哲思"]
  },
  {
    text: "沉舟侧畔千帆过，病树前头万木春。",
    textEn: "Past the sunken boat a thousand sails go by; ahead of the withered tree ten thousand woods are spring.",
    author: "刘禹锡",
    authorEn: "Liu Yuxi",
    source: "《酬乐天扬州初逢席上见赠》",
    sourceEn: "Written in Reply to Bai Juyi at Their First Meeting in Yangzhou · trans. S-ynapse",
    tags: ["时间", "励志"]
  },
  // ---- 宋诗词文 ----
  {
    text: "但愿人长久，千里共婵娟。",
    textEn: "May we all be blessed with long life; though a thousand li apart, we share the same bright moon.",
    author: "苏轼",
    authorEn: "Su Shi",
    source: "《水调歌头》",
    sourceEn: "Prelude to Water Melody · trans. S-ynapse",
    tags: ["情感"]
  },
  {
    text: "不识庐山真面目，只缘身在此山中。",
    textEn: "We cannot know Mount Lu's true face, for we are within the mountain.",
    author: "苏轼",
    authorEn: "Su Shi",
    source: "《题西林壁》",
    sourceEn: "Written on the Wall of Xilin Temple · trans. S-ynapse",
    tags: ["哲思"]
  },
  {
    text: "惟愿孩儿愚且鲁，无灾无难到公卿。",
    textEn: "I only wish my child dull and slow, that without disaster he may rise to high office.",
    author: "苏轼",
    authorEn: "Su Shi",
    source: "《洗儿戏作》",
    sourceEn: "A Jest on the Birth of a Child · trans. S-ynapse",
    tags: ["幽默", "情感"]
  },
  {
    text: "纸上得来终觉浅，绝知此事要躬行。",
    textEn: "What is learned from paper is shallow in the end; to truly know a matter, one must practise it.",
    author: "陆游",
    authorEn: "Lu You",
    source: "《冬夜读书示子聿》",
    sourceEn: "Reading on a Winter Night, to My Son Ziyu · trans. S-ynapse",
    tags: ["读书"]
  },
  {
    text: "问渠那得清如许？为有源头活水来。",
    textEn: "How can the pond be so clear? Because living water flows from its source.",
    author: "朱熹",
    authorEn: "Zhu Xi",
    source: "《观书有感》",
    sourceEn: "Impressions from Reading · trans. S-ynapse",
    tags: ["读书", "哲思"]
  },
  {
    text: "人生自古谁无死？留取丹心照汗青。",
    textEn: "Since ancient times, who has not died? Let my loyal heart shine in the pages of history.",
    author: "文天祥",
    authorEn: "Wen Tianxiang",
    source: "《过零丁洋》",
    sourceEn: "Crossing the Lonely Ocean · trans. S-ynapse",
    tags: ["励志", "情感"]
  },
  // ---- 明清 ----
  {
    text: "我自横刀向天笑，去留肝胆两昆仑。",
    textEn: "I laugh at heaven with my sword across; stay or go, my heart is as two great mountains.",
    author: "谭嗣同",
    authorEn: "Tan Sitong",
    source: "《狱中题壁》",
    sourceEn: "Written on the Prison Wall · trans. S-ynapse",
    tags: ["自由", "励志"]
  },
  {
    text: "落红不是无情物，化作春泥更护花。",
    textEn: "Fallen blossoms are not heartless things: turned to spring mud, they nurture the flowers the more.",
    author: "龚自珍",
    authorEn: "Gong Zizhen",
    source: "《己亥杂诗》",
    sourceEn: "Miscellaneous Poems of the Year Jihai · trans. S-ynapse",
    tags: ["情感", "自然"]
  },
  {
    text: "咬定青山不放松，立根原在破岩中。",
    textEn: "Clinging to the green mountain and never letting go, its roots are set in broken rock.",
    author: "郑板桥",
    authorEn: "Zheng Banqiao",
    source: "《竹石》",
    sourceEn: "Bamboo and Rock · trans. S-ynapse",
    tags: ["励志", "自然"]
  },
  {
    text: "难得糊涂。",
    textEn: "Rare is the art of playing the fool.",
    author: "郑板桥",
    authorEn: "Zheng Banqiao",
    source: "《难得糊涂》题刻",
    sourceEn: "Inscription · trans. S-ynapse",
    tags: ["幽默", "智慧"]
  },
  // ---- 兵书 / 史书 / 文论 ----
  {
    text: "知己知彼，百战不殆。",
    textEn: "Know your enemy and know yourself, and you will not be defeated in a hundred battles.",
    author: "孙武",
    authorEn: "Sun Tzu",
    source: "《孙子兵法·谋攻》",
    sourceEn: "The Art of War · Attack by Stratagem · trans. S-ynapse",
    tags: ["智慧"]
  },
  {
    text: "桃李不言，下自成蹊。",
    textEn: "The peach and the plum do not speak, yet a path is worn beneath them.",
    author: "司马迁",
    authorEn: "Sima Qian",
    source: "《史记·李将军列传》",
    sourceEn: "Records of the Grand Historian · trans. S-ynapse",
    tags: ["情感", "智慧"]
  },
  {
    text: "操千曲而后晓声，观千剑而后识器。",
    textEn: "Only after playing a thousand tunes does one understand music; only after seeing a thousand swords does one know weapons.",
    author: "刘勰",
    authorEn: "Liu Xie",
    source: "《文心雕龙·知音》",
    sourceEn: "The Literary Mind and the Carving of Dragons · trans. S-ynapse",
    tags: ["读书", "智慧"]
  },
  {
    text: "夕阳无限好，只是近黄昏。",
    textEn: "The setting sun is infinitely lovely — it is only that dusk is near.",
    author: "李商隐",
    authorEn: "Li Shangyin",
    source: "《乐游原》",
    sourceEn: "Leyou Plain · trans. S-ynapse",
    tags: ["时间", "哲思"]

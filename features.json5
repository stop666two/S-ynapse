// =============================================================================
// features.json5 — S-ynapse 交互与内容功能总控
// =============================================================================
// 作用     : 集中控制站点的交互功能与内容渲染行为(开关 + 粒度 + 微调)。
// 加载时机 : 构建时自动加载,随其余配置文件一起合并（可缺省/可删键）。
// 数据形状 : 每个功能一个一级对象;每个对象至少含 enabled(布尔)。
//            缺省任何键时构建器使用内置默认值(与本站当前行为一致)。
// 校验规则 : 键名不在 schema 中的会被忽略(不报错);enabled 非布尔或枚举字段
//            非法值会终止构建并给出精确错误(见 scripts/lib/features-schema.js)。
// 数组语义 : 数组合并为"替换"而非追加(如 share.order 删一项即彻底移除)。
// 编写规范 : 布尔值开启/关闭;数字为具体数值;字符串为 CSS 值或文本。
//            每个字段均有真实效果,无摆设项;修改后需重新构建。
// 双语约定 : 任一文案字段均可追加同名 En 后缀(如 buttonTextEn)提供英文站文案;
//            类型与中文值一致;空字符串 = en 站回退中文值(英文页兜底不空白)。
// 边界提示 : 视觉数值微调 → tuning.json5;站点级开关 → site.json5;
//            主题色/字体 → theme.json5;界面文案 → ui-strings.json5。
// =============================================================================

{
  // ---------------------------------------------------------------------------
  // 1. 图片灯箱(点击正文/图库图片放大预览)
  // ---------------------------------------------------------------------------
  lightbox: {
    // 启用图片灯箱。关闭后点击图片无放大效果。
    enabled: true,
    // 放大功能(工具栏放大/缩小按钮 + 双击 + 滚轮 + 双指捏合)。false 时隐藏。
    zoomEnabled: true,
    // 平移拖拽功能(放大后拖动图片查看细节)。false 时禁止拖拽。
    panEnabled: true,
    // 旋转功能(工具栏旋转 90°按钮)。
    rotateEnabled: true,
    // 移动端双指捏合缩放。
    pinchEnabled: true,
    // 每次点击按钮的缩放步长(0.25 = 25%)。
    zoomStep: 0.25,
    // 最小缩放倍数(1 = 原始尺寸)。
    zoomMin: 1,
    // 最大缩放倍数。
    zoomMax: 4,
    // 是否支持双击图片放大/还原。
    dblClickZoom: true,
    // 是否支持鼠标滚轮缩放。
    wheelZoom: true,
    // 是否显示缩放/旋转/重置按钮组。
    showZoomButtons: true,
    // 收集目标的选择器。默认正文图片 + 图库图片;其他容器可追加类名,逗号分隔。
    selectors: '.post-content img, .gallery-item img',
    // 控制在图片周围触发灯箱的最小边长(px)。用于过滤小图标。
    minSize: 60,
    // 是否支持上一张/下一张切换按钮。
    prevNextButtons: true,
    // 是否支持关闭按钮(右上角 ×)。
    closeButton: true,
    // 是否支持键盘方向键切换(左=上一张,右=下一张)。
    keyboardNavigate: true,
    // 是否支持 ESC 关闭。
    escToClose: true,
    // 是否支持移动端左右滑动切换。
    swipeToNavigate: true,
    // 是否支持下/上滑动关闭灯箱(移动端下拉关闭,放大状态下不触发)。
    swipeClose: true,
    // 点击遮罩区域是否关闭灯箱。
    closeOnBackdrop: true,
    // 是否显示"第 N / M 张"计数器。
    showCounter: true,
    // 计数器文本模板。{current} 当前索引,{total} 总数。
    counterFormat: '{current} / {total}',
    // 图片最大宽度(占视口百分比)。
    maxWidthVw: '92',
    // 图片最大尺寸上限(px)。
    maxSizePx: '1600',
    // 图片最大高度(占视口百分比)。
    maxHeightVh: '82',
    // 打开动画时长(ms)。
    openDurationMs: 180,
    // 切换动画时长(ms)。
    switchDurationMs: 120,
    // 遮罩背景透明度(0~1)。
    backdropOpacity: '0.9',
    // 是否预加载相邻图片(切换前预缓存)。
    preloadAdjacent: true,
    // 是否记忆上次浏览位置(刷新后仍从上次索引打开)。
    rememberPosition: false,
    // 是否在图片下方显示说明条(显示当前图片的 alt 文本)。
    showCaption: true,
    // 说明条最大显示行数(超出截断省略,1~3 推荐 2)。
    captionMaxLines: 2,
    // 灯箱打开/关闭过渡时长(ms,CSS transition-duration)。
    transitionDurationMs: 220
  },

  // ---------------------------------------------------------------------------
  // 2. 阅读进度条(顶部渐变条 + 点击跳转 + 跟随圆点)
  // ---------------------------------------------------------------------------
  readingProgress: {
    // 启用阅读进度条。
    enabled: true,
    // 是否只在文章页显示。false 时所有页面(含首页)均显示。
    articleOnly: true,
    // 是否支持点击跳转到相应位置。
    clickToJump: true,
    // 是否显示跟随小圆点(贴进度条底部)。
    showDot: true,
    // 圆点尺寸(px)。
    dotSize: '10px',
    // 进度条高度(px)。
    barHeight: '3px',
    // 是否使用渐变颜色(否则纯色)。
    useGradient: true,
    // 渐变起始色(变量名或色值;useGradient=true 有效)。
    gradientStart: 'var(--color-s)',
    // 渐变结束色(变量名或色值)。
    gradientEnd: 'var(--color-a)',
    // 点击后百分比提示的显示时长(ms)。
    tipDisplayMs: 500,
    // 记忆阅读位置:同一文章再次打开时恢复到上次滚动位置。
    rememberPosition: true,
    // 阅读位置最大记忆时长(小时;超时不再恢复)。
    rememberPositionMaxAgeHours: 72,
    // 滚动时实时更新节流间隔(ms)。
    updateThrottleMs: 30,
    // 是否通过 ARIA 播报进度(屏幕阅读器)。
    ariaAnnounce: true,
    // 进度条贴顶偏移(px)。
    topOffset: '0',
    // 进度条层叠顺序(z-index)。与其他浮层冲突时调大。
    zIndex: 1000,
    // 是否显示百分比提示气泡(跟随进度条的圆点下方)。
    showTip: true
  },

  // ---------------------------------------------------------------------------
  // 3. 返回顶部按钮(滚动后显示)
  // ---------------------------------------------------------------------------
  backToTop: {
    // 启用返回顶部按钮。
    enabled: true,
    // 滚动多少像素后显示按钮。
    showAfterPx: 400,
    // 距右边缘距离。
    rightOffset: '2rem',
    // 距底边距离。
    bottomOffset: '2rem',
    // 按钮尺寸(px)。
    size: '44px',
    // 滚动回顶部动画时长(ms)。
    scrollDurationMs: 450,
    // 是否平滑滚动。
    smoothScroll: true,
    // 键盘快捷键(KeyboardEvent.key 值,如 'Home');空字符串 = 禁用。
    // 仅在非输入框且无 Ctrl/Cmd/Alt 修饰键时生效。
    hotkey: '',
    // 无 JS 时的 HTML 锚点按钮(向后兼容)。
    htmlAnchorFallback: false,
    // 按钮层叠顺序(z-index)。与其他浮层冲突时调大。
    zIndex: 999
  },

  // ---------------------------------------------------------------------------
  // 4. 客户端全文搜索
  // ---------------------------------------------------------------------------
  search: {
    // 启用搜索(index/index 数据由导航配置 search.provider=local 控制)。
    enabled: true,
    // 在搜索框输入时达到多少字符才开始检索。
    minChars: 1,
    // 搜索结果数量上限。
    maxResults: 30,
    // 是否高亮命中词。
    // 预留: 当前命中高亮由 features.searchHighlight.enabled / maxMatches 控制，本键未接线。
    highlightMatches: true,
    // 是否显示文章总数提示。
    // 预留: 当前搜索结果数恒显示，未按下述开关门控，本键未接线。
    showCount: true,
    // 搜索框占位文本。
    // 预留: 当前使用 navigation.json5 search.placeholder（en 站点由 ui-strings 覆盖），本键未接线。
    placeholder: '搜索...',
    // 搜索框占位文本（en 站；空 = 回退中文；该键为预留，当前未接线）。
    placeholderEn: 'Search...',
    // 无输入时的提示文本。
    // 预留: 当前空态文案由 tuning/i18n 内置文案提供，本键未接线。
    emptyHint: '输入关键词开始搜索',
    // 无输入提示（en 站；空 = 回退中文；该键为预留，当前未接线）。
    emptyHintEn: 'Type a keyword to search',
    // 无结果时提示文本。
    noResultText: '未找到匹配内容',
    // 无结果提示（en 站；空 = 回退中文）。
    noResultTextEn: 'No matching content',
    // 结果命中截断长度(字符)。
    excerptLength: 120,
    // 是否包含正文全文(否则仅标题/摘要/标签)。
    // 说明: 由构建期消费——运行时生成 search-index.json（local 模式）时决定 content 字段是否写入正文。
    includeContent: true,
    // 是否匹配标签。
    // 预留: 当前前端检索仅匹配标题/摘要/正文，本键未接线。
    matchTags: true,
    // 是否匹配分类。
    // 预留: 当前前端检索仅匹配标题/摘要/正文，本键未接线。
    matchCategories: true,
    // 标题匹配权重(正整数;越大越优先)。
    // 预留: 当前前端无加权排序算法，本键未接线。
    weightTitle: 5,
    // 摘要匹配权重。
    // 预留: 当前前端无加权排序算法，本键未接线。
    weightExcerpt: 2,
    // 正文匹配权重。
    // 预留: 当前前端无加权排序算法，本键未接线。
    weightContent: 1,
    // 关闭方式:点击遮罩。
    // 预留: 当前“点击遮罩关闭”固定生效，未受本键控制，本键未接线。
    closeOnOverlay: true,
    // 打开后是否自动聚焦输入框。
    // 预留: 当前打开后恒自动聚焦，本键未接线。
    focusOnOpen: true,
    // 打开动画方式。
    // 类型: string | 可填: 'fade'(默认,弹层淡入)/'slide'(自下而上滑入)
    openAnimation: 'fade',
    // 是否支持拼音首字母匹配(实验)。
    pinyinFuzzy: false,
    // 输入防抖间隔(ms)。停止输入该时长后才执行检索,减少频繁重查。
    debounceMs: 120,
    // 聚焦输入框时是否自动显示搜索历史。
    showHistoryOnFocus: true,
    // 搜索历史最多保留条数(超出丢弃最旧)。
    maxHistory: 5
  },

  // ---------------------------------------------------------------------------
  // 5. 图片懒加载与表现
  // ---------------------------------------------------------------------------
  imageLazy: {
    // 启用原生 loading=lazy（加载时机由浏览器管理,无 JS 观察器,不提供自定义预取边距）。
    enabled: true,
    // 是否淡入显示。
    fadeIn: true,
    // 淡入时长(ms)。
    fadeInDurationMs: 300,
    // 图片占位背景色。
    placeholderColor: 'var(--color-hover)',
    // 加载中占位 class(配合 CSS 做淡入/占位)。
    loadingClass: 'img-loading',
    // 加载失败 class。
    errorClass: 'img-error',
    // 前 N 张图片立即加载(视口顶部),不做懒加载。
    eagerFirst: 3,
    // 是否保留 width/height 防止布局抖动。
    preserveAspectRatio: true,
    // 构建期生成 LQIP 模糊占位(内联 base64 背景;图片加载时先模糊后清晰,推荐)。
    lqip: true,
    // LQIP 缩略图宽度(px;8-64,越小体积越小)。
    lqipWidth: 24
  },

  // ---------------------------------------------------------------------------
  // 6. 代码块
  // ---------------------------------------------------------------------------
  codeBlock: {
    // 启用代码块整体增强(复制按钮/语言标签)。
    enabled: true,
    // 复制按钮显示方式:hover/always/never。
    copyButtonVisibility: 'hover',
    // 复制成功提示文本。
    copySuccessText: '已复制',
    // 复制成功提示（en 站；空 = 回退中文）。
    copySuccessTextEn: 'Copied',
    // 复制失败提示文本。
    copyFailText: '复制失败',
    // 复制失败提示（en 站；空 = 回退中文）。
    copyFailTextEn: 'Copy failed',
    // 下载触发后释放 Blob URL 的延迟(ms)。100ms 在慢盘/大文件下可能先于浏览器读取完成即被撤销,导致下载中断。
    // 类型: number(ms) | 推荐: 1000
    blobRevokeDelayMs: 1000,
    // 是否显示语言标签。
    showLanguageTag: true,
    // 是否显示 macOS 三圆点窗口栏(代码块顶部装饰栏)。
    windowBar: true,
    // 是否显示行号（Prism line-numbers 插件,本地 vendor;默认开启）。
    lineNumbers: true,
    // 长代码是否自动换行（true=软换行替代横向滚动;换行时行号由 Prism 插件按行高对齐,仍然显示）。
    wrapLongLines: false,
    // 代码块悬停时的背景提亮底色（与 code-bg 混合,混合力度见 tuning.code.hoverBgMix）。
    highlightBackground: 'var(--color-hover)',
    // 代码块圆角。
    borderRadius: '0.375rem',
    // 代码块最大高度(超出滚动)。
    maxHeight: '' /* 例如 '600px' 空=不限制 */,
    // 代码块容器最大高度(CSS 值,如 '60vh' 或 'none'=不限制)。同时作为
    // 长代码折叠的触发阈值(数字部分按行数计,如 '60vh' 视为 60 行)。
    maxHeightVh: 'none',
    // 代码块窗口栏(标题栏)高度(px)。
    headerHeight: '36px',
    // 代码块正文字号(em 相对单位)。
    fontSize: '0.92em',
    // 代码块上方"复制全部代码"按钮（多代码块页面适用;true=首块上方显示按钮,一键复制全页所有代码块）。
    copyAllButton: false,
    // 下载按钮。
    downloadButton: true
  },

  // ---------------------------------------------------------------------------
  // 7. 外部链接安全(白名单/弹窗)
  // ---------------------------------------------------------------------------
  externalLink: {
    // 启用外部链接警告弹窗(与 site.json5 的 externalLinkWarning.enabled 同时为 true 才生效)。
    enabled: true,
    // 白名单域名/IP 主机名(命中则直接放行,不弹窗)
    // 类型: string[] | 可填: "github.com"(整域精确) / "*.github.com"(* 通配子域) / "example.com/path"(* 可出现在路径段)
    // 不可填: 带协议(https://)或完整 URL;空数组 = 回退 site.json5→externalLinkWarning.whitelist
    // 推荐: 仅放行完全信任的站点;黑名单优先级高于白名单,命中黑名单先拦截
    whitelist: [],
    // 黑名单域名(命中即直接拦截提示,不跳转)。
    blacklist: [],
    // 拦截模式:warn=弹窗确认/prohibit=直接禁止跳转/hint=仅提示不拦截。
    mode: 'warn',
    // 弹窗内显示的提示文本。
    message: '即将离开本站,前往外部链接：',
    // 外链弹窗提示文本（en 站；空 = 回退中文）。
    messageEn: 'You are leaving this site. External link:',
    // 确认按钮文本。
    confirmText: '继续访问',
    // 确认按钮文本（en 站；空 = 回退中文）。
    confirmTextEn: 'Continue',
    // 取消按钮文本。
    cancelText: '返回',
    // 取消按钮文本（en 站；空 = 回退中文）。
    cancelTextEn: 'Back',
    // 是否显示完整 URL。
    showFullUrl: true,
    // 是否默认 target=_blank。
    openInNewTab: true,
    // 白名单链接是否也加 target。
    whitelistNewTab: false,
    // 联系/社交弹窗复制按钮文本。
    copyButtonText: '复制',
    // 复制按钮文本（en 站；空 = 回退中文）。
    copyButtonTextEn: 'Copy'
  },

  // ---------------------------------------------------------------------------
  // 8. 明暗主题切换
  // ---------------------------------------------------------------------------
  themeToggle: {
    // 启用明暗切换按钮(需 theme.json5 darkMode.enabled)。
    enabled: true,
    // 默认主题:light/dark/system。
    defaultTheme: 'system',
    // 是否记住用户选择(localStorage)。
    rememberChoice: true,
    // 切换动画时长(ms)。
    animationMs: 250,
    // 按钮图标:auto/sun-moon/toggle。
    iconStyle: 'sun-moon',
    // 切换时过渡所有元素(否则仅 body)。
    transitionAll: true,
    // 主题选择的 localStorage 键名。
    persistKey: 'ss-theme',
    // 切换时是否交替显示太阳/月亮图标。
    toggleIconSwap: true,
    // 切换按钮的 CSS z-index。
    zIndex: 100
  },

  // ---------------------------------------------------------------------------
  // 8b. 主题预设切换器
  // ---------------------------------------------------------------------------
  themePresets: {
    // 启用主题预设切换器(导航栏调色盘按钮,选择后即换色板,localStorage 记忆)。
    enabled: true,
    // 是否显示切换按钮(false 则隐藏按钮但保留已存选择)。
    pickerVisible: true,
    // 是否在 localStorage 记住用户选择。
    persistChoice: true,
    // 是否显示在导航栏(否则仅出现在设置页/其他入口)。
    showInNavbar: true,
    // 色卡悬停是否提示预设名。
    previewOnHover: true
  },

  // 8c. 主题定时切换
  // ---------------------------------------------------------------------------
  themeSchedule: {
    // 启用按时间自动切换明暗(默认关闭,避免无感改用户主题)。
    enabled: false,
    // 启动暗色模式的时刻(24h,HH:MM),如 22:00。
    darkFrom: '22:00',
    // 启动亮色模式的时刻(24h,HH:MM),如 06:00。
    lightFrom: '06:00',
    // 用户手动切换过主题后,当天不再自动覆盖(尊重用户选择)。
    respectManualOverride: true,
    // 到达时刻立即应用(否则延迟到下一次检查)。
    applyInstantly: true,
    // 检查周期(毫秒,默认 60000 = 每分钟)。
    checkIntervalMs: 60000,
    // 自动切换主题时平滑过渡的启用时长(ms,与 CSS .theme-switching 过渡匹配)。
    // 类型: number(ms) | 推荐: 350
    smoothTransitionMs: 350,
    // 定时切换时给 html 加 theme-switching 类,300ms 过渡动画。
    smoothTransition: true
  },

  // ---------------------------------------------------------------------------
  // 9. 键盘快捷键
  // ---------------------------------------------------------------------------
  shortcuts: {
    // 启用全局快捷键。
    enabled: true,
    // 打开搜索(键值格式: 单字符或 KeyboardEvent.key 名;空字符串 = 禁用该键)。
    openSearch: '/',
    // 切换主题。
    toggleTheme: 'd',
    // 上一篇(文章页)。
    prevPost: 'k',
    // 下一篇(文章页)。
    nextPost: 'j',
    // 打开/关闭快捷键帮助。
    help: '?',
    // 关闭弹窗/抽屉(通用)。
    close: 'Escape',
    // 显示帮助提示按钮。
    showHelpHint: true,
    // 帮助面板标题。
    helpTitle: '快捷键一览',
    // 帮助面板标题（en 站；空 = 回退中文）。
    helpTitleEn: 'Keyboard Shortcuts',
    // 帮助面板是否显示。
    showHelpTable: true,
    // 输入框(INPUT/TEXTAREA/SELECT/contenteditable)内按键是否忽略快捷键。
    // true(默认)=忽略;false=输入框内也触发。
    ignoreInInputs: true
  },

  // ---------------------------------------------------------------------------
  // 10. 文章目录(桌面端侧栏)
  // ---------------------------------------------------------------------------
  toc: {
    // 启用目录。
    enabled: true,
    // 目录最小标题层级(2=h2)。
    minLevel: 2,
    // 目录最大标题层级(≤6;小于 minLevel 时目录不可用)。
    maxLevel: 4,
    // 是否折叠子级。
    collapsible: true,
    // 默认展开层级。
    defaultOpenLevel: 2,
    // 高亮当前阅读章节。
    highlightActive: true,
    // 高亮滚动偏移(px)。
    activeOffset: 120,
    // 目录顶部显示阅读进度线(随滚动量增长)。
    progressLine: true,
    // 点击目录项时更新 URL 锚点(history.replaceState)。
    updateUrl: true,
    // 锚点跳转使用平滑滚动。
    smoothScroll: true,
    // 已读过的目录项淡色标记(visited)。
    visitedFade: true,
    // 分组折叠:点击二级目录项的箭头收起其下三级项(适合长文)。
    groupCollapse: true
    // 宽度见 theme.json5 tocWidth 相关
    ,
    // 目录侧栏标题文本(zh 语言)。
    titleText: '目录',
    // 目录侧栏标题文本(en 语言)。
    titleTextEn: 'Contents',
    // 是否显示标题行(整块隐藏,含折叠按钮)。
    showTitle: true,
    // 目录侧栏最大宽度(px)。
    maxWidthPx: 320
  },

  // ---------------------------------------------------------------------------
  // 10b. 阅读工具栏(文章页右下浮动)
  // ---------------------------------------------------------------------------
  readDock: {
    // 启用阅读工具栏(进度环 + 回到目录 + 返回顶部)。
    enabled: true,
    // 显示进度环(随阅读进度增长的圆环)。
    showProgressRing: true,
    // 显示回到目录按钮。
    showTocButton: true,
    // 显示返回顶部按钮。
    showTopButton: true,
    // 向下滚动时隐藏,向上滚动/到底时显示。
    hideOnScrollDown: true,
    // 位置:right(右下)。
    position: 'right'
  },
  // ---------------------------------------------------------------------------
  sidebarDrag: {
    // 启用侧栏 widget 拖拽排序。关闭后侧栏保持配置顺序不可拖。
    enabled: true,
    // 是否将排序结果持久化到 localStorage,刷新后保留。
    persistOrder: true,
    // 存储键,用于保存排序顺序。
    storageKey: 's-sidebarOrder',
    // 移动端是否支持长按拖拽(触屏)。桌面端默认支持 HTML5 drag。
    touchLongPress: true,
    // 桌面端是否仅在悬停时显示拖拽手柄(≡)。
    showHandleOnHover: true,
    // 本地存储解析失败时是否重置为配置默认顺序。
    resetOnLoadFail: true
  },

  // ---------------------------------------------------------------------------
  exportBackup: {
    // 导出备份命令 npm run export 的配置。
    enabled: true,
    // 是否将 media/assets/videos 媒体目录一并打包。
    includeMedia: true,
    // 是否将 13 个配置文件一并打包。
    includeConfig: true,
    // 导出目录(项目根下)。
    outputDir: 'exports',
    // 备份目录名前缀(时间戳自动追加,如 s-ynapse-backup-20260101-120000)。
    fileNamePrefix: 's-ynapse-backup'
  },

  // ---------------------------------------------------------------------------
  mediaAudit: {
    // npm run audit:media 媒体审计配置。
    enabled: true,
    // 报告引用的媒体文件缺失(文章引用但文件不存在)。
    reportMissed: true,
    // 报告未被任何文章引用的媒体文件(孤儿资源)。
    reportUnreferenced: true,
    // 是否报告重复条目(文件名相同大小相同)。
    reportDuplicate: false,
    // 输出方式:console(终端)或 json(导出 media-audit.json)。
    output: 'console'
  },

  // ---------------------------------------------------------------------------
  autoSummary: {
    // 文章未写 summary 时自动生成摘要。
    enabled: true,
    // 摘要最大字符数(中英混排)。
    maxLength: 160,
    // 回退策略:firstParagraph(取正文首段)。
    fallback: 'firstParagraph',
    // 是否剥离 Markdown 语法(链接/强调标记等)。
    stripMarkdown: true,
    // 截断时的省略号。
    ellipsis: '…'
  },

  // ---------------------------------------------------------------------------
  searchEnginePing: {
    // sitemap 生成后向搜索引擎发送 ping 通知。仅生产构建(CI 中 URL 公开)会执行。
    enabled: false,
    // 引擎列表:google/bing。
    engines: ['google'],
    // 是否仅在 production 构建时 ping(本地构建不改)。
    onlyProduction: true,
    // 每个请求超时(ms)。
    timeoutMs: 5000
  },

  // ---------------------------------------------------------------------------
  hreflang: {
    // 输出 hreflang 替代声明(SEO,i18n 界面双语)。
    enabled: true,
    // 是否包含自身语言条目(默认 zh 与 en 均输出)。
    includeSelf: true,
    // 是否同时输出 canonical 链接。
    canonical: true,
    // 是否输出 x-default 替代声明(指向默认语言版本;SEO 推荐开启)。
    xDefault: true
  },

  // ---------------------------------------------------------------------------
  schemaRich: {
    // schema.org 结构化数据完善(Article/Breadcrumb/Blog)。
    enabled: true,
    // 为文章页输出 BreadcrumbList 面包屑。
    breadcrumbs: true,
    // Article schema 增加 dateModified 字段。
    dateModified: true,
    // 首页输出 Blog 类型 schema。
    blogHomepage: true,
    // Article schema 增加作者主页 URL。
    authorUrl: true,
    // Article schema 增加正文字数(wordCount)。
    wordCount: true,
    // Article schema 增加预计阅读时长(timeRequired,PT{n}M)。
    timeRequired: true,
    // Article schema 增加关键词(keywords,来自标签)。
    keywords: true,
    // Article schema 增加所属栏目(articleSection,取首个分类)。
    articleSection: true,
    // Article schema 增加封面图(image,指向生成的 OG 图)。
    image: true
  },

  // ---------------------------------------------------------------------------
  ogImage: {
    // 构建时根据封面/文章标题生成 1200x630 OG 图。
    enabled: true,
    // 生成宽度(px;社交平台推荐 1200)。
    width: 1200,
    // 生成高度(px;社交平台推荐 630,宽高比 1.91:1)。
    height: 630,
    // 输出格式：png(默认,无损、边缘锐利、体积较大) / jpeg(有损,体积约为 png 的 1/3–1/2,适合流量敏感场景)。
    // 类型: string | 可填: 'png' | 'jpeg'('jpg' 视为同义,大小写不敏感) | 推荐: png
    // 注意: 切换格式后旧格式文件在下次构建时自动清理;社交平台可能缓存旧图(重新抓取由平台策略决定)
    format: 'png',
    // jpeg 输出质量(仅在 format='jpeg' 时生效)。
    // 类型: number | 可填: 1–100(越界/非数字回退 82) | 推荐: 82(文字与渐变画质/体积平衡点)
    jpegQuality: 82,
    // 优先复用文章封面图/首图为基准。
    useCover: true,
    // 无封面时用站点色渐变+标题文字合成。
    gradientForNoCover: true,
    // 标题文字相对画布缩放(生成 OG 图时)
    // 类型: number(>0) | 可填: 0.5–1.2 | 推荐: 0.75
    // 计算方式: 最终字号 = ogImageStyle.fontSizeBase × fontScale;非法值回退 1;超长标题仍按 maxLines 自动压缩
    fontScale: 0.75
  },

  // ---------------------------------------------------------------------------
  hotSearches: {
    // 本地记录搜索词,搜索框下拉显示（当前生效键仅 enabled 与 storageKey：
    // 下拉实际展示「最近搜索」，由 renderHistory 渲染；
    // top/showInDropdown/showClear 为预留键，暂无消费方——热门词列表 UI 尚未实现，
    // 文档同步标注见 docs/config-reference.md §3.4「未接线预留键」）
    enabled: true,
    // 显示条数。
    top: 5,
    // localStorage 存储键。
    storageKey: 's-hotSearches',
    // 是否在搜索下拉中展示。
    showInDropdown: true,
    // 是否提供清空按钮。
    showClear: true
  },

  // ---------------------------------------------------------------------------
  readingTime: {
    // 文章元信息显示预估阅读时长。
    enabled: true,
    // 中文每分钟字数参考。
    wordsPerMinuteCJK: 250,
    // 英文每分钟词数参考。
    wordsPerMinuteLatin: 200,
    // 是否在文章元信息栏显示。
    showInMeta: true,
    // 数值前缀文案(显示在数字前)。
    labelBefore: '',
    // 数值后缀文案(显示在数字后,如"阅读约需")。
    labelAfter: '阅读约需',
    // 阅读时长后缀文案（en 站；空 = 回退中文）。
    labelAfterEn: ' min read'
  },

  // ---------------------------------------------------------------------------
  codeCopy: {
    // 代码块复制按钮。
    enabled: true,
    // 按钮文案。
    buttonText: '复制',
    // 复制按钮文案（en 站；空 = 回退中文）。
    buttonTextEn: 'Copy',
    // 复制成功提示文案。
    copiedText: '已复制',
    // 复制成功提示文案（en 站；空 = 回退中文）。
    copiedTextEn: 'Copied',
    // 复制成功后按钮恢复时间(ms)。
    buttonTimeout: 1500,
    // 是否显示行号。
    showLineNumbers: false,
    // 是否复用代码窗栏(主题切换器按钮共用)。
    includeWindowBar: true
  },

  // ---------------------------------------------------------------------------
  tocScrollSpy: {
    // TOC 滚动高亮当前章节(scrollspy)。
    enabled: true,
    // 激活章节的 CSS 类名。
    activeClass: 'current',
    // 监听偏移(px)。
    offset: 80,
    // 滚动处理节流(ms)。
    throttleMs: 60
  },

  // ---------------------------------------------------------------------------
  searchHighlight: {
    // 搜索结果关键词高亮。
    enabled: true,
    // 高亮 span 类名。
    markClass: 'search-hit',
    // 每篇结果最大高亮次数(防止长文爆量)。
    maxMatches: 20
  },

  // ---------------------------------------------------------------------------
  darkImageFilter: {
    // 深色模式下图片减亮滤镜。
    enabled: true,
    // 滤镜表达式。
    filter: 'brightness(0.85) saturate(0.9)',
    // 是否作用于 img。
    applyImages: true,
    // 是否作用于 video 封面。
    applyVideos: true
  },

  // ---------------------------------------------------------------------------
  listCover: {
    // 列表页文章卡片显示封面图。
    enabled: true,
    // 首页生效。
    showOnHome: true,
    // 归档页生效。
    showOnArchive: true,
    // 无封面时回退:none(纯文字卡片)。
    fallback: 'none',
    // 封面图宽高比。
    aspectRatio: '21/9',
    // 封面懒加载。
    lazy: true
  },

  // ---------------------------------------------------------------------------
  imageFallback: {
    // 图片加载失败时的回退处理。
    enabled: true,
    // 自定义回退图路径(空则用内联 SVG 占位)。
    fallbackImage: '',
    // 回退时是否显示 alt 文本。
    showAlt: true
  },

  // ---------------------------------------------------------------------------
  mobileBottomNav: {
    // 移动端底部导航栏(仅小屏显示)。桌面不受影响。
    enabled: true,
    // 按钮顺序:home/archive/search/theme（可加 top）。
    items: ['home', 'archive', 'search', 'theme'],
    // 是否仅移动端显示。
    onlyMobile: true,
    // 是否适配 iOS 安全区(safe-area-inset-bottom)。
    useSafeArea: true,
    // 以下标签为空 = 走 ui-strings.json5 的 bottomNav.* 双语词典（推荐保持空）。
    // 标签覆盖:首页。
    labelHome: '',
    // 标签覆盖:归档。
    labelArchive: '',
    // 标签覆盖:搜索。
    labelSearch: '',
    // 标签覆盖:主题。
    labelTheme: '',
    // 标签覆盖:顶部。
    labelTop: ''
  },

  // ---------------------------------------------------------------------------
  incrementalBuild: {
    // 增量构建:源文件未变化时跳过页面重渲染。
    enabled: true,
    // 强制全量构建的参数。
    fullFlag: '--full',
    // 是否允许 --watch 时增量。
    watch: true,
    // 指纹算法。
    fingerprintHash: 'sha1',
    // 指纹一致时跳过该页。
    skipUnchanged: true
  },

  // ---------------------------------------------------------------------------
  customCSS: {
    // 注入自定义 CSS,无需修改模板即可定制外观。
    enabled: true,
    // CSS 片段数组,每段为一个字符串(允许注释),构建时合并到 </body> 前 <style>。
    // 示例: '.site-header{letter-spacing:0.01em}'  —— 移除此行即不注入任何内容。
    css: ['blockquote{border-left-color: var(--color-accent)}'],
    // 注入位置:before-closing-body。
    target: 'before-closing-body'
  },

  // ---------------------------------------------------------------------------
  // 11. 移动端目录抽屉
  // ---------------------------------------------------------------------------
  mobileToc: {
    // 启用移动端目录抽屉按钮。
    enabled: true,
    // 抽屉圆角。
    borderRadius: '1rem',
    // 抽屉最大高度(视口百分比)。
    maxHeightVh: '70',
    // 点击链接后是否自动关闭抽屉。
    autoClose: true,
    // 点击遮罩是否关闭。
    overlayClose: true,
    // 抽屉打开时锁定背景滚动。
    lockScroll: true,
    // 按钮位置:bottom-right/bottom-left。
    position: 'right',
    // 胶囊按钮显示当前章节名与阅读进度百分比。
    showCurrent: true
  },

  // ---------------------------------------------------------------------------
  // 12.5 阅读模式(文章页专注模式)
  // ---------------------------------------------------------------------------
  readMode: {
    // 启用阅读模式按钮。
    enabled: true,
    // 是否记住上次状态(localStorage)。
    persist: true,
    // 按钮文本。
    label: '阅读模式',
    // 按钮文本（en 站；空 = 回退中文）。
    labelEn: 'Reading Mode',
    // 进入阅读模式后隐藏侧栏/目录(仅保留正文)。
    focusOnlyContent: true,
    // 字号倍率(1=正常)。
    fontScale: 1
  },

  // ---------------------------------------------------------------------------
  // 12. 阅读设置面板(字号/行高/宽度)
  // ---------------------------------------------------------------------------
  // 阅读设置面板:字号/行高/内容宽度三组范围的步进与默认值。
  readingPanel: {
    // 启用阅读设置齿轮。
    enabled: true,
    // 字号下限(px)。
    fontSizeMin: 15,
    // 字号上限(px)。
    fontSizeMax: 26,
    // 字号步进(px)。
    fontSizeStep: 1,
    // 默认字号(px,须在 min–max 内)。
    fontSizeDefault: 19,
    // 行高下限(倍)。
    lineHeightMin: 1.4,
    // 行高上限(倍)。
    lineHeightMax: 2.6,
    // 行高步进(倍)。
    lineHeightStep: 0.1,
    // 默认行高(倍,须在 min–max 内)。
    lineHeightDefault: 1.9,
    // 内容宽度下限(px)。
    widthMin: 560,
    // 内容宽度上限(px)。
    widthMax: 1200,
    // 内容宽度步进(px)。
    widthStep: 40,
    // 默认内容宽度(px,须在 min–max 内)。
    widthDefault: 800,
    // 是否记住阅读设置。
    remember: true,
    // 阅读设置持久化键(字号/行高/宽度的 localStorage 键名)。
    persistKey: 'ss-reading',
    // 是否显示"重置"按钮(点击恢复默认值并清除本地存储)。
    showReset: true,
    // 重置按钮文本。
    resetText: '重置',
    // 重置按钮文本（en 站；空 = 回退中文）。
    resetTextEn: 'Reset',
    // 面板开关按钮位置:bottom-right/bottom-left。
    position: 'right'
  },

  // ---------------------------------------------------------------------------
  // 13. 语音朗读(TTS)
  // ---------------------------------------------------------------------------
  tts: {
    // 启用朗读按钮(文章页)。
    enabled: true,
    // 朗读语速(0.1~10,1=正常)。
    rate: 0.5,
    // 音调。
    pitch: 1,
    // 音量。
    volume: 1,
    // 是否使用系统首选语音。
    preferDefaultVoice: true,
    // 语音选择依据:auto/lang。
    voiceBy: 'lang',
    // 朗读区域选择器。
    readSelector: '.post-content',
    // 按钮图标:speaker/book。
    icon: 'speaker',
    // 是否高亮正在朗读段落(实验性)。
    highlightParagraph: false,
    // 朗读时逐句高亮当前句子(需浏览器支持 utterance boundary 事件)。
    highlightReading: true,
    // 高亮句子的 CSS 类名(可在 customCSS 中自定义样式)。
    highlightClass: 'tts-highlight',
    // 朗读文本提取时跳过的选择器(逗号分隔,默认跳过代码块/公式/图表)。
    skipSelectors: 'pre, .katex, .mermaid',
    // 阅读按钮位置:toolbar/float。
    position: 'toolbar'
  },

  // ---------------------------------------------------------------------------
  // 14. 双向链接(Wiki Links)
  // ---------------------------------------------------------------------------
  wikiLinks: {
    // 启用双链解析。
    enabled: true,
    // 未知目标显示方式:text(纯文本)/link(死链可点)/hide(隐藏)。
    unknownMode: 'text',
    // 未知目标附加后缀文本(例如 ⚠)。
    unknownSuffix: '',
    // 站内链接是否新页打开。
    openNewTab: false,
    // 是否忽略大小写匹配标题。
    caseInsensitive: true,
    // 自定义文本优先级:使用标签可覆盖。
    allowCustomLabel: true
  },

  // ---------------------------------------------------------------------------
  // 15. 上下标语法(^x^ / ~x~)
  // ---------------------------------------------------------------------------
  supSub: {
    // 启用 ^x^ 与 ~x~ 语法。
    enabled: true,
    // 上标字符标记。
    supMarker: '^',
    // 下标字符标记。
    subMarker: '~',
    // 冲突检测:在 $...$ 公式内自动跳过(需开启)。
    skipInsideMath: false,
    // 包裹不匹配时是否保留原样。
    preserveUnmatched: true
  },

  // ---------------------------------------------------------------------------
  // 16. 数学公式(KaTeX,按需 CDN)
  // ---------------------------------------------------------------------------
  math: {
    // 启用数学公式渲染(KaTeX,按需加载)。
    enabled: true,
    // 自动检测 $..$ / $$..$$ 公式并按需加载 KaTeX。
    autoDetect: true,
    // CDN 版本。
    version: '0.16.22',
    // 行内定界符。
    inlineDelimiters: ['$'],
    // 块级定界符。
    blockDelimiters: ['$$'],
    // 渲染错误时不抛出。
    throwOnError: false,
    // KaTeX strict 模式(false 静默 / warn / error)。
    strict: false,
    // 是否渲染 \\( \\) 定界符(mathGuard 保护,默认开)。
    renderRoundParens: true,
    // 是否渲染 \[ \] 定界符(mathGuard 保护,默认开)。
    renderSquareBrackets: true,
    // 公式区域选择器。
    selector: '.post-content',
    // 是否包含浏览器原生 MathML 输出。
    mathml: true
  },

  // ---------------------------------------------------------------------------
  // 17. Mermaid 图表(按需 CDN)
  // ---------------------------------------------------------------------------
  mermaid: {
    // 启用 Mermaid 图表渲染。
    enabled: true,
    // 自动检测 ```mermaid 代码块并按需加载 Mermaid。
    autoDetect: true,
    // CDN 版本。
    version: '11.4.1',
    // 渲染主题:default/dark/neutral/base 或跟随站点主题。
    followTheme: true,
    // 明色主题名。
    lightTheme: 'default',
    // 暗色主题名。
    darkTheme: 'dark',
    // 安全级别:strict/loose。
    securityLevel: 'strict',
    // 是否显示流程图内文本的复制按钮。
    copyAfterRender: false,
    // 渲染失败占位文本。
    errorText: '[图表渲染失败]',
    // 渲染失败占位文本（en 站；空 = 回退中文）。
    errorTextEn: '[Diagram failed to render]',
    // 图表尺寸(全局默认;单图可在代码块 info 覆盖,写法 ```mermaid w=900 h=520)
    // 子键类型均为 string(CSS 长度)或 'none':
    size: {
      // 固定宽度;空 = 自适应(推荐)
      width: '',
      // 固定高度;空 = 自适应(推荐)
      height: '',
      // 最小宽度(防止窄图塌陷) | 推荐: '320px'
      minWidth: '320px',
      // 最大宽度 | 可填: 'none'(不限制,推荐)/CSS 长度
      maxWidth: 'none',
      // 最小高度 | 推荐: '200px'
      minHeight: '200px',
      // 最大高度 | 可填: 'none'(推荐)/CSS 长度
      maxHeight: 'none',
      // 溢出策略 | 可填: 'scroll'(超高滚动,推荐)/'scale'(等比缩到容器)
      fit: 'scroll'
    }
  },

  // ---------------------------------------------------------------------------
  // 18. 系列文章
  // ---------------------------------------------------------------------------
  series: {
    // 启用系列功能。
    enabled: true,
    // 文章卡片显示系列徽标。
    showBadge: true,
    // 徽标文本模板:{name} 系列名。
    badgeFormat: '系列 · {name}',
    // 徽标文本模板（en 站；空 = 回退中文）。
    badgeFormatEn: 'Series · {name}',
    // 文章底部显示系列导航面板。
    showNavPanel: true,
    // 侧栏系列 widget(与 sidebar.json5 widgets 联动)。
    sidebarWidget: true,
    // 系列排序:asc(时间旧→新)/desc。
    order: 'asc',
    // 导航面板标题模板。
    panelTitle: '本系列共 {total} 篇',
    // 导航面板标题模板（en 站；空 = 回退中文）。
    panelTitleEn: '{total} posts in this series',
    // 系列文章前缀(自动标注,如 '第 1/3 篇')。
    showPosition: true,
    // 侧栏系列 widget 默认展示条数(超出截断)。
    // 类型: number(整数) | 可填: 1–20 | 推荐: 8
    defaultWidgetCount: 8,
    // 系列导航上一页按钮文本。
    prevLabel: '上一篇',
    // 上一页按钮文本（en 站；空 = 回退中文）。
    prevLabelEn: 'Previous',
    // 系列导航下一页按钮文本。
    nextLabel: '下一篇',
    // 下一页按钮文本（en 站；空 = 回退中文）。
    nextLabelEn: 'Next',
    // 进度文本模板:{index} 当前篇数,{total} 总篇数。
    progressLabel: '{index} / {total}',
    // 侧栏系列 widget 标题(sidebar.json5 中 w.title 为空时使用)。
    sidebarTitle: '系列',
    // 侧栏系列 widget 标题（en 站；空 = 回退中文）。
    sidebarTitleEn: 'Series'
  },

  // ---------------------------------------------------------------------------
  // 19. 关联推荐
  // ---------------------------------------------------------------------------
  related: {
    // 启用关联推荐区块。
    enabled: true,
    // 推荐数。
    topN: 4,
    // 同分类权重。
    sameCategoryWeight: 2,
    // 同标签权重。
    sameTagWeight: 3,
    // 最小得分(低于此不重复展示)。
    minScore: 2,
    // 是否排除当前文章。
    excludeCurrent: true,
    // 推荐区标题。
    title: '相关推荐',
    // 推荐区标题（en 站；空 = 回退中文）。
    titleEn: 'Related Posts',
    // 相关文章卡片是否显示摘要。
    showExcerpt: true,
    // 摘要截断长度(字符)。
    excerptLength: 80,
    // 卡片是否显示共享标签数徽章。
    showCount: false
  },

  // ---------------------------------------------------------------------------
  // 20. 置顶文章
  // ---------------------------------------------------------------------------
  pinned: {
    // 启用置顶。
    enabled: true,
    // 置顶徽标文本。
    badgeText: '置顶',
    // 置顶徽标文本（en 站；空 = 回退中文）。
    badgeTextEn: 'Pinned',
    // 置顶徽标样式:pill/corner/none。
    badgeStyle: 'pill',
    // 置顶排序规则:pinned-first(置顶前)/normal(仅标记不重排)。
    sortRule: 'pinned-first'
  },

  // ---------------------------------------------------------------------------
  // 21. 字数统计与阅读时间
  // ---------------------------------------------------------------------------
  wordCount: {
    // 启用字数统计。
    enabled: true,
    // 卡片显示字数。
    onCards: true,
    // 文章正文尾部显示字数。
    inArticle: true,
    // 文本模板:{count} 字数。
    textFormat: '{count} 字',
    // 字数模板（en 站；空 = 回退中文）。
    textFormatEn: '{count} words',
    // 阅读时长文本:{minutes} 分钟。
    readTimeFormat: '{minutes} 分钟阅读',
    // 阅读时长模板（en 站；空 = 回退中文）。
    readTimeFormatEn: '{minutes} min read',
    // 每分钟阅读字数(中文字数计算基准)。
    wpm: 265,
    // 中文英文字数合并统计视读方式。
    countCjkChars: true,
    // 是否统计数字。
    countDigits: false
  },

  // ---------------------------------------------------------------------------
  // 22. 分享按钮
  // ---------------------------------------------------------------------------
  share: {
    // 启用分享工具条。
    enabled: true,
    // 平台顺序:weibo/qq/wechat/x/facebook/mail/copy,缺省全部:
    order: ['weibo', 'qq', 'wechat', 'x', 'facebook', 'mail', 'copy'],
    // 坐标位置:toolbar(文章尾部)/floating(悬浮)。
    position: 'toolbar',
    // 弹窗宽度(px)。
    popupWidth: 640,
    // 弹窗高度(px)。
    popupHeight: 520,
    // 微信复制文案模板:{title}/{url}。
    wechatText: '{title} 分享自 {url}',
    // 微信复制文案模板（en 站；空 = 回退中文）。
    wechatTextEn: '{title} via {url}',
    // 复制成功提示文本。
    copiedText: '链接已复制',
    // 复制成功提示（en 站；空 = 回退中文）。
    copiedTextEn: 'Link copied',
    // 提示显示时长(ms)。
    copiedShowMs: 2500,
    // 是否显示分享标题。
    showLabel: false,
    // 工具条标题。
    label: '分享文章',
    // 工具条标题（en 站；空 = 回退中文）。
    labelEn: 'Share this post',
    // 浏览器支持 navigator.share 时优先使用系统原生分享面板。
    useNativeShare: false,
    // 剪贴板 API 不可用时用 textarea 回退复制。
    copyFallback: true
  },

  // ---------------------------------------------------------------------------
  // 23. 打赏
  // ---------------------------------------------------------------------------
  reward: {
    // 启用打赏(同时需 site.json5 reward.enabled,以本开关为准)。
    enabled: false,
    // 打赏按钮文本。
    buttonText: '打赏',
    // 打赏按钮文本（en 站；空 = 回退中文）。
    buttonTextEn: 'Reward',
    // 打赏提示文本(图片下方)。
    note: '感谢支持',
    // 打赏提示文本（en 站；空 = 回退中文）。
    noteEn: 'Thank you for your support',
    // 弹窗标题。
    popupTitle: '打赏支持',
    // 弹窗标题（en 站；空 = 回退中文）。
    popupTitleEn: 'Support this site',
    // 弹窗关闭方式:按钮。
    closeByBtn: true,
    // 弹窗关闭方式:点击遮罩。
    closeByOverlay: true,
    // 弹窗关闭方式:Esc 键。
    closeByEsc: true,
    // 二维码尺寸(px)。
    qrSize: '180px',
    // 弹窗最大宽度。
    maxWidth: '560px',
    // 是否显示打赏说明文字(图片下方 note)。
    showNote: true,
    // 二维码图片最大宽度 CSS。
    qrMaxWidth: '180px',
    // 弹窗关闭按钮文本。
    closeText: '关闭',
    // 关闭按钮文本（en 站；空 = 回退中文）。
    closeTextEn: 'Close',
    // 赞助平台链接(显示于打赏弹窗底部;如 GitHub Sponsors / Ko-fi / 爱发电)。
    // 每项格式: { label: '显示名', url: 'https://...' }; label 可省略(用 url 代替)。
    links: []
  },

  // ---------------------------------------------------------------------------
  // 24. 图库页
  // ---------------------------------------------------------------------------
  gallery: {
    // 启用 /gallery/ 图库页。
    enabled: true,
    // 页面标题。
    title: '图库',
    // 页面标题（en 站；空 = 回退中文）。
    titleEn: 'Gallery',
    // 描述文本。
    description: '站内图片集，点击查看大图。',
    // 描述文本（en 站；空 = 回退中文）。
    descriptionEn: 'In-site image gallery. Click to view full size.',
    // 空图库提示。
    emptyText: '暂无图片',
    // 空图库提示（en 站；空 = 回退中文）。
    emptyTextEn: 'No images',
    // 瀑布流列数。
    columns: 4,
    // 列最小宽度(minmax 下界)。
    columnMin: '220px',
    // 卡片是否显示来源文章名。
    showSource: true,
    // 是否收集文章封面图。
    collectFeatured: true,
    // 收集排序:newest/longest。
    order: 'newest',
    // 是否包含 404 前后的图(增量,始终 true)。
    incrementalByDefault: true,
    // 单页图片数上限(0=不限)。
    maxItems: 0,
    // 瀑布流列间距 CSS(column-gap)。
    gap: '12px',
    // 图片下方是否显示来源说明。
    showCaption: true,
    // 卡片圆角 CSS。
    borderRadius: '8px'
  },

  // ---------------------------------------------------------------------------
  // 24b. OG 封面图生成样式
  // ---------------------------------------------------------------------------
  ogImageStyle: {
    // 启用自动 OG 封面图(文章无 featuredImage 时生成)。
    enabled: true,
    // 封面模板: aurora(渐变极光)/mesh(光斑星云)/grid(科技栅格)/paper(纸感浅底)/duotone(双色对角)。
    template: 'aurora',
    // 配色来源: theme(站点主/辅色)/hash(按文章首个分类哈希出色,同分类同色)。
    palette: 'theme',
    // 是否在封面显示分类角标(取文章 categories 第一项)。
    showCategory: true,
    // 标题对齐:center(居中排版)/left(左侧排版)。
    align: 'center',
    // 是否在封面底部显示站点名。
    showSite: true,
    // 是否在封面右下角显示站点 URL（false = 不显示，保持画面简洁）
    // 类型: boolean | 可填: true/false | 推荐: 长域名站点可设 false
    showUrl: true,
    // 是否使用彩色渐变背景(否则纯色)。
    useGradient: true,
    // 渐变角度(deg 字符串,CSS 语法)。
    gradientAngle: '135deg',
    // 基础字号(px,超大字号,标题换行后按比例压缩)。
    fontSizeBase: 64,
    // 标题最多行数,超过自动压缩字号,再超则省略号截断。
    maxLines: 4,
    // 标题字距。
    letterSpacing: '0.02em'
  },

  // ---------------------------------------------------------------------------
  // 25. 归档热力图
  // ---------------------------------------------------------------------------
  heatmap: {
    // 启用归档页年历热力图。
    enabled: true,
    // 热力层级数(2~7)。
    levels: 5,
    // 层数配色模式:auto(按最大月文章数分级)/fixed(自定义色表)。
    scaling: 'auto',
    // 自定义色表(从低到高,仅 scaling=fixed 有效,可为 CSS 颜色数组)。
    palette: [],
    // 是否显示图例(少→多)。
    showLegend: true,
    // 图例低值文字。
    legendLow: '少',
    // 图例低值文字（en 站；空 = 回退中文）。
    legendLowEn: 'Less',
    // 图例高值文字。
    legendHigh: '多',
    // 图例高值文字（en 站；空 = 回退中文）。
    legendHighEn: 'More',
    // 悬停提示模板:{year}-{month}: {count} 篇。
    tooltipFormat: '{year}-{month}: {count} 篇',
    // 悬停提示模板（en 站；空 = 回退中文）。
    tooltipFormatEn: '{year}-{month}: {count} posts',
    // 是否显示每月数字。
    showMonthNumbers: true,
    // 单元格间距(px,热力图 12 列之间的 gap)。
    gap: '3px',
    // 单元格圆角(px)。
    borderRadius: '3px',
    // 单元格尺寸(px,固定后热力图按此尺寸紧凑排列;置空则撑满容器)。
    cellSize: '13px',
    // 空月份(无文章)单元格颜色。
    emptyColor: 'var(--color-border)'
  },

  // ---------------------------------------------------------------------------
  // 26. 站点统计
  // ---------------------------------------------------------------------------
  stats: {
    // 启用站点统计。
    enabled: true,
    // 归档页显示统计卡片。
    showArchiveCards: true,
    // 统计标签文案(顺序:文章/天数/字数/日均/标签/分类)。
    labelPosts: '文章总数',
    // 文章总数标签（en 站；空 = 回退中文）。
    labelPostsEn: 'Posts',
    // 发文天数标签。
    labelDays: '发文天数',
    // 发文天数标签（en 站；空 = 回退中文）。
    labelDaysEn: 'Days',
    // 总字数标签。
    labelWords: '总字数',
    // 总字数标签（en 站；空 = 回退中文）。
    labelWordsEn: 'Words',
    // 日均篇数标签。
    labelAvg: '日均篇数',
    // 日均篇数标签（en 站；空 = 回退中文）。
    labelAvgEn: 'Avg/Day',
    // 归档页日均标签(archive 统计卡专用)。
    labelAvgPerDay: '日均',
    // 归档页日均标签（en 站；空 = 回退中文）。
    labelAvgPerDayEn: 'Avg/Day',
    // 标签数标签。
    labelTags: '标签数',
    // 标签数标签（en 站；空 = 回退中文）。
    labelTagsEn: 'Tags',
    // 分类数标签。
    labelCategories: '分类数',
    // 分类数标签（en 站；空 = 回退中文）。
    labelCategoriesEn: 'Categories',
    // 统计卡网格列模式(auto-fit 自适应列数;也可填固定列数如 3)。
    cardColumns: 'auto-fit',
    // 侧栏统计 widget 总开关(sidebar.json5 需含 type=stats 的 widget)。
    showSidebar: true,
    // 卡片点击跳转(空=不跳)。
    linkArchive: '/archive/'
  },

  // ---------------------------------------------------------------------------
  // 27. 上一篇/下一篇导航
  // ---------------------------------------------------------------------------
  prevNext: {
    // 启用文章页上下篇导航。
    enabled: true,
    // 显示标签。
    showLabels: true,
    // 标签模板:
    prevLabel: '上一篇',
    // 上一页标签文本（en 站；空 = 回退中文）。
    prevLabelEn: 'Previous',
    // 下一页标签文本(同上,配套使用)。
    nextLabel: '下一篇',
    // 下一页标签文本（en 站；空 = 回退中文）。
    nextLabelEn: 'Next',
    // 无邻篇时是否隐藏整块。
    hideWhenMissing: false,
    // 导航卡是否显示缩略图(需文章 featuredImage)。
    showThumbnail: false,
    // 标签文字位置:left/center/right。
    labelPosition: 'left',
    // 点击导航后是否滚回页面顶部。
    scrollToTopOnClick: true
  },

  // ---------------------------------------------------------------------------
  // 28. 订阅(RSS + JSON Feed) — 预留区
  // 说明: 当前构建完全以 site.json5 的 rss 段与 features.json5 的 subscribe 段为准；
  //       本段各键尚未接线(未消费)，仅作为未来统一入口预留。请勿在此修改生效行为。
  // ---------------------------------------------------------------------------
  feed: {
    // 预留: RSS 总开关。当前以 site.json5 rss.enabled 为准，本键暂未被消费。
    rssEnabled: true,
    // 预留: RSS 输出路径。当前以 site.json5 rss.path 为准，本键暂未被消费。
    rssPath: '/feed.xml',
    // 预留: RSS 是否输出全文。当前以 site.json5 rss.fullContent 为准，本键暂未被消费。
    rssFullContent: true,
    // 预留: RSS 条目上限。当前以 site.json5 rss.maxItems 为准，本键暂未被消费。
    rssMaxItems: 50,
    // 预留: JSON Feed 输出路径。当前以 site.json5 rss.jsonFeed.path 为准，本键暂未被消费。
    jsonFeedPath: '/feed.json',
    // 预留: JSON Feed 是否输出全文。当前以 site.json5 rss.jsonFeed.fullContent 为准，本键暂未被消费。
    jsonFeedFullContent: false,
    // 预留: JSON Feed 条目上限。当前以 site.json5 rss.jsonFeed.maxItems 为准，本键暂未被消费。
    jsonFeedMaxItems: 20,
    // 预留: <head> 订阅链接开关。当前 head 链接恒随 site.rss 配置输出，本键暂未被消费。
    injectHeadLinks: true,
    // 预留: 页脚订阅链接开关。当前由 features.subscribe / footer.json5 控制，本键暂未被消费。
    injectFooterLink: false
  },

  // ---------------------------------------------------------------------------
  // 29. 云统计(Cloudflare Web Analytics)
  // ---------------------------------------------------------------------------
  analytics: {
    // 启用 CF Web Analytics(需设置 token 或环境变量 CF_WEB_ANALYTICS_TOKEN)。
    enabled: true,
    // 脚本 CDN 地址。
    scriptSrc: 'https://static.cloudflareinsights.com/beacon.min.js',
    // 输出位置
    // 类型: string(枚举) | 可填: 'body'(</body> 前,推荐)/'head'
    // 不可填: 'end-of-body' 等描述性写法(构建校验会拒绝)
    injectAt: 'body',
    // 是否输出 data-cf-beacon JSON。
    emitBeacon: true,
    // 站点标签(可选显示)。
    siteTag: ''
  },

  // ---------------------------------------------------------------------------
  // 30. 重定向
  // ---------------------------------------------------------------------------
  redirects: {
    // 启用重定向系统(规则来自 site.json5 redirects 数组)。
    enabled: false,
    // 生成 CF Pages _redirects 文件。
    generatePagesFile: true,
    // 本地 serve 是否应用重定向。
    applyInServe: true,
    // 非法规则处理:warn-only/abort。
    invalidRule: 'abort'
  },

  // ---------------------------------------------------------------------------
  // 31. 维护模式
  // ---------------------------------------------------------------------------
  maintenance: {
    // 本地 serve 参数 --maintenance 生效;生产由 Worker 环境变量 MAINTENANCE=1。
    enabled: false,
    // 维护提示消息。
    message: '站点维护中，请稍后再来。',
    // 维护提示消息（en 站；空 = 回退中文）。
    messageEn: 'The site is under maintenance. Please try again later.',
    // 返回的 HTTP 状态码
    // 类型: number(枚举) | 可填: 503(维护标准,推荐)/502/500
    // 不可填: 200/301 等成功或跳转状态
    status: 503,
    // 是否设置 Retry-After。
    setRetryAfter: true,
    // Retry-After 秒数。
    retryAfter: 3600
  },

  // ---------------------------------------------------------------------------
  // 32. 移动端优化
  // ---------------------------------------------------------------------------
  mobile: {
    // 启用移动端交互优化(抽屉关闭等)。
    enabled: true,
    // 移动端搜索是否改为全屏。
    searchFullscreen: true,
    // 移动端目录按钮与返回顶部间距(px)。
    buttonStackGap: '4rem',
    // 触摸屏悬停菜单自动展开。
    touchFallback: true,
    // 移动端代码块横向滚动提示。
    codeScrollHint: true,
    // 移动端 TOC 按钮断点(px,≤ 该宽度显示按钮)。
    tocBreakpoint: 900,
    // 底部导航底部安全区留白(适配 iPhone 底部横条)。
    safeAreaBottom: true,
    // 是否保留移动端点击高亮(false = 取消高亮)。
    tapHighlight: false
  },

  // ---------------------------------------------------------------------------
  // 33. 评论(前端渲染行为)
  // ---------------------------------------------------------------------------
  comments: {
    // 启用评论负载(建议同时配置 site.json5 comments)。
    enabled: true,
    // 是否在文章页加载评论容器。
    loadContainer: true,
    // 服务器端渲染占位(若 provider 为静态)。
    renderPlaceholder: true,
    // 占位加载文本。
    placeholderText: '评论加载中…',
    // 占位加载文本（en 站；空 = 回退中文）。
    placeholderTextEn: 'Loading comments…',
    // 占位显示时长(ms,过后若无评论组件则显示 emptyText)。
    loadDelayMs: 300,
    // 无评论提示(延迟结束后仍未加载出组件时显示)。
    emptyText: '暂无评论',
    // 无评论提示（en 站；空 = 回退中文）。
    emptyTextEn: 'No comments yet',
    // 评论容器标题。
    title: '评论',
    // 评论容器标题（en 站；空 = 回退中文）。
    titleEn: 'Comments'
  },

  // ---------------------------------------------------------------------------
  // 34. 联系方式弹窗
  // ---------------------------------------------------------------------------
  contactPopup: {
    // 启用社交联系方式弹窗(点击社交图标复制)。
    enabled: true,
    // 弹窗标题。
    title: '联系方式',
    // 弹窗标题（en 站；空 = 回退中文）。
    titleEn: 'Contact',
    // 复制按钮文本。
    copyText: '复制',
    // 复制按钮文本（en 站；空 = 回退中文）。
    copyTextEn: 'Copy',
    // 复制成功提示(留空则用内置双语文案 toolbar.copyDoneToast)。
    copySuccessText: '',
    // 复制成功提示英文（en 站；空 = 回退内置双语 toast）。
    copySuccessTextEn: '',
    // 弹窗宽度(px)。
    popupWidth: '360px',
    // 显示社交项(CG 配置社交链接中带弹窗样式)。
    showAllItems: true,
    // 弹窗顶部是否显示图标。
    showIcon: true,
    // 弹窗内最多显示的联系方式条目数(多行值按行截断)。
    maxItems: 4
  },

  // ---------------------------------------------------------------------------
  // 35. 外链警告(白名单已黑名单复合)
  // ---------------------------------------------------------------------------
  // 注: externalLink 已覆盖,以下为扩展行为
  linkBehavior: {
    // 域名白名单自动识别(匹配 hostname 或 hostname+path)。
    matchMode: 'hostname',
    // 忽略站内相对链接。
    skipInternal: true,
    // 邮箱块 mailto 处理:leave/confirm。
    mailtoMode: 'leave',
    // 二维码批量匹配(未来)。
    lateTargeted: false
  },

  // ---------------------------------------------------------------------------
  // 36. 性能预算
  // ---------------------------------------------------------------------------
  performance: {
    // 首页 JS 体量上限警告(kB)。
    warningJsKb: 80,
    // 首页 HTML 体量上限警告(kB)。
    warningHtmlKb: 400,
    // 图片未压缩告警阈值(kB)。
    warningImageKb: 300,
    // 构建耗时阈值(ms)超时给出提示。
    warningBuildMs: 30000
  },

  // ---------------------------------------------------------------------------
  // 37. 开发助手
  // ---------------------------------------------------------------------------
  debug: {
    // 输出构建明细日志。
    verbose: false,
    // 输出渲染页面列表。
    listPages: false,
    // 输出配置中心(校验合并结果)。
    dumpConfig: false
  },

  // ---------------------------------------------------------------------------
  // 38. 首页 Hero 区域
  // ---------------------------------------------------------------------------
  // 与 site.json5 → hero 配合;hero.enabled(站点级)=false 时整块不显示。
  hero: {
    // 是否启用 Hero 区域(更高层控制,站点级 hero.enabled 优先)。
    enabled: true,
    // 显示搜索按钮。
    showSearch: true,
    // 显示「查看全部文章」按钮。
    showCta: true,
    // 显示热门标签。
    showTags: true,
    // CTA 按钮文字。
    ctaLabel: '查看全部文章',
    // CTA 按钮跳转(#latest-post = 吸顶到文章列表)。
    ctaUrl: '#latest-post',
    // 热门标签显示数量(1~20)。
    tagCount: 8,
    // 搜索按钮占位文字。
    searchPlaceholder: '搜索文章…',
    // 搜索按钮占位文字（en 站；空 = 回退中文）。
    searchPlaceholderEn: 'Search posts…',
    // Hero 是否显示日期(最新文章日期)。
    showDate: false,
    // en 语言 CTA 按钮文字。
    ctaLabelEn: 'View all posts',
    // Hero 最小高度(vh,内容垂直居中)。
    heightVh: 61.8,
    // Hero 背景图 URL(空则使用纯色/渐变背景)。
    backgroundImage: ''
  },

  // ---------------------------------------------------------------------------
  // 39. 背景粒子特效
  // ---------------------------------------------------------------------------
  // 与 theme.json5 → background.mode = "particles" 配合;mode 非 particles 时
  // 本模块不生效(即使 enabled=true)。颜色自动跟随主题辅助色(--color-s)。
  background: {
    // 粒子参数组(数量/速度/连线/不透明度等)。
    particles: {
      // 是否启用粒子动画(仅 background.mode=particles 时生效)。
      enabled: true,
      // 粒子数量(10~120,越少越省电)。
      count: 72,
      // 粒子运动速度(0.2~2,越大动感越强)。
      speed: 0.5,
      // 粒子连线距离(px),超过此距离不连线。
      linkDistance: 120,
      // 粒子不透明度(0~1)。
      opacity: 0.7,
      // 是否绘制粒子间连线。
      showLines: true,
      // 触屏设备/窄屏(<640px)自动关闭粒子(性能保护)。
      autoDisableMobile: false
    }
  },

  // 40. 界面动效(批C)
  // ---------------------------------------------------------------------------
  // 控制全站微交互动画:卡片悬停上浮、链接下划线滑动、按钮涟漪、滚动渐入。
  // 所有动效尊重 users prefers-reduced-motion(系统减弱动效时自动全部关闭)。
  motion: {
    // 总开关:false 时本模块全部不生效。
    enabled: true,
    // 卡片悬停缩放倍数(1=不缩放)。
    cardHoverScale: 1.02,
    // reveal 动画结束后清理 transitionDelay 的延迟(ms,需 ≥ 最大 stagger + 过渡时长)。
    // 类型: number(ms) | 推荐: 1400
    revealCleanupMs: 1400,
    // 链接下划线相对文字的偏移(px)。
    linkUnderlineOffset: '3px',
    // 卡片悬停上浮(首页/分类/标签的文章卡片)。
    cardHoverLift: true,
    // 悬停上浮距离(px,2~8)。
    cardHoverLiftPx: 4,
    // 链接下划线滑入效果(正文/导航/卡片标题等链接)。
    linkUnderline: true,
    // 下划线粗细。
    linkUnderlineThickness: '2px',
    // 按钮点击涟漪(btn/分享/播放等按钮)。
    buttonRipple: true,
    // 涟漪扩散时长(ms,300~800)。
    rippleDurationMs: 500,
    // 滚动渐入(元素进入视口时淡入上滑)。
    scrollReveal: true,
    // 滚动渐入:文章卡片。
    revealCards: true,
    // 滚动渐入:文章页面 h2/h3 标题。
    revealHeadings: true,
    // 滚动渐入:文章/卡片内图片。
    revealImages: true,
    // 滚动渐入:文章内代码块与引用块。
    revealBlocks: false,
    // 渐入总时长(ms)。
    revealDurationMs: 250,
    // 同屏多个元素连续渐入时相邻延迟(ms)。
    revealDelayMs: 0,
    // 同屏元素错峰总时间上限(ms),超过不再累加,避免长页面等待过久。
    revealStaggerMax: 80,
    // 渐入起点位移(px)。
    revealOffset: '10px',
    // 每个元素只渐入一次(滚动回顶不重复)。
    revealOnce: true,
    // 进入视口阈值(0~1,值越小越早触发)。
    revealThreshold: 0.08,
    // 系统"减少动态效果"下的动画策略: light(轻量版:更短、幅度更小,推荐) / off(完全关闭) / full(始终完整)。
    reducedMotion: 'light'
  },
  // ---------------------------------------------------------------------------
  dailyQuote: {
    // 开启每日一言(侧栏 widget + 文章页引用)。
    enabled: true,
    // 数据显示于侧栏还是正文顶部,若为 false 则显示在文章内容开头。
    widgetStyle: 'sidebar',
    // 题目标签。
    label: '每日一言',
    // 题目标签（en 站；空 = 回退中文）。
    labelEn: 'Daily Quote',
    // 数据源。
    // 类型: string | 可填: 'builtin'(内置引语)/ 相对项目根或绝对路径的 .json/.json5 文件
    // 文件格式: ["引语"] 或 [{ text, author }](也接受 { quotes: [...] });加载失败自动回退内置并警告
    source: 'builtin',
    // 引用数量(循环轮换)。
    count: 7,
    // 文本颜色(空则继承)。
    quoteColor: ''
  },
  // ---------------------------------------------------------------------------
  favorites: {
    // 开启收藏按钮(文章页) + /favorites 收藏页。
    enabled: true,
    // 收藏按钮显示位置。
    // 类型: string | 可填: 'toolbar'(文章底部工具栏,默认)/'meta'(文章标题下元信息行)
    position: 'toolbar',
    // 存储键。
    storageKey: 's-favorites',
    // 按钮标签。
    label: '收藏',
    // 按钮标签（en 站；空 = 回退中文）。
    labelEn: 'Favorite',
    // 文章列表是否显示右侧收藏 icon。
    listIcon: true,
    // 未收藏状态文案。
    notText: '收藏',
    // 未收藏状态文案（en 站；空 = 回退中文）。
    notTextEn: 'Favorite',
    // 已收藏状态文案。
    favedText: '已收藏',
    // 已收藏状态文案（en 站；空 = 回退中文）。
    favedTextEn: 'Favorited'
  },
  // ---------------------------------------------------------------------------
  prismTheme: {
    // 代码高亮配色总开关（false = 代码块不着色）。
    // 配色值定义在 theme.json5 的 codeHighlight.palette，浅色/暗色两套随主题自动切换。
    enabled: true
  },
  // ---------------------------------------------------------------------------
  cover: {
    // 开启封面样式库。
    enabled: true,
    // 可选样式集合。
    patterns: ['gradient', 'stripes', 'dots', 'blob', 'mesh'],
    // 首篇文章默认 pattern。
    defaultPattern: 'gradient',
    // 在线预览(悬浮缩略图)。
    preview: true,
    // 图片链接若存在是否优先使用(否则用 pattern 合成)。
    preferImage: true
  },
  // ---------------------------------------------------------------------------
  i18n: {
    // 开启界面双语(内置 strings)。
    enabled: true,
    // 默认语言。
    defaultLanguage: 'zh',
    // 支持语言。
    languages: ['zh', 'en'],
    // 切换按钮是否置于导航。
    navToggle: true,
    // 文章页显示翻译互链提示(若另一语言存在同 slug 文章;关闭则隐藏提示)。
    translationNotice: true
  },
  // ---------------------------------------------------------------------------
  pagefind: {
    // 开启基于 Pagefind 的全文搜索(静态搜索, 无后端)。
    enabled: true,
    // index 目录。
    indexPath: '/pagefind',
    // 是否集成到现有 search 覆盖层。
    integrate: true
  },
  // ---------------------------------------------------------------------------
  giscus: {
    // 开启 Giscus 评论(仅本键生效: 作为文章页评论容器闸门)
    enabled: false,
    // 以下 repo/repoId/category/categoryId/mapping/theme/loading/crossorigin 无消费方
    // 真实评论配置在 site.json5 → comments.giscus(与 site.comments.provider='giscus' 联动)
    // 在此填写仓库 ID 不会生效
    repo: '',
    // 占位:无消费方,不生效。
    repoId: '',
    // 占位:无消费方,不生效。
    category: 'Announcements',
    // 占位:无消费方,不生效。
    categoryId: '',
    // 占位:无消费方,不生效。
    mapping: 'title',
    // 占位:无消费方,不生效。
    theme: 'preferred_color_scheme',
    // 占位:无消费方,不生效。
    loading: 'lazy',
    // 占位:无消费方,不生效。
    crossorigin: 'anonymous'
  },
  // ---------------------------------------------------------------------------
  sitemap: {
    // sitemap 是否按类型细分(文章/标签/分类/页面)。
    // 数据类型: 布尔值。取值: true=启用; false=不启用(仍生成普通单一 sitemap)。
    // split=true 且 URL 总数超过 maxUrlsPerFile 时自动拆分为多个 sitemap-{n}.xml + 一个 sitemap.xml 作为 sitemapindex(索引入口)。
    // 拆分后 URL 数量低于阈值则生成单一 <urlset> sitemap.xml。
    split: true,
    // 文章(文章页)URL 的搜索引擎优先权。
    // 数据类型: 字符串。取值: '0.0' 至 '1.0', 建议文章用 '0.7'-'1.0'(重要权重)。
    postPriority: '0.8',
    // 独立页面URL(首页/归档/相册/收藏等)的搜索引擎优先权。
    // 数据类型: 字符串。取值: '0.0' 至 '1.0', 建议页面用 '0.5'-'0.8'。
    pagePriority: '0.6',
    // 标签页URL 的搜索引擎优先权。
    // 数据类型: 字符串。取值: '0.0' 至 '1.0', 建议标签用 '0.3'-'0.6'(次要权重)。
    tagPriority: '0.4',
    // 文章页 URL 的更新频率提示(sitemap 协议标准值)。
    // 数据类型: 字符串。可填值: always / hourly / daily / weekly / monthly / yearly / never。
    // 建议: 博客文章 weekly; 新闻 always; 静态文档 yearly。
    postFrequency: 'weekly',
    // 独立页面URL 的更新频率提示。
    // 数据类型: 字符串。可填值: always / hourly / daily / weekly / monthly / yearly / never。
    // 建议: 首页与归档页 weekly 或 monthly。
    pageFrequency: 'monthly',
    // 标签页URL 的更新频率提示。
    // 数据类型: 字符串。可填值: always / hourly / daily / weekly / monthly / yearly / never。
    // 建议: 标签页 monthly 或 yearly。
    tagFrequency: 'monthly',
    // 拆分阈值:每个 sitemap 文件最多包含的 URL 数。URL 总数超过该值则拆分为多个文件。
    // 数据类型: 正整数。默认 500。可填值: 最小 10(低于会强制为 10), 最大建议不超过 50000(协议上限)。
    // 推荐: 小站点 500-1000; 大站点 5000(每个文件不超过 50000 条)。
    maxUrlsPerFile: 500
  },

  // ---------------------------------------------------------------------------
  // 41. 滚动行为(平滑滚动 / 锚点偏移 / reduced-motion 降级)
  // ---------------------------------------------------------------------------
  scrollBehavior: {
    // 平滑滚动总开关(false 时全站瞬时滚动)。
    enabled: true,
    // 滚动行为: smooth(平滑) / auto(瞬时)。
    behavior: 'smooth',
    // 锚点偏移(额外值,最终 scroll-padding-top = calc(var(--hh) + 该值))。
    anchorOffset: '18px',
    // 尊重系统"减少动态效果"设置(reduced-motion 时降级为 auto)。
    respectReducedMotion: true
  },

  // ---------------------------------------------------------------------------
  // 42. 轻提示(toast 统一通知)
  // ---------------------------------------------------------------------------
  toast: {
    // 统一轻提示总开关(false 时所有轻提示不显示)。
    enabled: true,
    // 显示位置: bottom-center / top-center / top-right / bottom-right / top-left / bottom-left。
    position: 'bottom-center',
    // 自动消失时长(ms)。
    durationMs: 2500,
    // 同屏最多显示条数(超出时最早一条先消失)。
    maxVisible: 3,
    // 淡出动画后移除节点的延迟(ms)。
    // 类型: number(ms) | 推荐: 300
    removeDelayMs: 300
  },

  // ---------------------------------------------------------------------------
  // 43. 面包屑导航
  // ---------------------------------------------------------------------------
  breadcrumb: {
    // 启用面包屑(所有页面,首页与 404 除外)。
    enabled: true,
    // 层级分隔符。
    separator: '›',
    // 显示"首页"链接。
    showHome: true,
    // 显示当前页(最后一级,不可点击)。
    showCurrent: true
  },

  // ---------------------------------------------------------------------------
  // 44. 页面切换过渡(离开淡出 + 入场动画)
  // ---------------------------------------------------------------------------
  pageTransition: {
    // 启用页面切换过渡(内链点击淡出 → 导航 → 新页入场)。
    enabled: true,
    // 过渡类型: slide(淡入+上滑) / fade(纯透明度)。
    type: 'slide',
    // 入场动画时长(ms)。
    durationMs: 180,
    // 离开(淡出)时长(ms)。
    outDurationMs: 120,
    // 系统"减少动态效果"下的策略: light(轻量版:更短的纯淡出,推荐) / off(不拦截链接) / full(始终完整)。
    reducedMotion: 'light',
    // 不拦截的选择器(匹配元素或其祖先)。
    excludeSelector: '[data-no-transition]'
  },

  // ---------------------------------------------------------------------------
  // 45. PWA 运行时(SW 注册 / 更新提示 / 离线提示)
  // ---------------------------------------------------------------------------
  pwa: {
    // 总开关: PWA 运行时功能(需 site.json5→pwa.enabled 同时开启才会生成 manifest/SW 资源)
    enabled: true,
    // 注册 Service Worker(获得离线缓存能力;由 js 端在支持时注册 /sw.js)
    registerSW: true,
    // SW 新版本就绪时弹 toast 提示刷新(避免用户停留在旧版本)
    updatePrompt: true,
    // 断网/恢复连接时弹 toast 提示(仅在 navigator.onLine 事件触发)
    offlineNotice: true,
    // 生成离线兜底页(断网访问未缓存页面时的 /offline 页面)
    offlinePage: true,
    // 显示「安装到桌面」按钮(仅浏览器触发 beforeinstallprompt 后出现)
    installPrompt: true,
    // 「安装到桌面」关闭状态的 localStorage 键(修改会使旧关闭记录失效)。
    // 类型: string | 推荐: 's-a2hs-dismissed'
    installDismissKey: 's-a2hs-dismissed',
    // SW 更新就绪 toast 的显示时长(ms)。
    // 类型: number(ms) | 推荐: 6000
    updateToastMs: 6000
  },

  // ---------------------------------------------------------------------------
  // 46. 图标变形动画(状态切换类图标 ↔ 弹簧物理变形)
  // ---------------------------------------------------------------------------
  morphIcons: {
    // 总开关(false = 全部图标恢复静态切换,不加载任何 vendor 代码)。
    enabled: true,
    // vendor 图标资产目录(站内绝对路径;构建复制 assets/vendor 后由此加载)。
    // 类型: string | 推荐: '/assets/vendor/morphicons'
    vendorPath: '/assets/vendor/morphicons',
    // 弹簧预设: smooth(无回弹) / snappy(快速微回弹) / bouncy(弹跳感);
    // tuning.morphicons.stiffness/damping 同时设置时优先于预设。
    spring: 'snappy',
    // 系统"减少动态效果"下的策略: light(轻量版:更快的弹簧,推荐) / off(直接切换不变形) / full(始终完整)。
    reducedMotion: 'light',
    // vendor 预加载策略: interaction(首次悬停/触摸/聚焦,推荐) / idle(空闲自动) / immediate(立即)。
    preload: 'interaction',
    // 单图标弹簧覆盖(可选): 图标名(theme/copy/favorite/tts/menu) → 预设名或 {stiffness,damping}。例: {"favorite":"bouncy"}。
    perIcon: {},
    // 各图标独立开关(false = 该图标保持原有静态实现)。
    icons: {
      // 主题切换 sun ↔ moon。
      theme: true,
      // 复制按钮 copy → check → copy。
      copy: true,
      // 收藏 空心 → 实心。
      favorite: true,
      // 朗读按钮 扬声器 → 停止。
      tts: true,
      // 移动端菜单 汉堡 → X。
      menu: true
    }
  },

  // ---------------------------------------------------------------------------
  // 47. 跨文档过渡动画(无白屏切页;不支持 VT 的浏览器自动忽略本段)
  // ---------------------------------------------------------------------------
  viewTransition: {
    // 总开关(false = 不注入 @view-transition,完全回退旧 pageTransition 淡出)。
    enabled: true,
    // 过渡类型: fade(交叉淡入淡出) / slide(横向滑动)。
    type: 'fade',
    // 过渡时长(ms;150~400 较自然)。
    durationMs: 180,
    // 共享元素过渡(列表卡片封面/标题 → 文章封面/标题 形变衔接;浏览器不支持时自动忽略)。
    shared: true,
    // 系统"减少动态效果"下的策略: light(轻量版:0.1s 纯淡出,推荐) / off(禁用 VT) / full(始终完整)。
    reducedMotion: 'light',
    // 页内开关配置。
    toggle: {
      // 是否在导航栏显示该开关(false = 只受本配置文件控制)。
      show: true,
      // 默认开启状态(用户未手动设置过时采用)。
      defaultOn: true,
      // localStorage 记忆键(用户手动切换后持久保存)。
      storageKey: 's-view-transition'
    }
  },

  // ---------------------------------------------------------------------------
  // 48. 预取/预渲染(Speculation Rules;仅 Chromium 系支持,其余浏览器自动忽略)
  // ---------------------------------------------------------------------------
  speculation: {
    // 总开关(false = 不注入任何投机规则)。
    enabled: true,
    // 规则下发方式: inline(内联脚本,页内开关可控;默认) / header(响应头+规则文件,全站生效且让 Cloudflare Speed Brain 礼让,但页内开关不生效) / both(双下发,可能轻微重复)。
    delivery: 'inline',
    // 投机模式: prefetch(仅下载文档体,零 JS 执行) / prerender(整页预渲染,最快但耗资源) / both(同时下发,浏览器择优)。
    mode: 'both',
    // 触发档位: moderate(悬停约 200ms,推荐) / eager(立即,较耗流量) / conservative(按下鼠标时)。
    eagerness: 'moderate',
    // 排除规则(命中则不投机;支持选择器与 URL 通配)。
    excludeSelectors: ['[download]', '[rel~=nofollow]', '.no-speculate'],
    // 页内开关配置。
    toggle: {
      // 是否在导航栏显示该开关(false = 只受本配置文件控制)。
      show: true,
      // 默认开启状态(用户未手动设置过时采用)。
      defaultOn: true,
      // localStorage 记忆键。
      storageKey: 's-speculation'
    }
  },

  // ---------------------------------------------------------------------------
  // 49. 卡片视觉增强(封面遮罩/分类色标/阅读时长徽章/悬停光泽)
  // ---------------------------------------------------------------------------
  cardFx: {
    // 总开关(false = 卡片恢复为纯图片+文字的基础样式)。
    enabled: true,
    // 封面底部渐变遮罩(提升文字可读性与层次感)。
    coverOverlay: false,
    // 封面左下分类色标(按分类名哈希取色,同分类同色)。
    categoryChip: false,
    // 封面右上阅读时长徽章。
    readTimeBadge: false,
    // 悬停扫过光泽(自动尊重 reduced-motion)。
    hoverShine: false
  },

  // ---------------------------------------------------------------------------
  // 50. 杂志排版(首字下沉/图片出血/表格悬停/标题编号)
  // ---------------------------------------------------------------------------
  magazine: {
    // 总开关(false = 恢复基础排版)。
    enabled: true,
    // 首段首字下沉(衬线展示字体+主题色;中英文均生效)。
    dropCap: true,
    // 正文图片向两侧出血(宽屏超出正文栏;窄屏自动回退)。
    figureBleed: true,
    // 表格行悬停高亮(主色调混合)。
    tableHover: true,
    // h2 自动编号(01/02…;默认关,避免与手写序号重复)。
    headingNumbers: false
  },

  // ---------------------------------------------------------------------------
  // 51. 性能预算门禁(构建期体积/请求数基线,超限提醒或阻断)
  // ---------------------------------------------------------------------------
  perfBudget: {
    // 总开关(false = 跳过预算检查)。
    enabled: true,
    // 单页 HTML gzip 大小上限(KB;含内联 CSS/脚本,超出触发提醒/阻断)。
    htmlKb: 28,
    // 页面 HTML raw 体积中位上限(KB;长文压力页等极端页面不受中位代表,仅作回归护栏)。
    htmlRawKb: 50,
    // 页面内联关键配置(降级子集)上限(KB;完整配置已外置为 /assets/config.<hash>.json)。
    inlineConfigKb: 2,
    // 应用 JS(assets/js)全量 gzip 合计上限(KB;第三方 vendor 库按需懒加载,不计入)。
    jsKb: 55,
    // 单页静态请求数上限(script src + stylesheet + modulepreload 之和)。
    requests: 12,
    // true = 仅提醒不阻断构建;false = 超限时构建失败(严格门禁)。
    warnOnly: true
  },

  // ---------------------------------------------------------------------------
  // 52. 滚动进度条(顶部 hairline;基于原生 scroll-driven 动画,零 JS)
  // ---------------------------------------------------------------------------
  scrollIndicator: {
    // 总开关(false = 不渲染进度条元素)。
    enabled: true,
    // 进度条高度(任意 CSS 长度;2px 精致,3px 醒目)。
    height: '2px',
    // 使用主题渐变(次级色→强调色);false = 单色次级色。
    gradient: true,
    // 系统"减少动态效果"时隐藏条(避免持续重绘;false = 始终显示)。
    respectReducedMotion: true
  },

  // ---------------------------------------------------------------------------
  // 53. 命令面板(Ctrl/Cmd+Shift+P;搜索文章 + 页面导航 + 快捷操作)
  // ---------------------------------------------------------------------------
  commandPalette: {
    // 总开关(false = 不监听快捷键,不加载搜索索引)。
    enabled: true,
    // 触发组合键(支持修饰键组合,如 'ctrl+shift+p' / 'ctrl+k' / 'alt+p';不含 '+' 的
    // 旧写法如 'k' 等价于"主修饰键(Ctrl 或 Cmd)+ 该键")。
    // 默认 'ctrl+shift+p':避免占用浏览器打印(Ctrl+P);Ctrl+K 固定保留给全站搜索
    // (代码对 hotkey='k' 另有避让:搜索弹层存在时不拦截)。置空字符串 = 不监听快捷键。
    hotkey: 'ctrl+shift+p',
    // 是否包含页面导航项(取自顶部导航菜单)。
    includeNavigation: true,
    // 是否包含快捷操作(切换主题/回到顶部/打开搜索/我的收藏)。
    includeActions: true,
    // 是否包含文章搜索(首次打开时懒加载 search-index.json)。
    includeSearch: true,
    // 结果列表最多显示条目数(8-12 较合适,超出需滚动)。
    maxResults: 10,
    // 打开时自动聚焦输入框(false = 需点击输入框;一般保持 true)。
    autoFocus: true
  },

  // ---------------------------------------------------------------------------
  // 54. 订阅组件(RSS / JSON Feed / 外邮件订阅表单)
  // ---------------------------------------------------------------------------
  subscribe: {
    // 总开关(false = 页脚不渲染订阅条)。
    enabled: true,
    // 是否显示 RSS 链接(指向当前语言的 {lang}/feed.xml)。
    rss: true,
    // 是否显示 JSON Feed 链接(仍受 site.rss.jsonFeed.enabled 总控)。
    jsonFeed: true,
    // 外部邮件订阅表单地址(如 Buttondown/Substack 主页;空字符串 = 隐藏该按钮)。
    newsletterUrl: '',
    // 邮件订阅按钮文案(空 = 用界面文案表 subscribe.mail)。
    newsletterLabel: '',
    // 邮件订阅按钮文案英文（en 站；空 = 回退界面文案表 subscribe.mail）。
    newsletterLabelEn: '',
    // 外链是否新窗口打开(false = 当前窗口)。
    newTab: true
  },

  // ---------------------------------------------------------------------------
  // 55. 作者卡(关于页;头像/简介/技能/时间线/社交矩阵)
  // ---------------------------------------------------------------------------
  authorCard: {
    // 总开关(false = 关于页不渲染作者卡)。
    enabled: true,
    // 显示作者卡的页面 slug(默认关于页 'about';需 site.authorProfile 提供至少一项内容)。
    pageSlug: 'about',
    // 是否显示社交矩阵(来自 site.authorProfile.socials)。
    showSocial: true,
    // 是否显示技能标签(来自 site.authorProfile.skills)。
    showSkills: true,
    // 是否显示时间线(来自 site.authorProfile.timeline,按配置顺序渲染)。
    showTimeline: true,
    // 头像尺寸(任意 CSS 长度;96px 适中)。
    avatarSize: '96px',
    // 时间线最多渲染条数(防止过长;0 = 不限制)。
    maxTimeline: 20
  },

  // ---------------------------------------------------------------------------
  // 56. 继续阅读(本地阅读历史;首页展示最近读过的文章)
  // ---------------------------------------------------------------------------
  readingHistory: {
    // 总开关(false = 不记录也不渲染)。
    enabled: true,
    // 首页最多显示条数(3-8 较合适)。
    maxItems: 5,
    // localStorage 键名(修改会丢弃旧历史)。
    storageKey: 's-history',
    // 是否在首页显示(仅首页/分页列表;false = 只记录不展示)。
    showOnHome: true,
    // 是否显示「清除」按钮。
    clearable: true
  },

  // ---------------------------------------------------------------------------
  // 57. 打印样式(打印/导出 PDF 时的排版优化)
  // ---------------------------------------------------------------------------
  printStyle: {
    // 总开关(false = 仅保留基础打印规则)。
    enabled: true,
    // 打印时隐藏导航/页脚/侧栏/按钮等交互元素(true = 纯净正文)。
    hideInteractive: true,
    // 正文外链打印为 "文字 (URL)" 形式(便于纸质阅读)。
    expandLinks: true,
    // 代码块/图片/表格/引用避免跨页断裂。
    avoidBreaks: true
  },

  // ---------------------------------------------------------------------------
  // 58. 氛围(全局颗粒纹理与主题光晕的页面级开关)
  // ---------------------------------------------------------------------------
  atmosphere: {
    // 总开关(false = 关闭全部氛围层)
    enabled: true,
    // 全页颗粒噪点层(伪元素纹理;强度/密度在 tuning.json5→texture 分类调整)
    grain: true,
    // Hero 区主题色光晕(关闭可省一次全屏合成,低端设备建议 false)
    glow: false
  },

  // ---------------------------------------------------------------------------
  // 59. 公告条(站顶单行公告,可关闭并记忆)
  // ---------------------------------------------------------------------------
  announcement: {
    // 总开关(false = 不渲染公告条,同时不注入头部防闪脚本)
    // 类型: boolean | 可填: true/false | 推荐: true
    enabled: true,

    // 关闭记录的 localStorage 键(按语言分别记忆，存储 {"zh":hash,"en":hash}；修改会使旧关闭记录失效，旧版单值会自动迁移)
    // 类型: string | 推荐: 's-announce-dismissed'
    storageKey: 's-announce-dismissed',

    // 关闭动画后移除公告 DOM 的延迟(ms,需 ≥ 滑出动画时长)
    // 类型: number(ms) | 推荐: 340
    removeDelayMs: 340,

    // 单条公告文本(zh 站使用;items 非空时本字段被忽略)
    // 类型: string | 可填: 任意短文本(建议 ≤ 40 字,超长会省略号截断)
    text: '欢迎来到 S-ynapse',

    // 单条公告英文文本(en 站使用;items 非空时本字段被忽略)
    // 类型: string | 可填: 任意短文本 | 空 = en 站回退为 text
    textEn: 'Welcome to S-ynapse',

    // 单条公告点击跳转(空 = 不可点击的纯文本;items 非空时本字段被忽略)
    // 类型: string | 可填: 站内路径("/about/")或完整外链("https://…")
    url: '',

    // 多条公告轮播列表(非空时覆盖上面的 text/textEn/url 三键)
    // 作用: 支持多条公告按时序轮播;每条可独立设置文案/跳转/徽标
    // 字段: text 中文正文(必填其一的其中之一) / textEn 英文正文 / url 跳转(空=纯文本) / icon 前缀徽标短文本(如 "NEW"/"活动")
    // 类型: 数组[{text?,textEn?,url?,icon?}]
    // 不可填: 全空条目(text 与 textEn 均空会被跳过);条目数建议 2–5 条
    // 推荐: 2–3 条(超出后用户很难看完)
    items: [],

    // 自动轮播间隔(毫秒;0 = 不轮播,仅显示第一条)
    // 类型: number | 可填: 0 或 2000–30000 | 推荐: 6000(6 秒)
    rotateMs: 6000,

    // 悬停/按住暂停轮播
    // 作用: 鼠标悬停或触屏按住时暂停轮播与进度条,移开后恢复
    // 类型: boolean | 可填: true(推荐,便于阅读)/false(全程轮播)
    pauseOnHover: true,

    // 条目切换动画
    // 类型: string | 可填: "fade"(淡入淡出,推荐)/"slide"(上滑+淡入)
    // 不可填: 其他值(回退 fade);reduced-motion 用户自动禁用动画
    transition: 'fade',

    // 配色风格
    // 类型: string | 可填: "accent"(主色淡渐变,推荐)/"solid"(主色实底白字)/"minimal"(表面色极简)/"gradient"(主→辅强渐变白字)
    // 不可填: 其他值(回退 accent)
    tone: 'accent',

    // 轮播进度条(显示当前条目剩余停留时间;仅多条轮播时渲染)
    // 类型: boolean | 可填: true/false | 推荐: false(更简洁;需要提示节奏时开启)
    showProgress: false,

    // 左侧装饰圆点
    // 类型: boolean | 可填: true(推荐)/false
    showDot: true,

    // 外链打开方式(仅 url 为 http(s) 外链时生效;站内链接始终当前窗口)
    // 类型: boolean | 可填: true(新窗口 target=_blank,推荐)/false(当前窗口)
    newTab: true,

    // 可关闭(× 按钮)
    // 作用: 点击后按「条目内容哈希」记忆关闭;内容更新后哈希变化,公告会重新出现
    // 类型: boolean | 可填: true(推荐)/false(常驻不可关)
    dismissible: true
  },

  // ---------------------------------------------------------------------------
  // 60. 防护与交互控制总控(右键菜单/复制控制/快捷键拦截/检测等;细节全部在 guard.json5)
  // ---------------------------------------------------------------------------
  // ===== 弹窗公告（popupNotice）=====
  // 页面加载后延迟弹出的公告对话框，与顶部公告条(announcement)相互独立。
  // 内容、按钮、关闭方式与配色均可自定义；默认关闭，需显式 enabled: true。
  popupNotice: {
    // 总开关(false = 不注入弹窗逻辑)
    // 类型: boolean | 推荐: false(按需开启)
    enabled: false,

    // 弹出延迟(毫秒;0 = 立即弹出)
    // 类型: number | 可填: 0 或 500–5000 | 推荐: 1200–2500
    delayMs: 1500,

    // 弹出频率(内容未变化时): 'session' 每会话一次 | 'day' 每天一次 | 'always' 每次都弹
    // 类型: string | 推荐: 'day'
    frequency: 'day',

    // 内容变化后是否重新弹出(true = 修改标题/正文/按钮/图片等后，已关闭的用户会再看到一次)
    // 类型: boolean | 推荐: true
    reshowOnChange: true,

    // 展示/关闭记忆的 localStorage 键(内容哈希与关闭日期存于此;会话记忆存同键+':session')
    // 类型: string | 推荐: 's-popupNotice'
    storageKey: 's-popupNotice',

    // 弹窗宽度(CSS 长度;移动端自动限制为 92vw)
    // 类型: string | 可填: 任意 CSS 宽度 | 推荐: '440px'
    width: '440px',

    // 标题(zh) / 英文标题(空 = en 站回退 zh)
    // 类型: string
    title: '', titleEn: '',

    // 正文(zh) / 英文正文(空行分段;纯文本渲染，不解析 Markdown/HTML)
    // 类型: string
    body: '', bodyEn: '',

    // 顶部图片(站内路径或外链;空 = 不显示) 与替代文本(zh/en)
    // 类型: string
    image: '', imageAlt: '', imageAltEn: '',

    // 二维码区块(适合公众号/群引导;src 为空且 enabled=true 会被构建校验拦截)
    qr: {
      // 是否显示二维码图片
      // 类型: boolean
      enabled: false,
      // 二维码图片地址(站内路径或外链)
      // 类型: string
      src: '',
      // 图注(zh) / 英文图注(空 = en 站回退 zh)
      // 类型: string
      caption: '', captionEn: ''
    },

    // 按钮组(空 = 仅显示关闭按钮);每项: {label,labelEn,url,style:'primary'|'ghost',newTab}
    // 类型: 数组 | 推荐: ≤2 个 | url 为空则渲染为仅关闭的按钮
    // 示例: [{ label: '查看详情', labelEn: 'Learn more', url: '/zh/about/', style: 'ghost' }]
    buttons: [],

    // 关闭按钮(「知道了」类);enabled: false = 不显示(仍可用右上角 × 或其他方式关闭)
    closeButton: { enabled: true, label: '知道了', labelEn: 'Got it', style: 'primary' },

    // 右上角 × 按钮
    // 类型: boolean | 推荐: true
    closeIcon: true,

    // 点击遮罩(弹窗外区域)关闭
    // 类型: boolean | 推荐: true
    closeOnBackdrop: true,

    // Esc 键关闭
    // 类型: boolean | 推荐: true
    escToClose: true,

    // 自定义配色(留空 = 跟随站点主题变量;支持任意 CSS 颜色值)
    // overlay 遮罩 / background 弹窗底 / text 主文字 / textSecondary 次文字 / border 描边 /
    // primary 主按钮底 / primaryText 主按钮字 / ghost 次按钮字
    colors: { overlay: '', background: '', text: '', textSecondary: '', border: '', primary: '', primaryText: '', ghost: '' }
  },

  // 软导航：拦截站内同语言链接，用 fetch + DOM 交换替代整页刷新（配合 View Transitions 实现无缝过渡）。
  // 前提：目标为同源、同语言页面；任何异常（超时/解析失败/脚本报错）都会自动回退为普通整页跳转。
  softNavigation: {
    // 总开关(false = 完全不拦截链接)
    // 类型: boolean | 推荐: true
    enabled: true,

    // 页内开关(「页面加速」面板)：用户可随时关闭以规避兼容问题
    // toggle.show: 是否显示开关 | toggle.defaultOn: 默认是否开启 | storageKey: 记忆键
    toggle: { show: true, defaultOn: true, storageKey: 's-soft-nav' },

    // 悬停/聚焦链接时预取目标页 HTML(加速点击后的交换)
    // 类型: boolean | 推荐: true
    prefetchOnHover: true,

    // 预取延迟(毫秒;避免快速掠过链接时产生无谓请求)
    // 类型: number | 推荐: 80
    prefetchDelayMs: 80,

    // 页面内存缓存有效期(毫秒;前进/后退优先复用)
    // 类型: number | 推荐: 300000(5 分钟)
    cacheTtlMs: 300000,

    // 单次 fetch 超时(毫秒;超时即回退整页跳转)
    // 类型: number | 推荐: 10000
    timeoutMs: 10000,

    // 是否使用同文档 View Transitions 做过渡动画(false = 直接交换内容)
    // 类型: boolean | 推荐: true
    viewTransition: true,

    // 不拦截的链接选择器(数组)
    // 类型: 数组 | 推荐: ['[data-no-soft-nav]', '.no-soft-nav']
    excludeSelectors: ['[data-no-soft-nav]', '.no-soft-nav'],

    // 交换成功后是否滚动到页面顶部
    // 类型: boolean | 推荐: true
    scrollToTop: true
  },

  guards: {
    // 总开关：false 时 guard.json5 全文件失效
    enabled: true,
    // 一键档位：'off'=全关 | 'soft'=仅右键菜单+复制署名(推荐) | 'strict'=按 guard.json5 各 enabled
    preset: 'soft',
    // 模块开关(类型均为 boolean)：preset='soft' 时仅 contextMenu/copyGuard 默认生效；
    // 其余模块需在 guard.json5 显式 enabled:true 才会执行；'strict' 档下以 guard.json5 各 enabled 为准；
    // 此处 false 强制关闭任何档位下的该模块。
    // contextMenu: 自定义右键菜单(替换浏览器菜单)
    contextMenu: true,
    // copyGuard: 复制拦截 + 追加署名
    copyGuard: true,
    // selectionGuard: 禁止选中文本
    selectionGuard: true,
    // hotkeyGuard: 拦截开发者工具等快捷键
    hotkeyGuard: true,
    // watermark: 页面水印(样式/文案见 guard.json5→watermark)
    watermark: true,
    // devtoolsDetect: 开发者工具开启检测(行为见 guard.json5)
    devtoolsDetect: true,
    // consoleGuard: 控制台 banner/清屏/反制
    consoleGuard: true,
    // privacyCurtain: 窗口失焦/截屏时的隐私帘
    privacyCurtain: true,
    // tamperWatch: 注入与 DOM 篡改监视
    tamperWatch: true,
    // accessGate: 路径口令访问门槛(密码/次数见 guard.json5→accessGate)
    accessGate: true
  },

  // ---------------------------------------------------------------------------
  // 61. 加载遮罩(引导短暂覆盖;防闪三保险:延迟出现/最短显示/硬超时兜底)
  // ---------------------------------------------------------------------------
  loading: {
    // 总开关；false = 不显示任何加载遮罩
    enabled: true,
    // 延迟出现(ms)：启动快于该值时不显示遮罩（0 = 总是显示，建议 80-200）
    delayMs: 120,
    // 最短显示(ms)：一旦出现至少停留这么久，避免"一闪而过"（推荐 200-400）
    minShowMs: 250,
    // 硬超时(ms)：无论启动是否完成，到点强制淡出（失败兜底，推荐 1500-3000）
    maxShowMs: 2000,
    // 系统"减少动态效果"时的策略：'skip'=完全不显示(推荐) | 'static'=显示但无动画
    reducedMotion: 'skip',
    // 遮罩文案（空 = 使用 ui-strings 的 loading.text；建议留空以便双语）
    text: '',
    // 启动期间为 <body> 设置 aria-busy（无障碍提示；推荐 true）
    ariaBusy: true,
    // 是否显示转圈动画（false = 仅文字）
    spinner: true,
    // 转圈样式：'orbit'=三点轨道（默认） | 'ring'=单环旋转
    spinnerStyle: 'orbit',
    // 是否在动画上方显示站点名标题（取页面标题栏的站点名）
    showTitle: false,
    // 转圈主色（空 = 跟随主题次要色 var(--color-s)；可填任意 CSS 颜色）
    overlayColor: '',
    // 淡出时长(ms)（收尾动画；推荐 300-500）
    fadeMs: 380,
    // 遮罩层级（应高于导航 1000 与公告；推荐 2500-3500）
    zIndex: 3000
  },

  // ---------------------------------------------------------------------------
  // 62. 启动调度(三阶段:关键同步 → 空闲批次 → 重模块动态导入;防长任务卡顿)
  // ---------------------------------------------------------------------------
  boot: {
    // 总开关；false = 旧行为（全部模块立即初始化，可能出现长任务）
    enabled: true,
    // 空闲等待上限(ms)：requestIdleCallback 超时兜底（推荐 500-1500）
    idleTimeoutMs: 800,
    // 首次交互（点击/按键/触摸/滚轮）立即唤醒后续批次（推荐 true，保 INP）
    interactionWake: true,
    // 控制台输出启动时间线（[boot] 前缀；排查性能时开，生产建议 false）
    log: false,
    // 每批时间片上限(ms)：一批内连续执行模块的预算（推荐 30-50）
    budgetMs: 40,
    // 重模块启动时机：'idle'=空闲即启（默认） | 'interaction'=等首次交互或兜底 | 'immediate'=不等待
    heavyMode: 'idle',
    // 无 requestIdleCallback 时的回退间隔(ms)（推荐 80-200）
    idleFallbackMs: 120,
    // 唤醒后续批次的交互事件名列表（默认四件套；可增删，如 'scroll'）
    interactionEvents: ['pointerdown', 'keydown', 'touchstart', 'wheel']
  },

  // ---------------------------------------------------------------------------
  // 63. 图片适配(正文/封面/画廊/灯箱四域;小图默认不放大,大图等比缩放)
  // ---------------------------------------------------------------------------
  imageFit: {
    // 总开关；false = 全部恢复默认行为（正文不放大/封面 cover 居中/画廊拉伸/灯箱 contain）
    enabled: true,
    // 正文图片（.post-content img）
    content: {
      // 小图策略：'never' 不放大（推荐）| 'cap' 最多放大 cap 倍（防糊）| 'full' 铺满容器
      upscale: 'never',
      // cap 模式的放大上限倍数（1.2 保守；1.5 适中；2 激进；仅 upscale='cap' 生效）
      cap: 1.5,
      // 最大高度（vh）：0 = 不限制；例如 60 表示超高长图最多占 60vh（超出等比缩小）
      maxHeightVh: 0,
      // 对齐方式：'center' 居中（推荐）| 'left' 左对齐
      align: 'center'
    },
    // 封面图（文章头图与卡片图）
    cover: {
      // 适配方式：'cover' 裁切填充（推荐）| 'contain' 完整显示（留白）| 'fill' 拉伸（不推荐）
      fit: 'cover',
      // 裁切焦点：'center'|'top'|'bottom'|'left'|'right' 或自定义 'x% y%'（如 '50% 30%' 偏上）
      position: 'center',
      // 封面最大高度（vh）：0 = 不限制（长图建议 40-60）
      maxHeightVh: 0,
      // 封面宽高比（空 = 用模板默认 16/10；如 '16/9'、'21/9'）
      aspect: '',
      // 是否把 fit/position 同时应用到列表卡片封面（false = 仅文章头图）
      applyToCards: true
    },
    // 画廊（/gallery/ 图库页与文章内图库）
    gallery: {
      // 是否拉伸小图铺满列宽：false = 保持原始尺寸（推荐，修复旧版拉伸变形）| true = 旧行为
      stretch: false,
      // 单图最大高度（px）：0 = 不限制
      maxHeightPx: 0
    },
    // 灯箱（点击大图）
    lightbox: {
      // 'contain' 适配屏幕（推荐）| 'actual' 原始尺寸（超出可平移查看）
      fit: 'contain',
      // 灯箱图最大宽（vw 百分比；推荐 85-95）
      maxWidthPct: 92,
      // 灯箱图最大高（vh；推荐 75-90）
      maxHeightVh: 82
    }
  },
}

// =============================================================================
// features.json5 — S-ynapse 交互与内容功能总控
// =============================================================================
// 作用     : 集中控制站点的交互功能与内容渲染行为(开关 + 粒度 + 微调)。
// 加载时机 : 构建时自动加载,随其余配置文件一起合并（可缺省/可删键）。
// 数据形状 : 每个功能一个一级对象;每个对象至少含 enabled(布尔)。
//            缺省任何键时构建器使用内置默认值(与本站当前行为一致)。
// 校验规则 : 键名不在 schema 中的会被忽略(不报错);enabled 非布尔或枚举字段
//            非法值会终止构建并给出精确错误(见 scripts/lib/features-schema.js)。
// 数组语义 : 数组合并为"替换"而非追加(如 share.order 删一项即彻底移除)。
// 编写规范 : 布尔值开启/关闭;数字为具体数值;字符串为 CSS 值或文本。
//            每个字段均有真实效果,无摆设项;修改后需重新构建。
// 边界提示 : 视觉数值微调 → tuning.json5;站点级开关 → site.json5;
//            主题色/字体 → theme.json5;界面文案 → ui-strings.json5。
// =============================================================================

{
  // ---------------------------------------------------------------------------
  // 1. 图片灯箱(点击正文/图库图片放大预览)
  // ---------------------------------------------------------------------------
  lightbox: {
    // 启用图片灯箱。关闭后点击图片无放大效果。
    enabled: true,
    // 放大功能(工具栏放大/缩小按钮 + 双击 + 滚轮 + 双指捏合)。false 时隐藏。
    zoomEnabled: true,
    // 平移拖拽功能(放大后拖动图片查看细节)。false 时禁止拖拽。
    panEnabled: true,
    // 旋转功能(工具栏旋转 90°按钮)。
    rotateEnabled: true,
    // 移动端双指捏合缩放。
    pinchEnabled: true,
    // 每次点击按钮的缩放步长(0.25 = 25%)。
    zoomStep: 0.25,
    // 最小缩放倍数(1 = 原始尺寸)。
    zoomMin: 1,
    // 最大缩放倍数。
    zoomMax: 4,
    // 是否支持双击图片放大/还原。
    dblClickZoom: true,
    // 是否支持鼠标滚轮缩放。
    wheelZoom: true,
    // 是否显示缩放/旋转/重置按钮组。
    showZoomButtons: true,
    // 收集目标的选择器。默认正文图片 + 图库图片;其他容器可追加类名,逗号分隔。
    selectors: '.post-content img, .gallery-item img',
    // 控制在图片周围触发灯箱的最小边长(px)。用于过滤小图标。
    minSize: 60,
    // 是否支持上一张/下一张切换按钮。
    prevNextButtons: true,
    // 是否支持关闭按钮(右上角 ×)。
    closeButton: true,
    // 是否支持键盘方向键切换(左=上一张,右=下一张)。
    keyboardNavigate: true,
    // 是否支持 ESC 关闭。
    escToClose: true,
    // 是否支持移动端左右滑动切换。
    swipeToNavigate: true,
    // 点击遮罩区域是否关闭灯箱。
    closeOnBackdrop: true,
    // 是否显示"第 N / M 张"计数器。
    showCounter: true,
    // 计数器文本模板。{current} 当前索引,{total} 总数。
    counterFormat: '{current} / {total}',
    // 图片最大宽度(占视口百分比)。
    maxWidthVw: '92',
    // 图片最大尺寸上限(px)。
    maxSizePx: '1600',
    // 图片最大高度(占视口百分比)。
    maxHeightVh: '82',
    // 打开动画时长(ms)。
    openDurationMs: 180,
    // 切换动画时长(ms)。
    switchDurationMs: 120,
    // 遮罩背景透明度(0~1)。
    backdropOpacity: '0.9',
    // 是否预加载相邻图片(切换前预缓存)。
    preloadAdjacent: true,
    // 是否记忆上次浏览位置(刷新后仍从上次索引打开)。
    rememberPosition: false,
    // 是否在图片下方显示说明条(显示当前图片的 alt 文本)。
    showCaption: true,
    // 说明条最大显示行数(超出截断省略,1~3 推荐 2)。
    captionMaxLines: 2,
    // 灯箱打开/关闭过渡时长(ms,CSS transition-duration)。
    transitionDurationMs: 220
  },

  // ---------------------------------------------------------------------------
  // 2. 阅读进度条(顶部渐变条 + 点击跳转 + 跟随圆点)
  // ---------------------------------------------------------------------------
  readingProgress: {
    // 启用阅读进度条。
    enabled: true,
    // 是否只在文章页显示。false 时所有页面(含首页)均显示。
    articleOnly: true,
    // 是否支持点击跳转到相应位置。
    clickToJump: true,
    // 是否显示跟随小圆点(贴进度条底部)。
    showDot: true,
    // 圆点尺寸(px)。
    dotSize: '10px',
    // 进度条高度(px)。
    barHeight: '3px',
    // 是否使用渐变颜色(否则纯色)。
    useGradient: true,
    // 渐变起始色(变量名或色值;useGradient=true 有效)。
    gradientStart: 'var(--color-s)',
    // 渐变结束色(变量名或色值)。
    gradientEnd: 'var(--color-a)',
    // 点击后百分比提示的显示时长(ms)。
    tipDisplayMs: 500,
    // 记忆阅读位置:同一文章再次打开时恢复到上次滚动位置。
    rememberPosition: true,
    // 阅读位置最大记忆时长(小时;超时不再恢复)。
    rememberPositionMaxAgeHours: 72,
    // 滚动时实时更新节流间隔(ms)。
    updateThrottleMs: 30,
    // 是否通过 ARIA 播报进度(屏幕阅读器)。
    ariaAnnounce: true,
    // 进度条贴顶偏移(px)。
    topOffset: '0',
    // 进度条层叠顺序(z-index)。与其他浮层冲突时调大。
    zIndex: 1000,
    // 是否显示百分比提示气泡(跟随进度条的圆点下方)。
    showTip: true,
    // 进度条渐变结束色(CSS 色值或变量名)。
    progressColor: 'var(--color-a)'
  },

  // ---------------------------------------------------------------------------
  // 3. 返回顶部按钮(滚动后显示)
  // ---------------------------------------------------------------------------
  backToTop: {
    // 启用返回顶部按钮。
    enabled: true,
    // 滚动多少像素后显示按钮。
    showAfterPx: 400,
    // 距右边缘距离。
    rightOffset: '2rem',
    // 距底边距离。
    bottomOffset: '2rem',
    // 按钮尺寸(px)。
    size: '44px',
    // 滚动回顶部动画时长(ms)。
    scrollDurationMs: 450,
    // 是否平滑滚动。
    smoothScroll: true,
    // 键盘快捷键(空字符串=禁用)。
    hotkey: '' /* 例如 'page-up' */,
    // 无 JS 时的 HTML 锚点按钮(向后兼容)。
    htmlAnchorFallback: false,
    // 按钮层叠顺序(z-index)。与其他浮层冲突时调大。
    zIndex: 999
  },

  // ---------------------------------------------------------------------------
  // 4. 客户端全文搜索
  // ---------------------------------------------------------------------------
  search: {
    // 启用搜索(index/index 数据由导航配置 search.provider=local 控制)。
    enabled: true,
    // 在搜索框输入时达到多少字符才开始检索。
    minChars: 1,
    // 搜索结果数量上限。
    maxResults: 30,
    // 是否高亮命中词。
    highlightMatches: true,
    // 是否显示文章总数提示。
    showCount: true,
    // 搜索框占位文本。
    placeholder: '搜索...',
    // 无输入时的提示文本。
    emptyHint: '输入关键词开始搜索',
    // 无结果时提示文本。
    noResultText: '未找到匹配内容',
    // 结果命中截断长度(字符)。
    excerptLength: 120,
    // 是否包含正文全文(否则仅标题/摘要/标签)。
    includeContent: true,
    // 是否匹配标签。
    matchTags: true,
    // 是否匹配分类。
    matchCategories: true,
    // 匹配得分权重(标题/摘要/正文)。
    weightTitle: 5,
    weightExcerpt: 2,
    weightContent: 1,
    // 关闭方式:点击遮罩。
    closeOnOverlay: true,
    // 打开后是否自动聚焦输入框。
    focusOnOpen: true,
    // 打开动画方式。
    openAnimation: 'fade',
    // 是否支持拼音首字母匹配(实验)。
    pinyinFuzzy: false,
    // 输入防抖间隔(ms)。停止输入该时长后才执行检索,减少频繁重查。
    debounceMs: 120,
    // 聚焦输入框时是否自动显示搜索历史。
    showHistoryOnFocus: true,
    // 搜索历史最多保留条数(超出丢弃最旧)。
    maxHistory: 5
  },

  // ---------------------------------------------------------------------------
  // 5. 图片懒加载与表现
  // ---------------------------------------------------------------------------
  imageLazy: {
    // 启用原生 loading=lazy（加载时机由浏览器管理,无 JS 观察器,不提供自定义预取边距）。
    enabled: true,
    // 是否淡入显示。
    fadeIn: true,
    // 淡入时长(ms)。
    fadeInDurationMs: 300,
    // 图片占位背景色。
    placeholderColor: 'var(--color-hover)',
    // 加载中占位 class(配合 CSS 做淡入/占位)。
    loadingClass: 'img-loading',
    // 加载失败 class。
    errorClass: 'img-error',
    // 前 N 张图片立即加载(视口顶部),不做懒加载。
    eagerFirst: 3,
    // 是否保留 width/height 防止布局抖动。
    preserveAspectRatio: true,
    // 构建期生成 LQIP 模糊占位(内联 base64 背景;图片加载时先模糊后清晰,推荐)。
    lqip: true,
    // LQIP 缩略图宽度(px;8-64,越小体积越小)。
    lqipWidth: 24
  },

  // ---------------------------------------------------------------------------
  // 6. 代码块
  // ---------------------------------------------------------------------------
  codeBlock: {
    // 启用代码块整体增强(复制按钮/语言标签)。
    enabled: true,
    // 复制按钮显示方式:hover/always/never。
    copyButtonVisibility: 'hover',
    // 复制成功提示文本。
    copySuccessText: '已复制',
    // 复制失败提示文本。
    copyFailText: '复制失败',
    // 是否显示语言标签。
    showLanguageTag: true,
    // 是否显示 macOS 三圆点窗口栏(代码块顶部装饰栏)。
    windowBar: true,
    // 是否显示行号（Prism line-numbers 插件,本地 vendor;默认开启）。
    lineNumbers: true,
    // 长代码是否自动换行（true=软换行替代横向滚动;换行时行号由 Prism 插件按行高对齐,仍然显示）。
    wrapLongLines: false,
    // 代码块悬停时的背景提亮底色（与 code-bg 混合,混合力度见 tuning.code.hoverBgMix）。
    highlightBackground: 'var(--color-hover)',
    // 代码块圆角。
    borderRadius: '0.375rem',
    // 代码块最大高度(超出滚动)。
    maxHeight: '' /* 例如 '600px' 空=不限制 */,
    // 代码块容器最大高度(CSS 值,如 '60vh' 或 'none'=不限制)。同时作为
    // 长代码折叠的触发阈值(数字部分按行数计,如 '60vh' 视为 60 行)。
    maxHeightVh: 'none',
    // 代码块窗口栏(标题栏)高度(px)。
    headerHeight: '36px',
    // 代码块正文字号(em 相对单位)。
    fontSize: '0.92em',
    // 代码块上方"复制全部代码"按钮（多代码块页面适用;true=首块上方显示按钮,一键复制全页所有代码块）。
    copyAllButton: false,
    // 下载按钮。
    downloadButton: true
  },

  // ---------------------------------------------------------------------------
  // 7. 外部链接安全(白名单/弹窗)
  // ---------------------------------------------------------------------------
  externalLink: {
    // 启用外部链接警告弹窗(与 site.json5 的 externalLinkWarning.enabled 同时为 true 才生效)。
    enabled: true,
    // 白名单域名(精确匹配 hostname 或 hostname+pathname 前缀)。
    whitelist: [],
    // 黑名单域名(命中即直接拦截提示,不跳转)。
    blacklist: [],
    // 拦截模式:warn=弹窗确认/prohibit=直接禁止跳转/hint=仅提示不拦截。
    mode: 'warn',
    // 弹窗内显示的提示文本。
    message: '即将离开本站,前往外部链接：',
    // 确认按钮文本。
    confirmText: '继续访问',
    // 取消按钮文本。
    cancelText: '返回',
    // 是否显示完整 URL。
    showFullUrl: true,
    // 是否默认 target=_blank。
    openInNewTab: true,
    // 白名单链接是否也加 target。
    whitelistNewTab: false,
    // 联系/社交弹窗复制按钮文本。
    copyButtonText: '复制'
  },

  // ---------------------------------------------------------------------------
  // 8. 明暗主题切换
  // ---------------------------------------------------------------------------
  themeToggle: {
    // 启用明暗切换按钮(需 theme.json5 darkMode.enabled)。
    enabled: true,
    // 默认主题:light/dark/system。
    defaultTheme: 'system',
    // 是否记住用户选择(localStorage)。
    rememberChoice: true,
    // 切换动画时长(ms)。
    animationMs: 250,
    // 按钮图标:auto/sun-moon/toggle。
    iconStyle: 'sun-moon',
    // 切换时过渡所有元素(否则仅 body)。
    transitionAll: true,
    // 主题选择的 localStorage 键名。
    persistKey: 'ss-theme',
    // 切换时是否交替显示太阳/月亮图标。
    toggleIconSwap: true,
    // 切换按钮的 CSS z-index。
    zIndex: 100
  },

  // ---------------------------------------------------------------------------
  // 8b. 主题预设切换器
  // ---------------------------------------------------------------------------
  themePresets: {
    // 启用主题预设切换器(导航栏调色盘按钮,选择后即换色板,localStorage 记忆)。
    enabled: true,
    // 是否显示切换按钮(false 则隐藏按钮但保留已存选择)。
    pickerVisible: true,
    // 是否在 localStorage 记住用户选择。
    persistChoice: true,
    // 是否显示在导航栏(否则仅出现在设置页/其他入口)。
    showInNavbar: true,
    // 色卡悬停是否提示预设名。
    previewOnHover: true
  },

  // 8c. 主题定时切换
  // ---------------------------------------------------------------------------
  themeSchedule: {
    // 启用按时间自动切换明暗(默认关闭,避免无感改用户主题)。
    enabled: false,
    // 启动暗色模式的时刻(24h,HH:MM),如 22:00。
    darkFrom: '22:00',
    // 启动亮色模式的时刻(24h,HH:MM),如 06:00。
    lightFrom: '06:00',
    // 用户手动切换过主题后,当天不再自动覆盖(尊重用户选择)。
    respectManualOverride: true,
    // 到达时刻立即应用(否则延迟到下一次检查)。
    applyInstantly: true,
    // 检查周期(毫秒,默认 60000 = 每分钟)。
    checkIntervalMs: 60000,
    // 定时切换时给 html 加 theme-switching 类,300ms 过渡动画。
    smoothTransition: true
  },

  // ---------------------------------------------------------------------------
  // 9. 键盘快捷键
  // ---------------------------------------------------------------------------
  shortcuts: {
    // 启用全局快捷键。
    enabled: true,
    // 打开搜索。
    openSearch: '/',
    // 切换主题。
    toggleTheme: 'd',
    // 上一篇(文章页)。
    prevPost: 'k',
    // 下一篇(文章页)。
    nextPost: 'j',
    // 打开/关闭快捷键帮助。
    help: '?',
    // 关闭弹窗/抽屉(通用)。
    close: 'Escape',
    // 显示帮助提示按钮。
    showHelpHint: true,
    // 帮助面板标题。
    helpTitle: '快捷键一览',
    // 帮助面板是否显示。
    showHelpTable: true,
    // 输入框内按键是否生效。
    ignoreInInputs: true
  },

  // ---------------------------------------------------------------------------
  // 10. 文章目录(桌面端侧栏)
  // ---------------------------------------------------------------------------
  toc: {
    // 启用目录。
    enabled: true,
    // 目录级别范围(最小/最大标题层级)。
    minLevel: 2,
    maxLevel: 4,
    // 是否折叠子级。
    collapsible: true,
    // 默认展开层级。
    defaultOpenLevel: 2,
    // 高亮当前阅读章节。
    highlightActive: true,
    // 高亮滚动偏移(px)。
    activeOffset: 120,
    // 目录顶部显示阅读进度线(随滚动量增长)。
    progressLine: true,
    // 点击目录项时更新 URL 锚点(history.replaceState)。
    updateUrl: true,
    // 锚点跳转使用平滑滚动。
    smoothScroll: true,
    // 已读过的目录项淡色标记(visited)。
    visitedFade: true,
    // 分组折叠:点击二级目录项的箭头收起其下三级项(适合长文)。
    groupCollapse: true
    // 宽度见 theme.json5 tocWidth 相关
    ,
    // 目录侧栏标题文本(zh 语言)。
    titleText: '目录',
    // 目录侧栏标题文本(en 语言)。
    titleTextEn: 'Contents',
    // 是否显示标题行(整块隐藏,含折叠按钮)。
    showTitle: true,
    // 目录侧栏最大宽度(px)。
    maxWidthPx: 320
  },

  // ---------------------------------------------------------------------------
  // 10b. 阅读工具栏(文章页右下浮动)
  // ---------------------------------------------------------------------------
  readDock: {
    // 启用阅读工具栏(进度环 + 回到目录 + 返回顶部)。
    enabled: true,
    // 显示进度环(随阅读进度增长的圆环)。
    showProgressRing: true,
    // 显示回到目录按钮。
    showTocButton: true,
    // 显示返回顶部按钮。
    showTopButton: true,
    // 向下滚动时隐藏,向上滚动/到底时显示。
    hideOnScrollDown: true,
    // 位置:right(右下)。
    position: 'right'
  },
  // ---------------------------------------------------------------------------
  sidebarDrag: {
    // 启用侧栏 widget 拖拽排序。关闭后侧栏保持配置顺序不可拖。
    enabled: true,
    // 是否将排序结果持久化到 localStorage,刷新后保留。
    persistOrder: true,
    // 存储键,用于保存排序顺序。
    storageKey: 's-sidebarOrder',
    // 移动端是否支持长按拖拽(触屏)。桌面端默认支持 HTML5 drag。
    touchLongPress: true,
    // 桌面端是否仅在悬停时显示拖拽手柄(≡)。
    showHandleOnHover: true,
    // 本地存储解析失败时是否重置为配置默认顺序。
    resetOnLoadFail: true
  },

  // ---------------------------------------------------------------------------
  exportBackup: {
    // 导出备份命令 npm run export 的配置。
    enabled: true,
    // 是否将 media/assets/videos 媒体目录一并打包。
    includeMedia: true,
    // 是否将 11 个配置文件一并打包。
    includeConfig: true,
    // 导出目录(项目根下)。
    outputDir: 'exports',
    // 备份目录名前缀(时间戳自动追加,如 s-ynapse-backup-20260101-120000)。
    fileNamePrefix: 's-ynapse-backup'
  },

  // ---------------------------------------------------------------------------
  mediaAudit: {
    // npm run audit:media 媒体审计配置。
    enabled: true,
    // 报告引用的媒体文件缺失(文章引用但文件不存在)。
    reportMissed: true,
    // 报告未被任何文章引用的媒体文件(孤儿资源)。
    reportUnreferenced: true,
    // 是否报告重复条目(文件名相同大小相同)。
    reportDuplicate: false,
    // 输出方式:console(终端)或 json(导出 media-audit.json)。
    output: 'console'
  },

  // ---------------------------------------------------------------------------
  autoSummary: {
    // 文章未写 summary 时自动生成摘要。
    enabled: true,
    // 摘要最大字符数(中英混排)。
    maxLength: 160,
    // 回退策略:firstParagraph(取正文首段)。
    fallback: 'firstParagraph',
    // 是否剥离 Markdown 语法(链接/强调标记等)。
    stripMarkdown: true,
    // 截断时的省略号。
    ellipsis: '…'
  },

  // ---------------------------------------------------------------------------
  searchEnginePing: {
    // sitemap 生成后向搜索引擎发送 ping 通知。仅生产构建(CI 中 URL 公开)会执行。
    enabled: false,
    // 引擎列表:google/bing。
    engines: ['google'],
    // 是否仅在 production 构建时 ping(本地构建不改)。
    onlyProduction: true,
    // 每个请求超时(ms)。
    timeoutMs: 5000
  },

  // ---------------------------------------------------------------------------
  hreflang: {
    // 输出 hreflang 替代声明(SEO,i18n 界面双语)。
    enabled: true,
    // 是否包含自身语言条目(默认 zh 与 en 均输出)。
    includeSelf: true,
    // 是否同时输出 canonical 链接。
    canonical: true,
    // 是否输出 x-default 替代声明(指向默认语言版本;SEO 推荐开启)。
    xDefault: true
  },

  // ---------------------------------------------------------------------------
  schemaRich: {
    // schema.org 结构化数据完善(Article/Breadcrumb/Blog)。
    enabled: true,
    // 为文章页输出 BreadcrumbList 面包屑。
    breadcrumbs: true,
    // Article schema 增加 dateModified 字段。
    dateModified: true,
    // 首页输出 Blog 类型 schema。
    blogHomepage: true,
    // Article schema 增加作者主页 URL。
    authorUrl: true,
    // Article schema 增加正文字数(wordCount)。
    wordCount: true,
    // Article schema 增加预计阅读时长(timeRequired,PT{n}M)。
    timeRequired: true,
    // Article schema 增加关键词(keywords,来自标签)。
    keywords: true,
    // Article schema 增加所属栏目(articleSection,取首个分类)。
    articleSection: true,
    // Article schema 增加封面图(image,指向生成的 OG 图)。
    image: true
  },

  // ---------------------------------------------------------------------------
  ogImage: {
    // 构建时根据封面/文章标题生成 1200x630 OG 图。
    enabled: true,
    // 生成尺寸。
    width: 1200,
    height: 630,
    // 优先复用文章封面图/首图为基准。
    useCover: true,
    // 无封面时用站点色渐变+标题文字合成。
    gradientForNoCover: true,
    // 标题文字相对画布缩放。
    fontScale: 0.75,
    // 生成缓存目录。
    cacheDir: '.og-cache'
  },

  // ---------------------------------------------------------------------------
  hotSearches: {
    // 本地记录搜索词,搜索框下拉显示热门。
    enabled: true,
    // 显示条数。
    top: 5,
    // localStorage 存储键。
    storageKey: 's-hotSearches',
    // 是否在搜索下拉中展示。
    showInDropdown: true,
    // 是否提供清空按钮。
    showClear: true
  },

  // ---------------------------------------------------------------------------
  readingTime: {
    // 文章元信息显示预估阅读时长。
    enabled: true,
    // 中文每分钟字数参考。
    wordsPerMinuteCJK: 250,
    // 英文每分钟词数参考。
    wordsPerMinuteLatin: 200,
    // 是否在文章元信息栏显示。
    showInMeta: true,
    // 文案前缀/后缀。
    labelBefore: '',
    labelAfter: '阅读约需'
  },

  // ---------------------------------------------------------------------------
  codeCopy: {
    // 代码块复制按钮。
    enabled: true,
    // 按钮文案。
    buttonText: '复制',
    // 复制成功提示文案。
    copiedText: '已复制',
    // 复制成功后按钮恢复时间(ms)。
    buttonTimeout: 1500,
    // 是否显示行号。
    showLineNumbers: false,
    // 是否复用代码窗栏(主题切换器按钮共用)。
    includeWindowBar: true
  },

  // ---------------------------------------------------------------------------
  tocScrollSpy: {
    // TOC 滚动高亮当前章节(scrollspy)。
    enabled: true,
    // 激活章节的 CSS 类名。
    activeClass: 'current',
    // 监听偏移(px)。
    offset: 80,
    // 滚动处理节流(ms)。
    throttleMs: 60
  },

  // ---------------------------------------------------------------------------
  searchHighlight: {
    // 搜索结果关键词高亮。
    enabled: true,
    // 高亮 span 类名。
    markClass: 'search-hit',
    // 每篇结果最大高亮次数(防止长文爆量)。
    maxMatches: 20
  },

  // ---------------------------------------------------------------------------
  darkImageFilter: {
    // 深色模式下图片减亮滤镜。
    enabled: true,
    // 滤镜表达式。
    filter: 'brightness(0.85) saturate(0.9)',
    // 是否作用于 img。
    applyImages: true,
    // 是否作用于 video 封面。
    applyVideos: true
  },

  // ---------------------------------------------------------------------------
  listCover: {
    // 列表页文章卡片显示封面图。
    enabled: true,
    // 首页生效。
    showOnHome: true,
    // 归档页生效。
    showOnArchive: true,
    // 无封面时回退:none(纯文字卡片)。
    fallback: 'none',
    // 封面图宽高比。
    aspectRatio: '21/9',
    // 封面懒加载。
    lazy: true
  },

  // ---------------------------------------------------------------------------
  imageFallback: {
    // 图片加载失败时的回退处理。
    enabled: true,
    // 自定义回退图路径(空则用内联 SVG 占位)。
    fallbackImage: '',
    // 回退时是否显示 alt 文本。
    showAlt: true
  },

  // ---------------------------------------------------------------------------
  mobileBottomNav: {
    // 移动端底部导航栏(仅小屏显示)。桌面不受影响。
    enabled: true,
    // 按钮顺序:home/archive/search/theme。
    items: ['home', 'archive', 'search', 'theme'],
    // 是否仅移动端显示。
    onlyMobile: true,
    // 是否适配 iOS 安全区(safe-area-inset-bottom)。
    useSafeArea: true
  },

  // ---------------------------------------------------------------------------
  incrementalBuild: {
    // 增量构建:源文件未变化时跳过页面重渲染。
    enabled: true,
    // 指纹缓存目录。
    cacheDir: '.build-cache',
    // 强制全量构建的参数。
    fullFlag: '--full',
    // 是否允许 --watch 时增量。
    watch: true,
    // 指纹算法。
    fingerprintHash: 'sha1',
    // 指纹一致时跳过该页。
    skipUnchanged: true
  },

  // ---------------------------------------------------------------------------
  customCSS: {
    // 注入自定义 CSS,无需修改模板即可定制外观。
    enabled: true,
    // CSS 片段数组,每段为一个字符串(允许注释),构建时合并到 </body> 前 <style>。
    // 示例: '.site-header{letter-spacing:0.01em}'  —— 移除此行即不注入任何内容。
    css: ['blockquote{border-left-color: var(--color-accent)}'],
    // 注入位置:before-closing-body。
    target: 'before-closing-body'
  },

  // ---------------------------------------------------------------------------
  // 11. 移动端目录抽屉
  // ---------------------------------------------------------------------------
  mobileToc: {
    // 启用移动端目录抽屉按钮。
    enabled: true,
    // 抽屉圆角。
    borderRadius: '1rem',
    // 抽屉最大高度(视口百分比)。
    maxHeightVh: '70',
    // 点击链接后是否自动关闭抽屉。
    autoClose: true,
    // 点击遮罩是否关闭。
    overlayClose: true,
    // 抽屉打开时锁定背景滚动。
    lockScroll: true,
    // 按钮位置:bottom-right/bottom-left。
    position: 'right',
    // 胶囊按钮显示当前章节名与阅读进度百分比。
    showCurrent: true
  },

  // ---------------------------------------------------------------------------
  // 12.5 阅读模式(文章页专注模式)
  // ---------------------------------------------------------------------------
  readMode: {
    // 启用阅读模式按钮。
    enabled: true,
    // 是否记住上次状态(localStorage)。
    persist: true,
    // 按钮文本。
    label: '阅读模式',
    // 进入阅读模式后隐藏侧栏/目录(仅保留正文)。
    focusOnlyContent: true,
    // 字号倍率(1=正常)。
    fontScale: 1
  },

  // ---------------------------------------------------------------------------
  // 12. 阅读设置面板(字号/行高/宽度)
  // ---------------------------------------------------------------------------
  readingPanel: {    // 启用阅读设置齿轮。
    enabled: true,
    // 字号范围(最小/最大 px)。
    fontSizeMin: 15,
    fontSizeMax: 26,
    fontSizeStep: 1,
    // 默认字号(px)。
    fontSizeDefault: 19,
    // 行高范围(最小/最大 倍)。
    lineHeightMin: 1.4,
    lineHeightMax: 2.6,
    lineHeightStep: 0.1,
    lineHeightDefault: 1.9,
    // 最大内容宽度范围(px)。
    widthMin: 560,
    widthMax: 1200,
    widthStep: 40,
    widthDefault: 800,
    // 是否记住阅读设置。
    remember: true,
    // 存储键名。
    storageKey: 'readerPrefs',
    // 阅读设置持久化键(字号/行高/宽度的 localStorage 键名)。
    persistKey: 'ss-reading',
    // 是否显示"重置"按钮(点击恢复默认值并清除本地存储)。
    showReset: true,
    // 重置按钮文本。
    resetText: '重置',
    // 面板开关按钮位置:bottom-right/bottom-left。
    position: 'right'
  },

  // ---------------------------------------------------------------------------
  // 13. 语音朗读(TTS)
  // ---------------------------------------------------------------------------
  tts: {
    // 启用朗读按钮(文章页)。
    enabled: true,
    // 朗读语速(0.1~10,1=正常)。
    rate: 0.5,
    // 音调。
    pitch: 1,
    // 音量。
    volume: 1,
    // 是否使用系统首选语音。
    preferDefaultVoice: true,
    // 语音选择依据:auto/lang。
    voiceBy: 'lang',
    // 朗读区域选择器。
    readSelector: '.post-content',
    // 按钮图标:speaker/book。
    icon: 'speaker',
    // 是否高亮正在朗读段落(实验性)。
    highlightParagraph: false,
    // 朗读时逐句高亮当前句子(需浏览器支持 utterance boundary 事件)。
    highlightReading: true,
    // 高亮句子的 CSS 类名(可在 customCSS 中自定义样式)。
    highlightClass: 'tts-highlight',
    // 朗读文本提取时跳过的选择器(逗号分隔,默认跳过代码块/公式/图表)。
    skipSelectors: 'pre, .katex, .mermaid',
    // 阅读按钮位置:toolbar/float。
    position: 'toolbar'
  },

  // ---------------------------------------------------------------------------
  // 14. 双向链接(Wiki Links)
  // ---------------------------------------------------------------------------
  wikiLinks: {
    // 启用双链解析。
    enabled: true,
    // 未知目标显示方式:text(纯文本)/link(死链可点)/hide(隐藏)。
    unknownMode: 'text',
    // 未知目标附加后缀文本(例如 ⚠)。
    unknownSuffix: '',
    // 站内链接是否新页打开。
    openNewTab: false,
    // 是否忽略大小写匹配标题。
    caseInsensitive: true,
    // 自定义文本优先级:使用标签可覆盖。
    allowCustomLabel: true
  },

  // ---------------------------------------------------------------------------
  // 15. 上下标语法(^x^ / ~x~)
  // ---------------------------------------------------------------------------
  supSub: {
    // 启用 ^x^ 与 ~x~ 语法。
    enabled: true,
    // 上标字符标记。
    supMarker: '^',
    // 下标字符标记。
    subMarker: '~',
    // 冲突检测:在 $...$ 公式内自动跳过(需开启)。
    skipInsideMath: false,
    // 包裹不匹配时是否保留原样。
    preserveUnmatched: true
  },

  // ---------------------------------------------------------------------------
  // 16. 数学公式(KaTeX,按需 CDN)
  // ---------------------------------------------------------------------------
  math: {
    // 启用数学公式渲染(KaTeX,按需加载)。
    enabled: true,
    // 自动检测 $..$ / $$..$$ 公式并按需加载 KaTeX。
    autoDetect: true,
    // CDN 版本。
    version: '0.16.22',
    // 行内定界符。
    inlineDelimiters: ['$'],
    // 块级定界符。
    blockDelimiters: ['$$'],
    // 渲染错误时不抛出。
    throwOnError: false,
    // KaTeX strict 模式(false 静默 / warn / error)。
    strict: false,
    // 是否渲染 \\( \\) 定界符(mathGuard 保护,默认开)。
    renderRoundParens: true,
    // 是否渲染 \[ \] 定界符(mathGuard 保护,默认开)。
    renderSquareBrackets: true,
    // 公式区域选择器。
    selector: '.post-content',
    // 是否包含浏览器原生 MathML 输出。
    mathml: true
  },

  // ---------------------------------------------------------------------------
  // 17. Mermaid 图表(按需 CDN)
  // ---------------------------------------------------------------------------
  mermaid: {
    // 启用 Mermaid 图表渲染。
    enabled: true,
    // 自动检测 ```mermaid 代码块并按需加载 Mermaid。
    autoDetect: true,
    // CDN 版本。
    version: '11.4.1',
    // 渲染主题:default/dark/neutral/base 或跟随站点主题。
    followTheme: true,
    // 明色主题名。
    lightTheme: 'default',
    // 暗色主题名。
    darkTheme: 'dark',
    // 安全级别:strict/loose。
    securityLevel: 'strict',
    // 是否显示流程图内文本的复制按钮。
    copyAfterRender: false,
    // 渲染失败占位文本。
    errorText: '[图表渲染失败]'
  },

  // ---------------------------------------------------------------------------
  // 18. 系列文章
  // ---------------------------------------------------------------------------
  series: {
    // 启用系列功能。
    enabled: true,
    // 文章卡片显示系列徽标。
    showBadge: true,
    // 徽标文本模板:{name} 系列名。
    badgeFormat: '系列 · {name}',
    // 文章底部显示系列导航面板。
    showNavPanel: true,
    // 侧栏系列 widget(与 sidebar.json5 widgets 联动)。
    sidebarWidget: true,
    // 系列排序:asc(时间旧→新)/desc。
    order: 'asc',
    // 导航面板标题模板。
    panelTitle: '本系列共 {total} 篇',
    // 系列文章前缀(自动标注,如 '第 1/3 篇')。
    showPosition: true,
    // 无另外参数
    defaultWidgetCount: 8,
    // 系列导航上一页按钮文本。
    prevLabel: '上一篇',
    // 系列导航下一页按钮文本。
    nextLabel: '下一篇',
    // 进度文本模板:{index} 当前篇数,{total} 总篇数。
    progressLabel: '{index} / {total}',
    // 侧栏系列 widget 标题(sidebar.json5 中 w.title 为空时使用)。
    sidebarTitle: '系列'
  },

  // ---------------------------------------------------------------------------
  // 19. 关联推荐
  // ---------------------------------------------------------------------------
  related: {
    // 启用关联推荐区块。
    enabled: true,
    // 推荐数。
    topN: 4,
    // 同分类权重。
    sameCategoryWeight: 2,
    // 同标签权重。
    sameTagWeight: 3,
    // 最小得分(低于此不重复展示)。
    minScore: 2,
    // 是否排除当前文章。
    excludeCurrent: true,
    // 推荐区标题。
    title: '相关推荐',
    // 相关文章卡片是否显示摘要。
    showExcerpt: true,
    // 摘要截断长度(字符)。
    excerptLength: 80,
    // 卡片是否显示共享标签数徽章。
    showCount: false
  },

  // ---------------------------------------------------------------------------
  // 20. 置顶文章
  // ---------------------------------------------------------------------------
  pinned: {
    // 启用置顶。
    enabled: true,
    // 置顶徽标文本。
    badgeText: '置顶',
    // 置顶徽标样式:pill/corner/none。
    badgeStyle: 'pill',
    // 置顶排序规则:pinned-first(置顶前)/normal(仅标记不重排)。
    sortRule: 'pinned-first'
  },

  // ---------------------------------------------------------------------------
  // 21. 字数统计与阅读时间
  // ---------------------------------------------------------------------------
  wordCount: {
    // 启用字数统计。
    enabled: true,
    // 卡片显示字数。
    onCards: true,
    // 文章正文尾部显示字数。
    inArticle: true,
    // 文本模板:{count} 字数。
    textFormat: '{count} 字',
    // 阅读时长文本:{minutes} 分钟。
    readTimeFormat: '{minutes} 分钟阅读',
    // 每分钟阅读字数(中文字数计算基准)。
    wpm: 265,
    // 中文英文字数合并统计视读方式。
    countCjkChars: true,
    // 是否统计数字。
    countDigits: false
  },

  // ---------------------------------------------------------------------------
  // 22. 分享按钮
  // ---------------------------------------------------------------------------
  share: {
    // 启用分享工具条。
    enabled: true,
    // 平台顺序:weibo/qq/wechat/x/facebook/mail/copy,缺省全部:
    order: ['weibo', 'qq', 'wechat', 'x', 'facebook', 'mail', 'copy'],
    // 坐标位置:toolbar(文章尾部)/floating(悬浮)。
    position: 'toolbar',
    // 弹窗宽/高(px)。
    popupWidth: 640,
    popupHeight: 520,
    // 微信复制文案模板:{title}/{url}。
    wechatText: '{title} 分享自 {url}',
    // 复制成功提示文本。
    copiedText: '链接已复制',
    // 提示显示时长(ms)。
    copiedShowMs: 2500,
    // 是否显示分享标题。
    showLabel: false,
    // 工具条标题。
    label: '分享文章',
    // 浏览器支持 navigator.share 时优先使用系统原生分享面板。
    useNativeShare: false,
    // 剪贴板 API 不可用时用 textarea 回退复制。
    copyFallback: true
  },

  // ---------------------------------------------------------------------------
  // 23. 打赏
  // ---------------------------------------------------------------------------
  reward: {
    // 启用打赏(同时需 site.json5 reward.enabled,以本开关为准)。
    enabled: false,
    // 打赏按钮文本。
    buttonText: '打赏',
    // 打赏提示文本(图片下方)。
    note: '感谢支持',
    // 弹窗标题。
    popupTitle: '打赏支持',
    // 弹窗关闭方式:按钮/遮罩/esc。
    closeByBtn: true,
    closeByOverlay: true,
    closeByEsc: true,
    // 二维码尺寸(px)。
    qrSize: '180px',
    // 弹窗最大宽度。
    maxWidth: '560px',
    // 是否显示打赏说明文字(图片下方 note)。
    showNote: true,
    // 二维码图片最大宽度 CSS。
    qrMaxWidth: '180px',
    // 弹窗关闭按钮文本。
    closeText: '关闭',
    // 赞助平台链接(显示于打赏弹窗底部;如 GitHub Sponsors / Ko-fi / 爱发电)。
    // 每项格式: { label: '显示名', url: 'https://...' }; label 可省略(用 url 代替)。
    links: []
  },

  // ---------------------------------------------------------------------------
  // 24. 图库页
  // ---------------------------------------------------------------------------
  gallery: {
    // 启用 /gallery/ 图库页。
    enabled: true,
    // 页面标题。
    title: '图库',
    // 描述文本。
    description: '站内图片集，点击查看大图。',
    // 空图库提示。
    emptyText: '暂无图片',
    // 瀑布流列数。
    columns: 4,
    // 列最小宽度(minmax 下界)。
    columnMin: '220px',
    // 卡片是否显示来源文章名。
    showSource: true,
    // 是否收集文章封面图。
    collectFeatured: true,
    // 收集排序:newest/longest。
    order: 'newest',
    // 是否包含 404 前后的图(增量,始终 true)。
    incrementalByDefault: true,
    // 单页图片数上限(0=不限)。
    maxItems: 0,
    // 瀑布流列间距 CSS(column-gap)。
    gap: '12px',
    // 图片下方是否显示来源说明。
    showCaption: true,
    // 卡片圆角 CSS。
    borderRadius: '8px'
  },

  // ---------------------------------------------------------------------------
  // 24b. OG 封面图生成样式
  // ---------------------------------------------------------------------------
  ogImageStyle: {
    // 启用自动 OG 封面图(文章无 featuredImage 时生成)。
    enabled: true,
    // 封面模板: aurora(渐变极光)/mesh(光斑星云)/grid(科技栅格)/paper(纸感浅底)/duotone(双色对角)。
    template: 'aurora',
    // 配色来源: theme(站点主/辅色)/hash(按文章首个分类哈希出色,同分类同色)。
    palette: 'theme',
    // 是否在封面显示分类角标(取文章 categories 第一项)。
    showCategory: true,
    // 标题对齐:center(居中排版)/left(左侧排版)。
    align: 'center',
    // 是否在封面底部显示站点名。
    showSite: true,
    // 是否使用彩色渐变背景(否则纯色)。
    useGradient: true,
    // 渐变角度(deg 字符串,CSS 语法)。
    gradientAngle: '135deg',
    // 基础字号(px,超大字号,标题换行后按比例压缩)。
    fontSizeBase: 64,
    // 标题最多行数,超过自动压缩字号,再超则省略号截断。
    maxLines: 4,
    // 标题字距。
    letterSpacing: '0.02em'
  },

  // ---------------------------------------------------------------------------
  // 25. 归档热力图
  // ---------------------------------------------------------------------------
  heatmap: {
    // 启用归档页年历热力图。
    enabled: true,
    // 热力层级数(2~7)。
    levels: 5,
    // 层数配色模式:auto(按最大月文章数分级)/fixed(自定义色表)。
    scaling: 'auto',
    // 自定义色表(从低到高,仅 scaling=fixed 有效,可为 CSS 颜色数组)。
    palette: [],
    // 是否显示图例(少→多)。
    showLegend: true,
    // 图例文字。
    legendLow: '少',
    legendHigh: '多',
    // 悬停提示模板:{year}-{month}: {count} 篇。
    tooltipFormat: '{year}-{month}: {count} 篇',
    // 是否显示每月数字。
    showMonthNumbers: true,
    // 单元格间距(px,热力图 12 列之间的 gap)。
    gap: '3px',
    // 单元格圆角(px)。
    borderRadius: '3px',
    // 单元格尺寸(px,固定后热力图按此尺寸紧凑排列;置空则撑满容器)。
    cellSize: '13px',
    // 空月份(无文章)单元格颜色。
    emptyColor: 'var(--color-border)'
  },

  // ---------------------------------------------------------------------------
  // 26. 站点统计
  // ---------------------------------------------------------------------------
  stats: {
    // 启用站点统计。
    enabled: true,
    // 归档页显示统计卡片。
    showArchiveCards: true,
    // 统计标签文案(顺序:文章/天数/字数/日均/标签/分类)。
    labelPosts: '文章总数',
    labelDays: '发文天数',
    labelWords: '总字数',
    labelAvg: '日均篇数',
    // 归档页日均标签(archive 统计卡专用)。
    labelAvgPerDay: '日均',
    labelTags: '标签数',
    labelCategories: '分类数',
    // 统计卡网格列模式(auto-fit 自适应列数;也可填固定列数如 3)。
    cardColumns: 'auto-fit',
    // 侧栏统计 widget 总开关(sidebar.json5 需含 type=stats 的 widget)。
    showSidebar: true,
    // 卡片点击跳转(空=不跳)。
    linkArchive: '/archive/'
  },

  // ---------------------------------------------------------------------------
  // 27. 上一篇/下一篇导航
  // ---------------------------------------------------------------------------
  prevNext: {
    // 启用文章页上下篇导航。
    enabled: true,
    // 显示标签。
    showLabels: true,
    // 标签模板:
    prevLabel: '上一篇',
    nextLabel: '下一篇',
    // 无邻篇时是否隐藏整块。
    hideWhenMissing: false,
    // 导航卡是否显示缩略图(需文章 featuredImage)。
    showThumbnail: false,
    // 标签文字位置:left/center/right。
    labelPosition: 'left',
    // 点击导航后是否滚回页面顶部。
    scrollToTopOnClick: true
  },

  // ---------------------------------------------------------------------------
  // 28. 订阅(RSS + JSON Feed)
  // ---------------------------------------------------------------------------
  feed: {
    // 启用 RSS(总开关,与 site.json5 rss.enabled 等价)。
    rssEnabled: true,
    // RSS 输出路径。
    rssPath: '/feed.xml',
    // RSS 是否输出全文。
    rssFullContent: true,
    // RSS 条目上限。
    rssMaxItems: 50,
    // JSON Feed 输出路径。
    jsonFeedPath: '/feed.json',
    // JSON Feed 是否输出全文。
    jsonFeedFullContent: false,
    // JSON Feed 条目上限。
    jsonFeedMaxItems: 20,
    // 是否在 <head> 输出 RSS 链接。
    injectHeadLinks: true,
    // 是否在页脚输出订阅链接(需 footer.json5 调整)。
    injectFooterLink: false
  },

  // ---------------------------------------------------------------------------
  // 29. 云统计(Cloudflare Web Analytics)
  // ---------------------------------------------------------------------------
  analytics: {
    // 启用 CF Web Analytics(需设置 token 或环境变量 CF_WEB_ANALYTICS_TOKEN)。
    enabled: true,
    // 脚本 CDN 地址。
    scriptSrc: 'https://static.cloudflareinsights.com/beacon.min.js',
    // 输出位置:end-of-body/head。
    injectAt: 'body',
    // 是否输出 data-cf-beacon JSON。
    emitBeacon: true,
    // 站点标签(可选显示)。
    siteTag: ''
  },

  // ---------------------------------------------------------------------------
  // 30. 重定向
  // ---------------------------------------------------------------------------
  redirects: {
    // 启用重定向系统(规则来自 site.json5 redirects 数组)。
    enabled: false,
    // 生成 CF Pages _redirects 文件。
    generatePagesFile: true,
    // 本地 serve 是否应用重定向。
    applyInServe: true,
    // 非法规则处理:warn-only/abort。
    invalidRule: 'abort'
  },

  // ---------------------------------------------------------------------------
  // 31. 维护模式
  // ---------------------------------------------------------------------------
  maintenance: {
    // 本地 serve 参数 --maintenance 生效;生产由 Worker 环境变量 MAINTENANCE=1。
    enabled: false,
    // 维护提示消息。
    message: '站点维护中，请稍后再来。',
    // 返回的 HTTP 状态。
    status: 503,
    // 是否设置 Retry-After。
    setRetryAfter: true,
    // Retry-After 秒数。
    retryAfter: 3600
  },

  // ---------------------------------------------------------------------------
  // 32. 移动端优化
  // ---------------------------------------------------------------------------
  mobile: {
    // 启用移动端交互优化(抽屉关闭等)。
    enabled: true,
    // 移动端搜索是否改为全屏。
    searchFullscreen: true,
    // 移动端目录按钮与返回顶部间距(px)。
    buttonStackGap: '4rem',
    // 触摸屏悬停菜单自动展开。
    touchFallback: true,
    // 移动端代码块横向滚动提示。
    codeScrollHint: true,
    // 移动端 TOC 按钮断点(px,≤ 该宽度显示按钮)。
    tocBreakpoint: 900,
    // 底部导航底部安全区留白(适配 iPhone 底部横条)。
    safeAreaBottom: true,
    // 是否保留移动端点击高亮(false = 取消高亮)。
    tapHighlight: false
  },

  // ---------------------------------------------------------------------------
  // 33. 评论(前端渲染行为)
  // ---------------------------------------------------------------------------
  comments: {
    // 启用评论负载(建议同时配置 site.json5 comments)。
    enabled: true,
    // 是否在文章页加载评论容器。
    loadContainer: true,
    // 服务器端渲染占位(若 provider 为静态)。
    renderPlaceholder: true,
    // 占位加载文本。
    placeholderText: '评论加载中…',
    // 占位显示时长(ms,过后若无评论组件则显示 emptyText)。
    loadDelayMs: 300,
    // 无评论提示(延迟结束后仍未加载出组件时显示)。
    emptyText: '暂无评论',
    // 评论容器标题。
    title: '评论'
  },

  // ---------------------------------------------------------------------------
  // 34. 联系方式弹窗
  // ---------------------------------------------------------------------------
  contactPopup: {
    // 启用社交联系方式弹窗(点击社交图标复制)。
    enabled: true,
    // 弹窗标题。
    title: '联系方式',
    // 复制按钮文本。
    copyText: '复制',
    // 复制成功提示(留空则用内置双语文案 toolbar.copyDoneToast)。
    copySuccessText: '',
    // 弹窗宽度(px)。
    popupWidth: '360px',
    // 显示社交项(CG 配置社交链接中带弹窗样式)。
    showAllItems: true,
    // 弹窗顶部是否显示图标。
    showIcon: true,
    // 弹窗内最多显示的联系方式条目数(多行值按行截断)。
    maxItems: 4
  },

  // ---------------------------------------------------------------------------
  // 35. 外链警告(白名单已黑名单复合)
  // ---------------------------------------------------------------------------
  // 注: externalLink 已覆盖,以下为扩展行为
  linkBehavior: {
    // 域名白名单自动识别(匹配 hostname 或 hostname+path)。
    matchMode: 'hostname',
    // 忽略站内相对链接。
    skipInternal: true,
    // 邮箱块 mailto 处理:leave/confirm。
    mailtoMode: 'leave',
    // 二维码批量匹配(未来)。
    lateTargeted: false
  },

  // ---------------------------------------------------------------------------
  // 36. 性能预算
  // ---------------------------------------------------------------------------
  performance: {
    // 首页 JS 体量上限警告(kB)。
    warningJsKb: 80,
    // 首页 HTML 体量上限警告(kB)。
    warningHtmlKb: 400,
    // 图片未压缩告警阈值(kB)。
    warningImageKb: 300,
    // 构建耗时阈值(ms)超时给出提示。
    warningBuildMs: 30000
  },

  // ---------------------------------------------------------------------------
  // 37. 开发助手
  // ---------------------------------------------------------------------------
  debug: {
    // 输出构建明细日志。
    verbose: false,
    // 输出渲染页面列表。
    listPages: false,
    // 输出配置中心(校验合并结果)。
    dumpConfig: false
  },

  // ---------------------------------------------------------------------------
  // 38. 首页 Hero 区域
  // ---------------------------------------------------------------------------
  // 与 site.json5 → hero 配合;hero.enabled(站点级)=false 时整块不显示。
  hero: {
    // 是否启用 Hero 区域(更高层控制,站点级 hero.enabled 优先)。
    enabled: true,
    // 显示搜索按钮。
    showSearch: true,
    // 显示「查看全部文章」按钮。
    showCta: true,
    // 显示热门标签。
    showTags: true,
    // CTA 按钮文字。
    ctaLabel: '查看全部文章',
    // CTA 按钮跳转(#latest-post = 吸顶到文章列表)。
    ctaUrl: '#latest-post',
    // 热门标签显示数量(1~20)。
    tagCount: 8,
    // 搜索按钮占位文字。
    searchPlaceholder: '搜索文章…',
    // Hero 是否显示日期(最新文章日期)。
    showDate: false,
    // en 语言 CTA 按钮文字。
    ctaLabelEn: 'View all posts',
    // Hero 最小高度(vh,内容垂直居中)。
    heightVh: 61.8,
    // Hero 背景图 URL(空则使用纯色/渐变背景)。
    backgroundImage: ''
  },

  // ---------------------------------------------------------------------------
  // 39. 背景粒子特效
  // ---------------------------------------------------------------------------
  // 与 theme.json5 → background.mode = "particles" 配合;mode 非 particles 时
  // 本模块不生效(即使 enabled=true)。颜色自动跟随主题辅助色(--color-s)。
  background: {
    particles: {
      // 是否启用粒子动画(仅 background.mode=particles 时生效)。
      enabled: true,
      // 粒子数量(10~120,越少越省电)。
      count: 72,
      // 粒子运动速度(0.2~2,越大动感越强)。
      speed: 0.5,
      // 粒子连线距离(px),超过此距离不连线。
      linkDistance: 120,
      // 粒子不透明度(0~1)。
      opacity: 0.7,
      // 是否绘制粒子间连线。
      showLines: true,
      // 触屏设备/窄屏(<640px)自动关闭粒子(性能保护)。
      autoDisableMobile: false
    }
  },

  // 40. 界面动效(批C)
  // ---------------------------------------------------------------------------
  // 控制全站微交互动画:卡片悬停上浮、链接下划线滑动、按钮涟漪、滚动渐入。
  // 所有动效尊重 users prefers-reduced-motion(系统减弱动效时自动全部关闭)。
  motion: {
    // 总开关:false 时本模块全部不生效。
    enabled: true,
    // 卡片悬停缩放倍数(1=不缩放)。
    cardHoverScale: 1.02,
    // 链接下划线相对文字的偏移(px)。
    linkUnderlineOffset: '3px',
    // 卡片悬停上浮(首页/分类/标签的文章卡片)。
    cardHoverLift: true,
    // 悬停上浮距离(px,2~8)。
    cardHoverLiftPx: 4,
    // 链接下划线滑入效果(正文/导航/卡片标题等链接)。
    linkUnderline: true,
    // 下划线粗细。
    linkUnderlineThickness: '2px',
    // 按钮点击涟漪(btn/分享/播放等按钮)。
    buttonRipple: true,
    // 涟漪扩散时长(ms,300~800)。
    rippleDurationMs: 500,
    // 滚动渐入(元素进入视口时淡入上滑)。
    scrollReveal: true,
    // 滚动渐入:文章卡片。
    revealCards: true,
    // 滚动渐入:文章页面 h2/h3 标题。
    revealHeadings: true,
    // 滚动渐入:文章/卡片内图片。
    revealImages: true,
    // 滚动渐入:文章内代码块与引用块。
    revealBlocks: false,
    // 渐入总时长(ms)。
    revealDurationMs: 250,
    // 同屏多个元素连续渐入时相邻延迟(ms)。
    revealDelayMs: 0,
    // 同屏元素错峰总时间上限(ms),超过不再累加,避免长页面等待过久。
    revealStaggerMax: 80,
    // 渐入起点位移(px)。
    revealOffset: '10px',
    // 每个元素只渐入一次(滚动回顶不重复)。
    revealOnce: true,
    // 进入视口阈值(0~1,值越小越早触发)。
    revealThreshold: 0.08,
    // 系统"减少动态效果"下的动画策略: light(轻量版:更短、幅度更小,推荐) / off(完全关闭) / full(始终完整)。
    reducedMotion: 'light'
  },
  // ---------------------------------------------------------------------------
  dailyQuote: {
    // 开启每日一言(侧栏 widget + 文章页引用)。
    enabled: true,
    // 数据显示于侧栏还是正文顶部,若为 false 则显示在文章内容开头。
    widgetStyle: 'sidebar',
    // 题目标签。
    label: '每日一言',
    // 数据源:内置 quotes.json5 或自定义 JSON。
    source: 'builtin',
    // 引用数量(循环轮换)。
    count: 7,
    // 文本颜色(空则继承)。
    quoteColor: ''
  },
  // ---------------------------------------------------------------------------
  favorites: {
    // 开启收藏按钮(文章页) + /favorites 收藏页。
    enabled: true,
    // 显示在 post 末尾(工具栏)还是 meta 行。
    position: 'toolbar',
    // 存储键。
    storageKey: 's-favorites',
    // 按钮标签。
    label: '收藏',
    // 文章列表是否显示右侧收藏 icon。
    listIcon: true,
    // 未收藏状态文案。
    notText: '收藏',
    // 已收藏状态文案。
    favedText: '已收藏'
  },
  // ---------------------------------------------------------------------------
  prismTheme: {
    // 代码高亮配色总开关（false = 代码块不着色）。
    // 配色值定义在 theme.json5 的 codeHighlight.palette，浅色/暗色两套随主题自动切换。
    enabled: true
  },
  // ---------------------------------------------------------------------------
  cover: {
    // 开启封面样式库。
    enabled: true,
    // 可选样式集合。
    patterns: ['gradient', 'stripes', 'dots', 'blob', 'mesh'],
    // 首篇文章默认 pattern。
    defaultPattern: 'gradient',
    // 在线预览(悬浮缩略图)。
    preview: true,
    // 图片链接若存在是否优先使用(否则用 pattern 合成)。
    preferImage: true
  },
  // ---------------------------------------------------------------------------
  i18n: {
    // 开启界面双语(内置 strings)。
    enabled: true,
    // 默认语言。
    defaultLanguage: 'zh',
    // 支持语言。
    languages: ['zh', 'en'],
    // 切换按钮是否置于导航。
    navToggle: true,
    // 文章页显示翻译互链提示(若另一语言存在同 slug 文章;关闭则隐藏提示)。
    translationNotice: true
  },
  // ---------------------------------------------------------------------------
  pagefind: {
    // 开启基于 Pagefind 的全文搜索(静态搜索, 无后端)。
    enabled: true,
    // index 目录。
    indexPath: '/pagefind',
    // 是否集成到现有 search 覆盖层。
    integrate: true
  },
  // ---------------------------------------------------------------------------
  giscus: {
    // 开启 Giscus 评论。
    enabled: false,
    // 建议关闭, 如需启用请配置 repo/repoId 等。
    repo: '',
    repoId: '',
    category: 'Announcements',
    categoryId: '',
    mapping: 'title',
    theme: 'preferred_color_scheme',
    loading: 'lazy',
    crossorigin: 'anonymous'
  },
  // ---------------------------------------------------------------------------
  sitemap: {
    // sitemap 是否按类型细分(文章/标签/分类/页面)。
    // 数据类型: 布尔值。取值: true=启用; false=不启用(仍生成普通单一 sitemap)。
    // split=true 且 URL 总数超过 maxUrlsPerFile 时自动拆分为多个 sitemap-{n}.xml + 一个 sitemap.xml 作为 sitemapindex(索引入口)。
    // 拆分后 URL 数量低于阈值则生成单一 <urlset> sitemap.xml。
    split: true,
    // 文章(文章页)URL 的搜索引擎优先权。
    // 数据类型: 字符串。取值: '0.0' 至 '1.0', 建议文章用 '0.7'-'1.0'(重要权重)。
    postPriority: '0.8',
    // 独立页面URL(首页/归档/相册/收藏等)的搜索引擎优先权。
    // 数据类型: 字符串。取值: '0.0' 至 '1.0', 建议页面用 '0.5'-'0.8'。
    pagePriority: '0.6',
    // 标签页URL 的搜索引擎优先权。
    // 数据类型: 字符串。取值: '0.0' 至 '1.0', 建议标签用 '0.3'-'0.6'(次要权重)。
    tagPriority: '0.4',
    // 文章页 URL 的更新频率提示(sitemap 协议标准值)。
    // 数据类型: 字符串。可填值: always / hourly / daily / weekly / monthly / yearly / never。
    // 建议: 博客文章 weekly; 新闻 always; 静态文档 yearly。
    postFrequency: 'weekly',
    // 独立页面URL 的更新频率提示。
    // 数据类型: 字符串。可填值: always / hourly / daily / weekly / monthly / yearly / never。
    // 建议: 首页与归档页 weekly 或 monthly。
    pageFrequency: 'monthly',
    // 标签页URL 的更新频率提示。
    // 数据类型: 字符串。可填值: always / hourly / daily / weekly / monthly / yearly / never。
    // 建议: 标签页 monthly 或 yearly。
    tagFrequency: 'monthly',
    // 拆分阈值:每个 sitemap 文件最多包含的 URL 数。URL 总数超过该值则拆分为多个文件。
    // 数据类型: 正整数。默认 500。可填值: 最小 10(低于会强制为 10), 最大建议不超过 50000(协议上限)。
    // 推荐: 小站点 500-1000; 大站点 5000(每个文件不超过 50000 条)。
    maxUrlsPerFile: 500
  },

  // ---------------------------------------------------------------------------
  // 41. 滚动行为(平滑滚动 / 锚点偏移 / reduced-motion 降级)
  // ---------------------------------------------------------------------------
  scrollBehavior: {
    // 平滑滚动总开关(false 时全站瞬时滚动)。
    enabled: true,
    // 滚动行为: smooth(平滑) / auto(瞬时)。
    behavior: 'smooth',
    // 锚点偏移(额外值,最终 scroll-padding-top = calc(var(--hh) + 该值))。
    anchorOffset: '18px',
    // 尊重系统"减少动态效果"设置(reduced-motion 时降级为 auto)。
    respectReducedMotion: true
  },

  // ---------------------------------------------------------------------------
  // 42. 轻提示(toast 统一通知)
  // ---------------------------------------------------------------------------
  toast: {
    // 统一轻提示总开关(false 时所有轻提示不显示)。
    enabled: true,
    // 显示位置: bottom-center / top-center / top-right / bottom-right / top-left / bottom-left。
    position: 'bottom-center',
    // 自动消失时长(ms)。
    durationMs: 2500,
    // 同屏最多显示条数(超出时最早一条先消失)。
    maxVisible: 3
  },

  // ---------------------------------------------------------------------------
  // 43. 面包屑导航
  // ---------------------------------------------------------------------------
  breadcrumb: {
    // 启用面包屑(所有页面,首页与 404 除外)。
    enabled: true,
    // 层级分隔符。
    separator: '›',
    // 显示"首页"链接。
    showHome: true,
    // 显示当前页(最后一级,不可点击)。
    showCurrent: true
  },

  // ---------------------------------------------------------------------------
  // 44. 页面切换过渡(离开淡出 + 入场动画)
  // ---------------------------------------------------------------------------
  pageTransition: {
    // 启用页面切换过渡(内链点击淡出 → 导航 → 新页入场)。
    enabled: true,
    // 过渡类型: slide(淡入+上滑) / fade(纯透明度)。
    type: 'slide',
    // 入场动画时长(ms)。
    durationMs: 180,
    // 离开(淡出)时长(ms)。
    outDurationMs: 120,
    // 系统"减少动态效果"下的策略: light(轻量版:更短的纯淡出,推荐) / off(不拦截链接) / full(始终完整)。
    reducedMotion: 'light',
    // 不拦截的选择器(匹配元素或其祖先)。
    excludeSelector: '[data-no-transition]'
  },

  // ---------------------------------------------------------------------------
  // 45. PWA 运行时(SW 注册 / 更新提示 / 离线提示)
  // ---------------------------------------------------------------------------
  pwa: {
    // 运行时总开关(需 site.pwa.enabled 同时开启)。
    enabled: true,
    // 注册 service worker。
    registerSW: true,
    // 新版本可用时 toast 提示。
    updatePrompt: true,
    // 离线/恢复时 toast 提示。
    offlineNotice: true
  },

  // ---------------------------------------------------------------------------
  // 46. 图标变形动画(状态切换类图标 ↔ 弹簧物理变形)
  // ---------------------------------------------------------------------------
  morphIcons: {
    // 总开关(false = 全部图标恢复静态切换,不加载任何 vendor 代码)。
    enabled: true,
    // 弹簧预设: smooth(无回弹) / snappy(快速微回弹) / bouncy(弹跳感);
    // tuning.morphicons.stiffness/damping 同时设置时优先于预设。
    spring: 'snappy',
    // 系统"减少动态效果"下的策略: light(轻量版:更快的弹簧,推荐) / off(直接切换不变形) / full(始终完整)。
    reducedMotion: 'light',
    // vendor 预加载策略: interaction(首次悬停/触摸/聚焦,推荐) / idle(空闲自动) / immediate(立即)。
    preload: 'interaction',
    // 单图标弹簧覆盖(可选): 图标名(theme/copy/favorite/tts/menu) → 预设名或 {stiffness,damping}。例: {"favorite":"bouncy"}。
    perIcon: {},
    // 各图标独立开关(false = 该图标保持原有静态实现)。
    icons: {
      // 主题切换 sun ↔ moon。
      theme: true,
      // 复制按钮 copy → check → copy。
      copy: true,
      // 收藏 空心 → 实心。
      favorite: true,
      // 朗读按钮 扬声器 → 停止。
      tts: true,
      // 移动端菜单 汉堡 → X。
      menu: true
    }
  },

  // ---------------------------------------------------------------------------
  // 47. 跨文档过渡动画(无白屏切页;不支持 VT 的浏览器自动忽略本段)
  // ---------------------------------------------------------------------------
  viewTransition: {
    // 总开关(false = 不注入 @view-transition,完全回退旧 pageTransition 淡出)。
    enabled: true,
    // 过渡类型: fade(交叉淡入淡出) / slide(横向滑动)。
    type: 'fade',
    // 过渡时长(ms;150~400 较自然)。
    durationMs: 180,
    // 共享元素过渡(列表卡片封面/标题 → 文章封面/标题 形变衔接;浏览器不支持时自动忽略)。
    shared: true,
    // 系统"减少动态效果"下的策略: light(轻量版:0.1s 纯淡出,推荐) / off(禁用 VT) / full(始终完整)。
    reducedMotion: 'light',
    // 页内开关配置。
    toggle: {
      // 是否在导航栏显示该开关(false = 只受本配置文件控制)。
      show: true,
      // 默认开启状态(用户未手动设置过时采用)。
      defaultOn: true,
      // localStorage 记忆键(用户手动切换后持久保存)。
      storageKey: 's-view-transition'
    }
  },

  // ---------------------------------------------------------------------------
  // 48. 预取/预渲染(Speculation Rules;仅 Chromium 系支持,其余浏览器自动忽略)
  // ---------------------------------------------------------------------------
  speculation: {
    // 总开关(false = 不注入任何投机规则)。
    enabled: true,
    // 规则下发方式: inline(内联脚本,页内开关可控;默认) / header(响应头+规则文件,全站生效且让 Cloudflare Speed Brain 礼让,但页内开关不生效) / both(双下发,可能轻微重复)。
    delivery: 'inline',
    // 投机模式: prefetch(仅下载文档体,零 JS 执行) / prerender(整页预渲染,最快但耗资源) / both(同时下发,浏览器择优)。
    mode: 'both',
    // 触发档位: moderate(悬停约 200ms,推荐) / eager(立即,较耗流量) / conservative(按下鼠标时)。
    eagerness: 'moderate',
    // 排除规则(命中则不投机;支持选择器与 URL 通配)。
    excludeSelectors: ['[download]', '[rel~=nofollow]', '.no-speculate'],
    // 页内开关配置。
    toggle: {
      // 是否在导航栏显示该开关(false = 只受本配置文件控制)。
      show: true,
      // 默认开启状态(用户未手动设置过时采用)。
      defaultOn: true,
      // localStorage 记忆键。
      storageKey: 's-speculation'
    }
  },

  // ---------------------------------------------------------------------------
  // 49. 卡片视觉增强(封面遮罩/分类色标/阅读时长徽章/悬停光泽)
  // ---------------------------------------------------------------------------
  cardFx: {
    // 总开关(false = 卡片恢复为纯图片+文字的基础样式)。
    enabled: true,
    // 封面底部渐变遮罩(提升文字可读性与层次感)。
    coverOverlay: true,
    // 封面左下分类色标(按分类名哈希取色,同分类同色)。
    categoryChip: true,
    // 封面右上阅读时长徽章。
    readTimeBadge: true,
    // 悬停扫过光泽(自动尊重 reduced-motion)。
    hoverShine: true
  },

  // ---------------------------------------------------------------------------
  // 50. 杂志排版(首字下沉/图片出血/表格悬停/标题编号)
  // ---------------------------------------------------------------------------
  magazine: {
    // 总开关(false = 恢复基础排版)。
    enabled: true,
    // 首段首字下沉(衬线展示字体+主题色;中英文均生效)。
    dropCap: true,
    // 正文图片向两侧出血(宽屏超出正文栏;窄屏自动回退)。
    figureBleed: true,
    // 表格行悬停高亮(主色调混合)。
    tableHover: true,
    // h2 自动编号(01/02…;默认关,避免与手写序号重复)。
    headingNumbers: false
  },

  // ---------------------------------------------------------------------------
  // 51. 性能预算门禁(构建期体积/请求数基线,超限提醒或阻断)
  // ---------------------------------------------------------------------------
  perfBudget: {
    // 总开关(false = 跳过预算检查)。
    enabled: true,
    // 单页 HTML gzip 大小上限(KB;含内联 CSS/脚本,超出触发提醒/阻断)。
    htmlKb: 70,
    // 应用 JS(assets/js)全量 gzip 合计上限(KB;第三方 vendor 库按需懒加载,不计入)。
    jsKb: 90,
    // 单页静态请求数上限(script src + stylesheet + modulepreload 之和)。
    requests: 18,
    // true = 仅提醒不阻断构建;false = 超限时构建失败(严格门禁)。
    warnOnly: true
  },

  // ---------------------------------------------------------------------------
  // 52. 滚动进度条(顶部 hairline;基于原生 scroll-driven 动画,零 JS)
  // ---------------------------------------------------------------------------
  scrollIndicator: {
    // 总开关(false = 不渲染进度条元素)。
    enabled: true,
    // 进度条高度(任意 CSS 长度;2px 精致,3px 醒目)。
    height: '2px',
    // 使用主题渐变(次级色→强调色);false = 单色次级色。
    gradient: true,
    // 系统"减少动态效果"时隐藏条(避免持续重绘;false = 始终显示)。
    respectReducedMotion: true
  },

  // ---------------------------------------------------------------------------
  // 53. 命令面板(Ctrl/Cmd+K;搜索文章 + 页面导航 + 快捷操作)
  // ---------------------------------------------------------------------------
  commandPalette: {
    // 总开关(false = 不监听快捷键,不加载搜索索引)。
    enabled: true,
    // 触发键(与 Ctrl/Cmd 组合;'k' 为通用惯例,避免与浏览器快捷键冲突)。
    hotkey: 'k',
    // 是否包含页面导航项(取自顶部导航菜单)。
    includeNavigation: true,
    // 是否包含快捷操作(切换主题/回到顶部/打开搜索/我的收藏)。
    includeActions: true,
    // 是否包含文章搜索(首次打开时懒加载 search-index.json)。
    includeSearch: true,
    // 结果列表最多显示条目数(8-12 较合适,超出需滚动)。
    maxResults: 10,
    // 打开时自动聚焦输入框(false = 需点击输入框;一般保持 true)。
    autoFocus: true
  },

  // ---------------------------------------------------------------------------
  // 54. 订阅组件(RSS / JSON Feed / 外邮件订阅表单)
  // ---------------------------------------------------------------------------
  subscribe: {
    // 总开关(false = 页脚不渲染订阅条)。
    enabled: true,
    // 是否显示 RSS 链接(指向当前语言的 {lang}/feed.xml)。
    rss: true,
    // 是否显示 JSON Feed 链接(仍受 site.rss.jsonFeed.enabled 总控)。
    jsonFeed: true,
    // 外部邮件订阅表单地址(如 Buttondown/Substack 主页;空字符串 = 隐藏该按钮)。
    newsletterUrl: '',
    // 邮件订阅按钮文案(空 = 用界面文案表 subscribe.mail)。
    newsletterLabel: '',
    // 外链是否新窗口打开(false = 当前窗口)。
    newTab: true
  },

  // ---------------------------------------------------------------------------
  // 55. 作者卡(关于页;头像/简介/技能/时间线/社交矩阵)
  // ---------------------------------------------------------------------------
  authorCard: {
    // 总开关(false = 关于页不渲染作者卡)。
    enabled: true,
    // 显示作者卡的页面 slug(默认关于页 'about';需 site.authorProfile 提供至少一项内容)。
    pageSlug: 'about',
    // 是否显示社交矩阵(来自 site.authorProfile.socials)。
    showSocial: true,
    // 是否显示技能标签(来自 site.authorProfile.skills)。
    showSkills: true,
    // 是否显示时间线(来自 site.authorProfile.timeline,按配置顺序渲染)。
    showTimeline: true,
    // 头像尺寸(任意 CSS 长度;96px 适中)。
    avatarSize: '96px',
    // 时间线最多渲染条数(防止过长;0 = 不限制)。
    maxTimeline: 20
  },

  // ---------------------------------------------------------------------------
  // 56. 继续阅读(本地阅读历史;首页展示最近读过的文章)
  // ---------------------------------------------------------------------------
  readingHistory: {
    // 总开关(false = 不记录也不渲染)。
    enabled: true,
    // 首页最多显示条数(3-8 较合适)。
    maxItems: 5,
    // localStorage 键名(修改会丢弃旧历史)。
    storageKey: 's-history',
    // 是否在首页显示(仅首页/分页列表;false = 只记录不展示)。
    showOnHome: true,
    // 是否显示「清除」按钮。
    clearable: true
  },

  // ---------------------------------------------------------------------------
  // 57. 打印样式(打印/导出 PDF 时的排版优化)
  // ---------------------------------------------------------------------------
  printStyle: {
    // 总开关(false = 仅保留基础打印规则)。
    enabled: true,
    // 打印时隐藏导航/页脚/侧栏/按钮等交互元素(true = 纯净正文)。
    hideInteractive: true,
    // 正文外链打印为 "文字 (URL)" 形式(便于纸质阅读)。
    expandLinks: true,
    // 代码块/图片/表格/引用避免跨页断裂。
    avoidBreaks: true
  },

  // ---------------------------------------------------------------------------
  // 58. 氛围(全局颗粒纹理与主题光晕的页面级开关)
  // ---------------------------------------------------------------------------
  atmosphere: {
    enabled: true, grain: true, glow: true
  },
}

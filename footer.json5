// =====================================================================
// footer.json5 — 页脚（版权 / 多列链接 / 底栏 / 备案 / 外观选项）
// ---------------------------------------------------------------------
// 格式: JSON5（允许注释/尾逗号/无引号键名）
// 生效: 修改后需重新构建（npm run build / npm run serve）
// 注释模板: 作用 / 类型 / 可填值及含义 / 不可填值及原因 / 推荐 / 注意
// =====================================================================
{
  // ===================================================================
  // 一、版权行
  // ===================================================================

  // 版权文本
  // 作用: 页脚底部版权行的完整文本（原样输出,支持 © 等符号）
  // 类型: string | 可填: "© 2026 你的名字" 等
  // 不可填: HTML 标签（会被转义为源码文本） | 推荐: 含年份与署名
  // 注意: 留空则不显示版权行;年份不会自动更新,请随版本维护
  "copyright": "© 2026 Your Name",

  // ===================================================================
  // 二、多列链接区（grid 布局;列数由 columns 控制）
  // ===================================================================

  // 列数
  // 作用: 页脚链接区的网格列数
  // 类型: number（整数） | 可填: 1–4 | 不可填: 0/负数/小数 | 推荐: 3
  // 注意: 实际列数受 columnItems 中 enabled 的条目数限制（少于列数时左对齐）
  "columns": 3,

  // 列内容
  "columnItems": {
    // 区域总开关
    // 类型: boolean | 可填: true/false | 推荐: true
    "enabled": true,

    // 列定义数组（顺序即列顺序）
    // 每列字段:
    //   enabled  该列开关（false 的列不渲染,也不占位）
    //   title    列标题（中文）
    //   titleEn  列标题（英文）
    //   links    链接列表（与 html 二选一）
    //   html     自定义 HTML 内容（与 links 二选一）
    // 链接项字段: enabled / label(中文) / labelEn(英文) / url(站内路径或 https)
    // 不可填: links 与 html 同时存在（html 优先渲染）;不可信第三方脚本
    "items": [
      {
        "enabled": true,
        "title": "导航",
        "titleEn": "Navigation",
        "links": [
          { "enabled": true, "label": "首页", "labelEn": "Home", "url": "/" },
          { "enabled": true, "label": "关于", "labelEn": "About", "url": "/about" }
        ]
      },
      {
        "enabled": false,
        "title": "友情链接",
        "titleEn": "Links",
        "links": [
          { "enabled": false, "label": "合作伙伴 A", "labelEn": "Partner A", "url": "https://a.com" },
          { "enabled": false, "label": "合作伙伴 B", "labelEn": "Partner B", "url": "https://b.com" }
        ]
      },
      {
        "enabled": true,
        "title": "联系",
        "titleEn": "Contact",
        "html": "<p>邮箱: admin@example.com</p>"
      }
    ]
  },

  // ===================================================================
  // 三、底栏链接（版权行上方的一行小链接）
  // ===================================================================

  "bottomLinks": {
    // 底栏总开关
    // 类型: boolean | 可填: true/false | 推荐: true
    "enabled": true,

    // 链接项数组（顺序即显示顺序）
    // 字段: enabled / label / labelEn / url
    // 不可填: 空 label（会渲染空白链接）
    "items": [
      { "enabled": true, "label": "隐私政策", "labelEn": "Privacy Policy", "url": "/privacy" },
      { "enabled": true, "label": "服务条款", "labelEn": "Terms", "url": "/terms" },
      { "enabled": true, "label": "RSS", "url": "/feed.xml" }
    ]
  },

  // ===================================================================
  // 四、备案信息（中国大陆站点合规项）
  // ===================================================================

  "beian": {
    // 是否显示备案信息
    // 作用: 页脚显示 ICP 备案号与公安备案号（链至官方查询站）
    // 类型: boolean | 可填: true(大陆服务器需展示)/false | 推荐: 按需
    "enabled": false,

    // ICP 备案号
    // 类型: string | 可填: "京ICP备12345678号" 等真实备案号
    // 不可填: 虚假备案号（合规风险） | 推荐: 与工信部备案一致
    "icp": "京ICP备12345678号",

    // 公安网备号
    // 类型: string | 可填: "京公网安备 11000002000001号" 等
    // 注意: 留空时不显示公安备案行
    "gongan": "京公网安备 11000002000001号"
  },

  // ===================================================================
  // 五、社交图标行 / Powered by / 自定义 HTML
  // ===================================================================

  "social": {
    // 是否显示页脚社交图标行
    // 作用: 复用 site.social.items 的数据渲染一行图标
    // 类型: boolean | 可填: true/false | 推荐: true
    // 注意: 图标尺寸/间距由下方 options.socialIconSize / socialGap 控制
    "enabled": true
  },

  "poweredBy": {
    // 是否显示 "Powered by" 署名行
    // 类型: boolean | 可填: true/false | 推荐: true
    // 注意: 当 site.showRepoLink 与 site.repoUrl 同时有效时,文本会链接到仓库
    "enabled": true,

    // 署名文本
    // 类型: string | 可填: "S-ynapse" 或你的项目名 | 不可填: HTML
    "text": "S-ynapse"
  },

  // 自定义 HTML（插入页脚顶部的原始片段）
  // 类型: string（HTML） | 可填: 简单结构;不可填: 外部 CDN 脚本（受 CSP 限制）
  // 推荐: ""（默认空）
  "customHtml": "",

  // ===================================================================
  // 六、外观选项（统一走此处,避免零散硬编码）
  // ===================================================================

  "options": {
    // 页脚上下内边距（黄金 φ²）
    // 类型: string（CSS 长度） | 可填: "1.5rem"–"4rem" | 推荐: "2.618rem"
    "paddingV": "2.618rem",

    // 列间距
    // 类型: string（CSS 长度） | 可填: "1rem"–"3rem" | 推荐: "2rem"
    "gap": "2rem",

    // 链接字号
    // 类型: string（CSS 长度） | 可填: ".8125rem"–"1rem" | 推荐: ".875rem"（14px）
    "linkSize": ".875rem",

    // 版权文字字号
    // 类型: string（CSS 长度） | 可填: ".75rem"–".9375rem" | 推荐: ".8125rem"（13px）
    "copyrightSize": ".8125rem",

    // 备案文字字号
    // 类型: string（CSS 长度） | 可填: ".6875rem"–".875rem" | 推荐: ".75rem"（12px）
    "icpSize": ".75rem",

    // 社交图标尺寸
    // 类型: string（CSS 长度） | 可填: "14px"–"24px" | 推荐: "18px"
    "socialIconSize": "18px",

    // 社交图标间距
    // 类型: string（CSS 长度） | 可填: ".5rem"–"1.5rem" | 推荐: ".75rem"
    "socialGap": ".75rem",

    // 链接悬停下划线
    // 作用: 页脚链接 hover 时显示下划线（辅助可点击感知）
    // 类型: boolean | 可填: true(推荐)/false | 注意: 关闭后仅颜色变化
    "linkHoverUnderline": true
  }
}

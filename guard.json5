// ============================================================================
// guard.json5 —— 防护与交互控制域（Guard）细项配置
// ----------------------------------------------------------------------------
// 这是第 13 个配置文件，只负责“防护类”功能的细节参数。
//   · 总开关与模块启停：features.json5 → guards 模块（preset: off/soft/strict）
//   · 本文件：每个模块的细节行为（菜单项、复制规则、绕过通道……）
//
// 生效规则（重要）：
//   features.guards.enabled = false  → 本文件所有配置失效（防护完全关闭）
//   preset = 'off'    → 全部关闭
//   preset = 'soft'   → 仅“自定义右键菜单 + 复制署名”生效（默认，体验友好）
//   preset = 'strict' → 各模块按本文件内的 enabled 字段生效（含拦截/检测类）
//
// 绕过通道（调试/无障碍必需，优先级从高到低）：
//   1. URL 参数  ?guard=off 强制关闭      ?guard=on 强制开启（覆盖一切）
//   2. localStorage['s-guards-off']='1'  持久关闭（控制台执行一次即可）
//   3. core.bypass.localhost = true 时，localhost/127.0.0.1 自动关闭
//
// 诚实声明：所有“拦截/检测”类能力均为威慑手段，均可被浏览器菜单、
//   开发者工具、阅读模式等绕过；且可能影响可访问性与正常用户操作。
//   请逐字段阅读“注意”后再开启；默认配置（soft 档 + 各拦截项关闭）最安全。
//
// 类型约定：单位支持 px/%/rem/vh/vw；纯数字仅用于毫秒（ms）与次数；
//   非法值（类型不符/超出枚举/负数）会被忽略并回退到“推荐值”。
// ============================================================================

{
  // ==========================================================================
  // 【core】全局行为与绕过通道（8 项）
  // ==========================================================================
  core: {
    // 作用：一键档位（供 features.guards.preset 读取；此处保持默认 'soft'）
    // 类型：string；可填：'off' | 'soft' | 'strict'
    // 不可填：其它字符串（校验不通过时回退 'soft'）
    // 推荐：'soft'；废弃值：无
    // 注意：'strict' 会按本文件 enabled 字段开启拦截类模块，普通用户会感到被冒犯
    preset: 'soft',

    // 作用：localhost/127.0.0.1 自动关闭全部防护（开发预览不被打扰）
    // 类型：boolean；可填：true | false
    // 推荐：false（本地预览所见即所得；需要安静时用 ?guard=off）
    // 注意：true 时你本机看到的界面与线上不一致，排查问题前先关掉它
    bypass: {
      localhost: false,

      // 作用：URL 参数名，?guard=off / ?guard=on 强制开关（覆盖一切其它设置）
      // 类型：string；可填：任意参数名（避免与已有参数冲突）
      // 不可填：空字符串（为空则禁用该通道）
      // 推荐：'guard'
      queryParam: 'guard',

      // 作用：localStorage 键名，值为 '1' 时持久关闭防护
      // 类型：string；可填：任意键名
      // 推荐：'s-guards-off'；注意：用户一旦设置，线上不会再看到防护
      storageFlag: 's-guards-off'
    },

    // 作用：控制台日志级别（前缀 [guard]，便于过滤）
    // 类型：string；可填：'off' | 'info' | 'debug'
    // 推荐：'off'（生产不留痕）；排查问题时临时改 'debug'
    logLevel: 'off',

    // 作用：输入框/文本域/可编辑区内不劫持右键与快捷键（无障碍与表单体验）
    // 类型：boolean；可填：true | false
    // 不可填：false（强烈不建议，会破坏表单复制粘贴）
    // 推荐：true
    respectEditable: true,

    // 作用：i18n 键缺失时的回退语言
    // 类型：string；可填：'zh' | 'en'
    // 推荐：'zh'（ui-strings.json5 顶层为中文）
    i18nFallbackLang: 'zh',

    // 作用：菜单/提示语的动态定位边距（防止贴边溢出）
    // 类型：string（CSS 长度）；可填：px/rem/%；不可填：负数
    // 推荐：'8px'
    edgePadding: '8px'
  },

  // ==========================================================================
  // 【contextMenu】自定义右键菜单（30 项）
  // --------------------------------------------------------------------------
  // 在“选择文字/链接/图片/代码块/空白处”时弹出站内菜单，替换浏览器默认菜单。
  // soft 档默认开启；这是体验增强类功能，无副作用。
  // ==========================================================================
  contextMenu: {
    // 作用：模块开关；preset='soft' 时随之启用；preset='off' 时忽略
    // 类型：boolean；推荐：true
    enabled: true,

    // 作用：是否屏蔽浏览器原生右键菜单（屏蔽后才叫“自定义菜单”）
    // 类型：boolean；可填：true | false
    // 不可填：无；注意：false 时站内菜单与原生菜单同时在（通常很丑）
    // 推荐：true
    disableNative: true,

    // 作用：触屏长按是否弹出菜单（移动端右键的替代手势）
    // 类型：boolean；推荐：true
    // 注意：部分 iOS 版本会同时弹出系统选择菜单，两者叠加时以系统为准
    trigger: {
      longPress: true,
      // 作用：长按触发时长；类型：number(ms)；可填 300–1200；推荐：550
      // 不可填：<300（误触率极高）或 >1500（用户以为没反应）
      longPressMs: 550
    },

    // 作用：关闭时机集合
    behavior: {
      // Esc 关闭；推荐 true
      closeOnEsc: true,
      // 页面滚动时关闭；推荐 true（防菜单悬空漂移）
      closeOnScroll: true,
      // 点击菜单外区域关闭；推荐 true
      closeOnOutside: true,
      // 窗口失焦关闭；推荐 true
      closeOnBlur: true
    },

    // 作用：菜单视觉（空字符串 = 使用 tuning.json5 → guard 分类的值）
    style: {
      // 类型：string(CSS 长度)；可填 px/rem；推荐：''（走 tuning）
      width: '',
      // 类型：string；推荐：''（走 tuning）
      radius: '',
      // 作用：菜单背景毛玻璃；类型 boolean；推荐 true
      blur: true,
      // 作用：弹出动画时长；类型 number(ms)；可填 80–300；推荐 140
      animMs: 140,
      // 作用：投影强度 0–1；类型 number；推荐 0.18
      shadowOpacity: 0.18
    },

    // 作用：在哪些场景显示菜单（精准控制，避免打扰）
    // 类型：boolean；推荐如上（代码/空白/图片/链接/文字选择全开）
    showOn: {
      selection: true,
      link: true,
      image: true,
      code: true,
      blank: true
    },

    // 作用：内置菜单项开关（均可单独关闭以精简菜单）
    // 类型：boolean；推荐值见注释
    builtin: {
      copy: true,          // 复制（有选中文字时）
      copyLink: true,      // 复制链接（在链接上时）
      openNewTab: true,    // 新标签页打开链接
      searchSelected: true,// 用站内搜索搜选中词
      translate: true,     // 调用在线翻译（新标签页打开，外部服务）
      backToTop: true,     // 返回顶部
      toggleTheme: true,   // 切换深浅色
      print: true,         // 打印
      copyCode: true,      // 复制代码（代码块内）
      copyRaw: true,       // 复制源码（代码块内，不等同于代码）
      download: true,      // 下载代码（代码块内）
      viewSource: false,   // 查看网页源码；注意：暴露源码，默认关（无防护意义）
      inspect: false       // 检查元素；注意：多数浏览器无效，默认关
    },

    // 作用：自定义菜单项（追加在内置项之后）
    // 类型：array；元素：{ label:'显示名', labelEn:'英文名', url:'打开地址',
    //   action:'自定义动作名', selector:'仅对匹配选择器显示' }
    // 可填：label 必填；url 与 action 二选一；不可填：两者都填或都不填
    // 推荐：[]（无自定义项）；注意：action 需自行在页面脚本监听
    //   事件 'guard:menu-action'（detail.action），否则该项点击无反应
    items: [],

    // 作用：不弹出菜单的区域白名单（CSS 选择器数组）
    // 类型：array<string>；推荐：[]；注意：输入框/文本域已由
    //   core.respectEditable 自动放行，无需在此重复添加
    excludeSelectors: [],

    // 作用：菜单的无障碍标签（空 = 使用 ui-strings 默认文案）
    // 类型：string；推荐：''
    ariaLabel: ''
  },

  // ==========================================================================
  // 【copyGuard】复制控制（20 项）
  // --------------------------------------------------------------------------
  // 四种模式：off（不管）｜attribution（追加出处，推荐默认）｜
  //          weakBlock（拦截并提示，仍可继续）｜block（硬拦截，不建议）
  // 诚实声明：文本已在网页源码中，任何拦截都可被查看源码/阅读模式绕过；
  //   拦截还会影响用户引用、翻译、笔记，请谨慎开启 block。
  // ==========================================================================
  copyGuard: {
    // 作用：模块开关；类型：boolean；推荐：true（attribution 模式）
    enabled: true,

    // 作用：工作模式
    // 类型：string；可填：'off' | 'attribution' | 'weakBlock' | 'block'
    // 不可填：其它字符串（回退 'off'）
    // 推荐：'attribution'；不可填值原因：自定义字符串无对应逻辑
    mode: 'attribution',

    // 作用：署名追加规则（mode='attribution' 时生效）
    attribution: {
      // 作用：中文附件模板；占位符：{title} 标题、{url} 链接、{author} 作者、
      //   {site} 站名；类型：string；不可填：无占位符也可（纯文本）
      // 推荐：'—— 原文：{title}\n{url}'（换行缩进由 attribution.separator 统一追加）
      text: '—— 原文：{title}\n{url}',
      // 作用：英文附件模板（英文页面使用）；推荐：'— From: {title}\n{url}'
      textEn: '— From: {title}\n{url}',
      // 作用：追加位置；类型：string；可填：'after' | 'before'
      // 推荐：'after'（复制正文尾部，不打断引用习惯）
      position: 'after',
      // 作用：模板缺占位符时补在正文间的分隔符；推荐：'\n\n'
      separator: '\n\n',
      // 作用：小于该字数不追加（复制一个词不打扰）；类型：number（字符数）
      // 可填：0–200；推荐：40；不可填：负数
      minChars: 40,
      // 作用：仅文章页生效（首页/归档等不追加）；推荐：true
      onlyArticles: true
    },

    // 作用：允许放行（不拦不署名）的区域
    allow: {
      // 代码块永远放行（复制代码是刚需）；类型：boolean；推荐：true
      codeBlocks: true,
      // 白名单选择器；类型：array<string>；推荐：[]（如需放行引用块可加 '.post-content blockquote'）
      selectors: []
    },

    // 作用：拦截提示（mode='weakBlock' 或 'block' 时生效）
    block: {
      // 类型：boolean；推荐：true（弹出提示，否则被拦无反馈很困惑）
      toast: true,
      // 作用：提示文案覆盖（空 = ui-strings 默认）；类型：string；推荐：''
      toastText: '',
      // 作用：被拦时页面边缘闪烁一次（视觉反馈）；类型：boolean；推荐：false
      flash: false
    },

    // 作用：其它小动作
    extra: {
      // 剪切（Ctrl+X）也遵循同策略；类型：boolean；推荐：false（剪切是编辑行为）
      alsoCut: false,
      // 图片：右键另存提示代替真正拦截（浏览器无法可靠拦截保存）；推荐：false
      imageNotice: false,
      // iOS 长按图片菜单覆盖（实验性）；推荐：false
      iOSOverride: false
    },

    // 作用：被拦时是否只在每会话提示一次（防轰炸）；推荐：true
    noticeOncePerSession: true,

    // 作用：本地统计（仅 console，不发起网络请求）；推荐：false
    logCopyEvents: false
  },

  // ==========================================================================
  // 【selectionGuard】选择控制（10 项）——默认关闭（保留但默认关）
  // --------------------------------------------------------------------------
  // 诚实声明：禁用选择无法阻止“查看源码/阅读模式/复制本页链接”，只会影响
  //   正常用户引用与翻译；请仅在确有需要时开启，并保留白名单。
  // ==========================================================================
  selectionGuard: {
    // 作用：模块开关；soft 档下需显式设为 true 才生效（见 core.preset 说明）
    // 类型：boolean；推荐：false
    enabled: false,

    // 作用：模式
    // 类型：string；可填：'allow'（不管）| 'content'（正文禁选，保留代码/输入框/白名单）
    //                  | 'strict'（除代码/输入框/白名单外全部禁选）
    // 不可填：其它字符串（回退 'allow'）；推荐：'content'
    mode: 'content',

    // 作用：选择白名单（即使禁选也允许选择的区域）
    // 类型：array<string>（CSS 选择器）；推荐：['.post-content pre', '.post-content code']
    // 注意：代码专属白名单另由 allowCode 控制，此处可留空
    allowSelectors: [],

    // 作用：代码块始终可选（复制代码是刚需）；类型：boolean；推荐：true
    allowCode: true,

    // 作用：保留 Ctrl/Cmd+A 全选；类型：boolean；推荐：true
    // 不可填：false 的原因：会破坏键盘用户与无障碍标准（WCAG）
    allowCtrlA: true,

    // 作用：保留 Shift+方向键键盘选择；类型：boolean；推荐：true
    allowShiftArrows: true,

    // 作用：尝试选择时提示一次（弱提醒，不闪烁）；类型：boolean；推荐：false
    noticeToast: false,

    // 作用：自定义提示文案（空 = 使用 ui-strings 默认）；类型：string；推荐：''
    noticeText: ''
  },

  // ==========================================================================
  // 【hotkeyGuard】开发者工具快捷键拦截（15 项）——默认关闭（保留但默认关）
  // --------------------------------------------------------------------------
  // 有效范围：仅拦截“键盘路径”（F12/Ctrl+Shift+I 等），浏览器菜单“检查”、
  //   独立窗口、外接调试器等无法拦截——纯威慑，请勿视为安全边界。
  // ==========================================================================
  hotkeyGuard: {
    // 作用：模块开关；类型：boolean；推荐：false（soft 档需显式 true 才生效）
    enabled: false,

    // 作用：各快捷键拦截开关（Windows/Linux 用 Ctrl、macOS 自动等效 Cmd）
    // 类型：boolean；推荐：true（在已决定开启本模块的前提下）
    // 注意：ctrlP（打印）与 features.printStyle 功能重叠——打印样式只改样式、
    //   本项拦按键；两者可共存，也可只留其一
    keys: {
      f12: true,
      ctrlShiftI: true,
      ctrlShiftJ: true,
      ctrlShiftC: true,
      ctrlU: true,
      ctrlS: true,
      ctrlP: true,
      // 作用：PrintScreen 仅检测并提示（无法阻止系统截图）；推荐：false
      printScreen: false,
      // 作用：自定义组合键；类型：array<string>；语法 'ctrl+alt+x'、'f5'、'ctrl+shift+k'
      // 推荐：[]；注意：拦截浏览器保留键（如 F5 刷新）可能造成页面无法刷新，慎用
      custom: []
    },

    // 作用：被拦截时提示（轻提示，防困惑）；类型：boolean；推荐：true
    noticeToast: true,
    // 作用：自定义提示文案（空 = ui-strings 默认）；类型：string；推荐：''
    noticeText: '',
    // 作用：每会话只提示一次；类型：boolean；推荐：true
    noticeOncePerSession: true
  },

  // ==========================================================================
  // 【watermark】页面水印（18 项）——默认关闭（保留但默认关）
  // --------------------------------------------------------------------------
  // 诚实声明：水印不能阻止截屏/复制，只用于威慑与泄露溯源（对角平铺为佳）。
  //   身份标识仅使用浏览器本地随机短哈希，不采集任何设备/个人信息。
  // ==========================================================================
  watermark: {
    // 作用：模块开关；类型：boolean；推荐：false（soft 档需显式 true 才生效）
    enabled: false,

    // 作用：水印布局
    // 类型：string；可填：'fixed'（单角固定）| 'tiled'（正交平铺）
    //                  | 'diagonal'（对角旋转平铺，推荐）
    // 不可填：其它字符串（回退 'diagonal'）；推荐：'diagonal'
    type: 'diagonal',

    // 作用：中文页水印文字模板；占位符：{site} 站名、{date} 日期、{time} 时间、{id} 标识
    // 类型：string；推荐：'{site} · {date}'；不可填：无（纯文本亦可）
    text: '{site} · {date}',
    // 作用：英文页模板；推荐：'{site} · {date}'
    textEn: '{site} · {date}',

    // 作用：访问者标识策略（用于溯源：同一浏览器同一标识）
    // 类型：string；可填：'none'（不显示）| 'random'（每次刷新随机）| 'storage'（本地持久，推荐）
    // 推荐：'storage'；隐私说明：仅 localStorage 随机串的截断哈希，无指纹
    identity: 'none',
    // 作用：标识显示长度；类型：number；可填 4–16；推荐：6
    idLength: 6,

    // 作用：视觉参数
    // opacity：透明度；number 0–0.5；推荐 0.06（可见但不干扰阅读）
    opacity: 0.06,
    // fontSize：字号；string；推荐 '13px'
    fontSize: '13px',
    // color：颜色；string；空 = 跟随主题次级文字色；推荐 ''
    color: '',
    // rotate：旋转角度（仅 diagonal）；number -90–90；推荐 -22
    rotate: -22,
    // gapX/gapY：平铺间距；string；推荐 '180px'/'140px'
    gapX: '180px',
    gapY: '140px',
    // position：单角位置（仅 fixed）；string；可填 'top-left|top-right|bottom-left|bottom-right'；推荐 'bottom-right'
    position: 'bottom-right',

    // 作用：层级（需高于正文、低于灯箱/菜单）；number；推荐 40
    zIndex: 40,
    // 作用：打印时隐藏（水印常不希望出现在打印稿）；boolean；推荐 true
    hideOnPrint: true,
    // 作用：灯箱查看图片时也显示水印；boolean；推荐 false（避免遮挡图片细节）
    showInLightbox: false,

    // 作用：移动端是否启用（小屏更易干扰）；boolean；推荐 false
    mobileEnabled: false,
    // 作用：缓慢漂移动画（防对齐裁剪，尊重系统减少动效设置）；boolean；推荐 false
    animate: false
  },

  // ==========================================================================
  // 【devtoolsDetect】开发者工具入侵检测（15 项）——默认关闭（保留但默认关）
  // --------------------------------------------------------------------------
  // 检定手段：停靠尺寸差（sizeDiff）与调试器计时（timingDebugger，含 debugger 语句）。
  // 诚实声明：检测非 100% 准确（窗口缩放、特殊布局会误报）；且“检测≠阻止”，
  //   控制台代码仍可执行。仅在确有需要时开启，并建议 action 用 'notice'。
  // ==========================================================================
  devtoolsDetect: {
    // 作用：模块开关；类型：boolean；推荐：false（soft 档需显式 true）
    enabled: false,

    // 作用：检测手段开关（可组合；任一命中即视为打开）
    // sizeDiff：停靠式开发者工具会改变内外窗口尺寸差，超过阈值即判定
    // timingDebugger：以 debugger 语句前后耗时判定（开发者工具打开时会被暂停）
    // 类型：boolean；推荐：sizeDiff true + timingDebugger false（后者有性能波动）
    methods: {
      sizeDiff: true,
      timingDebugger: false
    },

    // 作用：检测周期；类型：number(ms)；可填 1000–10000；推荐：1500
    // 不可填：<1000 的原因：频繁检定拖慢页面且无必要
    intervalMs: 1500,
    // 作用：尺寸差阈值（宽/高任一超出即判定）；类型：number(px)；可填 80–400；推荐：160
    thresholdSizePx: 160,
    // 作用：计时阈值（timingDebugger 用）；类型：number(ms)；可填 50–1000；推荐：120
    thresholdTimingMs: 120,

    // 作用：命中动作
    // 类型：string；可填：'none'（仅记录）| 'notice'（轻提示，推荐）|
    //                  'blurPage'（页面加模糊）| 'lockOverlay'（全屏遮罩）| 'reload'（刷新页面）
    // 不可填：其它字符串（回退 'none'）；推荐：'notice'
    // 注意：'lockOverlay' 会挡操作，遮罩自带关闭按钮可退出
    action: 'notice',
    // 作用：提示文案（空 = ui-strings 默认）；类型：string；推荐：''
    noticeText: '',
    // 作用：每会话只触发一次；类型：boolean；推荐：true（防打扰）
    noticeOncePerSession: true,

    // 作用：'blurPage' 的模糊强度；类型：string；推荐：'6px'
    blurAmount: '6px',
    // 作用：'lockOverlay' 的标题与正文；类型：string；推荐见右
    lockTitle: '开发者工具已打开',
    lockText: '请关闭开发者工具后继续浏览',
    // 作用：'reload' 延迟（给提示留时间）；类型：number(ms)；可填 0–3000；推荐：800
    reloadDelayMs: 800,

    // 作用：页面隐藏（切标签页）时暂停检测；类型：boolean；推荐：true
    pauseWhenHidden: true,
    // 作用：控制台输出检测日志（前缀 [guard]）；类型：boolean；推荐：false
    logDetect: false
  },

  // ==========================================================================
  // 【consoleGuard】控制台克制与反制（16 项）——默认关闭（保留但默认关）
  // --------------------------------------------------------------------------
  // 诚实声明：页面脚本无法拦截 DevTools 真实控制台的代码求值；本模块全部能力
  //   仅作用于“页面上下文可见的 console 对象”（防脚本噪音/误导性输出），
  //   对高级用户无效——属威慑与整洁性功能，不是安全边界。
  // ==========================================================================
  consoleGuard: {
    // 作用：模块开关；类型：boolean；推荐：false（soft 档需显式 true）
    enabled: false,

    // 作用：控制台欢迎语（打开控制台可见的站方留言）
    // bannerEnabled：boolean；推荐 false（避免噪音）
    // bannerText/bannerTextEn：string；不可填：无；推荐见右
    // bannerAscii：boolean；true 时以大字 ASCII 艺术输出；推荐 false
    bannerEnabled: false,
    bannerText: '本站为静态博客，请勿粘贴执行陌生代码',
    bannerTextEn: 'This is a static blog. Never paste unknown code here.',
    bannerAscii: false,

    // 作用：周期性清空控制台（对抗脚本刷屏）
    // clearEnabled：boolean；推荐 false
    // clearIntervalMs：number(ms)；可填 2000–60000；推荐 2000
    // clearOnDetect：boolean；检测（devtoolsDetect）命中时清空一次；推荐 true
    // 注意：清空属于与用户“抢控制台”，调试时会互相干扰
    clearEnabled: false,
    clearIntervalMs: 2000,
    clearOnDetect: true,

    // 作用：对页面脚本伪装 console（把指定方法替换为 no-op；仅影响页面自己的输出）
    // muteEnabled：boolean；推荐 false
    // muteMethods：array<string>；可填 'log','info','warn','error','debug','table' 子集
    // muteFreeze：boolean；冻结 console 对象防页面改回；推荐 false（可能破坏第三方脚本）
    muteEnabled: false,
    muteMethods: ['log', 'info', 'debug'],
    muteFreeze: false,

    // 作用：console.log 访问陷阱（页面脚本一碰 console.log 即触发动作）
    // trapEnabled：boolean；推荐 false
    // trapAction：string；可填 'notice' | 'none'；推荐 'notice'
    // trapText：string；空 = ui-strings 默认；推荐 ''
    trapEnabled: false,
    trapAction: 'notice',
    trapText: '',

    // 作用：隐藏 guard 自身全部控制台输出（覆盖 core.logLevel）；类型：boolean；推荐：false
    hideSelfLogs: false,
    // 作用：上述提示每会话只一次；类型：boolean；推荐：true
    noticeOncePerSession: true
  },

  // ==========================================================================
  // 【privacyCurtain】窗口隐私帘（10 项）——默认关闭（保留但默认关）
  // --------------------------------------------------------------------------
  // 场景：切出标签页/窗口失焦时遮罩内容，防止旁人瞥见或录屏采集。
  // 诚实声明：OS 级截屏/录屏无法阻止；PrintScreen 只能“检测提示”。
  // ==========================================================================
  privacyCurtain: {
    // 作用：模块开关；类型：boolean；推荐：false（soft 档需显式 true）
    enabled: false,

    // 作用：窗口失焦（切到别的应用）时显示隐私帘；类型：boolean；推荐：true
    blurOnBlur: true,
    // 作用：标签页隐藏（切标签）时显示隐私帘；类型：boolean；推荐：true
    blurOnVisibility: true,
    // 作用：模糊强度；类型：string；可填 px/rem；推荐：'8px'
    blurAmount: '8px',
    // 作用：帘上文案（中/英）；类型：string；推荐：'已暂停显示' / 'Paused'
    curtainText: '已暂停显示',
    curtainTextEn: 'Paused',
    // 作用：恢复显示的去抖延迟（快速切回不闪）；类型：number(ms)；可填 0–1000；推荐：200
    revealDelayMs: 200,

    // 作用：PrintScreen 按键检测提示（仅键盘路径；无法真正阻止截图）
    // prtScNotice：boolean；推荐 false
    // prtScText：string；空 = ui-strings 默认；推荐 ''
    // prtScOncePerSession：boolean；推荐 true
    prtScNotice: false,
    prtScText: '',
    prtScOncePerSession: true
  }
}

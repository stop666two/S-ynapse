// ============================================================================
// internals.json5 — 工程内部参数（非站点配置）
// ----------------------------------------------------------------------------
// 作用：集中承载「构建/审计/发布/CI 工具链」内部使用的参数，使脚本不再散落
//       写死的端口、路径、缓存天数、上限与颜色。站点面向用户的可配置项仍归
//       site/theme/features 等 14 个 JSON5，不放这里。
// 类型：JSON5 对象；由 scripts/lib/internals.js 深合并 scripts/lib/internals-defaults.js
//       的默认值并做类型/范围/枚举校验，校验失败构建与 CI 立即失败（fail fast）。
// 可填：任意键的子集——只写需要偏离默认值的键即可；未写的键取默认值。
// 不可填：未知顶层/嵌套键（校验报错）、超出范围的数值、非法枚举与颜色格式；
//         需要站点级可配置的参数（应放 features/site 等站点配置）。
// 推荐：保持随仓库提交；本地临时覆盖用环境变量（CHROME_PATH/SYNAPSE_OUT_DIR）而非改本文件。
// 默认值：本文件即默认清单——每个键的当前值就是规范默认值；代码侧默认见
//        scripts/lib/internals-defaults.js，二者由 verify:internals 与单元测试逐键守护。
// 守卫：scripts/check-internals.js（verify:internals）校验 .nvmrc、workers/wrangler.toml
//       的 assets 目录与关键写死形态是否与本文件一致；check-config-refs/comments/docs
//       亦覆盖本文件。
// ============================================================================
{
  // 本地进程端口（仅开发/审计用，不参与生产部署）。
  ports: {
    // 作用：dev/serve 构建预览服务器的默认监听端口。
    // 类型：整数；范围 1-65535。
    // 可填：任意空闲端口。
    // 不可填：0（由内核随机分配，调试时无法预知）、负值与大于 65535 的值。
    // 推荐：3000（与多数本地联调约定一致）；端口冲突时用 `--port <端口>` 覆盖。
    serve: 3000,
    // 作用：无障碍审计自起 serve 时的起始端口（被占用时脚本自动向后找空闲端口）。
    // 类型：整数；范围 1-65535。
    // 可填：任意空闲端口。
    // 不可填：与 CI 并行任务冲突的固定端口（脚本会自动+1 探测，无需在此规避）。
    // 推荐：3224（远离常见 3000/8080，减少与其它本地服务碰撞）。
    a11y: 3224,
    // 作用：性能审计在未显式传 --url 时使用的本地目标端口。
    // 类型：整数；范围 1-65535。
    // 可填：本地预览服务实际监听的端口。
    // 不可填：远端端口（本参数只用于拼接 127.0.0.1 地址，审计远端请显式传 --url）。
    // 推荐：3000（与 ports.serve 一致，先 `npm run serve` 再 `npm run perf:audit`）。
    perf: 3000
  },
  // Chrome 可执行文件探测（a11y/perf/mermaid 渲染共用）。
  chrome: {
    // 作用：显式指定 Chrome 可执行文件绝对路径；null 表示自动探测。
    // 类型：字符串或 null。
    // 可填：可执行文件绝对路径（Windows 形如 C:/.../chrome.exe）。
    // 不可填：目录路径、相对路径、空字符串（请写 null 表示自动探测）。
    // 推荐：null（自动探测：--chrome/CHROME_PATH > 本项 > 平台默认安装路径 > PATH）。
    path: null
  },
  // 构建与工具链使用的目录（均相对仓库根）。
  paths: {
    // 作用：默认构建输出目录；null 表示 dist。
    // 类型：字符串或 null。
    // 可填：仓库内相对路径（如 dist、out/site）或绝对路径。
    // 不可填：仓库外路径与空字符串（空字符串请写 null）。
    // 推荐：null；临时构建请用 --out/SYNAPSE_OUT_DIR（命令行优先于本项）。
    outDir: null,
    // 作用：构建缓存根目录（媒体/OG/字体/mermaid/压缩基线等子目录的父级）。
    // 类型：字符串；仓库内相对路径。
    // 可填：如 .cache 或 tmp/cache。
    // 不可填：dist 内路径（缓存不得进入部署产物）、绝对路径与仓库外路径。
    // 推荐：.cache（已随 .gitignore 排除）。
    cacheDir: '.cache',
    // 作用：CI/测试工件目录（fuzz 失败留档、Web 覆盖率、冒烟摘要、CI 报告、SBOM）。
    // 类型：字符串；仓库内相对路径。
    // 可填：如 build-artifacts。
    // 不可填：dist 内路径（工件不部署）、绝对路径与仓库外路径。
    // 推荐：build-artifacts（已随 .gitignore 排除并有 CI 上传约定）。
    artifactsDir: 'build-artifacts'
  },
  // 内容寻址缓存的兜底重验证天数；0 表示仅按内容键（源文件 stat+配置指纹）判定。
  cache: {
    // 作用：media 图片处理缓存的兜底重验证天数。
    // 类型：非负整数（天）。
    // 可填：0（仅内容键判定，现状）或正整数（产物 mtime 超过该天数即重处理）。
    // 不可填：负数与小数（校验报错）。
    // 推荐：0（内容寻址已保证正确性；仅在需要定期强制重编码时调大）。
    mediaTtlDays: 0,
    // 作用：OG 图片缓存的兜底重验证天数。
    // 类型：非负整数（天）。
    // 可填：0（仅内容键判定，现状）或正整数。
    // 不可填：负数与小数。
    // 推荐：0；OG 缓存键已含文章与封面指纹。
    ogTtlDays: 0,
    // 作用：CJK 字体分片清单（chunk-list.json）的缓存有效期。
    // 类型：非负整数（天）。
    // 可填：0（每次构建都重新拉取，离线失败仍复用过期缓存）或正整数。
    // 不可填：负数与小数。
    // 推荐：7（上游字体分片清单变化频率低，7 天兼顾新鲜度与离线可用性）。
    fontsTtlDays: 7,
    // 作用：mermaid 渲染 SVG 缓存的兜底重验证天数。
    // 类型：非负整数（天）。
    // 可填：0（仅按代码+主题+版本键判定，现状）或正整数。
    // 不可填：负数与小数。
    // 推荐：0；缓存键已含 mermaid 版本，升级自动失效。
    mermaidTtlDays: 0
  },
  // 审计工具上限与采样参数。
  audit: {
    // 无障碍审计（scripts/a11y-audit.js）。
    a11y: {
      // 作用：单次审计的最大页面数；0 表示审计 dist 下全部页面。
      // 类型：非负整数（页）。
      // 可填：0（全量，现状）或正整数（冒烟抽检）。
      // 不可填：负数与小数。
      // 推荐：0（全量；CI 需要抽样时再调小并在报告注明）。
      pages: 0,
      // 作用：每条 axe 规则在控制台打印的节点样例上限。
      // 类型：正整数（个）。
      // 可填：1 及以上；数值越大日志越长。
      // 不可填：0 与负数（无样例则无法定位元素）。
      // 推荐：3（足够定位且控制日志体积）。
      nodesPerRuleMax: 3,
      // 作用：违规节点 HTML 摘要在日志中的最大字符数。
      // 类型：正整数（字符）。
      // 可填：40 及以上（过短无法辨认元素）。
      // 不可填：0 与负数。
      // 推荐：120（约一行内可读）。
      htmlSummaryMax: 120
    },
    // dist 产物哈希护栏（scripts/dist-hash-guard.js diff）。
    distHash: {
      // 作用：diff 差异清单每条列表打印的最大条数（超出仅显示省略提示）。
      // 类型：非负整数（条）。
      // 可填：0（仅显示总数）或正整数。
      // 不可填：负数与小数。
      // 推荐：20（单屏可审阅，又足够定位常见差异）。
      previewLimit: 20
    }
  },
  // 发布清理（scripts/release-prune.js）。
  release: {
    // 作用：gh release list 的返回上限，用于枚举既有 Release。
    // 类型：正整数（条）。
    // 可填：不小于实际已有版本数的值。
    // 不可填：0 与负数（将导致清理遗漏）。
    // 推荐：200（只保留最新版的策略下远超可预见版本数）。
    listLimit: 200,
    // 作用：dry-run 计划逐条打印的上限，超出时仅显示省略提示。
    // 类型：正整数（条）。
    // 可填：1 及以上。
    // 不可填：0 与负数。
    // 推荐：20（保持输出可读，完整结果仍在返回值中）。
    previewLimit: 20
  },
  // 构建报告（scripts/build/report.js、scripts/build.js）。
  report: {
    // 作用：构建报告「输出体积」列表展示的前 N 个最大文件。
    // 类型：正整数（个）。
    // 可填：1 及以上。
    // 不可填：0 与负数。
    // 推荐：10（覆盖主要体积来源）。
    topN: 10,
    // 作用：构建耗时告警阈值（毫秒）；0 表示关闭耗时告警。
    // 类型：非负整数（毫秒）。
    // 可填：0（不告警，现状）或如 120000（2 分钟）。
    // 不可填：负数与小数。
    // 推荐：0（本地机器差异大，告警噪音高；需要时临时调大）。
    maxBuildMsWarn: 0
  },
  // 部署（scripts/deploy-pages.js、workers/wrangler.toml 守卫）。
  deploy: {
    // 作用：Cloudflare Pages 项目名（wrangler pages deploy --project-name）。
    // 类型：非空字符串（项目名标识符）。
    // 可填：与 Cloudflare 控制台一致的 Pages 项目名。
    // 不可填：空串、含空格或路径分隔符的值。
    // 推荐：s-ynapse（与仓库名一致；改名须同步 Cloudflare 控制台与 workers/wrangler.toml）。
    pagesProject: 's-ynapse',
    // 作用：Worker assets 绑定的静态资源目录（相对仓库根），必须与构建输出目录一致。
    // 类型：非空字符串（仓库内相对路径）。
    // 可填：dist 或 paths.outDir 指向的目录。
    // 不可填：仓库外路径、绝对路径、空串；改本项必须同步 workers/wrangler.toml 的 directory。
    // 推荐：dist（verify:internals 会解析 wrangler.toml 并断言两者一致）。
    workerAssetsDir: 'dist',
    // 作用：执行部署前是否先跑 verify:internals 守卫。
    // 类型：布尔值。
    // 可填：true（默认，防止端口/目录漂移后误发布）或 false（明确知情时跳过）。
    // 不可填：非布尔值。
    // 推荐：true。
    verifyOnDeploy: true
  },
  // CI/CD 参数（.nvmrc、scripts/ci-env.js、scripts/ci-checks.js）。
  ci: {
    // 作用：CI 主任务与 .nvmrc 使用的 Node 版本。
    // 类型：字符串（主版本或完整版本号）。
    // 可填：满足 package.json engines 的版本（如 24 或 24.9.0）。
    // 不可填：低于 engines 下限的版本；含 v 前缀的写法（.nvmrc 接受，校验统一去 v 比较）。
    // 推荐：24（当前 LTS 主线；check-internals 校验 .nvmrc 与本项一致）。
    nodeVersion: '24',
    // 作用：兼容性任务（compat job）使用的 Node 最低版本。
    // 类型：字符串（完整版本号）。
    // 可填：package.json engines 下限对应版本。
    // 不可填：高于 ci.nodeVersion 的版本（失去兼容性下限验证意义）。
    // 推荐：20.19.0（engines ^20.19.0 下限）。
    compatNodeVersion: '20.19.0',
    // 作用：CI 检查是否以「聚合模式」运行（单步跑完整套、统一汇总失败）。
    // 类型：布尔值。
    // 可填：true（scripts/ci-checks.js 跑完全部检查再统一失败）或 false（遇首个失败即停）。
    // 不可填：非布尔值。
    // 推荐：true（一次拿到全部失败线索，避免反复来回修）。
    aggregate: true,
    // 作用：每个检查项的超时上限（毫秒）；超时判失败并清理整棵子进程树。
    // 类型：正整数（毫秒）。
    // 可填：按最慢检查（含 Chrome 的端到端审计）留足余量的值。
    // 不可填：0 或负数（spawnSync 语义下 0 表示不限制，将失去兜底）。
    // 推荐：600000（10 分钟；单项异常挂起时及时止损）。
    checkTimeoutMs: 600000,
    // 作用：个别检查项的超时覆盖（键为检查名，值为毫秒）。
    // 类型：对象（字符串→正整数）。
    // 可填：确实需要更长/更短的检查项，如 { "audit:a11y": 900000 }。
    // 不可填：负值或未在检查矩阵中的名字（会被忽略并在报告标注）。
    // 推荐：{}（全部继承 checkTimeoutMs）。
    checkTimeouts: {},
    // 「无变化重复运行自动跳过」策略（scripts/ci-skip.js）。
    skip: {
      // 作用：是否启用连击跳过（仅对 HEAD 未变化的重复运行生效）。
      // 类型：布尔值。
      // 可填：true（推荐）或 false（每次都跑）。
      // 不可填：非布尔值。
      enabled: true,
      // 作用：是否要求当前 HEAD 与已运行序列一致才应用连击规则。
      // 类型：布尔值。
      // 可填：true（推荐；有新提交必然执行）或 false（仅按既有运行序列判断）。
      // 不可填：非布尔值。
      requireSameHead: true,
      // 作用：连续错误达到该次数后跳过后续无变化运行。
      // 类型：正整数（次）。
      // 可填：≥1（错误=存在阻断失败；告警不计入错误）。
      // 不可填：0（会立即触发跳过）或负数。
      // 推荐：2（连错 2 次停止自动重跑，避免空转消耗）。
      consecutiveErrors: 2,
      // 作用：连续「完全无错无警告」达到该次数后跳过后续无变化运行。
      // 类型：正整数（次）。
      // 可填：≥1。
      // 不可填：0 或负数。
      // 推荐：5（连净 5 次后停止自动执行，待有新提交再跑）。
      consecutiveClean: 5,
      // 作用：告警语义开关（true=告警不计错、不计净，但重置错误连击）。
      // 类型：布尔值。
      // 可填：true（推荐；告警仍需人工修复，但不触发自动停止）或 false（告警阻止连净）。
      // 不可填：非布尔值。
      ignoreWarnings: true,
      // 作用：强制执行的变量名（值为 1/true 时忽略跳过判定）。
      // 类型：字符串（环境变量名）。
      // 可填：CI 环境中可设置的变量名。
      // 不可填：空字符串。
      // 推荐：CI_FORCE。
      forceEnv: 'CI_FORCE',
      // 作用：提交信息强制标记（提交信息包含该标记时忽略跳过判定）。
      // 类型：字符串。
      // 可填：简短且不常见的标记。
      // 不可填：空字符串。
      // 推荐：[ci force]。
      forceToken: '[ci force]'
    }
  },
  // 工程内生成内容使用的颜色（非站点主题配色）。
  ui: {
    // 构建报告页状态色（scripts/build/report.js）。
    reportColors: {
      // 作用：通过状态（压缩/图片优化/安全开关已启用）的前景色。
      // 类型：十六进制颜色字符串（#rrggbb）。
      // 可填：满足对比度的暗色（报告页底色来自站点主题，浅色下需可读）。
      // 不可填：透明的 rgba 写法与具名色。
      // 推荐：#16a34a（与常见「成功」语义一致）。
      good: '#16a34a',
      // 作用：警告状态（功能未启用/存在拦截项）的前景色。
      // 类型：十六进制颜色字符串（#rrggbb）。
      // 可填：满足对比度的暗色。
      // 不可填：rgba 写法与具名色。
      // 推荐：#d97706（与常见「警告」语义一致）。
      warn: '#d97706'
    },
    // 作用：站点未配置可用 favicon 文件时，生成内联 SVG 兜底图标的底色。
    // 类型：十六进制颜色字符串（#rrggbb）。
    // 可填：与站点主题主色协调的颜色。
    // 不可填：透明色与 rgba 写法（SVG 矩形需要实色底）。
    // 推荐：#2d3748（中性深灰蓝，明暗主题下均有足够对比）。
    faviconFallbackColor: '#2d3748',
    // 作用：兜底 favicon SVG 中图形（连线与圆点）的前景色。
    // 类型：十六进制颜色字符串（#rrggbb）。
    // 可填：与 faviconFallbackColor 对比度足够的颜色。
    // 不可填：与底色相同或透明度写法（图形将不可见）。
    // 推荐：#ffffff（纯白，在深灰蓝底上清晰可辨）。
    faviconForegroundColor: '#ffffff'
  }
}

{
  "name": "s-ynapse",
  "version": "1.0.2",
  "description": "A minimal, secure, high-performance static blog system powered by Cloudflare",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "postinstall": "node scripts/init-project.js",
    "init": "node scripts/init-project.js",
    "test": "node scripts/run-tests.js",
    "test:build": "node --test scripts/build-smoke.test.js",
    "test:coverage": "node scripts/run-tests.js --experimental-test-coverage --test-coverage-include=scripts/lib/** --test-coverage-lines=80",
    "lint": "eslint js scripts workers",
    "audit": "node scripts/audit.js",
    "typecheck": "tsc -p tsconfig.json",
    "verify:security": "node scripts/security-verify.js",
    "verify:config": "node scripts/check-config-consistency.js",
    "audit:a11y": "node scripts/a11y-audit.js",
    "perf:audit": "node scripts/perf-audit.js",
    "import": "node scripts/import.js",
    "build": "node scripts/build.js",
    "sbom": "node scripts/sbom.js",
    "dev": "node scripts/build.js --watch --drafts",
    "serve": "node scripts/build.js --serve",
    "start": "node scripts/build.js --serve --port 3000",
    "deploy:pages": "wrangler pages deploy dist --project-name=s-ynapse",
    "deploy:worker": "wrangler deploy --config workers/wrangler.toml --env production"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "@minify-html/node": "0.18.1",
    "clean-css": "5.3.3",
    "deepmerge": "4.3.1",
    "ejs": "3.1.10",
    "feed": "4.2.2",
    "front-matter": "4.0.2",
    "json5": "2.2.3",
    "katex": "0.16.22",
    "marked": "12.0.2",
    "mermaid": "11.17.2",
    "morphicons": "1.7.1",
    "prismjs": "1.30.0",
    "sanitize-html": "2.17.7",
    "sharp": "0.35.4",
    "terser": "5.49.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "20.19.43",
    "axe-core": "4.10.2",
    "chokidar": "^3.6.0",
    "esbuild": "0.28.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "puppeteer-core": "25.12.0",
    "typescript": "5.9.3",
    "wrangler": "4.138.0"
  }
}

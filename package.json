{
  "name": "s-ynapse",
  "version": "1.0.1",
  "description": "A minimal, secure, high-performance static blog system powered by Cloudflare",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/init-project.js",
    "init": "node scripts/init-project.js",
    "build": "node scripts/build.js",
    "dev": "node scripts/build.js --watch --drafts",
    "serve": "node scripts/build.js --serve",
    "start": "node scripts/build.js --serve --port 3000",
    "deploy:pages": "wrangler pages publish dist --project-name=s-ynapse",
    "deploy:worker": "wrangler publish"
  },
  "dependencies": {
    "chokidar": "3.6.0",
    "clean-css": "5.3.3",
    "deepmerge": "4.3.1",
    "ejs": "3.1.10",
    "feed": "4.2.2",
    "front-matter": "4.0.2",
    "html-minifier": "4.0.0",
    "json5": "2.2.3",
    "marked": "12.0.2",
    "sharp": "0.33.5",
    "terser": "5.49.0"
  },
  "devDependencies": {
    "wrangler": "4.112.0"
  }
}

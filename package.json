{
  "name": "s-ynapse",
  "version": "1.0.0",
  "description": "A minimal, secure, high-performance static blog system powered by Cloudflare",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "node scripts/build.js --watch",
    "serve": "node scripts/build.js --serve",
    "start": "node scripts/build.js --serve --port 3000",
    "deploy:pages": "wrangler pages publish dist --project-name=s-ynapse",
    "deploy:worker": "wrangler publish"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "chokidar": "^3.6.0",
    "clean-css": "^5.3.3",
    "deepmerge": "^4.3.1",
    "dompurify": "^3.0.8",
    "ejs": "^3.1.10",
    "feed": "^4.2.2",
    "front-matter": "^4.0.2",
    "html-minifier": "^4.0.0",
    "jsdom": "^24.0.0",
    "json5": "^2.2.3",
    "marked": "^12.0.0",
    "sharp": "^0.33.2",
    "terser": "^5.27.0"
  },
  "devDependencies": {
    "wrangler": "^3.50.0"
  }
}

{
  "name": "s-ynapse",
  "version": "1.3.1",
  "description": "A minimal, secure, high-performance static blog system powered by Cloudflare",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "postinstall": "node scripts/init-project.js",
    "init": "node scripts/init-project.js",
    "test": "node scripts/run-tests.js",
    "test:build": "node --test scripts/build-smoke.test.js",
    "test:fuzz": "node scripts/run-tests.js --fuzz",
    "test:malicious": "node --test scripts/malicious.test.js",
    "test:smoke": "node scripts/smoke-web.js",
    "test:cov-web": "node scripts/coverage-web.js",
    "test:all": "node scripts/ci-checks.js",
    "test:coverage": "node scripts/run-tests.js --experimental-test-coverage --test-coverage-include=scripts/lib/** --test-coverage-lines=80",
    "lint": "eslint js scripts workers",
    "audit": "node scripts/audit-gate.js",
    "typecheck": "tsc -p tsconfig.json",
    "verify:security": "node scripts/security-verify.js",
    "verify:config": "node scripts/check-config-consistency.js",
    "verify:config-refs": "node scripts/check-config-refs.js",
    "verify:config-single-source": "node scripts/check-config-single-source.js",
    "gen:config-matrix": "node scripts/gen-config-switch-matrix.js",
    "verify:config-dupes": "node scripts/check-config-duplicates.js",
    "verify:config-comments": "node scripts/check-config-comments.js",
    "verify:config-docs": "node scripts/check-config-docs.js",
    "verify:internals": "node scripts/check-internals.js",
    "verify:comment-hygiene": "node scripts/check-comment-hygiene.js",
    "verify:process-guards": "node scripts/check-process-guards.js",
    "verify:compression": "node scripts/verify-compression.js",
    "audit:a11y": "node scripts/a11y-audit.js",
    "audit:media": "node scripts/audit-media.js",
    "perf:audit": "node scripts/perf-audit.js",
    "export": "node scripts/export.js",
    "import": "node scripts/import.js",
    "build": "node scripts/build.js",
    "sbom": "node scripts/sbom.js",
    "release:mark": "node scripts/release-mark.js",
    "release:archive": "node scripts/release-archive.js",
    "release:notes": "node scripts/release-notes.js",
    "release:publish": "node scripts/release-publish.js",
    "release:prune": "node scripts/release-prune.js",
    "dev": "node scripts/build.js --watch --drafts",
    "serve": "node scripts/build.js --serve",
    "start": "node scripts/build.js --serve",
    "deploy:pages": "node scripts/deploy-pages.js",
    "deploy:worker": "wrangler deploy --config workers/wrangler.toml --env production"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "@minify-html/node": "0.18.1",
    "clean-css": "5.3.3",
    "deepmerge": "4.3.1",
    "ejs": "3.1.10",
    "feed": "4.2.2",
    "front-matter": "4.0.2",
    "json5": "2.2.3",
    "katex": "0.19.1",
    "marked": "12.0.2",
    "mermaid": "12.3.0",
    "morphicons": "1.7.1",
    "prismjs": "1.30.0",
    "sanitize-html": "2.18.2",
    "sharp": "0.35.5",
    "terser": "5.49.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "axe-core": "4.10.2",
    "chokidar": "^3.6.0",
    "esbuild": "0.28.1",
    "eslint": "10.15.0",
    "fast-check": "4.10.2",
    "globals": "17.12.0",
    "javascript-obfuscator": "5.10.1",
    "puppeteer-core": "25.17.0",
    "typescript": "5.9.3",
    "wrangler": "4.162.0"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "source-map-js": "^1.2.2",
    "@vercel/blob": {
      ".": "^2.9.0",
      "undici": "^6.29.1"
    },
    "zod": "^4.6.7"
  }
}

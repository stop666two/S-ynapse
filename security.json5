// =====================================================================
// security.json5 — 安全（CSP / 安全头 / 限流 / robots / 路径限制 / 加固）
// ---------------------------------------------------------------------
// 格式: JSON5（允许注释/尾逗号/无引号键名）
// 生效: 修改后需重新构建（npm run build / npm run serve）
// 产物: dist/_headers（静态托管头）与 workers/security-config.js（Worker 数据）
//       两者均由构建从本文件生成,不要手改产物
// 注释模板: 作用 / 类型 / 可填值及含义 / 不可填值及原因 / 推荐 / 注意
// =====================================================================
{
  // ===================================================================
  // 一、内容安全策略（CSP）
  // ===================================================================
  // 控制浏览器允许加载哪些资源,是防 XSS 的第一道防线。
  // 指令语义与取值规则遵循 W3C CSP3 规范:
  //   'self' 同源 / 'none' 禁止 / 'unsafe-inline' 允许内联（谨慎） / https:// 域名白名单

  "csp": {
    // 是否启用 CSP 响应头
    // 作用: 输出 Content-Security-Policy 头（静态托管经 _headers 生效）
    // 类型: boolean | 可填: true/false | 推荐: true
    // 注意: 关闭后站点失去 CSP 防护,仅调试第三方资源时临时关闭
    "enabled": true,

    // 构建期自动裁剪未使用域名
    // 作用: 生成 _headers 与 Worker 配置时，按实际启用的功能移除 directives 中
    //   未使用的可选域名（giscus.app / cdn.jsdelivr.net / fonts.googleapis.com / fonts.gstatic.com）
    // 何时开: 默认开启（最小权限，未启用的能力不应留在 CSP 白名单里）
    // 何时关: 需要完全手动接管域名清单（自定义第三方资源未写进 theme.externalAssets 时），
    //   或排查第三方资源被裁剪问题时临时设为 false 对照
    // 类型: boolean | 可填: true(推荐)/false | 裁剪只涉及上述四个已知域名，自加域名永远保留
    "autoTrim": true,

    // 指令列表（均为 string[];空数组的指令会被跳过）
    // 类型: { [指令名]: string[] }
    // 不可填: 未列入计划的资源域名（会被浏览器拦截）
    "directives": {
      // 默认资源来源（未单独声明的资源类型的兜底）
      // 推荐: ["'self'"]（仅同源）
      "default-src": ["'self'"],
      // 脚本来源
      // 可填: 同源；'inline-speculation-rules'（Speculation Rules 内联规则）；
      //       统计（static.cloudflareinsights.com，仅 webAnalytics 配置 token 时由 autoTrim 保留）
      //       评论（giscus.app）
      // 不可填: 'unsafe-inline'（放开任意内联脚本，削弱 XSS 防护；本项目内联脚本一律以
      //       构建期 nonce 放行——build.js 每构建生成 CSP_NONCE，同步注入 HTML 的
      //       <script nonce="..."> 与本数组末尾的 'nonce-...'；模板内联事件属性已全部
      //       改为 addEventListener，不再依赖 'unsafe-inline'）
      // 注意: cdn.jsdelivr.net 与 giscus.app 在未启用对应能力时由 autoTrim 自动移除；
      //       nonce 由构建自动追加，无需手写（手写值会与实际 HTML 不一致而被拦截）
      "script-src": ["'self'", "'inline-speculation-rules'", "https://cdn.jsdelivr.net", "https://static.cloudflareinsights.com", "https://giscus.app"],
      // 样式来源（Google Fonts 样式表 / jsdelivr 兜底）
      // 可填: 同源；'nonce-...'（由构建期 applyCspNonce 自动注入，与 script-src 同一枚）；
      //       外链样式表域名（googleapis / jsdelivr）
      // 不可填: 'unsafe-inline'（style-src-elem 语境的内联 <style> 一律以构建期 nonce 放行——
      //       build.js 每构建生成 CSP_NONCE，同步注入 HTML 的 <style nonce="..."> 与本数组
      //       末尾的 'nonce-...'，无需手写）
      // 注意: 模板内联 style="..." 属性不受本条约束（CSP3 中属性不支持 nonce），由下方
      //       style-src-attr 单独放行；googleapis/jsdelivr 无 externalAssets 引用时由
      //       autoTrim 自动移除；nonce 由构建自动追加，手写值会与实际 HTML 不一致而被拦截
      "style-src": ["'self'", "https://fonts.googleapis.com", "https://cdn.jsdelivr.net"],
      // 样式属性来源（内联 style="..." 属性专用，仅作用于 element 的属性语境）
      // 作用: 放行模板中大量内联 style="..."（主题预设色/背景图/CSS 变量等动态值）
      // 类型: string[] | 可填: ["'unsafe-inline'"]（CSP 规范中 style 属性不支持 nonce/hash 放行，
      //       只能整体放行；如需收紧须先把模板内联样式全部抽离为类名）
      // 不可填: []（会拦截全部内联样式属性，页面视觉立即损坏）
      // 推荐: ["'unsafe-inline'"]（已知残余面：注入 style 属性无法执行脚本，风险低于内联脚本）
      "style-src-attr": ["'unsafe-inline'"],
      // 图片来源（data: 用于内联占位图;https: 整域放行便于外链封面）
      "img-src": ["'self'", "data:", "https:"],
      // 字体来源（Google Fonts 字体文件 / jsdelivr 兜底;本地 vendor 字体为同源）
      "font-src": ["'self'", "https://fonts.gstatic.com", "https://cdn.jsdelivr.net"],
      // 网络请求来源（fetch/XHR/beacon；CF 统计上报域名仅 webAnalytics 配置 token 时由 autoTrim 保留）
      "connect-src": ["'self'", "https://cloudflareinsights.com"],
      // 音视频来源 | 推荐: ["'self'"]（媒体文件均本地化）
      "media-src": ["'self'"],
      // 插件对象来源（<object>/<embed>） | 推荐: ["'none'"]（彻底禁用,防老式 XSS）
      "object-src": ["'none'"],
      // iframe 嵌入来源（giscus 评论为 iframe） | 推荐: ["https://giscus.app"]
      // 注意: 评论未启用时本指令被 autoTrim 裁空后整条移除
      "frame-src": ["https://giscus.app"],
      // 本页可被哪些页面 iframe 嵌入（CSP3 标准；防点击劫持的第二道锁）
      // 推荐: ["'none'"]（任何来源都不得嵌入本站页面）
      // 不可填: ["'self'"] 之外的来源（除非确有被嵌入需求）
      // 注意: 与 headers 段 X-Frame-Options: DENY 同时保留——旧客户端只认 X-Frame-Options，
      //       现代浏览器以 frame-ancestors 为准，两者语义一致；meta CSP 语境下本指令被忽略
      "frame-ancestors": ["'none'"],
      // Web Worker 来源 | 推荐: ["'self'"]
      "worker-src": ["'self'"],
      // Manifest 来源 | 推荐: ["'self'"]
      "manifest-src": ["'self'"],
      // <base> 标签限制 | 推荐: ["'self'"]（防 base 劫持）
      "base-uri": ["'self'"],
      // 表单提交目标限制 | 推荐: ["'self'"]（防表单劫持外发）
      "form-action": ["'self'"]
    },

    // 仅报告模式
    // 作用: true=发 Content-Security-Policy-Report-Only 头（不拦截,只上报违规）
    // 类型: boolean | 可填: true(上线新策略前观察)/false(强制执行,推荐)
    "reportOnly": false,

    // 违规报告接收地址
    // 作用: 追加 report-uri 指令,浏览器将违规上报到该路径
    // 类型: string（站内路径或 https URL）
    // 推荐: "/csp-report"（需 Worker/服务端配合接收;静态托管无接收端时仅记录于浏览器）
    "reportUri": "/csp-report",

    // <head> 中的 meta CSP 兜底
    // 作用: 在内联 <meta http-equiv="Content-Security-Policy"> 里重复一份 CSP 策略
    // 何时开: 目标托管环境无法设置响应头时——直接用 file:// 打开、
    //   第三方静态托管不读 _headers、CDN 剥离响应头等,需要 meta 作为唯一 CSP 来源
    // 何时关: 默认关闭——Cloudflare Pages 的 _headers 或 Worker 已下发响应头 CSP,
    //   再放一份 meta 只会重复传输（约 0.5–1KB/页）并与响应头策略取交集,
    //   排查 CSP 拦截时也难以分辨来源
    // 类型: boolean | 可填: true(无响应头兜底场景)/false(推荐,响应头为权威)
    // 注意: meta 只能表达强制策略,reportOnly 模式无法通过 meta 生效
    "metaEnabled": false
  },

  // ===================================================================
  // 二、HTTP 安全响应头（基础层;hardening 段可覆盖其中同名项）
  // ===================================================================
  // 均为标准 HTTP 头（IANA / W3C 规范）;值语法详见各规范。

  "headers": {
    // 禁止页面被 iframe 嵌入（防点击劫持）
    // 可填: "DENY"(完全禁止,推荐)/"SAMEORIGIN"(同源允许)
    "X-Frame-Options": "DENY",
    // 禁止 MIME 嗅探（防类型混淆攻击） | 固定 "nosniff"（唯一有效值）
    "X-Content-Type-Options": "nosniff",
    // Referer 发送策略（防隐私泄露）
    // 可填: "strict-origin-when-cross-origin"(推荐)/"no-referrer"(最严格)
    "Referrer-Policy": "strict-origin-when-cross-origin",
    // 浏览器 API 权限策略
    // 可填: "feature=()" 逗号分隔;括号内为允许来源（空=全禁）
    // 推荐: 按需启用（如 geolocation=()/microphone=()/camera=()）
    "Permissions-Policy": "geolocation=(), microphone=(), camera=()",
    // HSTS 强制 HTTPS
    // 可填: "max-age=秒数; includeSubDomains; preload"
    // 注意: 部署必须已全站 HTTPS;被 hardening.hstsMaxAge 覆盖重建
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains; preload",
    // 旧浏览器 XSS 过滤器（该头已被现代浏览器废弃/移除,OWASP 建议不再启用）
    // 作用: 早期 IE/Chrome 的反射型 XSS 审计器;审计器本身曾暴露绕过与信息泄露问题
    // 可填: "0"(推荐,显式关闭)/"1; mode=block"(仅极旧客户端兼容场景)
    // 注意: 现代浏览器均忽略本头;保留 "0" 是为了向旧客户端明确表达“已关闭”
    "X-XSS-Protection": "0",
    // 跨域资源策略
    // 可填: "same-origin"(推荐)/"same-site"/"cross-origin"
    "Cross-Origin-Resource-Policy": "same-origin",
    // 跨域嵌入策略（COEP）
    // 类型: string（枚举） | 可填: "unsafe-none"(默认,推荐)/"require-corp"(启用 SharedArrayBuffer 等需全部资源带 CORP 头)/"credentialless"(实验)
    "Cross-Origin-Embedder-Policy": "unsafe-none",
    // 跨域打开者策略（COOP;防跨窗口引用攻击）
    "Cross-Origin-Opener-Policy": "same-origin"
  },

  // ===================================================================
  // 三、速率限制（由 Workers 层执行;静态托管无效）
  // ===================================================================
  // 数据流: 构建提取本段 → workers/security-config.js → security-worker.js 执行。

  "rateLimiting": {
    // 是否启用限流
    // 类型: boolean | 可填: true/false | 推荐: true（Worker 部署时）
    // 注意: 纯静态托管（无 Worker）时本段不生效
    "enabled": true,

    // 时间窗口内请求上限
    // 类型: number（整数） | 可填: 10–1000 | 推荐: 100 | 不可填: 0/负数（全部拦截）
    "maxRequests": 100,

    // 时间窗口
    // 类型: number（毫秒） | 可填: 10000–300000 | 推荐: 60000（1 分钟）
    "windowMs": 60000,

    // 超限封禁时长
    // 类型: number（毫秒） | 可填: 60000–3600000 | 推荐: 300000（5 分钟）
    "blockDuration": 300000,

    // IP 白名单（不限流）
    // 类型: string[]（IP 或 CIDR） | 可填: ["192.168.1.1","10.0.0.0/8"] | 推荐: 默认占位按需清理
    "whitelist": ["192.168.1.1"],

    // IP 黑名单（始终封禁）
    // 类型: string[]（IP 或 CIDR） | 不可填: 泛化网段（可能误伤） | 推荐: 默认空按需添加
    "blacklist": [],

    // 不计限流的静态资源路径前缀（避免正常浏览单页引用上百个子资源时误触 429）
    // 作用: 命中这些前缀的 GET/HEAD 请求不消耗限流额度
    // 类型: string[]（以 / 开头的路径前缀）
    // 可填: ["/assets/","/media/","/og/","/icons/","/pagefind/"]
    // 推荐: 默认列表;空数组 = 不跳过任何路径（全部计入限流，严格计数）
    "skipPaths": ["/assets/", "/media/", "/og/", "/icons/", "/pagefind/"]
  },

  // ===================================================================
  // 四、robots.txt（爬虫协议;遵循 RFC 9309）
  // ===================================================================

  "robots": {
    // 是否生成 robots.txt
    // 作用: 输出 dist/robots.txt 供搜索引擎读取
    // 类型: boolean | 可填: true/false | 推荐: true
    "enabled": true,

    // 规则列表（按顺序输出为多组 User-agent 段）
    // 字段: userAgent 适用爬虫（"*" 通配）/ allow 允许路径 / disallow 禁止路径
    // 不可填: 空 userAgent;路径需以 / 开头
    // 推荐: 默认全放行 + 屏蔽敏感路径（如 /admin）
    "rules": [
      { "userAgent": "*", "allow": "/", "disallow": "/admin" },
      { "userAgent": "Googlebot", "allow": "/" }
    ],

    // sitemap 地址（追加 Sitemap: 行,自动拼接 site.url）
    // 类型: string（以 / 开头） | 推荐: "/sitemap.xml"
    "sitemap": "/sitemap.xml"
  },

  // ===================================================================
  // 五、路径访问限制（Workers 层;静态托管无效）
  // ===================================================================

  // 受保护路径列表
  // 字段: path 匹配模式（支持 /admin/* 通配;匹配时解码 %xx 并忽略大小写）
  //       requireAuth 是否要求登录（未接入鉴权提供方时保持拦截, fail-closed）
  //       allowedIPs 允许的 IP/CIDR（如 "10.0.0.0/8"、"2001:db8::/32";命中者放行该路径）
  // 类型: 数组[{path,requireAuth?,allowedIPs?}]
  // 不可填: 空 path;与站点实际路径不匹配的模式（配置无效）
  // 推荐: 无受保护目录时置为 []
  "pathRestrictions": [
    {
      "path": "/admin/*",
      "requireAuth": true,
      "allowedIPs": ["192.168.1.0/24"]
    }
  ],

  // ===================================================================
  // 六、HTTPS 强制与自定义响应头
  // ===================================================================

  // 强制 HTTPS 跳转
  // 作用: Worker 将 HTTP 请求 301 到 HTTPS（静态托管由平台自带 HTTPS 处理）
  // 类型: boolean | 可填: true(推荐)/false
  "forceHttps": true,

  // 自定义响应头
  // 作用: 追加任意响应头到 _headers（key-value,与 headers 段合并输出）
  // 类型: { [头名]: 值 }
  // 不可填: 与内置头重复的键名（会被覆盖或重复输出,请改用 headers 段）
  // 推荐: {}（默认空）
  "customHeaders": {},

  // ===================================================================
  // 七、安全加固（覆盖 headers 段中的同名项;Workers 与 _headers 双端同步）
  // ===================================================================

  "hardening": {
    // HSTS 有效期
    // 作用: 覆盖 headers 中的 Strict-Transport-Security 的 max-age
    // 类型: number（秒） | 可填: 86400–63072000 | 推荐: 31536000（1 年）
    // 注意: 仅 HTTPS 生效;首次上线建议先用较短时长
    "hstsMaxAge": 31536000,

    // HSTS 覆盖子域名
    // 类型: boolean | 可填: true(推荐,所有子域强制 HTTPS)/false
    "hstsIncludeSubDomains": true,

    // HSTS preload 标记（加入浏览器预载列表;提交 hstspreload.org 后不可轻易回退）
    // 作用: 在 max-age/includeSubDomains 之后追加 "; preload"
    // 类型: boolean | 可填: true(保留 preload,推荐)/false(移除)
    // 不可填: 未提交预载列表时保持 true 会提前声明意图（无害但需知悉）
    "hstsPreload": true,

    // Referrer-Policy 覆盖值
    // 类型: string | 可填: 同 headers 段的 Referrer-Policy 取值 | 推荐: "strict-origin-when-cross-origin"
    "referrerPolicy": "strict-origin-when-cross-origin",

    // Permissions-Policy 覆盖值
    // 类型: object{功能名: 允许来源} | 可填: {"camera": "()"}（禁用)
    // 推荐: {}（不覆盖 headers 段的值）
    "permissionsPolicy": {},

    // CORS 允许来源
    // 作用: 非空时输出 Access-Control-Allow-Origin 头（多个来源逗号拼接）
    // 类型: string[] | 可填: ["https://a.com"];不可填: ["*"]（配合凭证时违规）
    // 推荐: []（不发送 CORS 头,同源策略最安全）
    "corsAllowedOrigins": [],

    // X-XSS-Protection 覆盖值
    // 类型: string | 推荐: "0"（显式关闭,理由见 headers 段同名项注释）
    "xssProtection": "0"
  }
}

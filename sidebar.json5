// =====================================================================
// sidebar.json5 — 侧栏（开关 / 外观 / 组件列表）
// ---------------------------------------------------------------------
// 格式: JSON5（允许注释/尾逗号/无引号键名）
// 生效: 修改后需重新构建（npm run build / npm run serve）
// 注释模板: 作用 / 类型 / 可填值及含义 / 不可填值及原因 / 推荐 / 注意
// 说明: 侧栏位置（left/right）由 theme.layout.sidebarPosition 控制;
//       移动端抽屉行为由响应式 CSS 自动处理（无需配置）
// =====================================================================
{
  // ===================================================================
  // 一、侧栏总开关
  // ===================================================================

  // 是否启用侧栏
  // 作用: 全站右侧/左侧边栏的显示总开关（文章页与首页/列表页同时生效）
  // 类型: boolean | 可填: true/false | 推荐: true
  // 注意: 关闭后内容区自动居中加宽;文章 TOC 不受影响
  "enabled": true,

  // ===================================================================
  // 二、外观选项（单开关源:此处优先于 sidebar 根级旧键）
  // ===================================================================

  "options": {
    // 侧栏宽度
    // 作用: --sw 侧栏列宽（默认 318px = 目录 200 × φ 的取整微调）
    // 类型: string（CSS 长度） | 可填: "240px"–"360px" | 推荐: "318px"
    // 注意: 需与 theme.density.sidebarWidth 保持同一量级,避免布局断点错位
    "width": "318px",

    // 组件垂直间距
    // 作用: 侧栏组件（卡片）之间的 margin-bottom
    // 类型: string（CSS 长度） | 可填: "0.75rem"–"2.5rem" | 推荐: "1.618rem"（φ）
    "gap": "1.618rem",

    // 组件圆角
    // 类型: string（CSS 长度） | 可填: 与全局圆角一致的档位值 | 推荐: "0.618rem"
    "radius": "0.618rem",

    // 组件内边距
    // 类型: string（CSS 长度） | 可填: ".75rem"–"1.5rem" | 推荐: "1rem"
    "padding": "1rem",

    // 组件标题字号
    // 类型: string（CSS 长度） | 可填: ".8125rem"–"1.125rem" | 推荐: ".9375rem"（15px）
    "titleSize": ".9375rem",

    // 组件标题字重
    // 类型: number | 可填: 500–800 | 推荐: 600
    "titleWeight": 600,

    // 组件悬停上浮
    // 作用: 鼠标悬停组件时轻微上移（-2px）+ 过渡
    // 类型: boolean | 可填: true/false | 推荐: true
    "hoverLift": true,

    // 组件描边
    // 作用: 为组件添加 1px 边框（默认仅用阴影分隔）
    // 类型: boolean | 可填: true/false | 推荐: false（阴影层次更轻）
    "borderShow": false
  },

  // ===================================================================
  // 三、组件列表（数组顺序即显示顺序;enabled=false 的项会被跳过）
  // ===================================================================
  // 每个组件通用字段:
  //   type    组件类型（不可填未支持的类型,可选值见下方各段）
  //   enabled 该项开关
  //   title   组件标题（中文）;缺省时使用各类型内置默认文案
  //   titleEn 组件标题（英文）
  //   —— 文本类字段统一遵循「*En 后缀」约定:en 站优先取 *En,空 = 回退中文值 ——
  //   bioEn / placeholderEn / buttonTextEn / htmlEn 分别对应 bio / placeholder / buttonText / html

  // 每个部件可选 "icon" 字段（内置图标: clock 时钟/folder 文件夹/tags 标签/archive 归档/collection 合集/chart 图表/quote 引号/image 图片/link 链接/info 信息/book 书本/search 搜索/rss 订阅/download 下载/home 首页）。
  "widgets": [
    // 作者卡片（类型: author）
    // 字段: avatar 头像图片路径（空则按 theme.avatar.badge 生成首字母徽章）
    //       bio    个人简介（一句话,空则不显示）
    //       bioEn  简介英文版（en 站使用;空 = 回退 bio）
    {
      "type": "author",
      "icon": "info",
      "enabled": true,
      "title": "关于我",
      "titleEn": "About Me",
      "avatar": "/media/avatar.svg",
      "bio": "全栈开发者，热爱开源",
      "bioEn": "Full-stack developer and open-source enthusiast"
    },
    // 最新文章（类型: recent）
    // 字段: count    显示条数（1–20）
    //       showDate 是否在条目下方显示日期（bool）
    {
      "type": "recent",
      "icon": "clock",
      "enabled": true,
      "title": "最新文章",
      "titleEn": "Recent Posts",
      "count": 5,
      "showDate": true
    },
    // 标签云（类型: tags）
    // 字段: limit    最多显示标签数（1–50;缺省不限）
    //       showCount 是否显示每标签文章数（bool）
    //       sortBy   排序方式: count(按文章数,推荐)/name(按名称)
    //       minCount 过滤阈值: 仅显示文章数 ≥ 该值的标签（1 = 不过滤）
    {
      "type": "tags",
      "icon": "tags",
      "enabled": true,
      "title": "标签云",
      "titleEn": "Tag Cloud",
      "limit": 20,
      "showCount": true,
      "sortBy": "count",
      "minCount": 1
    },
    // 分类列表（类型: categories）
    // 字段: showCount 是否显示每分类文章数（bool）
    {
      "type": "categories",
      "icon": "folder",
      "enabled": true,
      "title": "分类",
      "titleEn": "Categories",
      "showCount": true
    },
    // 归档入口（类型: archive）
    // 字段: showCount 是否显示每月文章数（bool）
    {
      "type": "archive",
      "icon": "archive",
      "enabled": true,
      "title": "归档",
      "titleEn": "Archive",
      "showCount": true
    },
    // 系列文章（类型: series;存在系列文章时自动显示）
    // 字段: count 最多显示系列数（1–20）
    {
      "type": "series",
      "icon": "collection",
      "enabled": true,
      "title": "系列文章",
      "titleEn": "Series",
      "count": 8
    },
    // 搜索框（类型: search;点击/回车打开全站搜索弹层）
    // 字段: placeholder 输入框占位文字
    //       placeholderEn 占位文字英文版（en 站使用;空 = 回退 placeholder / ui-strings）
    {
      "type": "search",
      "icon": "search",
      "enabled": true,
      "title": "搜索",
      "titleEn": "Search",
      "placeholder": "输入关键词...",
      "placeholderEn": "Type a keyword..."
    },
    // 站点统计（类型: stats;默认关闭）
    // 字段: 无（数据自动计算:文章数/总字数/标签数/分类数）
    // 注意: 需 features.stats.enabled 且 features.stats.showSidebar 不为 false
    {
      "type": "stats",
      "icon": "chart",
      "enabled": false,
      "title": "站点统计",
      "titleEn": "Site Stats"
    },
    // 自定义 HTML（类型: custom;直接注入原始 HTML 片段）
    // 字段: html 任意 HTML（构建时按原文输出）
    //       htmlEn 自定义 HTML 英文版（en 站使用;空 = 回退 html）
    // 不可填: 不受信任的第三方脚本（受 security.json5 CSP 限制且存在安全风险）
    {
      "type": "custom",
      "enabled": false,
      "title": "自定义位",
      "titleEn": "Custom",
      "html": "<div>自定义内容</div>",
      "htmlEn": "<div>Custom content</div>"
    },
    // 邮件订阅（类型: newsletter）
    // 字段: provider        订阅服务商（当前支持 mailchimp）
    //       mailchimpAction Mailchimp 表单 action URL（以 https:// 开头的托管表单地址）
    //       buttonText      订阅按钮文字（buttonTextEn 为英文版;空 = 回退按钮中文值/内置文案）
    //       placeholder     邮箱输入框占位文字（placeholderEn 为英文版;空 = 回退中文值）
    // 不可填: 空 action（表单无法提交;将保持占位 "#"）
    // 注意: 表单以新窗口提交到服务商页面,本站不处理订阅数据
    {
      "type": "newsletter",
      "enabled": false,
      "title": "订阅更新",
      "titleEn": "Subscribe",
      "provider": "mailchimp",
      "mailchimpAction": "",
      "buttonText": "订阅",
      "buttonTextEn": "Subscribe",
      "placeholder": "输入邮箱",
      "placeholderEn": "Email address"
    },
    // 每日一言（类型: quote;文案与刷新频率见 features.dailyQuote）
    // 字段: 无（标题缺省使用 features.dailyQuote.label）
    {
      "type": "quote",
      "icon": "quote",
      "enabled": true,
      "title": "每日一言",
      "titleEn": "Daily Quote"
    }
  ]
}

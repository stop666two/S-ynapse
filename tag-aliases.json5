// =====================================================================
// tag-aliases.json5 — 标签别名（多对一归一化）
// ---------------------------------------------------------------------
// 作用: 把文章中写的标签名归一化到标准名。
//       例如写 "javascript" / "js" / "JS" 的文章都归到 "JavaScript" 标签页下。
// 格式: JSON5;生效: 修改后需重新构建
// 为可选文件;不配置或 enabled=false 时标签按文章原文原样聚合与展示
// 注释模板: 作用 / 类型 / 可填值及含义 / 不可填值及原因 / 推荐 / 注意
// =====================================================================
{
  // 别名归一化总开关
  // 作用: false 时忽略 aliases 映射（便于对比原始标签效果）
  // 类型: boolean | 可填: true(推荐)/false
  enabled: true,

  // 别名映射表（键 = 文章中的写法,值 = 归一化后的标准标签名）
  // 类型: object<{ 别名: 标准名 }>
  // 匹配顺序: 先精确匹配键名 → 再按键名小写匹配（大小写不敏感回退）
  // 可填: 键建议统一用小写（"js"/"javascript"）;值用规范展示名（"JavaScript"）
  // 不可填: 空值（标准名为空会导致标签丢失）;一个键映射到多个目标（不支持）
  // 推荐: 只收录实际会在文章中混用的变体;定期清理未使用的键
  // 注意: 值的大小写即最终展示效果（"C++" 不会被改写）;
  //       未出现在映射中的标签名保持不变
  aliases: {
    js: "JavaScript",
    javascript: "JavaScript",
    ts: "TypeScript",
    typescript: "TypeScript",
    cpp: "C++",
    golang: "Go",
    react: "React",
    // 示例：cn: "Chinese",
  },
}

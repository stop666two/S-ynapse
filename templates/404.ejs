<div class="error-page">
  <div class="error-art">
    <svg class="error-svg" viewBox="0 0 600 320" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="404 illustration">
      <defs>
        <linearGradient id="eg1" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="var(--color-s)"/>
          <stop offset="1" stop-color="var(--color-a)"/>
        </linearGradient>
      </defs>
      <circle cx="300" cy="160" r="120" fill="var(--color-background)" stroke="var(--color-s)" stroke-width="2" opacity="0.25"/>
      <ellipse cx="300" cy="272" rx="180" ry="16" fill="var(--color-s)" opacity="0.08"/>
      <path d="M300 60 a100 100 0 0 1 70 170" stroke="var(--color-a)" stroke-width="3" stroke-dasharray="6 8" opacity="0.5" fill="none"/>
      <circle cx="160" cy="90" r="4" fill="var(--color-s)" opacity="0.5"/>
      <circle cx="452" cy="230" r="5" fill="var(--color-a)" opacity="0.6"/>
      <circle cx="120" cy="226" r="3" fill="var(--color-ts)" opacity="0.4"/>
      <circle cx="486" cy="86" r="3" fill="var(--color-ts)" opacity="0.35"/>
      <!-- satellite -->
      <g transform="translate(300 150)">
        <rect x="-46" y="-20" width="92" height="40" rx="8" fill="var(--color-surface)" stroke="var(--color-s)" stroke-width="3"/>
        <circle cx="0" cy="0" r="12" fill="var(--color-background)" stroke="var(--color-a)" stroke-width="4"/>
        <path d="M-64 -16 H-46 M-64 8 H-46" stroke="var(--color-s)" stroke-width="8" stroke-linecap="round"/>
        <path d="M46 -16 H64 M46 8 H64" stroke="var(--color-s)" stroke-width="8" stroke-linecap="round"/>
        <path d="M-46 -20 L-46 -34 M46 -20 L46 -34" stroke="var(--color-ts)" stroke-width="2" opacity="0.6"/>
      </g>
      <!-- floating 4 0 4 digits -->
      <g font-family="var(--ff-mono)" font-weight="800" font-size="72" opacity="0.14">
        <text x="86" y="86" fill="var(--color-s)">4</text>
        <text x="376" y="288" fill="var(--color-a)">4</text>
        <text x="500" y="120" fill="var(--color-s)">0</text>
      </g>
    </svg>
  </div>
  <h1 class="error-code"><b>4</b>0<b>4</b></h1>
  <h2 class="error-heading" data-i18n="notFound.title"><%= ui('notFound.title', '页面走丢了') %></h2>
  <p class="error-message" data-i18n="notFound.desc"><%= ui('notFound.desc', '您访问的页面不存在或已被移除。') %></p>
  <div class="error-actions">
    <a href="<%= (typeof langPrefix!=='undefined' ? langPrefix : '/zh/') %>" class="btn btn-primary" data-i18n="notFound.backHome"><%= ui('notFound.backHome', '返回首页') %></a>
    <button type="button" class="btn btn-outline" id="errSearchBtn" data-i18n="notFound.searchSite"><%= ui('notFound.searchSite', '站内搜索') %></button>
  </div>
  <% if (typeof recentPosts !== 'undefined' && recentPosts && recentPosts.length) { %>
    <div class="error-suggest">
      <div class="error-suggest-title" data-i18n="notFound.hotArticles"><%= ui('notFound.hotArticles', '热门文章') %></div>
      <div class="error-suggest-list">
        <% recentPosts.slice(0, 5).forEach(function(p) { %>
          <a class="error-suggest-item" href="<%= p.url %>">
            <span class="error-suggest-badge">›</span>
            <span class="error-suggest-name"><%= p.title %></span>
            <span class="error-suggest-date"><%= formatDate(p.date) %></span>
          </a>
        <% }); %>
      </div>
    </div>
  <% } %>
</div>

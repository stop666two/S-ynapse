<%# 
  Archive page — lists all articles grouped by year (from groupByYearMonth()).
  Data contract:
    archives: Array<{year, month, articles: Array<{formattedDate, date, url, title}>, label}>
%>
<div class="post-article">
<h1><%= ui('archive.title','归档') %></h1>

<% if (typeof siteStats !== 'undefined' && siteStats && siteStats.posts > 0) { %>
<div class="stats-grid">
  <div class="stats-card"><div class="stats-value"><%= siteStats.posts %></div><div class="stats-label"><%= ui('archive.statPosts','文章总数') %></div></div>
  <div class="stats-card"><div class="stats-value"><%= siteStats.days %></div><div class="stats-label"><%= ui('archive.statDays','发文天数') %></div></div>
  <div class="stats-card"><div class="stats-value"><%= siteStats.words.toLocaleString() %></div><div class="stats-label"><%= ui('archive.statWords','总字数') %></div></div>
  <div class="stats-card"><div class="stats-value"><%= siteStats.avgPerDay %></div><div class="stats-label"><%= (typeof lang!=='undefined'&&lang==='en'&&features.stats&&features.stats.labelAvgPerDayEn)?features.stats.labelAvgPerDayEn:((features.stats&&features.stats.labelAvgPerDay)||ui('archive.statAvg','日均篇数')) %></div></div>
  <div class="stats-card"><div class="stats-value"><%= siteStats.tags %></div><div class="stats-label"><%= ui('archive.statTags','标签数') %></div></div>
  <div class="stats-card"><div class="stats-value"><%= siteStats.categories %></div><div class="stats-label"><%= ui('archive.statCats','分类数') %></div></div>
</div>
<% } %>

<% if (archives && archives.length) { %>
<% var MAXC = archives.reduce(function(m,g){ var c=g.articles.length; return c>m?c:m; }, 0); %>
<% archives.forEach(function(group) { %>
<div class="archive-year">
  <h2 class="archive-year-title"><%= group.year %></h2>
  <div class="cal-heat" aria-label="<%= group.year %> <%= ui('archive.heatmap','年每月') %><%= ui('archive.textArticle','文章') %><%= ui('archive.heatmapSuffix','热力图') %>">
    <% for (var mo = 1; mo <= 12; mo++) { %>
    <% var cnt = 0; group.articles.forEach(function(a){ var mm=parseInt(a.month,10); if(mm===mo) cnt++; }); %>
    <% var lvl = cnt===0 ? 'l0' : (MAXC<=2 ? 'l'+Math.min(cnt+1,5) : 'l'+Math.max(1,Math.min(5,Math.ceil(cnt/MAXC*5)))); %>
    <div class="cal-cell <%= lvl %>" title="<%= group.year %>-<%= mo %>: <%= cnt %> <%= ui('archive.postUnit','篇') %>"><%= mo %></div>
    <% } %>
  </div>
  <div class="archive-month">
    <ul class="archive-list">
      <% group.articles.forEach(function(article) { %>
      <li class="archive-item">
        <span class="archive-date"><%= article.formattedDate || article.date %></span>
        <a href="<%= article.url %>" class="archive-link"><% if (article.pinned) { %><span class="pin-badge"><%= ui('card.pinned','置顶') %></span> <% } %><%= article.title %></a>
      </li>
      <% }) %>
    </ul>
  </div>
</div>
<% }) %>
<div class="cal-legend"><span><%= ui('archive.count','文章') %></span><i class="cal-cell l0" style="background:<%=(features.heatmap&&features.heatmap.emptyColor)||'var(--color-hover)'%>"></i><i class="cal-cell l1"></i><i class="cal-cell l2"></i><i class="cal-cell l4"></i><span><%= ui('archive.legend','少 → 多') %></span></div>
<% } else { %>
<p style="color:var(--color-text-secondary)"><%= ui('archive.empty','暂无归档') %></p>
<% } %>
</div>

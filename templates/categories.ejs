<div class="post-article">
<h1><%= ui('category.title','分类') %></h1>

<% if (allCategories && allCategories.length) { %>
<div class="categories-list">
  <% allCategories.forEach(function(cat) { %>
  <div class="category-item">
    <a href="<%= cat.url %>" class="category-link"><%= cat.name %></a>
    <span class="category-count"><%= ui('category.postCount','{count} 篇文章').replace('{count}', cat.count) %></span>
  </div>
  <% }) %>
</div>
<% } else { %>
<p class="empty-state"><%= ui('category.empty','暂无分类') %></p>
<% } %>
</div>

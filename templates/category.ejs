<div class="post-article">
  <h1><%= ui('category.title','分类') %>: <%= categoryName %></h1>
  <p class="category-count"><%= articles.length %> <%= ui('category.postCount','篇文章') %></p>
</div>

<% if (articles && articles.length) { %>
<div class="blog-grid">
<% var _pcfg=(typeof pinnedCfg!=='undefined'&&pinnedCfg)||{showBadge:true,badgeStyle:'pill'}; articles.forEach(function(article) { %>
<article class="post-card">
  <h2 class="post-card-title">
    <% if (article.pinned && _pcfg.showBadge) { %><span class="pin-badge<%= _pcfg.badgeStyle==='corner'?' pin-badge-corner':'' %>"><%= (typeof pinnedText==='function')?pinnedText(typeof lang!=='undefined'?lang:'zh'):ui('card.pinned','置顶') %></span><% } %>    <% if (article.series && !(features.series&&features.series.showBadge===false)) { %><span class="series-badge"><%= (typeof seriesBadge==='function')?seriesBadge(article.series, typeof lang!=='undefined'?lang:'zh'):ui('card.series','系列') %></span><% } %>
    <a href="<%= article.url %>"><%= article.title %></a>
  </h2>
  <div class="post-card-meta">
    <% if (theme.card && theme.card.showDate && article.date) { %>
    <span><%= article.formattedDate || article.date %></span>
    <% } %>
    <% if (article.tags && article.tags.length) { %>
    <span>
      <% article.tags.forEach(function(tag) { %>
      <a href="<%= (typeof langPrefix!=='undefined' ? langPrefix : '/zh/') %>tags/<%= generateSlug(tag) %>/" class="post-tag"><%= tag %></a>
      <% }) %>
    </span>
    <% } %>
<% if (theme.card && theme.card.showWordCount && article.wordCount && !(features.wordCount&&(features.wordCount.enabled===false||features.wordCount.onCards===false))) { %>
    <span><%= (typeof wordCountLabel==='function')?wordCountLabel(article.wordCount, typeof lang!=='undefined'?lang:'zh'):ui('card.wordUnit','{count} 字').replace('{count}', article.wordCount) %></span>
    <% } %>
    <% if (theme.card && theme.card.showReadTime && article.readTime) { %>
    <span><%= (typeof readTimeLabel==='function')?readTimeLabel(article.readTime, typeof lang!=='undefined'?lang:'zh'):ui('card.minute','{minutes} 分钟阅读').replace('{minutes}', article.readTime) %></span>
    <% } %>
  </div>
  <% if (theme.card && theme.card.showExcerpt && article.excerpt) { %>
  <p class="post-card-excerpt"><%= article.excerpt %></p>
  <% } %>
</article>
<% }) %>
</div>
<% } else { %>
<div class="post-article"><p class="empty-state-ts"><%= ui('category.empty','该分类下暂无文章') %></p></div>
<% } %>


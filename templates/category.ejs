<div class="post-article">
  <h1>分类: <%= categoryName %></h1>
  <p style="color:var(--color-ts);margin-bottom:1.5rem"><%= articles.length %> 篇文章</p>
</div>

<% if (articles && articles.length) { %>
<% articles.forEach(function(article) { %>
<article class="post-card">
  <h2 class="post-card-title">
    <a href="<%= article.url %>"><%= article.title %></a>
  </h2>
  <div class="post-card-meta">
    <% if (theme.card && theme.card.showDate && article.date) { %>
    <span><%= article.formattedDate || article.date %></span>
    <% } %>
    <% if (article.tags && article.tags.length) { %>
    <span>
      <% article.tags.forEach(function(tag) { %>
      <a href="/tags/<%= generateSlug(tag) %>/" class="post-tag"><%= tag %></a>
      <% }) %>
    </span>
    <% } %>
    <% if (theme.card && theme.card.showReadTime && article.readTime) { %>
    <span><%= article.readTime %> 分钟</span>
    <% } %>
  </div>
  <% if (theme.card && theme.card.showExcerpt && article.excerpt) { %>
  <p class="post-card-excerpt"><%= article.excerpt %></p>
  <% } %>
</article>
<% }) %>
<% } else { %>
<div class="post-article"><p style="text-align:center;padding:2rem;color:var(--color-ts)">该分类下暂无文章</p></div>
<% } %>

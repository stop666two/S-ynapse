<%# 
  Favorites page — client-side rendered list of bookmarked articles.
  Data contract: none static; JS reads localStorage (s-favorites) and renders.
%>
<div class="post-article">
<h1><%= ui('favorites.title','我的收藏') %></h1>
<p class="fav-page-desc"><%= ui('favorites.hint','点击文章标题访问') %>，点击 × <%= ui('favorites.remove','从收藏中移除') %>。<%= ui('favorites.storedLocally','存储于本地浏览器') %>。</p>
<div id="favPageList" class="fav-page-list"></div>
</div>

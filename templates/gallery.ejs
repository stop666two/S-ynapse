<%# 
  Gallery page — masonry grid of every image referenced by published articles.
  Data contract:
    galleryItems: Array<{src, title, url, alt}>  (newest article first)
  Clicking an image opens the shared lightbox (collects .gallery img).
%>
<div class="post-article">
<% var _gen=(typeof lang!=='undefined'&&lang==='en'); var _g=features.gallery||{}; %>
<h1><%= (_gen&&_g.titleEn)?_g.titleEn:(_g.title||ui('gallery.title','图库')) %></h1>
<% if (typeof galleryItems !== 'undefined' && galleryItems && galleryItems.length) { %>
<p class="gallery-desc"><%= ui('gallery.count','共 {count} 张图片').replace('{count}', galleryItems.length) %> · <%= (_gen&&_g.descriptionEn)?_g.descriptionEn:(_g.description||ui('gallery.desc','站内图片集，点击查看大图。')) %></p>
<div class="gallery-grid" id="galleryGrid">
  <% galleryItems.forEach(function(g) { %>
  <figure class="gallery-item">
    <img src="<%= g.src %>"<% if(typeof imgDimsAttrs==='function'){ %> <%- imgDimsAttrs(g.src) %><% } %> alt="<%= g.alt %>" loading="lazy">
    <% if(features.gallery&&features.gallery.showCaption!==false){ %>
    <figcaption class="gallery-caption">
      <% if(features.gallery.showSource!==false){ %><a href="<%= g.url %>" class="gallery-link"><%= g.title %></a><% } %>
    </figcaption>
    <% } %>
  </figure>
  <% }) %>
</div>
<% } else { %>
<p class="gallery-empty"><%= (_gen&&_g.emptyTextEn)?_g.emptyTextEn:(_g.emptyText||ui('gallery.empty','暂无图片')) %>。</p>
<% } %>
</div>

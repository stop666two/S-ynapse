<%# 
  Index page template — renders article cards with pagination.
  Data contract:
    articles: Array<{title, url, featuredImage, formattedDate, date, categories, tags, readTime, excerpt}>
    pagination: {current, total, prev, next, prevLabel, nextLabel, pages: Array<{num, url, current}>}
    theme.card: {showDate, showCategories, showReadTime, showExcerpt, showTags}
%>
<% if (heroData) { %>
<section class="hero">
  <h1><%= heroData.title %></h1>
  <% if (heroData.subtitle) { %><p class="hero-sub"><%= heroData.subtitle %></p><% } %>
  <% if (heroData.showDate && heroData.date) { %><div class="hero-date"><%= heroData.date %></div><% } %>
  <div class="hero-actions">
    <% if (heroData.showSearch) { %><button type="button" class="hero-search"><%= ui('toolbar.searchPlaceholder','搜索文章…') %></button><% } %>
    <% if (heroData.showCta) { %><span class="hero-cta"><a href="<%= heroData.ctaUrl %>"><%= heroData.ctaLabel %></a></span><% } %>
  </div>
  <% if (heroData.showTags && heroData.tags && heroData.tags.length) { %>
  <div class="hero-tags">
    <% heroData.tags.forEach(function(t) { %><a href="<%= t.url %>"><%= t.name %><% if (t.count) { %> · <%= t.count %><% } %></a><% }) %>
  </div>
  <% } %>
</section>
<% } %>
<% if (typeof features!=='undefined'&&features.readingHistory&&features.readingHistory.enabled!==false) { %>
<div class="reading-history" id="readingHistory" hidden></div>
<% } %>
<% if (articles && articles.length) { %>
<div class="blog-grid<%= (typeof tuning!=='undefined'&&tuning.card&&tuning.card.bentoFeatured===false)?'':' bento' %>">
<% var _bentoOn = !(typeof tuning!=='undefined'&&tuning.card&&tuning.card.bentoFeatured===false); %>
<% var _catCss = []; %>
<% articles.forEach(function(article, _ai) { %>
<article class="post-card<%= (typeof features!=='undefined'&&features.cardFx&&features.cardFx.enabled!==false&&features.cardFx.hoverShine!==false)?' card-shine':'' %>">
  <% if (article.featuredImage && listCoverEnabled) { %>
  <a href="<%= article.url %>" class="card-media">
    <img <%- cardImgAttrs(article.featuredImage) %> alt="<%= article.title %>"<% if (!(typeof features!=='undefined'&&features.viewTransition&&features.viewTransition.shared===false) && !(_bentoOn && articles.indexOf(article)===0)) { %> data-vt="cover-<%= article.slug %>"<% } %> class="post-card-image" loading="<%= _ai===0 ? 'eager' : 'lazy' %>"<% if (_ai===0) { %> fetchpriority="high"<% } %>>
    <% if (typeof features!=='undefined'&&features.cardFx&&features.cardFx.enabled!==false&&features.cardFx.coverOverlay!==false) { %><span class="card-overlay" aria-hidden="true"></span><% } %>
    <% if (typeof features!=='undefined'&&features.cardFx&&features.cardFx.enabled!==false&&features.cardFx.categoryChip!==false&&article.categories&&article.categories.length) { _catCss.push('.card-cat-h'+_ai+'{--cat-h:'+categoryHue(article.categories[0])+'}'); %><span class="card-cat card-cat-h<%= _ai %>"><%= article.categories[0] %></span><% } %>
    <% if (typeof features!=='undefined'&&features.cardFx&&features.cardFx.enabled!==false&&features.cardFx.readTimeBadge!==false&&article.readTime) { %><span class="card-time"><%= ui('card.minute','{minutes} 分钟阅读').replace('{minutes}', article.readTime) %></span><% } %>
  </a>
  <% } else if (listCoverEnabled && listCoverFallback !== 'none') { %>
  <a href="<%= article.url %>" class="post-card-nocover" aria-hidden="true" tabindex="-1"><%= article.title %></a>
  <% } %>
  <h2 class="post-card-title">
    <% if (article.pinned) { %><span class="pin-badge"><%= ui('card.pinned','置顶') %></span><% } %><% if (article.series) { %><span class="series-badge"><%= ui('card.series','系列') %></span><% } %>
    <a href="<%= article.url %>"<% if (!(typeof features!=='undefined'&&features.viewTransition&&features.viewTransition.shared===false)) { %> data-vt="title-<%= article.slug %>"<% } %>><%= article.title %></a>
  </h2>
  <div class="post-card-meta">
    <% if (theme.card && theme.card.showDate && article.date) { %>
    <span><%= article.formattedDate || article.date %></span>
    <% } %>
    <% if (theme.card && theme.card.showCategories && article.categories && article.categories.length) { %>
    <span>
      <% article.categories.forEach(function(cat, i) { %>
      <a href="<%= (typeof langPrefix!=='undefined' ? langPrefix : '/zh/') %>categories/<%= generateSlug(cat) %>/"><%= cat %></a><% if (i < article.categories.length - 1) { %>, <% } %>
      <% }) %>
    </span>
    <% } %>
<% if (theme.card && theme.card.showWordCount && article.wordCount) { %>
    <span><%= ui('card.wordUnit','{count} 字').replace('{count}', article.wordCount) %></span>
    <% } %>
    <% if (theme.card && theme.card.showReadTime && article.readTime) { %>
    <span><%= ui('card.minute','{minutes} 分钟阅读').replace('{minutes}', article.readTime) %></span>
    <% } %>
  </div>
  <% if (theme.card && theme.card.showExcerpt && article.excerpt) { %>
  <p class="post-card-excerpt"><%= article.excerpt %></p>
  <% } %>
  <% if (theme.card && theme.card.showTags && article.tags && article.tags.length) { %>
  <div class="post-tags card-tags">
    <% article.tags.forEach(function(tag) { %>
    <a href="<%= (typeof langPrefix!=='undefined' ? langPrefix : '/zh/') %>tags/<%= generateSlug(tag) %>/" class="post-tag"><%= tag %></a>
    <% }) %>
  </div>
  <% } %>
</article>
<% }) %>
<% if (_catCss.length) { %><style><%- _catCss.join('') %></style><% } %>
</div>
<% if (pagination && pagination.total > 1) { %>
<nav class="pagination" aria-label="<%= ui('pagination.label','分页导航') %>">
  <% if (pagination.prev) { %>
  <a href="<%= pagination.prev %>" class="page-link">&laquo; <%= pagination.prevLabel %></a>
  <% } else { %>
  <span class="page-link disabled" aria-hidden="true">&laquo; <%= pagination.prevLabel %></span>
  <% } %>

  <% pagination.items.forEach(function(p) { %>
  <% if (p.ellipsis) { %><span class="page-link ellipsis" aria-hidden="true">…</span><% } else { %><a href="<%= p.url %>" class="page-link <%= p.current ? 'active' : '' %>"<%= p.current ? ' aria-current="page"' : '' %>><%= p.num %></a><% } %>
  <% }) %>

  <% if (pagination.next) { %>
  <a href="<%= pagination.next %>" class="page-link"><%= pagination.nextLabel %> &raquo;</a>
  <% } else { %>
  <span class="page-link disabled" aria-hidden="true"><%= pagination.nextLabel %> &raquo;</span>
  <% } %>
</nav>
<% } %>
<% } else { %>
<div class="empty-hero">
  <p><%= ui('card.empty','暂无文章') %></p>
</div>
<% } %>


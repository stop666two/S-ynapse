    .fav-page-item:hover{border-color:var(--color-a)}
    .fav-page-item .fav-remove{background:none;border:none;color:var(--color-ts);cursor:pointer;font-size:1rem}
    .fav-page-item .fav-remove:hover{color:#e5484d}
    .fav-empty{text-align:center;color:var(--color-ts);padding:3rem 0}
    /* prism theme switcher */
    .code-windowbar{display:flex;justify-content:space-between;align-items:center;background:var(--color-surface-2,#1f2430);padding:.35rem .8rem;font-size:.75rem;color:var(--color-ts)}
    .code-theme-picker{display:flex;gap:.3rem;align-items:center}
    .code-theme-picker button{background:transparent;border:1px solid var(--color-border);border-radius:4px;padding:0 .4rem;font-size:.7rem;color:inherit;cursor:pointer}
    .code-theme-picker button.active{background:var(--color-a);color:#fff;border-color:var(--color-a)}
    /* cover styles */
    .cover-thumb-row{display:flex;gap:.6rem;flex-wrap:wrap;margin-top:.8rem}
    .cover-thumb{width:88px;height:56px;border-radius:6px;border:2px solid transparent;cursor:pointer;background-size:cover;background-position:center;transition:border-color .2s,transform .2s}
    .cover-thumb:hover{transform:scale(1.06)}
    .cover-thumb.active{border-color:var(--color-a)}
    .cover-pattern-gradient{background:linear-gradient(135deg,#6d5df6,#a445f0 55%,#e04fbf)}
    .cover-pattern-stripes{background:repeating-linear-gradient(45deg,#3b82f6 0 12px,#667eea 12px 24px,#8b5cf6 24px 36px)}
    .cover-pattern-dots{background-image:radial-gradient(#f59e0b 2px,transparent 2.5px),radial-gradient(#f59e0b 2px,transparent 2.5px);background-size:22px 22px;background-position:0 0,11px 11px;background-color:#17212b}
    .cover-pattern-blob{background:radial-gradient(circle at 30% 30%,#ec4899 0 32%,transparent 34%),radial-gradient(circle at 72% 66%,#8b5cf6 0 38%,transparent 40%),#171523}
    .cover-pattern-mesh{background:conic-gradient(from 40deg,#06b6d4,#3b82f6,#8b5cf6,#06b6d4)}

    .lang-btn{background:none;border:1px solid var(--color-border);color:var(--color-ts);font-size:.8rem;line-height:1;padding:.45rem .55rem;border-radius:var(--r);cursor:pointer;flex-shrink:0}
    .lang-btn:hover{color:var(--color-a);border-color:var(--color-a)}
  </style>

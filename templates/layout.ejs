    .footer-copyright{color:var(--color-tl);font-size:.8125rem}.footer-beian{display:flex;gap:1rem;font-size:.8125rem}.footer-beian a{color:var(--color-tl)}.footer-powered{color:var(--color-tl);font-size:.75rem}
    .tags-cloud{display:flex;flex-wrap:wrap;gap:.75rem;justify-content:center;padding:2rem;background:var(--color-surface);border-radius:var(--r);box-shadow:var(--sc)}
    .tags-cloud-item{display:inline-flex;align-items:center;gap:.25rem;padding:.5rem 1rem;background:var(--color-hover);color:var(--color-ts);border-radius:2rem;text-decoration:none}.tags-cloud-item:hover{background:var(--color-s);color:#fff;transform:scale(1.05)}
    .tags-cloud-count{font-size:.75rem;opacity:.7}.tags-cloud-item.size-lg{font-size:1.25rem;padding:.75rem 1.5rem}.tags-cloud-item.size-md{font-size:1rem}.tags-cloud-item.size-sm{font-size:.875rem}.tags-cloud-item.size-xs{font-size:.75rem}
    .categories-list{display:grid;gap:1rem}.category-item{display:flex;justify-content:space-between;align-items:center;padding:1rem 1.25rem;background:var(--color-surface);border-radius:var(--r);box-shadow:var(--sc)}.category-item:hover{box-shadow:0 6px 12px var(--color-shadow)}
    .category-link{color:var(--color-t);font-weight:500;font-size:1.0625rem}.category-link:hover{color:var(--color-s)}.category-count{color:var(--color-tl);font-size:.875rem}
    .archive-year{background:var(--color-surface);border-radius:var(--r);padding:1.5rem;margin-bottom:1.5rem;box-shadow:var(--sc)}.archive-year-title{font-size:1.5em;margin-bottom:1rem;padding-bottom:.5rem;border-bottom:2px solid var(--color-border)}
    .archive-list{list-style:none}.archive-item{display:flex;gap:1rem;padding:.5rem 0;border-bottom:1px solid var(--color-border)}.archive-date{color:var(--color-tl);font-size:.875rem;white-space:nowrap;min-width:5em}.archive-link{color:var(--color-t)}.archive-link:hover{color:var(--color-s)}
    .term-header{margin-bottom:2rem;text-align:center}.term-title{font-size:1.75em;margin-bottom:.25rem}.term-count{font-size:.9375rem;color:var(--color-ts)}
    .error-page{text-align:center;padding:4rem 1rem}.error-code{font-size:6em;font-weight:800;color:var(--color-border);line-height:1;margin-bottom:1rem}.error-message{font-size:1.25em;color:var(--color-ts);margin-bottom:2rem}
    .reading-progress{position:fixed;top:0;left:0;width:0%;height:3px;background:linear-gradient(90deg,var(--color-s),var(--color-a));z-index:9999;transition:width .1s ease;display:none}.reading-progress.visible{display:block}
    .back-to-top{position:fixed;bottom:2rem;right:2rem;width:44px;height:44px;border-radius:50%;background:var(--color-surface);color:var(--color-ts);border:1px solid var(--color-border);box-shadow:var(--sc);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:1.25rem;opacity:0;transform:translateY(20px);transition:all var(--td) ease;z-index:999;pointer-events:none}.back-to-top.visible{opacity:1;transform:translateY(0);pointer-events:auto}.back-to-top:hover{background:var(--color-s);color:#fff;border-color:var(--color-s)}
    .link-warning-overlay{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.6);z-index:3000;display:flex;align-items:center;justify-content:center;padding:1rem}
    .link-warning-modal{background:var(--color-surface);border-radius:var(--r-lg);padding:2rem;max-width:480px;width:100%;box-shadow:0 25px 60px rgba(0,0,0,.4)}
    .link-warning-header{font-size:1.25rem;font-weight:700;margin-bottom:1rem;display:flex;align-items:center;gap:.5rem}
    .link-warning-header::before{content:'⚠';font-size:1.5rem}
    .link-warning-body{font-size:.9375rem;color:var(--color-ts);line-height:1.7;margin-bottom:1.5rem;white-space:pre-wrap;word-break:break-all}
    .link-warning-body .link-url{display:block;color:var(--color-s);font-size:.8125rem;margin-top:.5rem;padding:.5rem;background:var(--color-hover);border-radius:var(--r);word-break:break-all}
    .link-warning-footer{display:flex;justify-content:flex-end}
    .contact-popup-overlay{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.6);z-index:4000;display:flex;align-items:center;justify-content:center;padding:1rem}
    .contact-popup-modal{background:var(--color-surface);border-radius:var(--r-lg);padding:2rem;max-width:400px;width:100%;box-shadow:0 25px 60px rgba(0,0,0,.4);text-align:center}
    .contact-popup-title{font-size:1.25rem;font-weight:700;margin-bottom:1rem}
    .contact-popup-body{font-size:1rem;color:var(--color-ts);margin-bottom:1.5rem;line-height:1.7;word-break:break-all}
    .contact-popup-value{display:block;font-size:1.25rem;font-weight:600;color:var(--color-t);padding:.75rem;background:var(--color-hover);border-radius:var(--r);margin:.5rem 0;cursor:pointer;transition:background var(--td) ease;user-select:all}
    .contact-popup-value:hover{background:var(--color-border)}
    .contact-popup-copied{font-size:.8125rem;color:var(--color-s);margin-top:.5rem;min-height:1.5rem}
    .contact-popup-footer{display:flex;justify-content:center;gap:.5rem}
    .related-posts{margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--color-border)}.related-posts-title{font-size:1rem;margin-bottom:1rem;color:var(--color-ts)}.related-posts-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:.75rem}.related-post-card{display:flex;flex-direction:column;gap:.35rem;padding:.75rem 1rem;background:var(--color-hover);border-radius:var(--r);text-decoration:none;transition:background var(--td) ease,transform var(--td) ease}.related-post-card:hover{background:var(--color-surface);transform:translateY(-2px);box-shadow:var(--sc)}.related-post-title{font-size:.875rem;font-weight:500;color:var(--color-t);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.related-post-tags{display:flex;flex-wrap:wrap;gap:.25rem}.related-post-tag{font-size:.6875rem;padding:.1rem .45rem;background:var(--color-surface);color:var(--color-ts);border-radius:1rem}.comments-section{margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--color-border)}
    @keyframes fadeIn{from{opacity:0}to{opacity:1}}@keyframes slideUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
    .page-enter{animation:fadeIn .3s ease,slideUp .3s ease}
  </style>

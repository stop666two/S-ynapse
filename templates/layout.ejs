<body>
<div class="reading-progress" id="rp"></div>
<%- site.customBodyStart || '' %>
<div class="site-wrapper">
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="site-logo"><span style="font-size:1em;font-weight:var(--fw-heading)"><%= site.title %></span><% if(site.subtitle){ %><span style="font-size:.55em;font-weight:400;color:var(--color-tl)"><%= site.subtitle %></span><% } %></a>
    <div class="nav-actions">
      <nav class="main-nav" id="mainNav">
        <ul class="nav-list">
          <% nav.menu.forEach(function(m){ %>
           <li class="nav-item">
            <a href="<%=m.url%>" class="nav-link"<%- m.target?' target="'+m.target+'"':''%><%- m.rel?' rel="'+m.rel+'"':''%>><%- m.label%></a>
          </li>
          <% }) %>
           <% if(site.showRepoLink!==false&&site.repoUrl){ %><li class="nav-item"><a href="<%=site.repoUrl%>" class="nav-link" target="_blank" rel="noopener noreferrer">项目</a></li><% } %>
        </ul>
      </nav>
      <% if(nav.socialInNav&&nav.socialInNav.enabled&&site.social&&site.social.enabled){ %><div class="nav-social"><% (nav.socialInNav.order||Object.keys(site.social.items)).forEach(function(k){ var s=site.social.items[k]; if(!s||!s.enabled)return; var tp=s.type||'link'; if(tp=='link'&&s.url){ %><a href="<%=s.url%>" class="nav-social-link" aria-label="<%=k%>" title="<%=k%>" target="_blank" rel="noopener noreferrer"><% }else if(tp=='popup'&&s.value){ %><a href="#" class="nav-social-link" aria-label="<%=k%>" title="<%=s.popupTitle||k%>" onclick="event.preventDefault();showContact('<%=s.value%>','<%=s.popupTitle||k%>','<%=s.popupContent||s.value%>')"><% } %><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><% if(k==='github'){%><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/><%}else if(k==='twitter'||k==='x'){%><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/><%}else if(k==='rss'){%><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/><%}else if(k==='email'){%><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/><%}else if(k==='weibo'){%><circle cx="12" cy="12" r="10"/><path d="M8 12l4 4 8-8"/><%}else if(k==='telegram'){%><path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4 20-7z"/><%}else if(k==='facebook'){%><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/><%}else if(k==='phone'){%><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/><%}else if(k==='qq'||k==='qqgroup'){%><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/><%}else if(k==='wechat'){%><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14.5c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm2.5 0c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm-4-5c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm5.5 0c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1z"/><%}else{%><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/><%}%></svg></a><% }) %></div><% } %>
      <button class="nav-toggle" id="navToggle" onclick="document.getElementById('mainNav').classList.toggle('open');this.classList.toggle('active')"><span></span><span></span><span></span></button>
      <% if(nav.search&&nav.search.enabled){ %><button class="search-toggle" onclick="openSearch()"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></button><% } %>
      <% if(theme.darkMode&&theme.darkMode.enabled&&theme.darkMode.toggle){ %><button class="dark-toggle" onclick="toggleDark()"><svg id="sunI" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg><svg id="moonI" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg></button><% } %>
    </div>
  </div>
</header>
<% if(nav.search&&nav.search.enabled){ %><div class="search-overlay" id="searchOverlay" onclick="if(event.target===this)closeSearch()"><div class="search-modal"><div class="search-input-wrapper"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg><input type="text" class="search-input" id="searchInput" placeholder="<%= nav.search.placeholder || '搜索...' %>" autofocus oninput="doSearch(this.value)"><button class="search-close" onclick="closeSearch()">&times;</button></div><div class="search-results" id="searchResults"></div></div></div><% } %>
<% if(site.externalLinkWarning&&site.externalLinkWarning.enabled){ %>
<div class="link-warning-overlay" id="linkWarningOverlay" style="display:none">
  <div class="link-warning-modal">
    <div class="link-warning-header"><%= site.externalLinkWarning.title||'安全提醒' %></div>
    <div class="link-warning-body" id="linkWarningBody"></div>
    <div class="link-warning-footer">
      <button class="btn btn-primary" id="linkWarningConfirm"><%= site.externalLinkWarning.confirmText||'继续访问' %></button>
      <button class="btn" style="background:var(--color-hover);color:var(--color-ts);margin-left:.5rem" id="linkWarningCancel"><%= site.externalLinkWarning.cancelText||'取消返回' %></button>
    </div>
  </div>
</div>
<% } %>
<div class="contact-popup-overlay" id="contactPopup" style="display:none" onclick="if(event.target===this)document.getElementById('contactPopup').style.display='none'">
  <div class="contact-popup-modal">
    <div class="contact-popup-title" id="contactPopupTitle"></div>
    <div class="contact-popup-body"><span id="contactPopupContent"></span><span class="contact-popup-value" id="contactPopupValue" onclick="copyContact(this)"></span></div>
    <div class="contact-popup-copied" id="contactPopupCopied"></div>
    <div class="contact-popup-footer"><button class="btn" style="background:var(--color-hover);color:var(--color-ts)" onclick="document.getElementById('contactPopup').style.display='none'">关闭</button></div>
  </div>
</div>
<% var fw=site.build&&site.build.forceContentWidth!==false; %><div class="content-wrapper<%- fw?' force-width':''%>">
  <% if(fw){ %><% if(typeof article!=='undefined'&&article.toc&&article.toc.length){ %><nav class="toc-sidebar visible"><div class="toc-sidebar-inner"><div class="toc-sidebar-label">目录</div><ul class="toc-sidebar-list"><li class="toc-sidebar-item"><a href="#<%=article.slug%>" class="toc-sidebar-link is-title"><%=article.title%></a></li><% article.toc.forEach(function(h){ %><li class="toc-sidebar-item"><a href="#<%=h.id%>" class="toc-sidebar-link level-<%=h.level%>"><%=h.text%></a></li><% }) %></ul></div></nav><% } %><main class="main-content page-enter"><%- body %></main><% if(sidebar.enabled){ %><aside class="sidebar"><% sidebar.widgets.forEach(function(w){ if(!w.enabled) return; %>
    <% if(w.type==='author'){ %><div class="sidebar-widget widget-author"><h3 class="widget-title"><%= w.title || '关于我' %></h3><% if(w.avatar){ %><img src="<%=w.avatar%>" alt="avatar" class="widget-author-avatar" loading="lazy"><% } %><div class="widget-author-name"><%= site.author %></div><% if(w.bio){ %><div class="widget-author-bio"><%= w.bio %></div><% } %></div><% } %>
    <% if(w.type==='recent'&&typeof recentPosts!=='undefined'){ %><div class="sidebar-widget"><h3 class="widget-title"><%= w.title || '最新文章' %></h3><% recentPosts.slice(0,w.count||5).forEach(function(p){ %><div class="widget-recent-item"><a href="<%=p.url%>" class="widget-recent-link"><%-p.title%></a><% if(w.showDate&&p.date){ %><div class="widget-recent-date"><%=new Date(p.date).toLocaleDateString(site.language||'zh-CN',{year:'numeric',month:'short',day:'numeric'})%></div><% } %></div><% }) %></div><% } %>
    <% if(w.type==='tags'&&typeof allTags!=='undefined'){ %><div class="sidebar-widget"><h3 class="widget-title"><%= w.title || '标签云' %></h3><div class="widget-tag-cloud"><% (w.limit?allTags.slice(0,w.limit):allTags).forEach(function(t){ %><a href="<%=t.url%>" class="widget-tag-link"><%=t.name%><% if(w.showCount){ %><span class="tags-cloud-count"> (<%=t.count%>)</span><% } %></a><% }) %></div></div><% } %>
    <% if(w.type==='categories'&&typeof allCategories!=='undefined'){ %><div class="sidebar-widget"><h3 class="widget-title"><%= w.title||'分类' %></h3><% allCategories.forEach(function(c){ %><div class="widget-category-item"><a href="<%=c.url%>" class="widget-category-link"><%=c.name%></a><% if(w.showCount){ %><span class="widget-category-count"><%=c.count%></span><% } %></div><% }) %></div><% } %>
    <% if(w.type==='archive'&&typeof archives!=='undefined'){ %><div class="sidebar-widget"><h3 class="widget-title"><%= w.title||'归档' %></h3><% archives.forEach(function(g){ %><div class="widget-archive-item"><a href="/archive#<%=g.year%>" class="widget-archive-link"><%=g.year%><% if(g.month){ %>-<%=g.month%><% } %></a><% if(w.showCount){ %><span class="widget-archive-count"><%=g.articles.length%></span><% } %></div><% }) %></div><% } %>
    <% if(w.type==='search'){ %><div class="sidebar-widget"><h3 class="widget-title"><%= w.title||'搜索' %></h3><input type="text" class="widget-search-input" placeholder="<%= w.placeholder||'输入关键词...'%>" onkeydown="if(event.key==='Enter')openSearch()"></div><% } %>
    <% if(w.type==='toc'&&typeof article!=='undefined'&&article.toc&&article.toc.length>1){ %><div class="sidebar-widget"><h3 class="widget-title"><%= w.title||'目录' %></h3><nav class="toc"><ul class="toc-list"><% article.toc.forEach(function(h){ %><li class="toc-item level-<%=h.level%>"><a href="#<%=h.id%>" class="toc-link"><%=h.text%></a></li><% }) %></ul></nav></div><% } %>
    <% if(w.type==='custom'){ %><div class="sidebar-widget"><h3 class="widget-title"><%= w.title||'自定义' %></h3><%- w.html||'' %></div><% } %>
  <% }) %></aside><% } %><% }else{ %><div class="container"><main class="main-content page-enter"><%- body %></main><% if(sidebar.enabled){ %><aside class="sidebar"><% sidebar.widgets.forEach(function(w){ if(!w.enabled) return; %>
    <% if(w.type==='author'){ %><div class="sidebar-widget widget-author"><h3 class="widget-title"><%= w.title || '关于我' %></h3><% if(w.avatar){ %><img src="<%=w.avatar%>" alt="avatar" class="widget-author-avatar" loading="lazy"><% } %><div class="widget-author-name"><%= site.author %></div><% if(w.bio){ %><div class="widget-author-bio"><%= w.bio %></div><% } %></div><% } %>
    <% if(w.type==='recent'&&typeof recentPosts!=='undefined'){ %><div class="sidebar-widget"><h3 class="widget-title"><%= w.title || '最新文章' %></h3><% recentPosts.slice(0,w.count||5).forEach(function(p){ %><div class="widget-recent-item"><a href="<%=p.url%>" class="widget-recent-link"><%-p.title%></a><% if(w.showDate&&p.date){ %><div class="widget-recent-date"><%=new Date(p.date).toLocaleDateString(site.language||'zh-CN',{year:'numeric',month:'short',day:'numeric'})%></div><% } %></div><% }) %></div><% } %>
    <% if(w.type==='tags'&&typeof allTags!=='undefined'){ %><div class="sidebar-widget"><h3 class="widget-title"><%= w.title || '标签云' %></h3><div class="widget-tag-cloud"><% (w.limit?allTags.slice(0,w.limit):allTags).forEach(function(t){ %><a href="<%=t.url%>" class="widget-tag-link"><%=t.name%><% if(w.showCount){ %><span class="tags-cloud-count"> (<%=t.count%>)</span><% } %></a><% }) %></div></div><% } %>
    <% if(w.type==='categories'&&typeof allCategories!=='undefined'){ %><div class="sidebar-widget"><h3 class="widget-title"><%= w.title||'分类' %></h3><% allCategories.forEach(function(c){ %><div class="widget-category-item"><a href="<%=c.url%>" class="widget-category-link"><%=c.name%></a><% if(w.showCount){ %><span class="widget-category-count"><%=c.count%></span><% } %></div><% }) %></div><% } %>
    <% if(w.type==='archive'&&typeof archives!=='undefined'){ %><div class="sidebar-widget"><h3 class="widget-title"><%= w.title||'归档' %></h3><% archives.forEach(function(g){ %><div class="widget-archive-item"><a href="/archive#<%=g.year%>" class="widget-archive-link"><%=g.year%><% if(g.month){ %>-<%=g.month%><% } %></a><% if(w.showCount){ %><span class="widget-archive-count"><%=g.articles.length%></span><% } %></div><% }) %></div><% } %>
    <% if(w.type==='search'){ %><div class="sidebar-widget"><h3 class="widget-title"><%= w.title||'搜索' %></h3><input type="text" class="widget-search-input" placeholder="<%= w.placeholder||'输入关键词...'%>" onkeydown="if(event.key==='Enter')openSearch()"></div><% } %>
    <% if(w.type==='toc'&&typeof article!=='undefined'&&article.toc&&article.toc.length>1){ %><div class="sidebar-widget"><h3 class="widget-title"><%= w.title||'目录' %></h3><nav class="toc"><ul class="toc-list"><% article.toc.forEach(function(h){ %><li class="toc-item level-<%=h.level%>"><a href="#<%=h.id%>" class="toc-link"><%=h.text%></a></li><% }) %></ul></nav></div><% } %>
    <% if(w.type==='custom'){ %><div class="sidebar-widget"><h3 class="widget-title"><%= w.title||'自定义' %></h3><%- w.html||'' %></div><% } %>
  <% }) %></aside><% } %></div><% } %>
</div>
<footer class="site-footer"><div class="container">
  <% if(footer.columnItems&&footer.columnItems.enabled!==false&&footer.columnItems.items){ %><div class="footer-grid"><% footer.columnItems.items.forEach(function(c){ if(c.enabled===false)return; %><div class="footer-column"><% if(c.title){ %><h4 class="footer-column-title"><%=c.title%></h4><% } if(c.links){ %><ul class="footer-links"><% c.links.forEach(function(l){ if(l.enabled===false)return; %><li><a href="<%=l.url%>" class="footer-link"><%=l.label%></a></li><% }) %></ul><% } if(c.html){ %><div class="footer-html"><%-c.html%></div><% } %></div><% }) %></div><% } %>
  <div class="footer-bottom">
    <% if(footer.social&&footer.social.enabled&&site.social&&site.social.enabled){ %><div class="footer-social"><% Object.entries(site.social.items).forEach(function(e){ var s=e[1],k=e[0]; if(!s||!s.enabled)return; var tp=s.type||'link'; if(tp=='link'&&s.url){ %><a href="<%=s.url%>" target="_blank" rel="noopener noreferrer" aria-label="<%=k%>" title="<%=k%>"><% }else if(tp=='popup'&&s.value){ %><a href="#" onclick="event.preventDefault();showContact('<%=s.value%>','<%=s.popupTitle||k%>','<%=s.popupContent||s.value%>')" aria-label="<%=k%>" title="<%=s.popupTitle||k%>"><% } %><svg width="<%=footer.social.iconSize||'24px'%>" height="<%=footer.social.iconSize||'24px'%>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><% if(k==='github'){%><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/><%}else if(k==='twitter'||k==='x'){%><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/><%}else if(k==='rss'){%><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/><%}else if(k==='email'){%><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/><%}else if(k==='weibo'){%><circle cx="12" cy="12" r="10"/><path d="M8 12l4 4 8-8"/><%}else if(k==='telegram'){%><path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4 20-7z"/><%}else if(k==='facebook'){%><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/><%}else if(k==='phone'){%><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/><%}else if(k==='qq'||k==='qqgroup'){%><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/><%}else if(k==='wechat'){%><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14.5c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm2.5 0c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm-4-5c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm5.5 0c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1z"/><%}else{%><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/><%}%></svg></a><% }) %></div><% } %>
    <% if(footer.bottomLinks&&footer.bottomLinks.enabled!==false&&footer.bottomLinks.items){ %><div class="footer-bottom-links"><% footer.bottomLinks.items.forEach(function(l){ if(l.enabled===false)return; %><a href="<%=l.url%>" class="footer-link"><%=l.label%></a><% }) %></div><% } %>
    <div class="footer-copyright"><%= footer.copyright || site.copyright %></div>
    <% if(footer.beian&&footer.beian.enabled){ %><div class="footer-beian"><% if(footer.beian.icp){ %><a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer"><%=footer.beian.icp%></a><% } if(footer.beian.gongan){ %><a href="http://www.beian.gov.cn/" target="_blank" rel="noopener noreferrer"><%=footer.beian.gongan%></a><% } %></div><% } %>
    <% if(footer.poweredBy&&footer.poweredBy.enabled){ var sr=site.showRepoLink!==false&&site.repoUrl; %><div class="footer-powered">Powered by<% if(sr){ %> <a href="<%=site.repoUrl%>" target="_blank" rel="noopener noreferrer"><% } %><%=footer.poweredBy.text||'S-ynapse'%><% if(sr){ %></a><% } %></div><% } %>
  </div>
  <%- footer.customHtml||'' %>
</div></footer>
</div>
<button class="back-to-top" id="btt" onclick="window.scrollTo({top:0,behavior:'smooth'})"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="18,15 12,9 6,15"/></svg></button>
<%- site.customBodyEnd||'' %>
<% if(theme.externalAssets&&theme.externalAssets.scripts){ %><% theme.externalAssets.scripts.forEach(function(s){ %><script src="<%=s%>" defer></script><% }) %><% } %>
<script>
function a(d){document.documentElement.setAttribute('data-theme',d?'dark':'light');var su=document.getElementById('sunI'),mo=document.getElementById('moonI');if(su&&mo){su.style.display=d?'inline':'none';mo.style.display=d?'none':'inline'}}(function(){var t='<%=theme.darkMode&&theme.darkMode.default||"system"%>',s=localStorage.getItem('theme'),p=window.matchMedia('(prefers-color-scheme:dark)').matches;if(!s&&t==='system'){window.matchMedia('(prefers-color-scheme:dark)').addEventListener('change',function(e){if(!localStorage.getItem('theme'))a(e.matches)})}})();
function toggleDark(){var c=document.documentElement.getAttribute('data-theme'),d=c!=='dark';a(d);localStorage.setItem('theme',d?'dark':'light')}
function openSearch(){var o=document.getElementById('searchOverlay');if(o){o.classList.add('open');setTimeout(function(){var i=document.getElementById('searchInput');if(i)i.focus()},100)}}
function closeSearch(){var o=document.getElementById('searchOverlay');if(o)o.classList.remove('open')}
document.addEventListener('keydown',function(e){if(e.key==='Escape')closeSearch();if((e.ctrlKey||e.metaKey)&&e.key==='k'){e.preventDefault();var o=document.getElementById('searchOverlay');if(o&&!o.classList.contains('open'))openSearch();else closeSearch()}});
function doSearch(q){var d=document.getElementById('searchResults');if(!d)return;if(!q||q.length<2){d.classList.remove('has-results');d.innerHTML='';return}var w=window.__SEARCH_DATA__||[],r=[],lq=q.toLowerCase();for(var i=0;i<w.length;i++){var it=w[i];if(it.title&&it.title.toLowerCase().includes(lq)||it.excerpt&&it.excerpt.toLowerCase().includes(lq)||it.content&&it.content.toLowerCase().includes(lq)){r.push(it);if(r.length>=10)break}}if(r.length){d.classList.add('has-results');d.innerHTML=r.map(function(r){return'<a href="'+r.url+'" class="search-result-item"><div class="search-result-title">'+r.title+'</div>'+(r.excerpt?'<div class="search-result-excerpt">'+r.excerpt.substring(0,120)+'</div>':'')+'</div></a>'}).join('')}else{d.classList.remove('has-results');d.innerHTML='<div style="text-align:center;color:var(--color-tl);padding:1rem">未找到相关文章</div>'}}
(function(){var p=document.getElementById('rp');if(p&&document.querySelector('.post-article')){p.classList.add('visible');window.addEventListener('scroll',function(){var s=window.scrollY,h=document.documentElement.scrollHeight-window.innerHeight;if(h>0)p.style.width=Math.min(100,(s/h)*100)+'%'})}})();
(function(){var b=document.getElementById('btt');if(b){window.addEventListener('scroll',function(){b.classList.toggle('visible',window.scrollY>300)})}})();
(function(){document.addEventListener('DOMContentLoaded',function(){document.querySelectorAll('.post-content pre').forEach(function(p){var b=document.createElement('button');b.className='copy-code-btn';b.textContent='复制';b.onclick=function(){var c=p.querySelector('code')||p;navigator.clipboard.writeText(c.textContent).then(function(){b.textContent='已复制';setTimeout(function(){b.textContent='复制'},2000)})};p.appendChild(b)})})})();
document.addEventListener('DOMContentLoaded',function(){document.querySelectorAll('img:not([loading=eager])').forEach(function(i){if(i.complete)i.classList.add('loaded');else i.addEventListener('load',function(){i.classList.add('loaded')});i.addEventListener('error',function(){i.classList.add('loaded')})})});
function toggleReadingMode(){var d=document.documentElement;var a=d.getAttribute('data-reading');if(a==='true'){d.removeAttribute('data-reading');localStorage.setItem('readingMode','false')}else{d.setAttribute('data-reading','true');localStorage.setItem('readingMode','true')}};(function(){if(localStorage.getItem('readingMode')==='true')document.documentElement.setAttribute('data-reading','true')})()
;(function(){var d=document.querySelector('.toc-sidebar-list');if(!d)return;var links=d.querySelectorAll('.toc-sidebar-link');var ids=[];links.forEach(function(l){var h=l.getAttribute('href');if(h&&h[0]==='#')ids.push(h.slice(1))});if(!ids.length)return;function update(){var cur='';for(var i=0;i<ids.length;i++){var el=document.getElementById(ids[i]);if(el&&el.getBoundingClientRect().top<120)cur=ids[i]}links.forEach(function(l){var h=l.getAttribute('href');l.classList.toggle('active',h==='#'+cur)})}window.addEventListener('scroll',update);update()})()
function showContact(v,t,c){var o=document.getElementById('contactPopup'),tv=document.getElementById('contactPopupTitle'),cv=document.getElementById('contactPopupContent'),vv=document.getElementById('contactPopupValue'),cp=document.getElementById('contactPopupCopied');if(!o)return;tv.textContent=t;cv.textContent=c;vv.textContent=v;vv.setAttribute('data-value',v);cp.textContent='';o.style.display='flex'}
function copyContact(el){var v=el.getAttribute('data-value')||el.textContent;if(navigator.clipboard){navigator.clipboard.writeText(v).then(function(){document.getElementById('contactPopupCopied').textContent='✓ 已复制到剪贴板'})}else{var ta=document.createElement('textarea');ta.value=v;document.body.appendChild(ta);ta.select();document.execCommand('copy');document.body.removeChild(ta);document.getElementById('contactPopupCopied').textContent='✓ 已复制到剪贴板'}}
(function(){var c=<%- JSON.stringify(site.externalLinkWarning||{}) %>;if(!c.enabled)return;var wl=c.whitelist||[];function matchWhitelist(url){for(var i=0;i<wl.length;i++){var raw=wl[i];var p=raw.replace(/\./g,'\\.').replace(/\*/g,'[^/]*?');if(new RegExp('^'+p+'$','i').test(url))return true;if(raw.startsWith('*.')){var p2=raw.slice(2).replace(/\./g,'\\.');if(new RegExp('^'+p2+'$','i').test(url))return true}}return false}document.addEventListener('click',function(e){var a=e.target.closest('a');if(!a)return;var h=a.getAttribute('href');if(!h||h[0]=='/'||h[0]=='#'||h.slice(0,7)=='mailto:'||h.slice(0,11)=='javascript:')return;try{var u=new URL(h,window.location.href);if(u.origin==window.location.origin)return;if(matchWhitelist(u.hostname+u.pathname))return;if(matchWhitelist(u.hostname))return}catch(ex){};e.preventDefault();var o=document.getElementById('linkWarningOverlay'),b=document.getElementById('linkWarningBody'),x=document.getElementById('linkWarningConfirm'),n=document.getElementById('linkWarningCancel');if(!o||!b)return;b.innerHTML=(c.message||'').replace('{url}','')+'<span class=\"link-url\">'+h+'</span>';o.style.display='flex';x.onclick=function(){o.style.display='none';window.open(h,'_blank')};n.onclick=function(){o.style.display='none'}})})()
</script>
</body>
</html>

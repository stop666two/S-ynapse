    .related-posts{margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--color-border)}.related-posts-title{font-size:1rem;margin-bottom:1rem;color:var(--color-ts)}.related-posts-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:.75rem}.related-post-card{display:flex;flex-direction:column;gap:.35rem;padding:.75rem 1rem;background:var(--color-hover);border-radius:var(--r);text-decoration:none;transition:background var(--td) var(--te),transform var(--td) var(--te)}.related-post-card:hover{background:var(--color-surface);transform:translateY(-2px);box-shadow:var(--sc)}.related-post-title{font-size:.875rem;font-weight:500;color:var(--color-t);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.related-post-tags{display:flex;flex-wrap:wrap;gap:.25rem}.related-post-tag{font-size:.6875rem;padding:.1rem .45rem;background:var(--color-surface);color:var(--color-ts);border-radius:1rem}.comments-section{margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--color-border)}
    @keyframes fadeIn{from{opacity:0}to{opacity:1}}@keyframes slideUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
    .page-enter{animation:fadeIn .35s cubic-bezier(.4,0,.2,1),slideUp .35s cubic-bezier(.4,0,.2,1)}
    .motion-card-hover{transition:transform var(--td) var(--te),box-shadow var(--td) var(--te),background var(--td) var(--te)}.motion-card-hover:hover{transform:translateY(calc(-1 * var(--mh-lift,4px)));box-shadow:var(--sd)}
    .motion-underline{position:relative}.motion-underline:after{content:'';position:absolute;left:0;bottom:-2px;height:var(--mh-under,2px);width:100%;background:currentColor;transform:scaleX(0);transform-origin:left;transition:transform .25s cubic-bezier(.4,0,.2,1)}.motion-underline:hover:after{transform:scaleX(1)}
    .ripple-host{position:relative;overflow:hidden}.ripple-ink{position:absolute;border-radius:50%;background:currentColor;opacity:.18;transform:scale(0);pointer-events:none;animation:rippleAnim var(--mh-ripple,500ms) ease-out}.ripple-ink.end{opacity:0;transition:opacity .4s}
    @keyframes rippleAnim{to{transform:scale(3)}}
    .motion-reveal{opacity:0;transform:translateY(var(--mh-offset,28px));will-change:opacity,transform}.motion-reveal.in{opacity:1;transform:none;transition:opacity var(--mh-dur,500ms) cubic-bezier(.4,0,.2,1),transform var(--mh-dur,500ms) cubic-bezier(.4,0,.2,1)}
    .post-card{display:flex;flex-direction:column}.post-card-image{aspect-ratio:16/9;height:auto;transition:transform .3s cubic-bezier(.4,0,.2,1)}.post-card:hover .post-card-image{transform:scale(1.02)}
    .post-card-nocover{aspect-ratio:16/9;height:auto;display:flex;align-items:center;justify-content:center;margin-bottom:1rem;border-radius:var(--r);background:linear-gradient(135deg,var(--color-s) 0%,var(--color-a) 100%);color:#fff;font-size:2rem;font-weight:var(--fw-heading);opacity:.92}
    .post-content blockquote{border-left:4px solid var(--color-s);background:var(--color-hover);padding:.75rem 1.25rem;border-radius:0 var(--r) var(--r) 0;font-style:normal;color:var(--color-ts);position:relative}
    .post-content blockquote:before{content:'';position:absolute;left:-4px;top:0;bottom:0;width:4px;background:linear-gradient(180deg,var(--color-s),var(--color-a))}
    .post-content table{border-collapse:collapse;width:100%;border:1px solid var(--color-border);border-radius:var(--r);overflow:hidden}
    .post-content th{background:var(--color-hover);padding:.6rem .9rem;font-weight:600;color:var(--color-t);border:1px solid var(--color-border);text-align:left}
    .post-content td{padding:.55rem .9rem;border:1px solid var(--color-border);color:var(--color-ts)}
    .post-content tbody tr:nth-child(odd){background:rgba(0,0,0,.025)}[data-theme=dark] .post-content tbody tr:nth-child(odd){background:rgba(255,255,255,.04)}
    .post-content ul li::marker{color:var(--color-s)}.post-content ol li::marker{color:var(--color-s);font-weight:600}
    .post-content ul ul,.post-content ol ol{margin-left:1.25rem}
    .post-content :is(h2,h3,h4){scroll-margin-top:calc(var(--hh,64px) + 18px)}
    .hero-actions{align-items:center}

    /* dailyQuote widget */
    .widget-quote{font-size:.95rem;font-style:normal;color:var(--color-t);line-height:1.8}
    .widget-quote .quote-mark{font-size:2rem;color:var(--color-a);line-height:1}
    .widget-quote-text{display:block;margin:.4rem 0}
    .widget-quote-author{display:block;margin-top:.6rem;font-size:.8rem;color:var(--color-ts);text-align:right}
    /* favorites */
    .fav-btn{display:inline-flex;align-items:center;gap:.35rem;background:transparent;border:1px solid var(--color-border);border-radius:999px;padding:.35rem .9rem;font-size:.85rem;color:var(--color-t);cursor:pointer;transition:all .2s}
    .fav-btn:hover{border-color:var(--color-a);color:var(--color-a)}
    .fav-btn.faved{border-color:var(--color-a);background:var(--color-a);color:#fff}
    .fav-toast{position:fixed;bottom:2rem;left:50%;transform:translateX(-50%);background:var(--color-surface);border:1px solid var(--color-border);border-radius:999px;padding:.5rem 1.2rem;font-size:.85rem;box-shadow:0 4px 20px rgba(0,0,0,.12);z-index:1200;opacity:0;transition:opacity .25s,transform .25s}
    .fav-toast.show{opacity:1;transform:translateX(-50%) translateY(-4px)}
    /* favorites page */
    .fav-page-list{list-style:none;padding:0;margin:1.5rem 0}

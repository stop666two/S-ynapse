<% var fw=site.build&&site.build.forceContentWidth!==false; %><div class="content-wrapper<%- fw?' force-width':''%>">
  <% if(fw){ %><% if(typeof article!=='undefined'&&article.toc&&article.toc.length){ %><nav class="toc-sidebar visible"><div class="toc-sidebar-inner"><% if(features.toc&&features.toc.showTitle!==false){ %><div class="toc-sidebar-label"><%= (typeof lang!=='undefined'&&lang==='en')?((features.toc&&features.toc.titleTextEn)||'Contents'):((features.toc&&features.toc.titleText)||'目录') %><button type="button" class="toc-toggle" id="tocToggle" aria-label="折叠目录" data-i18n-aria="sidebar.collapse" aria-expanded="true"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6,9 12,15 18,9"/></svg></button></div><% } %><div class="toc-progress" id="tocProgress" aria-hidden="true"><i></i></div><ul class="toc-sidebar-list" id="tocList"><li class="toc-sidebar-item"><a href="#<%=article.slug%>" class="toc-sidebar-link is-title"><%=article.title%></a></li><% article.toc.forEach(function(h){ %><li class="toc-sidebar-item"><a href="#<%=h.id%>" class="toc-sidebar-link level-<%=h.level%>"><%=h.text%></a></li><% }) %></ul></div></nav><% } %><main class="main-content page-enter"><%- body %></main><% if(sidebar.enabled){ %><aside class="sidebar"><% sidebar.widgets.forEach(function(w){ if(!w.enabled) return; %>
    <% if(w.type==='author'){ %><div class="sidebar-widget widget-author"><h3 class="widget-title"><%= w.title || '关于我' %></h3><% if(w.avatar){ %><img src="<%=w.avatar%>" alt="avatar" class="widget-author-avatar avatar-<%=theme.avatar.shape%><%=theme.avatar.ring?' avatar-ring':''%>" loading="lazy"><% } else if(theme.avatar.badge){ %><div class="widget-author-avatar widget-author-badge avatar-<%=theme.avatar.shape%><%=theme.avatar.ring?' avatar-ring':''%>"><%= (typeof site.author==='string'&&site.author?site.author:'S').charAt(0).toUpperCase() %></div><% } %><div class="widget-author-name"><%= site.author %></div><% if(w.bio){ %><div class="widget-author-bio"><%= w.bio %></div><% } %></div><% } %>
    <% if(w.type==='recent'&&typeof recentPosts!=='undefined'){ %><div class="sidebar-widget"><h3 class="widget-title"><%= w.title || '最新文章' %></h3><% recentPosts.slice(0,w.count||5).forEach(function(p){ %><div class="widget-recent-item"><a href="<%=p.url%>" class="widget-recent-link"><%=p.title%></a><% if(w.showDate&&p.date){ %><div class="widget-recent-date"><%=new Date(p.date).toLocaleDateString(site.language||'zh-CN',{year:'numeric',month:'short',day:'numeric'})%></div><% } %></div><% }) %></div><% } %>
    <% if(w.type==='quote'){ %><div class="sidebar-widget quote-widget"><h3 class="widget-title"><%= w.title || (features.dailyQuote&&features.dailyQuote.label||'每日一言') %></h3><div class="widget-quote"><span class="quote-mark">”</span><blockquote class="widget-quote-text" id="quoteText">…</blockquote><span class="widget-quote-author" id="quoteAuthor"></span></div></div><% } %>
    <% if(w.type==='tags'&&typeof allTags!=='undefined'){ %><div class="sidebar-widget"><h3 class="widget-title"><%= w.title || '标签云' %></h3><div class="widget-tag-cloud"><% (w.limit?allTags.slice(0,w.limit):allTags).forEach(function(t){ %><a href="<%=t.url%>" class="widget-tag-link"><%=t.name%><% if(w.showCount){ %><span class="tags-cloud-count"> (<%=t.count%>)</span><% } %></a><% }) %></div></div><% } %>
    <% if(w.type==='categories'&&typeof allCategories!=='undefined'){ %><div class="sidebar-widget"><h3 class="widget-title"><%= w.title||'分类' %></h3><% allCategories.forEach(function(c){ %><div class="widget-category-item"><a href="<%=c.url%>" class="widget-category-link"><%=c.name%></a><% if(w.showCount){ %><span class="widget-category-count"><%=c.count%></span><% } %></div><% }) %></div><% } %>
    <% if(w.type==='archive'&&typeof archives!=='undefined'){ %><div class="sidebar-widget"><h3 class="widget-title"><%= w.title||'归档' %></h3><% archives.forEach(function(g){ %><div class="widget-archive-item"><a href="<%= (typeof langPrefix!=='undefined'&&langPrefix ? langPrefix : '/zh/') %>archive#<%=g.year%>" class="widget-archive-link"><%=g.year%><% if(g.month){ %>-<%=g.month%><% } %></a><% if(w.showCount){ %><span class="widget-archive-count"><%=g.articles.length%></span><% } %></div><% }) %></div><% } %>
    <% if(w.type==='search'){ %><div class="sidebar-widget"><h3 class="widget-title"><%= w.title||'搜索' %></h3><input type="text" class="widget-search-input" placeholder="<%= w.placeholder||'输入关键词...'%>" onkeydown="if(event.key==='Enter')openSearch()"></div><% } %>
    <% if(w.type==='toc'&&typeof article!=='undefined'&&article.toc&&article.toc.length>1){ %><div class="sidebar-widget"><h3 class="widget-title"><%= w.title||'目录' %></h3><nav class="toc"><ul class="toc-list"><% article.toc.forEach(function(h){ %><li class="toc-item level-<%=h.level%>"><a href="#<%=h.id%>" class="toc-link"><%=h.text%></a></li><% }) %></ul></nav></div><% } %>
    <% if(w.type==='stats'&&features.stats&&features.stats.enabled!==false&&typeof siteStats!=='undefined'&&siteStats&&siteStats.posts>0){ %><div class="sidebar-widget"><h3 class="widget-title"><%= w.title||ui('sidebar.stats','站点统计') %></h3><div class="widget-stats-grid"><div class="widget-stats"><span class="widget-stats-value"><%=siteStats.posts%></span><span class="widget-stats-label"><%= ui('archive.statPosts','文章') %></span></div><div class="widget-stats"><span class="widget-stats-value"><%=siteStats.words%></span><span class="widget-stats-label"><%= ui('archive.statWords','字数') %></span></div><div class="widget-stats"><span class="widget-stats-value"><%=siteStats.tags%></span><span class="widget-stats-label"><%= ui('archive.statTags','标签') %></span></div><div class="widget-stats"><span class="widget-stats-value"><%=siteStats.categories%></span><span class="widget-stats-label"><%= ui('archive.statCats','分类') %></span></div></div></div><% } %>
    <% if(w.type==='series'&&typeof seriesList!=='undefined'&&seriesList&&seriesList.length){ %><div class="sidebar-widget"><h3 class="widget-title"><%= w.title||ui('sidebar.series','系列') %></h3><nav class="toc"><ul class="toc-list"><% seriesList.forEach(function(s){ %><li class="toc-item"><a href="<%=s.firstUrl%>" class="toc-link"><%=s.name%> <span class="widget-count">(<%=s.count%>)</span></a></li><% }) %></ul></nav></div><% } %>
    <% if(w.type==='friends'&&typeof friends!=='undefined'&&friends&&friends.friends&&friends.friends.length){ %><div class="sidebar-widget"><h3 class="widget-title"><%= w.title||'友情链接' %></h3><nav class="toc"><ul class="toc-list"><% friends.friends.slice(0,8).forEach(function(f){ %><li class="toc-item"><a href="<%=f.url%>" class="toc-link" target="_blank" rel="noopener noreferrer"><%=f.name%></a></li><% }) %></ul></nav></div><% } %>
    <% if(w.type==='custom'){ %><div class="sidebar-widget"><h3 class="widget-title"><%= w.title||'自定义' %></h3><%- w.html||'' %></div><% } %>
  <% }) %></aside><% } %><% }else{ %><div class="container"><main class="main-content page-enter"><%- body %></main><% if(sidebar.enabled){ %><aside class="sidebar"><% sidebar.widgets.forEach(function(w){ if(!w.enabled) return; %>
    <% if(w.type==='author'){ %><div class="sidebar-widget widget-author"><h3 class="widget-title"><%= w.title || '关于我' %></h3><% if(w.avatar){ %><img src="<%=w.avatar%>" alt="avatar" class="widget-author-avatar avatar-<%=theme.avatar.shape%><%=theme.avatar.ring?' avatar-ring':''%>" loading="lazy"><% } else if(theme.avatar.badge){ %><div class="widget-author-avatar widget-author-badge avatar-<%=theme.avatar.shape%><%=theme.avatar.ring?' avatar-ring':''%>"><%= (typeof site.author==='string'&&site.author?site.author:'S').charAt(0).toUpperCase() %></div><% } %><div class="widget-author-name"><%= site.author %></div><% if(w.bio){ %><div class="widget-author-bio"><%= w.bio %></div><% } %></div><% } %>
    <% if(w.type==='recent'&&typeof recentPosts!=='undefined'){ %><div class="sidebar-widget"><h3 class="widget-title"><%= w.title || '最新文章' %></h3><% recentPosts.slice(0,w.count||5).forEach(function(p){ %><div class="widget-recent-item"><a href="<%=p.url%>" class="widget-recent-link"><%=p.title%></a><% if(w.showDate&&p.date){ %><div class="widget-recent-date"><%=new Date(p.date).toLocaleDateString(site.language||'zh-CN',{year:'numeric',month:'short',day:'numeric'})%></div><% } %></div><% }) %></div><% } %>
    <% if(w.type==='tags'&&typeof allTags!=='undefined'){ %><div class="sidebar-widget"><h3 class="widget-title"><%= w.title || '标签云' %></h3><div class="widget-tag-cloud"><% (w.limit?allTags.slice(0,w.limit):allTags).forEach(function(t){ %><a href="<%=t.url%>" class="widget-tag-link"><%=t.name%><% if(w.showCount){ %><span class="tags-cloud-count"> (<%=t.count%>)</span><% } %></a><% }) %></div></div><% } %>
    <% if(w.type==='categories'&&typeof allCategories!=='undefined'){ %><div class="sidebar-widget"><h3 class="widget-title"><%= w.title||'分类' %></h3><% allCategories.forEach(function(c){ %><div class="widget-category-item"><a href="<%=c.url%>" class="widget-category-link"><%=c.name%></a><% if(w.showCount){ %><span class="widget-category-count"><%=c.count%></span><% } %></div><% }) %></div><% } %>
    <% if(w.type==='archive'&&typeof archives!=='undefined'){ %><div class="sidebar-widget"><h3 class="widget-title"><%= w.title||'归档' %></h3><% archives.forEach(function(g){ %><div class="widget-archive-item"><a href="<%= (typeof langPrefix!=='undefined'&&langPrefix ? langPrefix : '/zh/') %>archive#<%=g.year%>" class="widget-archive-link"><%=g.year%><% if(g.month){ %>-<%=g.month%><% } %></a><% if(w.showCount){ %><span class="widget-archive-count"><%=g.articles.length%></span><% } %></div><% }) %></div><% } %>
    <% if(w.type==='search'){ %><div class="sidebar-widget"><h3 class="widget-title"><%= w.title||'搜索' %></h3><input type="text" class="widget-search-input" placeholder="<%= w.placeholder||'输入关键词...'%>" onkeydown="if(event.key==='Enter')openSearch()"></div><% } %>
    <% if(w.type==='toc'&&typeof article!=='undefined'&&article.toc&&article.toc.length>1){ %><div class="sidebar-widget"><h3 class="widget-title"><%= w.title||'目录' %></h3><nav class="toc"><ul class="toc-list"><% article.toc.forEach(function(h){ %><li class="toc-item level-<%=h.level%>"><a href="#<%=h.id%>" class="toc-link"><%=h.text%></a></li><% }) %></ul></nav></div><% } %>
    <% if(w.type==='stats'&&features.stats&&features.stats.enabled!==false&&typeof siteStats!=='undefined'&&siteStats&&siteStats.posts>0){ %><div class="sidebar-widget"><h3 class="widget-title"><%= w.title||ui('sidebar.stats','站点统计') %></h3><div class="widget-stats-grid"><div class="widget-stats"><span class="widget-stats-value"><%=siteStats.posts%></span><span class="widget-stats-label"><%= ui('archive.statPosts','文章') %></span></div><div class="widget-stats"><span class="widget-stats-value"><%=siteStats.words%></span><span class="widget-stats-label"><%= ui('archive.statWords','字数') %></span></div><div class="widget-stats"><span class="widget-stats-value"><%=siteStats.tags%></span><span class="widget-stats-label"><%= ui('archive.statTags','标签') %></span></div><div class="widget-stats"><span class="widget-stats-value"><%=siteStats.categories%></span><span class="widget-stats-label"><%= ui('archive.statCats','分类') %></span></div></div></div><% } %>
    <% if(w.type==='series'&&typeof seriesList!=='undefined'&&seriesList&&seriesList.length){ %><div class="sidebar-widget"><h3 class="widget-title"><%= w.title||ui('sidebar.series','系列') %></h3><nav class="toc"><ul class="toc-list"><% seriesList.forEach(function(s){ %><li class="toc-item"><a href="<%=s.firstUrl%>" class="toc-link"><%=s.name%> <span class="widget-count">(<%=s.count%>)</span></a></li><% }) %></ul></nav></div><% } %>
    <% if(w.type==='friends'&&typeof friends!=='undefined'&&friends&&friends.friends&&friends.friends.length){ %><div class="sidebar-widget"><h3 class="widget-title"><%= w.title||'友情链接' %></h3><nav class="toc"><ul class="toc-list"><% friends.friends.slice(0,8).forEach(function(f){ %><li class="toc-item"><a href="<%=f.url%>" class="toc-link" target="_blank" rel="noopener noreferrer"><%=f.name%></a></li><% }) %></ul></nav></div><% } %>
    <% if(w.type==='custom'){ %><div class="sidebar-widget"><h3 class="widget-title"><%= w.title||'自定义' %></h3><%- w.html||'' %></div><% } %>
  <% }) %></aside><% } %></div><% } %>
</div>
<footer class="site-footer"><div class="container">
  <% if(footer.columnItems&&footer.columnItems.enabled!==false&&footer.columnItems.items){ %><div class="footer-grid"><% footer.columnItems.items.forEach(function(c){ if(c.enabled===false)return; %><div class="footer-column"><% if(c.title){ %><h4 class="footer-column-title"><%=c.title%></h4><% } if(c.links){ %><ul class="footer-links"><% c.links.forEach(function(l){ if(l.enabled===false)return; %><li><a href="<%=l.url%>" class="footer-link"><%=l.label%></a></li><% }) %></ul><% } if(c.html){ %><div class="footer-html"><%-c.html%></div><% } %></div><% }) %></div><% } %>
  <div class="footer-bottom">
    <% if(footer.social&&footer.social.enabled&&site.social&&site.social.enabled){ %><div class="footer-social"><% Object.entries(site.social.items).forEach(function(e){ var s=e[1],k=e[0]; if(!s||!s.enabled)return; var tp=s.type||'link'; if(tp=='link'&&s.url){ %><a href="<%=s.url%>" target="_blank" rel="noopener noreferrer" aria-label="<%=k%>" title="<%=k%>"><% }else if(tp=='popup'&&s.value){ %><a href="#" class="js-contact" aria-label="<%=k%>" title="<%=escapeAttr(s.popupTitle||k)%>" data-contact="<%=escapeAttr(s.value)%>" data-title="<%=escapeAttr(s.popupTitle||k)%>" data-body="<%=escapeAttr(s.popupContent||s.value)%>"><% } %><svg width="<%=footer.social.iconSize||'24px'%>" height="<%=footer.social.iconSize||'24px'%>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><% if(k==='github'){%><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/><%}else if(k==='twitter'||k==='x'){%><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/><%}else if(k==='rss'){%><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/><%}else if(k==='email'){%><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/><%}else if(k==='weibo'){%><circle cx="12" cy="12" r="10"/><path d="M8 12l4 4 8-8"/><%}else if(k==='telegram'){%><path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4 20-7z"/><%}else if(k==='facebook'){%><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/><%}else if(k==='phone'){%><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/><%}else if(k==='qq'||k==='qqgroup'){%><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/><%}else if(k==='wechat'){%><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14.5c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm2.5 0c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm-4-5c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm5.5 0c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1z"/><%}else{%><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/><%}%></svg></a><% }) %></div><% } %>
    <% if(footer.bottomLinks&&footer.bottomLinks.enabled!==false&&footer.bottomLinks.items){ %><div class="footer-bottom-links"><% footer.bottomLinks.items.forEach(function(l){ if(l.enabled===false)return; %><a href="<%=l.url%>" class="footer-link"><%=l.label%></a><% }) %></div><% } %>
    <div class="footer-copyright"><%= footer.copyright || site.copyright %></div>
    <% if(footer.beian&&footer.beian.enabled){ %><div class="footer-beian"><% if(footer.beian.icp){ %><a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer"><%=footer.beian.icp%></a><% } if(footer.beian.gongan){ %><a href="http://www.beian.gov.cn/" target="_blank" rel="noopener noreferrer"><%=footer.beian.gongan%></a><% } %></div><% } %>
    <% if(footer.poweredBy&&footer.poweredBy.enabled){ var sr=site.showRepoLink!==false&&site.repoUrl; %><div class="footer-powered">Powered by<% if(sr){ %> <a href="<%=site.repoUrl%>" target="_blank" rel="noopener noreferrer"><% } %><%=footer.poweredBy.text||'S-ynapse'%><% if(sr){ %></a><% } %></div><% } %>
  </div>
  <%- footer.customHtml||'' %>
</div></footer>
</div>
<button class="back-to-top" id="btt" onclick="window.scrollTo({top:0,behavior:'smooth'})" aria-label="返回顶部" data-i18n-aria="toolbar.backToTop"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="18,15 12,9 6,15"/></svg><div class="read-dock" id="readDock" aria-label="阅读工具栏"><button class="dock-btn" id="dockToc" aria-label="回到目录" title="回到目录"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16"/><path d="M4 12h16"/><path d="M4 18h10"/></svg></button><button class="dock-btn" id="dockTop" aria-label="返回顶部" data-i18n-aria="toolbar.backToTop" title="返回顶部"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6,15 12,9 18,15"/></svg></button><svg class="dock-ring" id="dockRing" viewBox="0 0 40 40" aria-hidden="true"><circle class="dock-ring-bg" cx="20" cy="20" r="16"/><circle class="dock-ring-fg" id="dockFg" cx="20" cy="20" r="16"/></svg></div></button>

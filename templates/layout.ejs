    .read-tts-btn{display:inline-flex;align-items:center;gap:.3rem;padding:.35rem .75rem;font-size:.75rem;color:var(--color-ts);background:var(--color-hover);border:1px solid var(--color-border);border-radius:var(--br);cursor:pointer;transition:color var(--td) var(--te),border-color var(--td) var(--te)}.read-tts-btn:hover{color:var(--color-s);border-color:var(--color-s)}.read-tts-btn.speaking{color:#fff;background:var(--color-s);border-color:var(--color-s)}
    .kbd-help{position:fixed;left:1.5rem;bottom:1.5rem;background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--r);box-shadow:var(--sd);padding:.9rem 1.2rem;z-index:1500;display:none;font-size:.8125rem;color:var(--color-ts)}.kbd-help.open{display:block}.kbd-help table{border-collapse:collapse}.kbd-help td{padding:.22rem .6rem}.kbd-help kbd{background:var(--color-hover);border:1px solid var(--color-border);border-bottom-width:2px;border-radius:.25rem;padding:.05rem .4rem;font-family:var(--ff-mono);font-size:.75rem}
    .lightbox{position:fixed;inset:0;background:rgba(0,0,0,.9);display:none;align-items:center;justify-content:center;z-index:2000}.lightbox.open{display:flex}.lightbox img{max-width:min(92vw,1600px);max-height:82vh;border-radius:.25rem;box-shadow:0 24px 70px rgba(0,0,0,.55)}.lb-btn{position:absolute;top:50%;transform:translateY(-50%);width:46px;height:46px;border:none;border-radius:50%;background:rgba(255,255,255,.14);color:#fff;font-size:1.6rem;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background var(--td)}.lb-btn:hover{background:rgba(255,255,255,.3)}.lb-prev{left:14px}.lb-next{right:14px}.lb-close{position:absolute;top:14px;right:14px;width:46px;height:46px;border:none;border-radius:50%;background:rgba(255,255,255,.14);color:#fff;font-size:1.5rem;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center}.lb-close:hover{background:rgba(255,255,255,.3)}.lb-count{position:absolute;bottom:16px;left:50%;transform:translateX(-50%);color:rgba(255,255,255,.85);font-size:.875rem;letter-spacing:.05em}@media(max-width:768px){.lb-prev{left:8px}.lb-next{right:8px}}
    .link-warning-overlay{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.6);z-index:3000;display:flex;align-items:center;justify-content:center;padding:1rem}

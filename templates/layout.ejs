<% var fw=site.build&&site.build.forceContentWidth!==false; %><div class="content-wrapper<%- fw?' force-width':''%>">
  <% if(fw){ %><% if(typeof article!=='undefined'&&article.toc&&article.toc.length){ %><nav class="toc-sidebar visible"><div class="toc-sidebar-inner"><% if(features.toc&&features.toc.showTitle!==false){ %><div class="toc-sidebar-label"><%= (typeof lang!=='undefined'&&lang==='en')?((features.toc&&features.toc.titleTextEn)||'Contents'):((features.toc&&features.toc.titleText)||ui('post.tocTitle','目录')) %><button type="button" class="toc-toggle" id="tocToggle" aria-label="<%= ui('toolbar.tocCollapse','折叠目录') %>" data-i18n-aria="sidebar.collapse" aria-expanded="true"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6,9 12,15 18,9"/></svg></button></div><% } %><div class="toc-progress" id="tocProgress" aria-hidden="true"><i></i></div><ul class="toc-sidebar-list" id="tocList"><li class="toc-sidebar-item"><a href="#<%=article.slug%>" class="toc-sidebar-link is-title"><%=article.title%></a></li><% article.toc.forEach(function(h){ %><li class="toc-sidebar-item"><a href="#<%=h.id%>" class="toc-sidebar-link level-<%=h.level%>"><%=h.text%></a></li><% }) %></ul></div></nav><% } %><main class="main-content page-enter"><%- _bcHtml %><%- body %></main><% if(sidebar.enabled){ %><aside class="sidebar"><% sidebar.widgets.forEach(function(w){ if(!w.enabled) return; %>
    <% if(w.type==='author'){ %><div class="sidebar-widget widget-author"><h3 class="widget-title"><%- (w.icon&&NAV_ICONS[w.icon])||'' %><%= _wt(w, '关于我') %></h3><% if(w.avatar){ %><img src="<%=w.avatar%>" alt="avatar" class="widget-author-avatar avatar-<%=theme.avatar.shape%><%=theme.avatar.ring?' avatar-ring':''%>" loading="lazy"><% } else if(theme.avatar.badge){ %><div class="widget-author-avatar widget-author-badge avatar-<%=theme.avatar.shape%><%=theme.avatar.ring?' avatar-ring':''%>"><%= (typeof site.author==='string'&&site.author?site.author:'S').charAt(0).toUpperCase() %></div><% } %><div class="widget-author-name"><%= site.author %></div><% var _bio=(typeof lang!=='undefined'&&lang==='en'&&w.bioEn)?w.bioEn:w.bio; if(_bio){ %><div class="widget-author-bio"><%= _bio %></div><% } %></div><% } %>
    <% if(w.type==='recent'&&typeof recentPosts!=='undefined'){ %><div class="sidebar-widget"><h3 class="widget-title"><%- (w.icon&&NAV_ICONS[w.icon])||'' %><%= _wt(w, '最新文章') %></h3><% recentPosts.slice(0,w.count||5).forEach(function(p){ %><div class="widget-recent-item"><a href="<%=p.url%>" class="widget-recent-link"><%=p.title%></a><% if(w.showDate&&p.date){ %><div class="widget-recent-date"><%=new Date(p.date).toLocaleDateString(site.language||'zh-CN',{year:'numeric',month:'short',day:'numeric'})%></div><% } %></div><% }) %></div><% } %>
    <% if(w.type==='quote'){ %><div class="sidebar-widget quote-widget"><h3 class="widget-title"><%- (w.icon&&NAV_ICONS[w.icon])||'' %><%= _wt(w, (features.dailyQuote&&features.dailyQuote.label||'每日一言')) %></h3><div class="widget-quote"><span class="quote-mark">”</span><blockquote class="widget-quote-text" id="quoteText">…</blockquote><span class="widget-quote-author" id="quoteAuthor"></span></div></div><% } %>
    <% if(w.type==='tags'&&typeof allTags!=='undefined'){ %><div class="sidebar-widget"><h3 class="widget-title"><%- (w.icon&&NAV_ICONS[w.icon])||'' %><%= _wt(w, '标签云') %></h3><div class="widget-tag-cloud"><% var _wtf=(w.minCount?allTags.filter(function(t){return t.count>=w.minCount}):allTags);if(w.sortBy==='name'){_wtf=_wtf.slice().sort(function(a,b){return String(a.name).localeCompare(String(b.name),(typeof site!=='undefined'&&site.language)||'zh-CN')})}if(w.limit){_wtf=_wtf.slice(0,w.limit)}_wtf.forEach(function(t){ %><a href="<%=t.url%>" class="widget-tag-link"><%=t.name%><% if(w.showCount){ %><span class="tags-cloud-count"> (<%=t.count%>)</span><% } %></a><% }) %></div></div><% } %>
    <% if(w.type==='categories'&&typeof allCategories!=='undefined'){ %><div class="sidebar-widget"><h3 class="widget-title"><%- (w.icon&&NAV_ICONS[w.icon])||'' %><%= _wt(w, '分类') %></h3><% allCategories.forEach(function(c){ %><div class="widget-category-item"><a href="<%=c.url%>" class="widget-category-link"><%=c.name%></a><% if(w.showCount){ %><span class="widget-category-count"><%=c.count%></span><% } %></div><% }) %></div><% } %>
    <% if(w.type==='archive'&&typeof archives!=='undefined'){ %><div class="sidebar-widget"><h3 class="widget-title"><%- (w.icon&&NAV_ICONS[w.icon])||'' %><%= _wt(w, '归档') %></h3><% archives.forEach(function(g){ %><div class="widget-archive-item"><a href="<%= (typeof langPrefix!=='undefined'&&langPrefix ? langPrefix : '/zh/') %>archive#<%=g.year%>" class="widget-archive-link"><%=g.year%><% if(g.month){ %>-<%=g.month%><% } %></a><% if(w.showCount){ %><span class="widget-archive-count"><%=g.articles.length%></span><% } %></div><% }) %></div><% } %>
    <% if(w.type==='search'){ %><div class="sidebar-widget"><h3 class="widget-title"><%- (w.icon&&NAV_ICONS[w.icon])||'' %><%= _wt(w, '搜索') %></h3><input type="text" class="widget-search-input" placeholder="<%= (typeof lang!=='undefined'&&lang==='en'&&w.placeholderEn)?w.placeholderEn:(w.placeholder||'输入关键词...') %>" onkeydown="if(event.key==='Enter'&&window.openSearch)openSearch()"></div><% } %>
    <% if(w.type==='toc'&&typeof article!=='undefined'&&article.toc&&article.toc.length>1){ %><div class="sidebar-widget"><h3 class="widget-title"><%- (w.icon&&NAV_ICONS[w.icon])||'' %><%= _wt(w, '目录') %></h3><nav class="toc"><ul class="toc-list"><% article.toc.forEach(function(h){ %><li class="toc-item level-<%=h.level%>"><a href="#<%=h.id%>" class="toc-link"><%=h.text%></a></li><% }) %></ul></nav></div><% } %>

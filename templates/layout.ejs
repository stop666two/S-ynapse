      <button class="btn btn-primary" id="linkWarningConfirm"><%= site.externalLinkWarning.confirmText||'继续访问' %></button>
      <button class="btn" style="background:var(--color-hover);color:var(--color-ts);margin-left:.5rem" id="linkWarningCancel"><%= site.externalLinkWarning.cancelText||'取消返回' %></button>
    </div>
  </div>
</div>

      <% if(features.themePresets&&features.themePresets.enabled!==false&&typeof presets!=='undefined'&&presets&&presets.length){ %><div style="position:relative" data-ss-lang-wrap class="lang-wrap" style="position:relative"><button class="lang-btn" id="langBtn" aria-label="<%= ui('top.language','语言切换') %>" data-i18n-aria="top.language" onclick="toggleLangPop()">中/EN</button></div>  <div data-preset-wrap style="position:relative"><button class="preset-btn" id="presetBtn" aria-label="<%= ui('top.preset','主题预设') %>" title="<%= ui('top.preset','主题预设') %>" onclick="togglePresetPop()"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l2.4 4.8 5.6.8-4 4 .9 5.6-4.9-2.6-4.9 2.6.9-5.6-4-4 5.6-.8z"/></svg></button><div class="preset-pop" id="presetPop"><div class="preset-pop-title"><%= ui('top.preset','主题预设') %></div><% presets.forEach(function(p){ %><button class="preset-item" data-preset="<%=p.id%>" onclick="applyPreset('<%=p.id%>')" title="<%= (typeof lang!=='undefined'&&lang==='en')?p.labelEn:p.label %>"><span class="preset-swatch"><i style="background:<%=p.sample.light[0]%>"></i><i style="background:<%=p.sample.light[1]%>"></i><i style="background:<%=p.sample.light[2]%>"></i><i style="background:<%=p.sample.light[3]%>"></i></span><span class="preset-item-name"><%= (typeof lang!=='undefined'&&lang==='en')?p.labelEn:p.label %></span></button><% }); %></div></div><% } %>
    </div>

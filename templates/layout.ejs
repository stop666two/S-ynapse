<% if(nav.search&&nav.search.enabled&&features.search&&features.search.enabled!==false){ %><div class="search-overlay search-anim-<%= ((features.search&&features.search.openAnimation)==='slide')?'slide':'fade' %>" id="searchOverlay" onclick="if(event.target===this)closeSearch()"><div class="search-modal"><div class="search-input-row"><svg class="search-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg><input type="text" class="search-input" id="searchInput" placeholder="<%= nav.search.placeholder || '搜索...' %>" data-i18n-placeholder="search.placeholder" autofocus oninput="doSearch(this.value)"><span class="search-kbd">Ctrl K</span><button class="search-close" onclick="closeSearch()" aria-label="<%= ui('toolbar.closeSearch','关闭搜索') %>"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button></div><div class="search-history" id="searchHistory" hidden></div><div class="search-count-label" id="searchCount"></div><div class="search-results" id="searchResults"></div><div id="pfWrap" hidden></div></div></div><% } %>

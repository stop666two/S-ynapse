<script>
function a(d){document.documentElement.setAttribute('data-theme',d?'dark':'light');var su=document.getElementById('sunI'),mo=document.getElementById('moonI');if(su&&mo){su.style.display=d?'inline':'none';mo.style.display=d?'none':'inline'}}(function(){var t='<%=theme.darkMode&&theme.darkMode.default||"system"%>',s=localStorage.getItem('theme'),p=window.matchMedia('(prefers-color-scheme:dark)').matches;if(!s&&t==='system'){window.matchMedia('(prefers-color-scheme:dark)').addEventListener('change',function(e){if(!localStorage.getItem('theme'))a(e.matches)})}})();
function toggleDark(){var c=document.documentElement.getAttribute('data-theme'),d=c!=='dark';a(d);localStorage.setItem('theme',d?'dark':'light')}
function openSearch(){var o=document.getElementById('searchOverlay');if(o){o.classList.add('open');setTimeout(function(){var i=document.getElementById('searchInput');if(i)i.focus()},100)}}
function closeSearch(){var o=document.getElementById('searchOverlay');if(o)o.classList.remove('open')}
document.addEventListener('keydown',function(e){if(e.key==='Escape')closeSearch();if((e.ctrlKey||e.metaKey)&&e.key==='k'){e.preventDefault();var o=document.getElementById('searchOverlay');if(o&&!o.classList.contains('open'))openSearch();else closeSearch()}});
function doSearch(q){var d=document.getElementById('searchResults');if(!d)return;if(!q||q.length<2){d.classList.remove('has-results');d.innerHTML='';return}var w=window.__SEARCH_DATA__||[],r=[],lq=q.toLowerCase();for(var i=0;i<w.length;i++){var it=w[i];if(it.title&&it.title.toLowerCase().includes(lq)||it.excerpt&&it.excerpt.toLowerCase().includes(lq)||it.content&&it.content.toLowerCase().includes(lq)){r.push(it);if(r.length>=10)break}}if(r.length){d.classList.add('has-results');r.forEach(function(item){var a=document.createElement('a');a.className='search-result-item';a.href=item.url;var t=document.createElement('div');t.className='search-result-title';t.textContent=item.title;a.appendChild(t);if(item.excerpt){var e=document.createElement('div');e.className='search-result-excerpt';e.textContent=item.excerpt.substring(0,120);a.appendChild(e)}d.appendChild(a)})}else{d.classList.remove('has-results');var empty=document.createElement('div');empty.style.textAlign='center';empty.style.color='var(--color-tl)';empty.style.padding='1rem';empty.textContent='未找到相关文章';d.appendChild(empty)}}
(function(){var p=document.getElementById('rp');if(p&&document.querySelector('.post-article')){p.classList.add('visible');window.addEventListener('scroll',function(){var s=window.scrollY,h=document.documentElement.scrollHeight-window.innerHeight;if(h>0)p.style.width=Math.min(100,(s/h)*100)+'%'})}})();
(function(){var b=document.getElementById('btt');if(b){window.addEventListener('scroll',function(){b.classList.toggle('visible',window.scrollY>300)})}})();
(function(){document.addEventListener('DOMContentLoaded',function(){document.querySelectorAll('.post-content pre').forEach(function(p){var b=document.createElement('button');b.className='copy-code-btn';b.textContent='复制';b.onclick=function(){var c=p.querySelector('code')||p;navigator.clipboard.writeText(c.textContent).then(function(){b.textContent='已复制';setTimeout(function(){b.textContent='复制'},2000)})};p.appendChild(b)})})})();
document.addEventListener('DOMContentLoaded',function(){document.querySelectorAll('img:not([loading=eager])').forEach(function(i){i.classList.add('js-img');if(i.complete)i.classList.add('loaded');else i.addEventListener('load',function(){i.classList.add('loaded')});i.addEventListener('error',function(){i.classList.add('loaded')})})});
function toggleReadingMode(){var d=document.documentElement;var a=d.getAttribute('data-reading');if(a==='true'){d.removeAttribute('data-reading');localStorage.setItem('readingMode','false')}else{d.setAttribute('data-reading','true');localStorage.setItem('readingMode','true')}};(function(){if(localStorage.getItem('readingMode')==='true')document.documentElement.setAttribute('data-reading','true')})()
;(function(){var d=document.querySelector('.toc-sidebar-list');if(!d)return;var links=d.querySelectorAll('.toc-sidebar-link');var ids=[];links.forEach(function(l){var h=l.getAttribute('href');if(h&&h[0]==='#')ids.push(h.slice(1))});if(!ids.length)return;function update(){var cur='';for(var i=0;i<ids.length;i++){var el=document.getElementById(ids[i]);if(el&&el.getBoundingClientRect().top<120)cur=ids[i]}links.forEach(function(l){var h=l.getAttribute('href');l.classList.toggle('active',h==='#'+cur)})}window.addEventListener('scroll',update);update()})()
function showContact(v,t,c){var o=document.getElementById('contactPopup'),tv=document.getElementById('contactPopupTitle'),cv=document.getElementById('contactPopupContent'),vv=document.getElementById('contactPopupValue'),cp=document.getElementById('contactPopupCopied');if(!o)return;tv.textContent=t;cv.textContent=c;vv.textContent=v;vv.setAttribute('data-value',v);cp.textContent='';o.style.display='flex'}
document.addEventListener('click',function(e){var el=e.target.closest('.js-contact');if(!el)return;e.preventDefault();showContact(el.getAttribute('data-contact')||'',el.getAttribute('data-title')||'',el.getAttribute('data-body')||'')});
function copyContact(el){var v=el.getAttribute('data-value')||el.textContent;if(navigator.clipboard){navigator.clipboard.writeText(v).then(function(){document.getElementById('contactPopupCopied').textContent='✓ 已复制到剪贴板'})}else{var ta=document.createElement('textarea');ta.value=v;document.body.appendChild(ta);ta.select();document.execCommand('copy');document.body.removeChild(ta);document.getElementById('contactPopupCopied').textContent='✓ 已复制到剪贴板'}}
(function(){var c=<%- JSON.stringify(site.externalLinkWarning||{}) %>;if(!c.enabled)return;var wl=c.whitelist||[];function matchWhitelist(url){for(var i=0;i<wl.length;i++){var raw=wl[i];var p=raw.replace(/\./g,'\\.').replace(/\*/g,'[^/]*?');if(new RegExp('^'+p+'$','i').test(url))return true;if(raw.startsWith('*.')){var p2=raw.slice(2).replace(/\./g,'\\.');if(new RegExp('^'+p2+'$','i').test(url))return true}}return false}document.addEventListener('click',function(e){var a=e.target.closest('a');if(!a)return;var h=a.getAttribute('href');if(!h||h[0]=='/'||h[0]=='#'||h.slice(0,7)=='mailto:'||h.slice(0,11)=='javascript:')return;try{var u=new URL(h,window.location.href);if(u.origin==window.location.origin)return;if(matchWhitelist(u.hostname+u.pathname))return;if(matchWhitelist(u.hostname))return}catch(ex){};e.preventDefault();var o=document.getElementById('linkWarningOverlay'),b=document.getElementById('linkWarningBody'),x=document.getElementById('linkWarningConfirm'),n=document.getElementById('linkWarningCancel');if(!o||!b)return;b.innerHTML=(c.message||'').replace('{url}','')+'<span class=\"link-url\">'+h+'</span>';o.style.display='flex';x.onclick=function(){o.style.display='none';window.open(h,'_blank')};n.onclick=function(){o.style.display='none'}})})()
;(function(){var lb=document.getElementById('lightbox'),img=document.getElementById('lbImg'),cnt=document.getElementById('lbCount');if(!lb||!img)return;var list=[],idx=0,tx0=null;function collect(){list=[];document.querySelectorAll('.post-content img,.gallery img').forEach(function(im){if(!im.closest('a'))list.push(im)})}function show(i){if(!list.length)return;idx=(i+list.length)%list.length;img.src=list[idx].currentSrc||list[idx].src;img.alt=list[idx].alt||'';cnt.textContent=(idx+1)+' / '+list.length;lb.classList.add('open');document.body.style.overflow='hidden'}function hide(){lb.classList.remove('open');document.body.style.overflow=''}document.addEventListener('click',function(e){var im=e.target.closest('.post-content img,.gallery img');if(!im||im.closest('a'))return;e.preventDefault();collect();var j=list.indexOf(im);if(j>-1)show(j)});document.getElementById('lbPrev').onclick=function(){show(idx-1)};document.getElementById('lbNext').onclick=function(){show(idx+1)};document.getElementById('lbClose').onclick=hide;lb.addEventListener('click',function(e){if(e.target===lb)hide()});document.addEventListener('keydown',function(e){if(!lb.classList.contains('open'))return;var k=e.key;if(k==='Escape'){hide()}else if(k==='ArrowLeft'){e.preventDefault();show(idx-1)}else if(k==='ArrowRight'){e.preventDefault();show(idx+1)}});lb.addEventListener('touchstart',function(e){tx0=e.touches[0].clientX},{passive:true});lb.addEventListener('touchend',function(e){if(tx0===null)return;var dx=e.changedTouches[0].clientX-tx0;if(dx>50)show(idx-1);if(dx<-50)show(idx+1);tx0=null},{passive:true})})()
;(function(){var h=document.getElementById('kbdHelp'),btn=document.getElementById('mTocBtn'),dr=document.getElementById('mTocDrawer');if(btn&&dr){function open(){dr.classList.add('open');btn.setAttribute('aria-expanded','true');btn.classList.add('open')}function close(){dr.classList.remove('open');btn.setAttribute('aria-expanded','false');btn.classList.remove('open')}btn.onclick=function(){dr.classList.contains('open')?close():open()};document.getElementById('mTocClose').onclick=close;dr.addEventListener('click',function(e){if(e.target.closest('a'))close()})}document.addEventListener('keydown',function(e){if(e.key==='Escape'){var m=dr;if(m)m.classList.remove('open');if(h)h.classList.remove('open');if(btn)btn.classList.remove('open')}});if(h){document.addEventListener('click',function(e){if(h.classList.contains('open')&&!e.target.closest('#kbdHelp'))h.classList.remove('open')})}})()
;(function(){var g=document.getElementById('readerGear'),p=document.getElementById('readerPanel');if(!g)return;var fs=document.getElementById('rFont'),lh=document.getElementById('rLine'),wd=document.getElementById('rWidth');var prefs={};try{prefs=JSON.parse(localStorage.getItem('readerPrefs')||'{}')}catch(e){}function apply(){var s='';if(prefs.fs)s=prefs.fs+'px';document.documentElement.style.setProperty('--post-fs',s);s='';if(prefs.lh)s=prefs.lh;document.documentElement.style.setProperty('--post-lh',s);s='';if(prefs.wd)s=prefs.wd+'px';document.documentElement.style.setProperty('--post-w',s)}function syncUI(){fs.value=prefs.fs||16;lh.value=prefs.lh||1.8;wd.value=prefs.wd||''}g.onclick=function(){var open=p.classList.toggle('open');g.setAttribute('aria-expanded',open?'true':'false');if(open)syncUI()};fs.oninput=function(){prefs.fs=+fs.value;save();apply()};lh.oninput=function(){prefs.lh=+lh.value;save();apply()};wd.oninput=function(){prefs.wd=+wd.value;save();apply()};function save(){try{localStorage.setItem('readerPrefs',JSON.stringify(prefs))}catch(e){}}document.getElementById('rReset').onclick=function(){prefs={};localStorage.removeItem('readerPrefs');apply();syncUI()};apply()})()
;(function(){var b=document.getElementById('ttsBtn');if(!b||!window.speechSynthesis)return;var u=null;function text(){var c=document.querySelector('.post-content');return c?c.textContent.replace(/\s+/g,' ').trim():''}function set(on){b.classList.toggle('speaking',on);b.setAttribute('aria-pressed',on?'true':'false')}b.onclick=function(){if(speechSynthesis.speaking||speechSynthesis.pending){speechSynthesis.cancel();u=null;set(false);return}var t=text();if(!t)return;u=new SpeechSynthesisUtterance(t);u.lang=document.documentElement.lang||'zh-CN';u.rate=parseFloat(b.getAttribute('data-rate'))||1;u.onend=function(){set(false)};u.onerror=function(){set(false)};speechSynthesis.speak(u);set(true)}})()
document.addEventListener('keydown',function(e){var t=e.target;if(t&&(t.tagName==='INPUT'||t.tagName==='TEXTAREA'||t.tagName==='SELECT'||t.isContentEditable))return;if(e.ctrlKey||e.metaKey||e.altKey)return;var k=e.key;if(k==='/'){e.preventDefault();openSearch()}else if(k==='d'||k==='D'){toggleDark()}else if(k==='j'||k==='J'){var n=document.querySelector('.post-nav-link.next');if(n)n.click()}else if(k==='k'||k==='K'){var pv=document.querySelector('.post-nav-link.prev');if(pv)pv.click()}else if(k==='?'){var h=document.getElementById('kbdHelp');if(h)h.classList.toggle('open')}})

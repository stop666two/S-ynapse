<div class="post-article">
<h1><%= (typeof title!=='undefined'&&title) || friends.title || ui('links.title','友情链接') %></h1>

<% var _len=(typeof lang!=='undefined'&&lang==='en'); %>
<% if (friends.description) { %><p class="links-description"><%= (_len&&friends.descriptionEn)?friends.descriptionEn:friends.description %></p><% } %>

<% if (friends.friends && friends.friends.length) { %>
<div class="links-grid">
  <% friends.friends.forEach(function(f) { var _fn=(_len&&f.nameEn)?f.nameEn:f.name; var _fd=(_len&&f.descEn)?f.descEn:f.desc; %>
  <a href="<%= f.url %>" class="links-card" target="_blank" rel="noopener noreferrer">
    <% if (f.logo) { %><img src="<%= f.logo %>" alt="<%= _fn %>" class="links-card-logo" loading="lazy"><% } else { %><span class="links-card-logo links-card-logo-placeholder" aria-hidden="true"><%= _fn.charAt(0) %></span><% } %>
    <div class="links-card-body">
      <div class="links-card-name"><%= _fn %></div>
      <% if (_fd) { %><div class="links-card-desc"><%= _fd %></div><% } %>
    </div>
  </a>
  <% }) %>
</div>
<% } else { %>
<p class="empty-state"><%= ui('links.empty','暂无友链') %></p>
<% } %>

<% if (friends.applyNote) { %>
<div class="links-apply">
  <h3><%= ui('links.apply','友链申请') %></h3>
  <p><%= (_len&&friends.applyNoteEn)?friends.applyNoteEn:friends.applyNote %></p>
</div>
<% } %>
</div>

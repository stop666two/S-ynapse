<% if (!pageContent.match(/<h1/i)) { %><h1><%= pageTitle %></h1><% } %>
<div class="post-article page-pad">
  <div class="post-content">
    <%- pageContent %>
  </div>
</div>
<% var ac = (typeof features!=='undefined'&&features.authorCard)||{}; var ap = (typeof site!=='undefined'&&site.authorProfile)||{}; var acName=(ap.name||site.author||''); if (pageSlug===(ac.pageSlug||'about')&&ac.enabled!==false&&(ap.bio||ap.avatar||(ap.skills&&ap.skills.length)||(ap.timeline&&ap.timeline.length)||(ap.socials&&ap.socials.length))) { %>
<div class="post-article author-section">
<div class="author-card">
  <div class="author-card-head">
    <% if (ap.avatar) { %><style>.author-card{--about-avatar-size:<%= ac.avatarSize||'96px' %>}</style><img class="author-avatar" src="<%= ap.avatar %>" alt="<%= acName %>" loading="lazy" decoding="async"><% } %>
    <div class="author-card-meta">
      <% if (acName) { %><div class="author-card-name"><%= acName %></div><% } %>
      <% if (ap.bio) { %><p class="author-card-bio"><%= ap.bio %></p><% } %>
      <% if (ap.socials&&ap.socials.length&&ac.showSocial!==false) { %><div class="author-socials"><% ap.socials.forEach(function(s){ if(!s||!s.url)return; %><a class="author-social" href="<%= s.url %>" target="_blank" rel="noopener noreferrer"><%= s.label||s.url %></a><% }) %></div><% } %>
    </div>
  </div>
  <% if (ap.skills&&ap.skills.length&&ac.showSkills!==false) { %><div class="author-skills"><% ap.skills.forEach(function(k){ %><span class="author-skill"><%= k %></span><% }) %></div><% } %>
  <% if (ap.timeline&&ap.timeline.length&&ac.showTimeline!==false) { %><ul class="author-timeline"><% ap.timeline.slice(0, Number(ac.maxTimeline)>0?Number(ac.maxTimeline):ap.timeline.length).forEach(function(t){ if(!t)return; %><li class="author-tl-item"><span class="author-tl-year"><%= t.year||'' %></span><span class="author-tl-title"><%= t.title||'' %></span><% if(t.desc){ %><span class="author-tl-desc"><%= t.desc %></span><% } %></li><% }) %></ul><% } %>
</div>
</div>
<% } %>

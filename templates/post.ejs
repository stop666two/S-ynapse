<%# 
  Article detail page template.
  Data contract:
    article: {slug, title, url, formattedDate, date, categories, tags, readTime, featuredImage, content, relatedArticles, toc}
    site.comments: {enabled, provider, giscus/utterances/disqus config}
    pagesContent: {[filename]: {title, content, body}} — .md content from pages/ directory, keyed by filename without extension
    theme.articleFooter: {enabled, source, backgroundColor, textColor, borderColor, ...styling}
    prevArticle / nextArticle: {title, url} or null
%>
<article class="post-article">
  <header class="post-header">
    <h1 class="post-title" id="<%= article.slug %>"<% if (!(typeof features!=='undefined'&&features.viewTransition&&features.viewTransition.shared===false)) { %> style="view-transition-name:title-<%= article.slug %>"<% } %>><% if (article.pinned) { %><span class="pin-badge"><%= ui('card.pinned','置顶') %></span> <% } %><%= article.title %></h1>
    <div class="post-meta">
      <% if (article.date) { %>
      <span><%= article.formattedDate || article.date %></span>
      <% } %>
      <% if (features.readingTime && features.readingTime.enabled !== false && article.readTime) { %><span class="post-reading-time"><%= features.readingTime.labelBefore || '' %><%= article.readTime %><%= features.readingTime.labelAfter || ' 分钟' %></span><% } %>
      <% if (article.categories && article.categories.length) { %>
      <span>
        <% article.categories.forEach(function(cat, i) { %>
        <a href="<%= (typeof langPrefix!=='undefined' ? langPrefix : '/zh/') %>categories/<%= generateSlug(cat) %>/"><%= cat %></a><% if (i < article.categories.length - 1) { %>, <% } %>
        <% }) %>
      </span>
      <% } %>
      <% if (article.wordCount && features.wordCount && features.wordCount.enabled!==false && features.wordCount.inArticle!==false) { %>
      <span><%= article.wordCount %> <span data-i18n="post.words">字</span></span>
      <% } %>
      <% if (article.readTime) { %>
      <span><%= article.readTime %> <span data-i18n="post.readMinutes">分钟阅读</span></span>
      <% } %>
      <% if (article.tags && article.tags.length) { %>
      <span>
        <% article.tags.forEach(function(tag) { %>
        <a href="<%= (typeof langPrefix!=='undefined' ? langPrefix : '/zh/') %>tags/<%= generateSlug(tag) %>/" class="post-tag"><%= tag %></a>
        <% }) %>
      </span>
      <% } %>
    </div>
  </header>

  <% if (article.featuredImage) { %>
  <img src="<%= article.featuredImage %>" alt="<%= article.title %>"<% if (!(typeof features!=='undefined'&&features.viewTransition&&features.viewTransition.shared===false)) { %> style="view-transition-name:cover-<%= article.slug %>"<% } %> class="post-featured-image" loading="eager">
  <% if(features.cover&&features.cover.enabled!==false&&article.featuredImage){ %>
  <div class="cover-strip cover-apply" data-article="<%= article.slug %>">
    <span class="cover-strip-label">封面样式</span>
    <div class="cover-thumb-row" role="radiogroup" aria-label="封面样式">
    <% (features.cover.patterns||['gradient','stripes','dots','blob','mesh']).forEach(function(pat,i){ %>
    <button type="button" class="cover-thumb cover-pattern-<%= pat %> <%= i===0?'active':'' %>" data-cover="<%= pat %>" aria-label="<%= pat %>" title="<%= pat %>"></button>
    <% }) %>
    </div>
  </div>
  <% } %>
  <% } %>

  <div class="post-content<% var _mg=(typeof features!=='undefined'&&features.magazine)||{}; if(_mg.enabled!==false){ if(_mg.dropCap!==false){%> mg-dropcap<%} if(_mg.figureBleed!==false){%> mg-bleed<%} if(_mg.tableHover!==false){%> mg-tablehover<%} if(_mg.headingNumbers){%> mg-h2num<%} } %>">
    <%- article.content %>
  </div>
  <%# Article footer: rendered from pages/ content. Source filename is set in theme.json5 articleFooter.source. %>
  <% if(features.favorites&&features.favorites.enabled!==false&&!page.favoriteExclude){ %>
  <button type="button" class="fav-btn" id="favBtn" data-url="<%= article.url %>" data-title="<%= article.title %>" aria-label="收藏"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-4.6-9.6-8.4C.6 9.2 2.6 5.5 6.2 5.5c2.1 0 3.6 1.2 4.4 2.4.8-1.2 2.3-2.4 4.4-2.4 3.6 0 5.6 3.7 3.8 7.1C19 16.4 12 21 12 21z"/></svg><span><%= ui('favorites.not', features.favorites.notText||'收藏') %></span></button>
  <% } %>
  <% if(theme.articleFooter&&theme.articleFooter.enabled!==false&&theme.articleFooter.source&&typeof pagesContent!=='undefined'&&pagesContent[theme.articleFooter.source]){ var f=theme.articleFooter; var pc=pagesContent[f.source]; %><div class="article-footer" style="--ff-bg:<%=f.backgroundColor%>;--ff-t:<%=f.textColor%>;--ff-bd:<%=f.borderColor%>;--ff-pan:<%=f.paddingTop||'1.25rem'%>;--ff-par:<%=f.paddingRight||'1.5rem'%>;--ff-pab:<%=f.paddingBottom||'1.25rem'%>;--ff-pal:<%=f.paddingLeft||'1.5rem'%>;--ff-r:<%=f.borderRadius||'0.5rem'%>;--ff-fs:<%=f.fontSize||'0.875rem'%>"><%- pc.content %></div><% } %>
  <div style="display:flex;justify-content:flex-end;gap:.5rem;margin-top:1rem;padding-top:1rem;border-top:1px solid var(--color-border)">
    <% if(features.tts&&features.tts.enabled!==false){ %><button class="read-tts-btn" id="ttsBtn" aria-pressed="false" data-rate="<%= features.tts.rate||1 %>"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="11,5 6,9 2,9 2,15 6,15 11,19"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/><path d="M18.5 5.5a9 9 0 0 1 0 13"/></svg> 朗读</button><% } %>
    <% if(features.readMode&&features.readMode.enabled!==false){ %><button class="reading-mode-btn" onclick="toggleReadingMode()"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg> <%= features.readMode.label||'阅读模式' %></button><% } %>
  </div>
</article>
<% if(features.readingPanel&&features.readingPanel.enabled!==false){ %>
<button class="reader-gear" id="readerGear" aria-label="阅读设置" data-i18n-aria="post.readSettings" aria-expanded="false"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33h.01a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51h.01a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82v.01a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></button>
<div class="reader-panel" id="readerPanel" role="dialog" aria-label="阅读设置" data-i18n-aria="post.readSettings">
  <h4 data-i18n="post.readSettings">阅读设置</h4>
  <div class="reader-row"><label for="rFont" data-i18n="post.fontSize">字号</label><input type="range" id="rFont" min="<%=features.readingPanel.fontSizeMin||15%>" max="<%=features.readingPanel.fontSizeMax||26%>" step="<%=(typeof tuning!=='undefined'&&tuning.reading&&tuning.reading.fontSizeStep)||features.readingPanel.fontSizeStep||1%>" value="<%=features.readingPanel.fontSizeDefault||19%>"></div>
  <div class="reader-row"><label for="rLine" data-i18n="post.lineHeight">行距</label><input type="range" id="rLine" min="<%=features.readingPanel.lineHeightMin||1.4%>" max="<%=features.readingPanel.lineHeightMax||2.6%>" step="<%=(typeof tuning!=='undefined'&&tuning.reading&&tuning.reading.lineHeightStep)||features.readingPanel.lineHeightStep||0.1%>" value="<%=features.readingPanel.lineHeightDefault||1.9%>"></div>
  <div class="reader-row"><label for="rWidth" data-i18n="post.width">宽幅</label><input type="range" id="rWidth" min="<%=features.readingPanel.widthMin||560%>" max="<%=features.readingPanel.widthMax||1200%>" step="<%=features.readingPanel.widthStep||40%>" value="<%=features.readingPanel.widthDefault||800%>"></div>
  <% if(features.readingPanel.showReset!==false){ %><button class="reader-reset" id="rReset"><%=features.readingPanel.resetText||ui('post.resetDefault','重置为默认')%></button><% } %>
</div>
<% } %>

<%# Related articles section — computed by computeRelatedArticles() based on shared tags/categories. %>
<% if (article.relatedArticles && article.relatedArticles.length && features.related && features.related.enabled!==false) { %>
<section class="related-posts">
  <h3 class="related-posts-title"><span data-i18n="post.relatedTitle">相关文章</span></h3>
  <div class="related-posts-grid">
    <% article.relatedArticles.forEach(function(r) { %>
    <a href="<%= r.url %>" class="related-post-card">
      <div class="related-post-title"><%= r.title %></div>
      <% if (features.related && features.related.showExcerpt!==false && r.excerpt) { %><div class="related-post-excerpt"><%= r.excerpt.length > (features.related.excerptLength||80) ? r.excerpt.slice(0, features.related.excerptLength||80) + '…' : r.excerpt %></div><% } %>
      <% if (r.tags && r.tags.length) { %><div class="related-post-tags"><% r.tags.forEach(function(t) { %><span class="related-post-tag"><%= t %></span><% }) %><% if (features.related && features.related.showCount) { %><span class="related-post-count"><%= r.tags.length %></span><% } %></div><% } %>
    </a>
    <% }) %>
  </div>
</section>
<% } %>

<%# Comments section — supports Giscus (GitHub Discussions), Utterances (GitHub Issues), or Disqus. %>
<% if (site.comments && site.comments.enabled && features.comments && features.comments.enabled!==false) { %>
<section class="comments-section">
<div class="comments-head" aria-hidden="true"><span class="comments-avatar"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span></div>
  <% if (site.comments.provider === 'giscus') { %>
  <script src="https://giscus.app/client.js"
          data-repo="<%= site.comments.giscus.repo %>"
          data-repo-id="<%= site.comments.giscus.repoId %>"
          data-category="<%= site.comments.giscus.category %>"
          data-category-id="<%= site.comments.giscus.categoryId %>"
          data-mapping="<%= site.comments.giscus.mapping || 'pathname' %>"
          data-strict="<%= site.comments.giscus.strict || '0' %>"
          data-reactions-enabled="<%= site.comments.giscus.reactionsEnabled || '1' %>"
          data-emit-metadata="<%= site.comments.giscus.emitMetadata || '0' %>"
          data-input-position="<%= site.comments.giscus.inputPosition || 'bottom' %>"
          data-theme="<%= site.comments.giscus.theme || 'light' %>"
          data-lang="<%= site.comments.giscus.lang || site.language || 'zh-CN' %>"
          async>
  </script>
  <% } else if (site.comments.provider === 'utterances') { %>
  <script src="https://utteranc.es/client.js"
          repo="<%= site.comments.utterances.repo %>"
          issue-term="pathname"
          label="<%= site.comments.utterances.label || 'comment' %>"
          theme="<%= site.comments.utterances.theme || 'github-light' %>"
          crossorigin="anonymous"
          async>
  </script>
  <% } else if (site.comments.provider === 'disqus') { %>
  <div id="disqus_thread"></div>
  <script>
    var disqus_config = function () {
      this.page.url = '<%= site.url + article.url %>';
      this.page.identifier = '<%= article.slug %>';
    };
    (function() {
      var d = document, s = d.createElement('script');
      s.src = 'https://<%= site.comments.disqus.shortname %>.disqus.com/embed.js';
      s.setAttribute('data-timestamp', +new Date());
      (d.head || d.body).appendChild(s);
    })();
  </script>
  <noscript><%- ui('post.disqusNoScript','请启用 JavaScript 以查看 Disqus 评论。') %></noscript>
  <% } %>
  <% if(features.comments&&features.comments.renderPlaceholder!==false){ %><div class="comments-placeholder" id="commentsPlaceholder"><%= (features.comments&&features.comments.placeholderText)||'评论加载中…' %></div><% } %>
</section>
<% } %>

<%# Series navigation panel — appears when the article belongs to a series (front-matter `series`). %>
<% if (article.series && features.series && features.series.enabled!==false && features.series.showNavPanel!==false) { %>
<div class="series-nav" role="navigation" aria-label="系列导航">
  <div class="series-nav-head"><span class="series-nav-badge"><span data-i18n="post.series">系列</span></span><span class="series-nav-name"><%= article.series %></span><span class="series-nav-progress"><%= String(features.series.progressLabel||'{index} / {total}').replace('{index}',article.seriesIndex).replace('{total}',article.seriesTotal) %></span></div>
  <% var _spct=article.seriesTotal>0?Math.round((article.seriesIndex/article.seriesTotal)*100):0; %><div class="series-progress" aria-hidden="true"><i style="width:<%= _spct %>%"></i></div>
  <div class="series-nav-links">
    <% if (article.seriesPrevUrl) { %><a href="<%= article.seriesPrevUrl %>" class="series-nav-link prev">← <%= features.series.prevLabel||'上一篇' %></a><% } %>
    <% if (article.seriesNextUrl) { %><a href="<%= article.seriesNextUrl %>" class="series-nav-link next"><%= features.series.nextLabel||'下一篇' %> →</a><% } %>
  </div>
</div>
<% } %>

<%# Share row — internal icons + copy link / wechat copy, zero external deps. Order is configurable via features.share.order. %>
<% if(features.share&&features.share.enabled!==false){ var SHORDER=features.share.order||[]; var SHTML={weibo:'fill:currentColor:<path d="M10.1 21c-4.5 0-8.1-2.5-8.1-5.8 0-2.8 2.7-5.8 5.6-7 2.9-1.1 4.6-2.6 4.6-4.3 0-2.4-3-3.4-3-3.4s4.9 1 4.9 5.4c0 2-1.3 3.7-3.1 5.2 4.2.3 7.6 2.6 7.6 6.1 0 3.2-3.5 5.8-8.4 5.8z"/><circle cx="16" cy="11.5" r="1.2"/><circle cx="14.2" cy="13.8" r="1.2"/>',qq:'fill:currentColor:<path d="M12 2C8 2 5 5 5 9c0 2.5 1 4.6 2.5 6-.3 1-.9 2-1.5 2.6 1.7.4 3-.2 3.8-.8.7.2 1.4.3 2.2.3s1.5-.1 2.2-.3c.8.6 2.1 1.2 3.8.8-.6-.6-1.2-1.6-1.5-2.6C18 13.6 19 11.5 19 9c0-4-3-7-7-7z"/>',wechat:'fill:currentColor:<path d="M9.5 4C5.4 4 2 6.7 2 10c0 1.9 1 3.5 2.7 4.6l-.7 2.1 2.4-1.2c.9.3 2 .4 3.1.4.2-3.6 3.2-6.5 7-6.5.2 0 .4 0 .6.1C16.5 6.2 13.3 4 9.5 4z"/><path d="M22 14.5c0-2.8-2.7-5-6-5s-6 2.2-6 5 2.7 5 6 5c.6 0 1.2-.1 1.8-.2l1.9 1-.6-1.7c1.8-.9 2.9-2.4 2.9-4.1z"/>',x:'fill:currentColor:<path d="M18.9 2H22l-6.8 7.8L23.2 22h-6.3l-4.9-6.4L6.4 22H3.2l7.3-8.3L1 2h6.4l4.4 5.9L18.9 2zm-1.1 18h1.7L7.1 3.7H5.3L17.8 20z"/>',facebook:'fill:currentColor:<path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.3-1.5 1.6-1.5h1.6V3.6c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.5-4 4.1v2.3H7.6V13h2.7v8h3.2z"/>',mail:'none:currentColor:<rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 7l-10 6L2 7"/>',copy:'none:currentColor:<rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>'}; %>
<div class="share-row" role="group" aria-label="<span data-i18n="post.shareThis">分享本文</span>">
  <% if(features.share.showLabel){ %><span class="share-label"><%=features.share.label||'分享'%></span><% } %>
  <% SHORDER.forEach(function(k){ if(!SHTML[k])return; var seg=SHTML[k].split(':'); var fb=seg[0], fw=seg[1], inner=seg[2]; if(k==='copy'){ %><button class="share-btn" data-share="copy" type="button" aria-label="复制链接" title="复制链接"><svg width="15" height="15" viewBox="0 0 24 24" fill="<%=fb==='fill'?'currentColor':'none'%>"<%-fb==='none'?' stroke="' + fw + '" stroke-width="2"':''%>><%-inner%></svg></button><% } else { %><a class="share-btn" data-share="<%=k%>" href="#" aria-label="分享到<%=k==='x'?'X':k%>" title="分享到<%=k==='x'?'X':k%>"><svg width="15" height="15" viewBox="0 0 24 24" fill="<%=fb==='fill'?'currentColor':'none'%>"<%-fb==='none'?' stroke="' + fw + '" stroke-width="2"':''%>><%-inner%></svg></a><% } }) %>
</div>
<% } %>

<%# Reward section — money collection. Renders only when site.reward config provides image/url entries AND features.reward is enabled. %>
<% if (site.reward && site.reward.enabled && features.reward && features.reward.enabled!==false) { var rw = site.reward; var rwEntries = []; if (rw.wechat && (rw.wechat.image || rw.wechat.url)) rwEntries.push({key:'wechat', label: rw.wechat.label || '微信', image: rw.wechat.image || '', url: rw.wechat.url || ''}); if (rw.alipay && (rw.alipay.image || rw.alipay.url)) rwEntries.push({key:'alipay', label: rw.alipay.label || '支付宝', image: rw.alipay.image || '', url: rw.alipay.url || ''}); if (Array.isArray(rw.custom)) rw.custom.forEach(function(c,ci){ if (c && (c.image || c.url)) rwEntries.push({key:'custom'+ci, label: c.label || '其他', image: c.image || '', url: c.url || ''}); }); if (rwEntries.length) { %>
<div class="reward-bar">
  <button class="reward-btn" type="button" aria-haspopup="dialog" data-reward-open><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21c-4.5-3-8-6.5-8-10.5C4 7 6 5 8.5 5c1.4 0 2.7.7 3.5 1.8C12.8 5.7 14.1 5 15.5 5 18 5 20 7 20 10.5c0 4-3.5 7.5-8 10.5z"/></svg> <%= features.reward.buttonText||'打赏' %></button>
  <% if(features.reward.showNote!==false){ %><span class="reward-note"><%= rw.note || features.reward.note || '' %></span><% } %>
</div>
<div class="reward-overlay" id="rewardOverlay" role="dialog" aria-modal="true" aria-label="<%= features.reward.popupTitle||'打赏' %>" hidden>
  <div class="reward-popup">
    <button class="reward-close" type="button" aria-label="<%= features.reward.closeText||'关闭' %>" data-reward-close><%= features.reward.closeText||'×' %></button>
    <div class="reward-entries">
      <% rwEntries.forEach(function(e) { %>
      <div class="reward-entry">
        <div class="reward-entry-label"><%= e.label %></div>
        <% if (e.image) { %><img src="<%= e.image %>" alt="<%- e.label %><span data-i18n="reward.qrCode">收款码</span>" class="reward-qr"><% } %>
        <% if (e.url) { %><a href="<%= e.url %>" class="reward-link" target="_blank" rel="noopener noreferrer">前往<%= e.label %>支付页</a><% } %>
      </div>
      <% }) %>
    </div>
    <% if (Array.isArray(features.reward.links) && features.reward.links.length) { %><div class="reward-links"><% features.reward.links.forEach(function(l){ if(!l || !l.url) return; %><a class="reward-link-btn" href="<%= l.url %>" target="_blank" rel="noopener noreferrer"><%= l.label || l.url %></a><% }) %></div><% } %>
  </div>
</div>
<% } } %>

<% if(features.giscus&&features.giscus.enabled!==false){ %>
<div class="post-comments" id="giscusContainer">
  <h2 class="post-comments-title" data-i18n="post.comments">评论</h2>
</div>
<% } %>

<%# Prev/next article navigation — determined by date-sorted position. Falls back to site config labels. %>
<% if ((prevArticle || nextArticle) && features.prevNext && features.prevNext.enabled!==false && !(features.prevNext.hideWhenMissing&&(!prevArticle||!nextArticle))) { %>
<nav class="post-navigation<%= (features.prevNext&&features.prevNext.labelPosition&&features.prevNext.labelPosition!=='left')?' pos-'+features.prevNext.labelPosition:'' %>">
  <% if (prevArticle) { %>
  <a href="<%= prevArticle.url %>" class="post-nav-link">
    <% if(features.prevNext&&features.prevNext.showThumbnail&&prevArticle.featuredImage){ %><img src="<%= prevArticle.featuredImage %>" alt="" class="post-nav-thumb" loading="lazy"><% } %>
    <% if(features.prevNext&&features.prevNext.showLabels!==false){ %><span class="post-nav-label"><%= features.prevNext.prevLabel||site.prevPostLabel||'上一篇' %></span><% } %>
    <span class="post-nav-title"><%= prevArticle.title %></span>
  </a>
  <% } %>
  <% if (nextArticle) { %>
  <a href="<%= nextArticle.url %>" class="post-nav-link next">
    <% if(features.prevNext&&features.prevNext.showThumbnail&&nextArticle.featuredImage){ %><img src="<%= nextArticle.featuredImage %>" alt="" class="post-nav-thumb" loading="lazy"><% } %>
    <% if(features.prevNext&&features.prevNext.showLabels!==false){ %><span class="post-nav-label"><%= features.prevNext.nextLabel||site.nextPostLabel||'下一篇' %></span><% } %>
    <span class="post-nav-title"><%= nextArticle.title %></span>
  </a>
  <% } %>
</nav>
<% } %>

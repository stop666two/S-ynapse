<div class="post-article" style="padding:2rem">
  <h1 data-i18n="search.open">搜索</h1>
  <div style="margin:2rem 0">
    <input type="text" id="searchPageInput" placeholder="输入关键词搜索" data-i18n-placeholder="search.inputPlaceholder" style="width:100%;padding:1rem 1.25rem;font-size:1.125rem;border:2px solid var(--color-border);border-radius:var(--r);background:var(--color-bg);color:var(--color-t);font-family:var(--ff);outline:none" oninput="searchPage(this.value)" autofocus>
  </div>
  <div id="searchPageResults">
    <p style="color:var(--color-text-secondary);text-align:center;padding:2rem">输入关键词开始搜索</p>
  </div>
</div>

<script>
var searchData = window.__SEARCH_DATA__ || [];
function escHtml(s){return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;')}
function hlOnce(s,qq){
  var esc=escHtml(s), t=qq.toLowerCase();
  var idx=esc.toLowerCase().indexOf(t);
  if(idx<0)return esc;
  var q=esc.substr(idx,qq.length);
  return esc.slice(0,idx)+'<mark data-mm>'+q+'</mark>'+esc.slice(idx+qq.length);
}
function wrapExcerpt(ex,q,max){
  max=max||120;
  if(ex.length<=max)return ex;
  var idx=ex.toLowerCase().indexOf(q.toLowerCase());
  if(idx<0)return ex.slice(0,max)+'…';
  var st=Math.max(0,idx-45),en=Math.min(ex.length,idx+q.length+55);
  return (st>0?'…':'')+ex.slice(st,en)+(en<ex.length?'…':'');
}
function searchPage(query){
  var rDiv=document.getElementById('searchPageResults');
  if(!rDiv)return;
  if(!query||query.length<2){
    rDiv.innerHTML='<p style="color:var(--color-text-secondary);text-align:center;padding:2rem">'+__T('search.startHint','输入关键词开始搜索')+'</p>';
    return;
  }
  var lq=query.toLowerCase(),results=[];
  for(var i=0;i<searchData.length;i++){
    var it=searchData[i],score=0;
    if(it.title&&it.title.toLowerCase().includes(lq))score+=10;
    if(it.content&&it.content.toLowerCase().includes(lq))score+=3;
    if(it.excerpt&&it.excerpt.toLowerCase().includes(lq))score+=3;
    if(it.tags&&it.tags.some(function(t){return t.toLowerCase().includes(lq)}))score+=5;
    if(it.categories&&it.categories.some(function(c){return c.toLowerCase().includes(lq)}))score+=4;
    if(score>0){it.score=score;results.push(it)}
  }
  results.sort(function(a,b){return b.score-a.score});
  if(results.length){
    rDiv.innerHTML='<p style="color:var(--color-text-secondary);margin-bottom:1rem">'+__T('search.foundCount','找到')+' '+results.length+' '+__T('search.foundCount','个结果')+'</p>'+
      results.map(function(r){
        var meta='';
        if(r.date)meta+='<span class="post-card-meta-item">'+escHtml(r.date)+'</span>';
        if(r.categories&&r.categories.length)meta+='<span class="post-card-meta-item">'+r.categories.map(escHtml).join(' · ')+'</span>';
        return '<article class="post-card">'+
          (r.featuredImage?'<a href="'+escHtml(r.url)+'"><img src="'+escHtml(r.featuredImage)+'" alt="'+escHtml(r.title)+'" class="post-card-image" loading="lazy"></a>':'')+
          '<h2 class="post-card-title"><a href="'+escHtml(r.url)+'">'+hlOnce(r.title,query)+'</a></h2>'+
          (r.excerpt?'<p class="post-card-excerpt">'+hlOnce(wrapExcerpt(r.excerpt,query,170),query)+'</p>':'')+
          (meta?'<div class="post-card-meta">'+meta+'</div>':'')+
          (r.tags&&r.tags.length?'<div class="post-tags" style="margin-top:0.5rem">'+r.tags.slice(0,6).map(function(t){return '<span class="post-tag">'+escHtml(t)+'</span>'}).join('')+'</div>':'')+
        '</article>';
      }).join('');
  }else{
    rDiv.innerHTML='<p style="color:var(--color-text-secondary);text-align:center;padding:2rem">'+__T('search.notFound','未找到相关文章')+'</p>';
  }
}
window.addEventListener('DOMContentLoaded',function(){
  var params=new URLSearchParams(window.location.search);
  var q=params.get('q');
  if(q){
    document.getElementById('searchPageInput').value=q;
    searchPage(q);
  }
});
</script>

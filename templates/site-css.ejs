    .pn-x{position:absolute;top:.5rem;right:.5rem;width:34px;height:34px;border:0;background:transparent;color:var(--pn-fg2,var(--color-ts));font-size:1.3rem;line-height:1;cursor:pointer;border-radius:50%}
    .pn-x:hover{background:var(--color-hover,rgba(0,0,0,.06))}
    @media(max-width:520px){.pn-dialog{padding:1.1rem 1rem .9rem}.pn-actions .pn-btn{flex:1 1 auto}}
    @media(prefers-reduced-motion:reduce){.pn-overlay,.pn-dialog{transition:none}}


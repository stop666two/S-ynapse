    .site-header{background:var(--color-bg)}
    .site-header::after{display:none}
    .site-header.scrolled{box-shadow:none}
    .site-logo{font-family:var(--ff-d)}
    .hero{text-align:left;align-items:flex-start;max-width:920px;margin:0;padding-bottom:1.75rem;border-bottom:1px solid var(--color-border)}
    .hero h1{font-size:clamp(2.1rem,4.2vw,2.75rem);line-height:1.22;letter-spacing:.005em}
    .hero h1::after{display:none}

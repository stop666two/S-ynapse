    .post-content h2::before{width:2px;height:.9em;background:var(--color-a)}
    .post-content blockquote{background:none;border-radius:0;border-left:3px solid var(--color-a);font-style:italic;color:var(--color-ts)}
    .post-content blockquote::before{display:none}

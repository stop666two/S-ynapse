    .pn-image{display:block;width:100%;height:auto;border-radius:var(--r-md,6px);margin-bottom:.9rem}
    .pn-title{margin:0 0 .55rem;font-family:var(--ff-h);font-size:1.15rem;line-height:1.4;color:inherit}
    .pn-body p{margin:0 0 .55rem;font-size:.92rem;line-height:1.7;color:var(--pn-fg2,var(--color-ts))}
    .pn-qr{margin:.4rem auto .8rem;text-align:center}
    .pn-qr img{width:148px;height:148px;object-fit:contain;border:1px solid var(--pn-border,var(--color-border));border-radius:var(--r-md,6px);background:#fff;padding:4px}

    .pn-actions{display:flex;flex-wrap:wrap;gap:.55rem;margin-top:.9rem}
    .pn-btn{display:inline-flex;align-items:center;justify-content:center;min-height:38px;padding:0 1.05rem;border-radius:var(--r-md,6px);font-size:.9rem;cursor:pointer;text-decoration:none;border:1px solid transparent;transition:opacity .15s var(--te,ease)}

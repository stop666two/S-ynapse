<% } %>
    /* —— 代码块:行号列（Prism line-numbers 几何适配）—— */
    .post-content pre.line-numbers{padding-left:3.8em;counter-reset:linenumber}
    .post-content pre.line-numbers>code{position:relative;white-space:inherit}
    .line-numbers .line-numbers-rows{position:absolute;pointer-events:none;top:0;left:-3.8em;width:3em;border-right:1px solid color-mix(in srgb,var(--color-border) 55%,transparent);user-select:none;-webkit-user-select:none;font-size:inherit}
    .line-numbers .line-numbers-rows>span{display:block;counter-increment:linenumber}
    .line-numbers .line-numbers-rows>span::before{content:counter(linenumber);display:block;padding-right:.7em;text-align:right;color:var(--code-lineNumberColor,var(--color-tl));opacity:var(--code-lineNumberOpacity,.5)}
    .post-content pre.wrap-lines{white-space:pre-wrap;word-break:break-word}
    .post-content pre.wrap-lines>code{white-space:inherit}
    /* —— 代码块:悬停质感 + 高亮背景 —— */
    .post-content pre:hover,.post-content pre:focus-within{border-color:color-mix(in srgb,var(--color-s) var(--code-hoverBorderMix,35%),var(--color-border));box-shadow:0 4px 18px -8px color-mix(in srgb,var(--color-s) var(--code-hoverShadowMix,25%),transparent);background:color-mix(in srgb,var(--color-code-bg) var(--code-hoverBgMix,92%),var(--code-highlightBg,var(--color-hover)))}
    /* —— diff 行着色 + 终端语言标签 —— */
    .post-content .token.inserted{background:color-mix(in srgb,#16a34a var(--code-diffAddMix,12%),transparent)}
    .post-content .token.deleted{background:color-mix(in srgb,#dc2626 var(--code-diffDelMix,12%),transparent)}[data-theme="dark"] .post-content .token.inserted{background:color-mix(in srgb,#4ade80 var(--code-diffAddMix,12%),transparent)}[data-theme="dark"] .post-content .token.deleted{background:color-mix(in srgb,#f87171 var(--code-diffDelMix,12%),transparent)}
    .post-content pre[data-language="bash"]:not(.code-window)::before{content:"$ bash"}.post-content pre[data-language="sh"]:not(.code-window)::before{content:"$ sh"}.post-content pre[data-language="shell"]:not(.code-window)::before{content:"$ shell"}.post-content pre[data-language="zsh"]:not(.code-window)::before{content:"$ zsh"}.post-content pre[data-language="fish"]:not(.code-window)::before{content:"$ fish"}.post-content pre[data-language="powershell"]:not(.code-window)::before{content:"PS> powershell"}.post-content pre[data-language="console"]:not(.code-window)::before{content:"> console"}
    /* —— 代码工具条:语言胶囊 / 复制全部 —— */
    .post-content pre.has-actions::before{display:none}
    .code-actions .cw-lang{margin-left:0;margin-right:.15rem;padding:.1rem .5rem;border-radius:999px;background:rgba(125,138,158,.14);opacity:.9}
    .code-copy-all-row{display:flex;justify-content:flex-end;margin:-.35rem 0 .6rem}
    .code-copy-all-btn{display:inline-flex;align-items:center;gap:.35rem;padding:.3rem .7rem;font-size:.75rem;font-family:var(--ff);color:var(--color-ts);background:var(--color-hover);border:1px solid color-mix(in srgb,var(--color-border) var(--code-borderMix,65%),transparent);border-radius:var(--br);cursor:pointer;transition:color .3s var(--te),border-color .3s var(--te)}.code-copy-all-btn:hover{color:var(--color-s);border-color:color-mix(in srgb,var(--color-s) 40%,var(--color-border))}
    /* —— 图标:描边统一 —— */
    .site-header svg,.site-header svg [stroke-width],.footer-social svg,.footer-social svg [stroke-width],.footer-subscribe svg,.footer-subscribe svg [stroke-width],.back-to-top svg [stroke-width],.m-bottom-nav svg [stroke-width],.read-dock svg [stroke-width],.lightbox svg [stroke-width],.search-modal svg [stroke-width],.contact-popup-icon svg [stroke-width],.kbd-help svg [stroke-width],.code-action-btn svg [stroke-width],.code-expand-btn svg [stroke-width],.code-copy-all-btn svg [stroke-width]{stroke-width:var(--icons-strokeWidth,1.75)}
    /* —— 图标:微动效 —— */
    .nav-link svg{width:16px;height:16px;margin-right:.45rem;vertical-align:-3px;flex:none}
    .nav-link svg,.nav-social-link svg,.footer-social a svg,.back-to-top svg,.code-action-btn svg,.code-copy-all-btn svg,.search-toggle svg,.nav-boost-btn svg{transition:transform .35s var(--te),color .35s var(--te)}
    .nav-link:hover svg,.nav-social-link:hover svg,.footer-social a:hover svg,.back-to-top:hover svg,.search-toggle:hover svg,.nav-boost-btn:hover svg{transform:translateY(calc(-1 * var(--icons-hoverLift,1px)))}
    .nav-toggle:not(.active):hover span,.nav-toggle:not(.active):hover svg{transform:translateY(calc(-1 * var(--icons-hoverLift,1px)))}
    .nav-toggle svg{transition:transform .35s var(--te)}
    @media(prefers-reduced-motion:reduce){.nav-indicator.on{transition:none}.dark-toggle:hover{transform:none}.nav-link:hover svg,.nav-social-link:hover svg,.footer-social a:hover svg,.back-to-top:hover svg,.search-toggle:hover svg,.nav-boost-btn:hover svg,.nav-toggle:not(.active):hover span,.nav-toggle:not(.active):hover svg{transform:none}}
    .dark-toggle svg{transition:transform .5s var(--te)}.dark-toggle:hover svg{transform:rotate(20deg)}.dark-toggle:active svg{transform:rotate(-20deg)}
    /* —— 小型文字的隐形点按面积扩展（WCAG 2.5.8 目标尺寸）—— */
    .breadcrumb-item a,.post-card-meta a,.post-meta a,.post-tag,.gallery-link,.footer-link,.footer-bottom a,.footer-powered a{position:relative}
    .breadcrumb-item a::after,.post-card-meta a::after,.post-meta a::after,.post-tag::after,.gallery-link::after,.footer-link::after,.footer-bottom a::after,.footer-powered a::after{content:'';position:absolute;left:-4px;right:-4px;top:-6px;bottom:-6px}
    /* —— 图标:描边绘制动画（复制/下载等交互反馈）—— */
    @keyframes icon-draw{from{stroke-dashoffset:100}to{stroke-dashoffset:0}}
    .icon-draw [pathLength]{stroke-dasharray:100;stroke-dashoffset:0;animation:icon-draw .7s var(--te) forwards}
    @media(prefers-reduced-motion:reduce){.icon-draw [pathLength]{animation:none;stroke-dasharray:none;stroke-dashoffset:0}}
    @media(max-width:<%=nav.navbar.breakpoint||'768px'%>){.nav-social,.nav-boost,[data-preset-wrap]{display:none}.hero::before{left:0;right:0}.post-content table{display:block;max-width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch}body{padding-bottom:calc(3.75rem + env(safe-area-inset-bottom,0px))}.back-to-top{bottom:4rem}.m-toc-btn{bottom:var(--mobileToc-btnMobileBottom,7.4rem)}.reader-gear{bottom:var(--reading-gearMobileBottom,10.8rem)}.read-dock{bottom:var(--reading-dockMobileBottom,14.2rem)}}
    @media(max-width:1200px){.nav-social{display:none}}
    @media(max-width:1100px){.nav-link{padding:.5rem .55rem}}
    @media(max-width:960px){.nav-boost{display:none}.nav-link{font-size:.875rem}.site-logo{font-size:calc(var(--header-logoSize,var(--nb-ls,1.272em))*.85)}}

    /* ======================================================================
       界面方向 A：编辑部头版（Editorial Front Page）— 2026-09-25 用户选定
       令牌依据：theme.json5 rounding=sharp / shadowLevel=flat（无阴影）；
                fontSystem displayStack/headingStack=serif；background.mode=plain；
                features.atmosphere.glow=false；features.cardFx 悬浮特效全关。
       位置说明：本段位于样式表末尾，以同等优先级后置覆盖前文增强样式。

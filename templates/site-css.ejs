    .post-article{background:transparent;box-shadow:none;border-radius:0;padding:0}
    .post-header{text-align:left;border-bottom:1px solid var(--color-t);padding-bottom:1rem}
    .post-title{font-size:clamp(2rem,4vw,2.6rem);line-height:1.22;letter-spacing:.005em}
    .post-meta{justify-content:flex-start;border-top:0;border-bottom:1px solid var(--color-border);padding:.55rem 0;margin-top:.9rem}

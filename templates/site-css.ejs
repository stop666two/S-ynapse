    .hero-date{font-size:.75rem;letter-spacing:.16em;text-transform:uppercase;color:var(--color-a);font-weight:600}
    .post-card{background:transparent;border-radius:0;box-shadow:none;border-bottom:1px solid var(--color-border)}

    .g-gate-card{width:min(92vw,360px);padding:2rem;background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--r-lg,1.618rem);box-shadow:var(--sc),var(--surface-hi);display:flex;flex-direction:column;gap:.8rem;text-align:center}
    .g-gate-card h3{font-size:1.05rem;font-weight:600;color:var(--color-t)}
    .g-gate-input{padding:.55rem .8rem;border:1px solid var(--color-border);border-radius:var(--br);background:var(--color-bg);color:var(--color-t);font:inherit;font-size:.875rem;text-align:center}
    .g-gate-input:focus{outline:2px solid var(--color-s);outline-offset:0}
    .g-gate-card button{padding:.55rem 1rem;border:1px solid var(--color-border);border-radius:var(--br);background:var(--color-s);color:#fff;cursor:pointer;font:inherit;font-size:.875rem}

    /* 弹窗公告（features.popupNotice）：默认跟随主题变量，colors.* 可覆盖；与公告条相互独立。 */
    .pn-overlay{position:fixed;inset:0;z-index:var(--zIndex-popupNotice,2100);display:flex;align-items:center;justify-content:center;padding:1rem;background:var(--pn-overlay,rgba(0,0,0,.55));opacity:0;transition:opacity .22s var(--te,ease)}
    .pn-overlay.on{opacity:1}
    .pn-dialog{position:relative;width:min(var(--pn-width,440px),92vw);max-height:86vh;overflow:auto;background:var(--pn-bg,var(--color-surface));color:var(--pn-fg,var(--color-t));border:1px solid var(--pn-border,var(--color-border));border-radius:var(--r-lg,10px);box-shadow:0 18px 50px rgba(0,0,0,.22);padding:1.3rem 1.3rem 1rem;transform:translateY(10px);transition:transform .22s var(--te,ease);text-align:left}

<div class="post-article">
  <h1>鏍囩: <%= tagName %></h1>
  <p style="color:var(--color-ts);margin-bottom:1.5rem"><%= articles.length %> 绡囨枃绔?/p>
</div>

<% if (articles && articles.length) { %>
<% articles.forEach(function(article) { %>
<article class="post-card">
  <h2 class="post-card-title">
    <% if (article.pinned) { %><span class="pin-badge">缃《</span><% } %><% if (article.series) { %><span class="series-badge">绯诲垪</span><% } %>
    <a href="<%= article.url %>"><%= article.title %></a>
  </h2>
  <div class="post-card-meta">
    <% if (theme.card && theme.card.showDate && article.date) { %>
    <span><%= article.formattedDate || article.date %></span>
    <% } %>
    <% if (theme.card && theme.card.showCategories && article.categories && article.categories.length) { %>
    <span>
      <% article.categories.forEach(function(cat, i) { %>
      <a href="/categories/<%= generateSlug(cat) %>/"><%= cat %></a><% if (i < article.categories.length - 1) { %>, <% } %>
      <% }) %>
    </span>
    <% } %>
    <% if (theme.card && theme.card.showWordCount && article.wordCount) { %>
    <span><%= article.wordCount %> 瀛?/span>
    <% } %>
    <% if (theme.card && theme.card.showReadTime && article.readTime) { %>
    <span><%= article.readTime %> 鍒嗛挓</span>
    <% } %>
  </div>
  <% if (theme.card && theme.card.showExcerpt && article.excerpt) { %>
  <p class="post-card-excerpt"><%= article.excerpt %></p>
  <% } %>
</article>
<% }) %>
<% } else { %>
<div class="post-article"><p style="text-align:center;padding:2rem;color:var(--color-ts)">璇ユ爣绛句笅鏆傛棤鏂囩珷</p></div>
<% } %>


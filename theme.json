{
  // ==================== 主题预设系统 ====================
  // 三层优先级（高层覆盖低层）：
  //   1. 内置六套预设：classic-blue(经典蓝) / night-jet(极夜黑) /
  //      forest-green(森林绿) / sakura-pink(樱花粉) /
  //      editorial-grey(编辑部灰) / cyber-purple(赛博紫)
  //   2. presetOverrides —— 在预设基础上的微调（推荐微调方式）
  //   3. 非颜色档位（rounding/shadowLevel/borderStyle）与预设正交，随时可调
  // 注意：preset 非空时 colors / darkMode.colors 整组以预设为准（预设接管），
  //       手工 colors 不再生效；想改单色请写进 presetOverrides。
  //       将 preset 设为 null 或删除该字段可回退到手工 colors 模式。

  // 预设名称；null=关闭预设接管（走下方手工 colors）
  "preset": "classic-blue",
  // 在预设基础上的颜色微调（最高优先级，任意替换 13 色之一）
  "presetOverrides": {
    "colors": {},          // 明亮模式覆盖：如 { "secondary": "#b91c1c" }
    "darkMode": {          // 暗色模式覆盖
      "colors": {}
    }
  },

  // ==================== 字体系统 ====================
  // stack: inter / noto-sans(思源黑体) / noto-serif(思源宋体) / system / custom
  // scale: 全局字号缩放 0.9~1.2（1=100%）
  // displayStack: 展示层字体（h1/hero 大标题/站点 Logo）——sora / manrope / 同 stack 枚举；中文自动回退 CJK 字体链
  // headingStack: 次级标题字体（h2-h6/卡片标题/部件标题）；inherit=跟随整体 / sans=无衬线 / serif=衬线 / sora / manrope
  // numbersMono: 统计数字用等宽字体（阅读面板、统计卡片）
  "fontSystem": {
    "stack": "inter",
    "customStack": "",
    "scale": 1,
    "bodyWeight": 400,
    "displayStack": "sora",
    "headingStack": "manrope",
    "numbersMono": true
  },

  // 圆角档位: sharp(2px) / sm(4px) / md(0.5rem) / lg(0.75rem)
  "rounding": "md",
  // 阴影档位: flat(无) / soft(轻) / medium(中) / strong(重)
  "shadowLevel": "soft",
  // 边框档位: none(隐藏边框) / subtle(淡) / visible(明显)
  "borderStyle": "subtle",

  // ==================== 档位数值表 ====================
  // 上方 rounding/shadowLevel/borderStyle/density.preset 只负责"选档"；
  // 每档具体数值全部定义在这里，改这里即可全局调整档位表现（四组相互独立、与颜色预设正交）。
  "tiers": {
    // 圆角档位数值：radius 通用圆角 / radiusLarge 大圆角（图片、弹窗）/ button 按钮圆角
    "rounding": {
      "sharp": { "radius": "2px", "radiusLarge": "8px", "button": "2px" },
      "sm": { "radius": "4px", "radiusLarge": "10px", "button": "3px" },
      "md": { "radius": "0.618rem", "radiusLarge": "1.618rem", "button": "0.382rem" },
      "lg": { "radius": "0.75rem", "radiusLarge": "1.25rem", "button": "0.5rem" }
    },
    // 阴影档位数值：card 卡片 / dropdown 浮层 / fixed 吸顶元素；dark 为暗色模式同款（暗底需更深的黑）
    "shadow": {
      "flat": { "card": "none", "dropdown": "none", "fixed": "none", "dark": { "card": "none", "dropdown": "none", "fixed": "none" } },
      "soft": {
        "card": "0 1px 2px rgba(16,24,40,.04),0 8px 24px -12px rgba(16,24,40,.12)",
        "dropdown": "0 4px 12px rgba(16,24,40,.06),0 20px 48px -20px rgba(16,24,40,.20)",
        "fixed": "0 1px 2px rgba(16,24,40,.05),0 6px 16px -10px rgba(16,24,40,.10)",
        "dark": { "card": "0 1px 2px rgba(0,0,0,.35),0 8px 24px -12px rgba(0,0,0,.55)", "dropdown": "0 4px 12px rgba(0,0,0,.4),0 20px 48px -20px rgba(0,0,0,.6)", "fixed": "0 1px 2px rgba(0,0,0,.35),0 6px 16px -10px rgba(0,0,0,.5)" }
      },
      "medium": {
        "card": "0 1px 3px rgba(16,24,40,.05),0 12px 32px -14px rgba(16,24,40,.16)",
        "dropdown": "0 6px 16px rgba(16,24,40,.08),0 24px 56px -22px rgba(16,24,40,.24)",
        "fixed": "0 2px 4px rgba(16,24,40,.06),0 8px 20px -12px rgba(16,24,40,.12)",
        "dark": { "card": "0 1px 3px rgba(0,0,0,.4),0 12px 32px -14px rgba(0,0,0,.6)", "dropdown": "0 6px 16px rgba(0,0,0,.45),0 24px 56px -22px rgba(0,0,0,.65)", "fixed": "0 2px 4px rgba(0,0,0,.4),0 8px 20px -12px rgba(0,0,0,.55)" }
      },
      "strong": {
        "card": "0 2px 6px rgba(16,24,40,.06),0 18px 44px -16px rgba(16,24,40,.22)",
        "dropdown": "0 8px 20px rgba(16,24,40,.1),0 32px 72px -26px rgba(16,24,40,.3)",
        "fixed": "0 2px 6px rgba(16,24,40,.08),0 10px 26px -14px rgba(16,24,40,.16)",
        "dark": { "card": "0 2px 6px rgba(0,0,0,.45),0 18px 44px -16px rgba(0,0,0,.65)", "dropdown": "0 8px 20px rgba(0,0,0,.5),0 32px 72px -26px rgba(0,0,0,.7)", "fixed": "0 2px 6px rgba(0,0,0,.45),0 10px 26px -14px rgba(0,0,0,.6)" }
      }
    },
    // 边框档位数值：light 明亮模式边框色 / dark 暗色模式边框色（#00000000 = 视觉关闭）
    "border": {
      "none": { "light": "#00000000", "dark": "#00000000" },
      "subtle": { "light": "#e2e8f0", "dark": "#334155" },
      "visible": { "light": "#cbd5e1", "dark": "#475569" }
    },
    // 布局密度档位数值：containerWidth 内容最大宽 / gap 主间距 / sidebarWidth 侧栏宽 / columns 卡片列数
    "density": {
      "compact": { "containerWidth": "1000px", "gap": "1.25rem", "sidebarWidth": "240px", "columns": 2 },
      "balanced": { "containerWidth": "1250px", "gap": "1.618rem", "sidebarWidth": "318px", "columns": 2 },
      "airy": { "containerWidth": "1400px", "gap": "2.5rem", "sidebarWidth": "320px", "columns": 3 }
    }
  },

  // 头像与 Logo 显示模式
  "avatar": {
    "shape": "round",     // 头像形状: round(圆形) / rounded(圆角方形) / square(方形)
    "ring": false,        // 是否显示品牌色描边
    "ringColor": "",      // 描边色（留空=用辅色 --color-s）
    "badge": true        // 无头像图片时生成 首字母+品牌色 徽章
  },

  // ==================== 页面背景特效 ====================
  // mode: plain(纯色) / gradient(对角渐变) / grid(网格纸) / dots(点阵) / particles(动态粒子)
  // particles 的配色/数量/速度/连线等由 features.json5 → background.particles 控制
  "background": {
    "mode": "particles",
    "colors": ["#f7fafc", "#e0eaff"],  // gradient 模式的两端色(任意)
    "gradientAngle": 135,              // 渐变角度(deg)
    "gridSize": 24,                    // 网格间距(px)
    "dotSize": 1,                      // 点阵点径(px)
    "opacity": 1                       // 纹理层不透明度 0~1
  },

  // ==================== 导航栏毛玻璃 ====================
  // 不支持的浏览器自动回退纯色;alpha 为背景不透明度
  "glass": {
    "enabled": true,
    "blur": "12px",
    "alpha": 0.8,
    "darkAlpha": 0.85
  },

  // ==================== 布局密度档位 ====================
  // preset: compact(紧凑) / balanced(均衡默认) / airy(宽松)
  // columns: 文章卡片列数(列表布局同样生效,2-4)
  // 规则: preset 非 null 时 containerWidth/gap/sidebarWidth/columns 由档位填充;
  //       完全手调请将 preset 设为 null 并直接改下列四键
  "density": {
    "preset": "balanced",
    "containerWidth": "1250px",  // 内容区最大宽度
    "gap": "1.618rem",           // 卡片间距（黄金分割 φ）
    "sidebarWidth": "318px",     // 侧栏宽（目录 200 × φ ≈ 324，取 318）
    "columns": 2                 // 卡片列数
  },

  // ==================== 颜色方案（明亮模式） ====================
  // preset 为 null 时以下手工颜色生效；preset 非空时此段被预设接管

  "colors": {
    "primary": "#2d3748",             // 主色 - 标题和强调元素
    "secondary": "#2563eb",           // 辅色 - 链接和按钮
    "accent": "#c53030",              // 强调色 - 特殊标记
    "background": "#f7fafc",          // 页面背景色
    "surface": "#ffffff",             // 卡片/表面背景色
    "text": "#1a202c",                // 主文字颜色
    "textSecondary": "#4a5568",       // 次要文字颜色
    "textLight": "#64748b",           // 浅色文字（如日期、页脚）
    "border": "#e2e8f0",              // 边框颜色
    "shadow": "rgba(0,0,0,0.1)",      // 阴影颜色
    "hover": "#edf2f7",               // 悬停背景色
    "codeBackground": "#e9eef4",      // 代码块背景色（浅色模式；随明暗模式自动切换）
    "codeText": "#1f2328"             // 代码块文字颜色（浅色模式）
  },

  // ==================== 深色模式 ====================

  "darkMode": {
    "enabled": true,                   // 是否启用深色模式
    "toggle": true,                    // 是否显示切换按钮
    "default": "system",               // 默认模式：light / dark / system（跟随系统）
    "colors": {                        // 深色模式下的颜色覆盖（如不覆盖则使用默认配色）
      "background": "#0f172a",         // 页面背景（深蓝灰，比纯黑更柔和）
      "surface": "#1e293b",            // 卡片/面板背景
      "text": "#f1f5f9",               // 主文字色（暖白，减轻眼疲劳）
      "textSecondary": "#a3b2c4",      // 副文字色
      "textLight": "#9aa8ba",          // 浅色文字
      "border": "#334155",             // 边框色
      "shadow": "rgba(0,0,0,0.3)",    // 阴影色
      "hover": "#334155",              // 悬停背景色
      "secondary": "#7caeff",          // 链接色（深色下提亮以达 4.5:1）
      "accent": "#fca5a5",             // 强调色（深色下提亮）
      "codeBackground": "#0a1120",     // 代码块背景（深色模式，与页面底色区分以保留块感）
      "codeText": "#e6edf3"            // 代码块文字色（深色模式）
    }
  },

  // ==================== 字体设置 ====================

  // 正文字体族（fontSystem.stack 为 custom 时此值生效；其他 stack 下由字体系统生成）
  "fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
  // 等宽字体族（代码块使用，可自由修改）
  "fontFamilyMono": "'Fira Code', 'Menlo', 'Consolas', monospace",
  // 基础字号
  "fontSizeBase": "16px",
  // 行高
  "lineHeight": 1.8,
  // 标题字重
  "headingFontWeight": 700,
  // 字间距
  "letterSpacing": "0.02em",

  // ==================== 间距与尺寸 ====================

  "spacing": {
    "containerWidth": "1250px",  // 内容区最大宽度
    "gap": "1.618rem",           // 元素间距（黄金分割 φ）
    "padding": "2.618rem",       // 内边距（黄金分割 φ²）
    "radius": "0.618rem",        // 默认圆角兜底（正常由 tiers.rounding 档位写入）
    "radiusLarge": "1.618rem"    // 大圆角兜底（正常由 tiers.rounding 档位写入）
  },

  // ==================== 表面质感 ====================
  // 阴影数值统一由上方 tiers.shadow 按 shadowLevel 档位提供（此处不再重复定义，避免多开关）。
  // 表面高光/描边：为卡片、面板等"表面"增加的精致层次；"0 0 #0000" = 关闭（透明无效果）
  "surfaceHighlight": {
    "light": "0 0 0 1px rgba(16,24,40,.04)",                                      // 浅色模式：极淡描边环
    "dark": "inset 0 1px 0 rgba(255,255,255,.05),0 0 0 1px rgba(255,255,255,.05)" // 暗色模式：顶部内高光 + 描边环
  },

  // ==================== 布局 ====================

  "layout": {
    "headerStyle": "fixed",       // 导航栏样式：fixed / static
    "headerHeight": "60px",       // 导航栏高度
    "footerStyle": "simple",      // 页脚样式
    "sidebarPosition": "right",   // 侧边栏位置：left / right
    "contentWidth": "main",       // 内容宽度模式
    "postLayout": "standard",     // 文章布局：standard / full
    "archiveLayout": "list"       // 归档布局：list / grid
  },

  // ==================== 动画 ====================

  "animation": {
    "enable": true,               // 是否启用动画
    "transitionDuration": "0.3s", // 过渡动画时长（兜底，正常由 tuning.motion.transitionDuration 写入）
    "transitionTiming": "cubic-bezier(0.22, 1, 0.36, 1)"  // 过渡缓动曲线（兜底，正常由 tuning.motion.transitionTiming 写入）
  },

  // ==================== 代码高亮配色 ====================
  // Prism 按 token 类型着色，浅色/暗色两套随主题自动切换（无需维护外部样式表）。
  // token 类型：comment 注释 / keyword 关键字 / string 字符串 / number 数字与常量 /
  //            fn 函数名与类名 / attr 属性名・选择器・标签 / punct 标点与运算符

  "codeHighlight": {
    // 明亮模式 token 配色（GitHub Light 调校）
    "palette": {
      "light": {
        "comment": "#6a737d", "keyword": "#cf222e", "string": "#0a3069",
        "number": "#0550ae", "fn": "#8250df", "attr": "#116329", "punct": "#6e7781"
      },
      // 暗色模式 token 配色（One Dark 调校，暗底使用更高亮度）
      "dark": {
        "comment": "#8b949e", "keyword": "#ff7b72", "string": "#a5d6ff",
        "number": "#79c0ff", "fn": "#d2a8ff", "attr": "#7ee787", "punct": "#c9d1d9"
      }
    }
  },

  // ==================== 文章卡片 ====================

  "card": {
    "showDate": true,             // 是否显示日期
    "showTags": true,             // 是否显示标签
    "showCategories": true,       // 是否显示分类
    "showExcerpt": true,          // 是否显示摘要
    "excerptLength": 150,         // 摘要最大字符数
    "showReadTime": true,         // 是否显示阅读时间
    "readTimeSpeed": 265          // 阅读速度（字/分钟）
  },

  // ==================== 按钮 ====================

  "button": {
    "radius": "0.25rem",                  // 按钮圆角兜底（正常由 tiers.rounding.button 写入）
    "padding": "0.5rem 1.5rem",          // 按钮内边距
    "primaryBackground": "#4a90d9",       // 主要按钮背景色
    "primaryText": "#ffffff",             // 主要按钮文字色
    "hoverScale": 1.02                    // 悬停缩放比例
  },

  // ==================== 自定义 CSS ====================

  // 自定义 CSS 变量覆盖，可按组件名传入样式字符串

  // ==================== 外观细节选项（微调） ====================

  "appearance": {
    "selectionBg": "",             // 文本选中背景色（空 = 用辅色 25% 透明）
    "scrollbarWidth": "8px",       // 滚动条宽度（WebKit）
    "scrollbarRadius": "4px",      // 滚动条圆角
    "focusRingWidth": "2px",       // 键盘焦点环宽度（无障碍）
    "focusRingOffset": "2px",      // 焦点环偏移
    "codePadding": "1rem",         // 代码块内边距
    "codeLineHeight": 1.6,         // 代码行高
    "blockquoteBorderWidth": "3px", // 引用块左侧竖线宽度
    "tableStripeBg": "",           // 表格斑马纹背景（空 = 用 hover 色 50%）
    "tableCellPadding": ".6rem .9rem", // 表格单元格内边距
    "hrOpacity": 0.6,              // 分隔线不透明度
    "imageCaptionAlign": "center"  // 图注对齐：left/center/right
  },


  // ==================== 外部资源 ====================

  "externalAssets": {
    "styles": [                    // 外部 CSS 文件 URL 列表
      "https://fonts.googleapis.com/css2?family=Inter&display=swap"
    ],
    "scripts": [                   // 外部 JS 文件 URL 列表
      "https://cdn.jsdelivr.net/npm/prismjs@1/prism.min.js"
    ]
  },

  // ==================== 文章页脚公告栏 ====================

  "articleFooter": {
    "enabled": true,               // 是否启用
    "source": "disclaimer",        // pages/ 下的文件名（不含 .md 后缀），例如：disclaimer / privacy / terms / about
    "backgroundColor": "#f0f4f8",  // 背景色
    "textColor": "#4a5568",        // 文字色
    "borderColor": "#cbd5e1",      // 边框色
    "borderWidth": "1px",          // 边框粗细
    "paddingTop": "1.25rem",       // 上下留空
    "paddingBottom": "1.25rem",
    "paddingLeft": "1.5rem",       // 左右留空
    "paddingRight": "1.5rem",
    "borderRadius": "0.5rem"       // 圆角
  },

  // ==================== 布局微调 ====================

  "contentOffset": -10,            // 内容区偏移（px），负=左移，正=右移，0=居中
  "headerContentGap": 48,          // 标题与内容区额外间距（px）
  "tocWidth": "200px",             // 左侧目录宽度
  "sidebarWidth": "318px",         // 右侧边栏宽度（200 × φ）
  "tocMinLeft": "10px",            // 左侧目录离屏幕左边缘最小距离
  "sidebarMinRight": "10px"        // 右侧边栏离屏幕右边缘最小距离
}

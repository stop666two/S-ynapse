{
  // ==================== S-ynapse UI 精细调节（tuning.json5） ====================
  // 说明: 每个参数对应一个 UI 数值，构建时注入为 CSS 变量（--{分类}-{参数}）。
  //       修改后重新构建生效；变量可在浏览器 DevTools 或 customCSS 中覆盖。
  //       所有数值均为默认值，删除某项即回退到模板内置 fallback。

  // ---------- 排版系统（18 项） ----------
  "typography": {
    // 正文字号
    "bodySize": "1em",
    // 一级标题字号（黄金 φ²）
    "h1Size": "2.058em",
    // 二级标题字号（黄金 φ）
    "h2Size": "1.618em",
    // 三级标题字号（黄金 √φ）
    "h3Size": "1.272em",
    // 四级标题字号
    "h4Size": "1em",
    // 五级标题字号
    "h5Size": ".875em",
    // 六级标题字号
    "h6Size": ".8125em",
    // 小号文字（辅助信息）
    "smallSize": ".875em",
    // 极小文字（标签/日期）
    "tinySize": ".75em",
    // 正文行高
    "lineHeight": "1.8",
    // 标题行高
    "headingLineHeight": "1.3",
    // 字间距
    "letterSpacing": "0.02em",
    // 标题字重
    "headingWeight": "700",
    // 代码字号
    "monoSize": ".875em",
    // 引用块字号
    "quoteSize": "1.05em",
    // 图注字号
    "captionSize": ".8125rem",
    // 元信息字号
    "metaSize": ".875rem",
    // 导语字号（黄金 √φ）
    "leadSize": "1.272em",
  },

  // ---------- 布局系统（16 项） ----------
  "layout": {
    // 内容区最大宽度
    "containerWidth": "1250px",
    // 左侧目录宽度
    "tocWidth": "200px",
    // 右侧边栏宽度（= 目录 × φ）
    "sidebarWidth": "318px",
    // 模块间距（黄金 φ）
    "gap": "1.618rem",
    // 页面内边距（黄金 φ²）
    "padding": "2.618rem",
    // 导航栏高度
    "headerHeight": "60px",
    // 内容区水平偏移
    "contentOffset": "-10px",
    // 标题与内容区间距
    "headerContentGap": "48px",
    // 目录离屏幕左缘最小距离
    "tocMinLeft": "10px",
    // 侧栏离屏幕右缘最小距离
    "sidebarMinRight": "10px",
    // 移动端断点
    "mobileBreakpoint": "768px",
    // 目录隐藏断点
    "tocHideBreakpoint": "900px",
    // 平板断点
    "tabletBreakpoint": "1024px",
    // 宽屏断点
    "wideBreakpoint": "1556px",
    // 超宽屏内容上限
    "maxContentWidth": "1600px",
    // 页脚列数
    "footerColumns": "3",
  },

  // ---------- 圆角系统（8 项） ----------
  "radius": {
    // 默认圆角（黄金）
    "default": "0.618rem",
    // 大圆角（黄金 φ）
    "large": "1.618rem",
    // 按钮圆角
    "button": "0.382rem",
    // 卡片圆角
    "card": "0.618rem",
    // 图片圆角
    "image": "0.618rem",
    // 头像圆角
    "avatar": "50%",
    // 徽章圆角
    "badge": "0.25rem",
    // 输入框圆角
    "input": "0.382rem",
  },

  // ---------- 动效系统（10 项） ----------
  "motion": {
    // 卡片悬停上浮距离（px）
    "hoverLiftPx": "4",
    // 卡片悬停缩放
    "hoverScale": "1.02",
    // 链接下划线粗细
    "underlineThickness": "2px",
    // 链接下划线偏移
    "underlineOffset": "3px",
    // 按钮波纹时长
    "rippleDurationMs": "500",
    // 滚动渐入时长
    "revealDurationMs": "250",
    // 滚动渐入位移
    "revealOffset": "10px",
    // 渐入错峰延迟
    "staggerDelayMs": "60",
    // 按钮按压缩放
    "buttonPressScale": "0.97",
    // 通用过渡时长
    "transitionDuration": "0.3s",
  },

  // ---------- 首屏 Hero（10 项） ----------
  "hero": {
    // 首屏高度（黄金 61.8vh）
    "heightVh": "61.8",
    // Hero 标题字号（黄金 φ²）
    "titleSize": "2.618em",
    // Hero 副标题字号
    "subSize": "1.05em",
    // Hero 内容最大宽度
    "maxWidth": "760px",
    // 操作区间距
    "actionsGap": ".75rem",
    // 标签区间距
    "tagGap": ".5rem",
    // CTA 按钮圆角
    "ctaRadius": "0.382rem",
    // 顶部内边距
    "paddingTop": "1rem",
    // 底部内边距
    "paddingBottom": "2rem",
    // 日期字号
    "dateSize": ".9375rem",
  },

  // ---------- 文章卡片（10 项） ----------
  "card": {
    // 封面图宽高比（≈φ）
    "imageAspect": "16/10",
    // 卡片圆角
    "radius": "0.618rem",
    // 文章容器内边距
    "padding": "2rem",
    // 卡片标题字号
    "titleSize": "1.272rem",
    // 摘要最大行数
    "excerptLines": "3",
    // 悬停上浮（px）
    "hoverLiftPx": "4",
    // 元信息字号
    "metaSize": ".875rem",
    // 无封面占位字号下限
    "nocoverMinSize": "1.272rem",
    // 无封面占位字号上限
    "nocoverMaxSize": "1.618rem",
    // 卡片栅格间距
    "gridGap": "1.618rem",
  },

  // ---------- 目录侧栏（10 项） ----------
  "toc": {
    // 目录正文字号
    "fontSize": ".8125rem",
    // 目录标题字号
    "labelSize": ".6875rem",
    // 二级缩进
    "indentL2": ".5rem",
    // 三级缩进
    "indentL3": "1.2rem",
    // 四级缩进
    "indentL4": "1.9rem",
    // 进度线高度
    "progressHeight": "3px",
    // 吸顶偏移
    "stickyTop": "80px",
    // 目录最大宽度
    "maxWidthPx": "320",
    // 滚动高亮偏移
    "scrollOffset": "120",
    // 默认折叠
    "collapsedByDefault": "false",
  },

  // ---------- 搜索弹层（10 项） ----------
  "search": {
    // 弹层宽度
    "modalWidth": "760px",
    // 输入框高度
    "inputHeight": "56px",
    // 输入字号
    "inputFontSize": "1.375rem",
    // 历史记录条数
    "historyCount": "8",
    // 热门搜索条数
    "hotCount": "6",
    // 输入防抖（ms）
    "debounceMs": "200",
    // 最小查询长度
    "minQueryLength": "1",
    // 结果摘要长度
    "excerptLength": "80",
    // 结果最大条数
    "resultLimit": "20",
    // 空结果文案
    "emptyText": "无匹配结果",
  },

  // ---------- 阅读体验（10 项） ----------
  "reading": {
    // 阅读进度条高度
    "progressHeight": "3px",
    // 进度条颜色
    "progressColor": "var(--color-s)",
    // 返回顶部按钮尺寸
    "backToTopSize": "44px",
    // 返回顶部偏移
    "backToTopOffset": "2rem",
    // 阅读坞底部偏移
    "dockBottom": "5.6rem",
    // TTS 语速
    "ttsRate": "1",
    // TTS 音调
    "ttsPitch": "1",
    // 字号调节步长
    "fontSizeStep": "0.1",
    // 行高调节步长
    "lineHeightStep": "0.1",
    // 阅读模式最大宽度
    "readingMaxWidth": "72ch",
  },

  // ---------- 评论区（8 项） ----------
  "comments": {
    // 占位延迟（ms）
    "loadDelayMs": "300",
    // 加载中占位文案
    "placeholderText": "评论加载中…",
    // 空评论文案
    "emptyText": "暂无评论",
    // 头像尺寸
    "avatarSize": "40px",
    // 区域上边距
    "marginTop": "2rem",
    // 区域宽度
    "width": "100%",
    // 区域圆角
    "borderRadius": "0.618rem",
    // 显示分隔线
    "dividerShow": "true",
  },

  // ---------- 页脚（8 项） ----------
  "footer": {
    // 上下内边距
    "paddingV": "2.618rem",
    // 列间距
    "gap": "2rem",
    // 备案字号
    "icpSize": ".75rem",
    // 链接字号
    "linkSize": ".875rem",
    // 版权字号
    "copyrightSize": ".8125rem",
    // 列数
    "columns": "3",
    // 社交图标尺寸
    "socialIconSize": "18px",
    // 社交图标间距
    "socialGap": ".75rem",
  },

  // ---------- 导航栏（8 项） ----------
  "header": {
    // 导航栏高度
    "height": "60px",
    // 毛玻璃模糊
    "glassBlur": "12px",
    // 毛玻璃透明度
    "glassAlpha": "0.8",
    // Logo 字号
    "logoSize": "1.272em",
    // 导航字号
    "navFontSize": ".9375rem",
    // 导航项间距
    "navGap": ".25rem",
    // 图标尺寸
    "iconSize": "18px",
    // 底阴影不透明度
    "shadowOpacity": "0.08",
  },

  // ---------- 侧栏（8 项） ----------
  "sidebar": {
    // 侧栏宽度
    "width": "318px",
    // 部件间距
    "widgetGap": "1.618rem",
    // 部件标题字号
    "widgetTitleSize": ".875rem",
    // 部件圆角
    "widgetRadius": "0.618rem",
    // 部件内边距
    "widgetPadding": "1rem",
    // 头像尺寸
    "avatarSize": "80px",
    // 吸顶偏移
    "stickyTop": "80px",
    // 移动端折叠断点
    "mobileBreakpoint": "1024px",
  },

  // ---------- 分页（6 项） ----------
  "pagination": {
    // 最大可见页数
    "maxVisible": "5",
    // 按钮间距
    "gap": ".5rem",
    // 上一页文案
    "prevText": "上一页",
    // 下一页文案
    "nextText": "下一页",
    // 当前页缩放
    "activeScale": "1.05",
    // 按钮圆角
    "radius": "0.382rem",
  },

  // ---------- 热力图（6 项） ----------
  "heatmap": {
    // 单元格尺寸
    "cellSize": "13px",
    // 单元格间距
    "gap": "3px",
    // 单元格圆角
    "radius": "3px",
    // 空格颜色
    "emptyColor": "var(--color-border)",
    // 月份标签字号
    "labelSize": ".75rem",
    // 最大宽度
    "maxWidth": "100%",
  },

  // ---------- 统计卡片（6 项） ----------
  "stats": {
    // 列数（auto-fit 自适应）
    "cardColumns": "auto-fit",
    // 数值字号
    "numberSize": "1.5rem",
    // 标签字号
    "labelSize": ".8125rem",
    // 卡片内边距
    "cardPadding": "1rem 1.25rem",
    // 卡片间距
    "gap": "1rem",
    // 悬停上浮（px）
    "hoverLiftPx": "2",
  },

  // ---------- 轻提示（6 项） ----------
  "toast": {
    // 显示位置
    "position": "bottom-center",
    // 显示时长（ms）
    "durationMs": "2500",
    // 最大同时显示
    "maxVisible": "3",
    // 底部偏移
    "offsetBottom": "2rem",
    // 圆角
    "radius": "0.618rem",
    // 边框粗细
    "borderWidth": "1px",
  },

  // ---------- 图片灯箱（6 项） ----------
  "lightbox": {
    // 背景不透明度
    "bgOpacity": "0.9",
    // 过渡时长（ms）
    "transitionMs": "220",
    // 按钮尺寸
    "btnSize": "46px",
    // 图注字号
    "captionSize": ".875rem",
    // 图注最大行数
    "captionMaxLines": "2",
    // 缩放步长
    "zoomStep": "0.25",
  },

  // ---------- 面包屑（5 项） ----------
  "breadcrumb": {
    // 分隔符
    "separator": "›",
    // 字号
    "fontSize": ".8125rem",
    // 项间距
    "gap": ".5rem",
    // 下边距
    "marginBottom": "1rem",
    // 当前项字重
    "currentWeight": "600",
  },

  // ---------- 分享按钮（4 项） ----------
  "share": {
    // 按钮尺寸
    "btnSize": "32px",
    // 按钮间距
    "gap": ".5rem",
    // 图标尺寸
    "iconSize": "16px",
    // 按钮圆角
    "radius": ".375rem",
  },

  // ---------- 上下篇导航（5 项） ----------
  "prevNext": {
    // 缩略图宽
    "thumbSize": "64px",
    // 缩略图高
    "thumbHeight": "44px",
    // 间距
    "gap": "1rem",
    // 上边距
    "marginTop": "2rem",
    // 标题最大行数
    "titleLines": "1",
  },

  // ---------- 联系弹窗（5 项） ----------
  "contactPopup": {
    // 最大条目数
    "maxItems": "4",
    // 图标尺寸
    "iconSize": "1.5rem",
    // 圆角
    "radius": "0.618rem",
    // 条目字号
    "valueFontSize": "1.25rem",
    // 标题字号
    "titleSize": "1.25rem",
  },

  // ---------- 赞赏（4 项） ----------
  "reward": {
    // 二维码尺寸
    "qrSize": "180px",
    // 按钮字号
    "btnFontSize": ".8125rem",
    // 弹窗圆角
    "popupRadius": "0.618rem",
    // 条目间距
    "entryGap": "1.5rem",
  },

  // ---------- 每日一句（5 项） ----------
  "dailyQuote": {
    // 显示作者
    "showAuthor": "true",
    // 引文字号
    "quoteFontSize": "1rem",
    // 作者字号
    "authorFontSize": ".8125rem",
    // 引号装饰尺寸
    "markSize": "2rem",
    // 每日刷新
    "refreshDaily": "true",
  },

  // ---------- 图库（5 项） ----------
  "gallery": {
    // 列数
    "columns": "3",
    // 间距
    "gap": "1rem",
    // 圆角
    "radius": "0.618rem",
    // 悬停缩放
    "hoverZoom": "1.05",
    // 显示图注
    "captionShow": "true",
  },

  // ---------- 标签云（5 项） ----------
  "tags": {
    // 最小字号
    "cloudMinSize": ".75rem",
    // 最大字号
    "cloudMaxSize": "1.25rem",
    // 标签间距
    "cloudGap": ".5rem",
    // 显示计数
    "showCount": "true",
    // 悬停缩放
    "hoverScale": "1.05",
  },

  // ---------- 归档页（5 项） ----------
  "archive": {
    // 条目间距
    "itemGap": ".5rem",
    // 年份字号
    "yearFontSize": "1.5em",
    // 显示计数
    "showCount": "true",
    // 日期格式
    "dateFormat": "YYYY-MM-DD",
    // 按年分组
    "groupByYear": "true",
  },

  // ---------- 系列文章（4 项） ----------
  "series": {
    // 面板圆角
    "panelRadius": "0.618rem",
    // 进度条高度
    "progressHeight": "4px",
    // 徽章颜色
    "badgeColor": "var(--color-s)",
    // 面板内边距
    "panelPadding": "1rem 1.25rem",
  },

  // ---------- 返回顶部（5 项） ----------
  "backToTop": {
    // 按钮尺寸
    "size": "44px",
    // 底部偏移
    "offsetBottom": "2rem",
    // 侧边偏移
    "offsetSide": "2rem",
    // 滚动多少像素后显示
    "showAfterPx": "400",
    // 层级
    "zIndex": "999",
  },

}
{
  // ==================== S-ynapse UI 精细调节（tuning.json5） ====================
  // 作用     : UI 数值集中层;每个参数对应一个数值,构建时注入为 CSS 变量
  //            （--{分类}-{参数},如 --typography-h1Size）。
  // 生效方式 : ① CSS 变量由模板 var(--…) 消费并带回退;
  //            ② 行为参数由 window.__TUNING__ 供 JS 运行时优先读取
  //            （搜索/目录/TTS/阅读面板/每日一言等,缺省回退 features 同名值）。
  // 覆盖链   : 本文件 > 模板/模块内置 fallback;与 features 重叠的键以本文件优先。
  // 编写规范 : 值型参数用 CSS 长度/颜色;行为参数用数字/字符串/布尔;
  //            删除某项即回退内置值;修改后需重新构建。
  // 注意     : 所有参数均有消费点;字符串/布尔型行为参数以引号书写。
  // 消费方   : scripts/build/config.js（加载）→ 模板 CSS 变量注入;
  //            js/core/runtime.js 挂载 window.__TUNING__,js/domains/** 运行时读取。
  // 文档     : docs/config-reference.md §10 tuning.json5。
  // =============================================================================

  // ---------- 排版系统（18 项） ----------
  "typography": {
    // 作用: 正文段落/列表基础字号（--typography-bodySize;文章与页面正文消费）
    // 类型: string(CSS 长度) | 可填: 任意合法 font-size（建议 .875–1.25rem） | 不可填: 空串或无单位数字（CSS 无效,回退浏览器默认） | 推荐/默认: "1.0625rem"
    "bodySize": "1.0625rem",
    // 作用: 一级标题字号;黄金比例 φ² 基准（--typography-h1Size）
    // 类型: string(CSS 长度) | 可填: 任意合法 font-size（建议 1.75–2.5em） | 不可填: 空串或非法值（回退内置） | 推荐/默认: "2.058em"
    "h1Size": "2.058em",
    // 作用: 二级标题字号;黄金比例 φ 基准（--typography-h2Size）
    // 类型: string(CSS 长度) | 可填: 任意合法 font-size（建议 1.4–1.9em） | 不可填: 空串或非法值（回退内置） | 推荐/默认: "1.618em"
    "h2Size": "1.618em",
    // 作用: 三级标题字号;黄金比例 √φ 基准（--typography-h3Size）
    // 类型: string(CSS 长度) | 可填: 任意合法 font-size（建议 1.15–1.4em） | 不可填: 空串或非法值（回退内置） | 推荐/默认: "1.272em"
    "h3Size": "1.272em",
    // 作用: 四级标题字号（--typography-h4Size）
    // 类型: string(CSS 长度) | 可填: 任意合法 font-size（建议等于正文或略大） | 不可填: 空串或非法值（回退内置） | 推荐/默认: "1em"
    "h4Size": "1em",
    // 作用: 五级标题字号（--typography-h5Size）
    // 类型: string(CSS 长度) | 可填: 任意合法 font-size（建议略小于正文） | 不可填: 空串或非法值（回退内置） | 推荐/默认: ".875em"
    "h5Size": ".875em",
    // 作用: 六级标题字号（--typography-h6Size）
    // 类型: string(CSS 长度) | 可填: 任意合法 font-size（建议略小于正文） | 不可填: 空串或非法值（回退内置） | 推荐/默认: ".8125em"
    "h6Size": ".8125em",
    // 作用: 小号辅助文字字号（--typography-smallSize）
    // 类型: string(CSS 长度) | 可填: 任意合法 font-size（建议 .75–1rem） | 不可填: 空串或非法值（回退内置） | 推荐/默认: ".875em"
    "smallSize": ".875em",
    // 作用: 极小文字字号（标签/日期;--typography-tinySize）
    // 类型: string(CSS 长度) | 可填: 任意合法 font-size（建议 ≥ .6875rem 保可读） | 不可填: 空串或非法值（回退内置） | 推荐/默认: ".75em"
    "tinySize": ".75em",
    // 作用: 正文行高（无单位倍数;--typography-lineHeight）
    // 类型: string(number 形式的倍数) | 可填: 1.2–2.4（建议 1.6–1.9） | 不可填: 带单位值（如 "28px",会与 font-size 脱钩） | 推荐/默认: "1.8"
    "lineHeight": "1.8",
    // 作用: 各级标题行高（--typography-headingLineHeight）
    // 类型: string(number 形式的倍数) | 可填: 1.1–1.8（建议 1.2–1.4） | 不可填: 带单位值 | 推荐/默认: "1.3"
    "headingLineHeight": "1.3",
    // 作用: 全局字间距（--typography-letterSpacing）
    // 类型: string(CSS 长度) | 可填: 负值–0.1em 均合法（建议 0–0.05em;CJK 慎用负值） | 不可填: 空串或非法值（回退内置） | 推荐/默认: "0.02em"
    "letterSpacing": "0.02em",
    // 作用: 各级标题字重（--typography-headingWeight）
    // 类型: string(number 字重) | 可填: 100–900（600 半粗/700 粗;可变字体可任意） | 不可填: 非数字关键字以外写法（部分字体解析失败） | 推荐/默认: "700"
    "headingWeight": "700",
    // 作用: 代码/等宽文字字号（--typography-monoSize;pre/code/kbd 消费）
    // 类型: string(CSS 长度) | 可填: 任意合法 font-size（建议 .8–1em,略小于正文） | 不可填: 空串或非法值（回退内置） | 推荐/默认: ".875em"
    "monoSize": ".875em",
    // 作用: 引用块字号（--typography-quoteSize;blockquote 消费）
    // 类型: string(CSS 长度) | 可填: 任意合法 font-size（建议与正文相当或略大） | 不可填: 空串或非法值（回退内置） | 推荐/默认: "1.05em"
    "quoteSize": "1.05em",
    // 作用: 图注字号（--typography-captionSize;figcaption 消费）
    // 类型: string(CSS 长度) | 可填: 任意合法 font-size（建议 .75–1rem） | 不可填: 空串或非法值（回退内置） | 推荐/默认: ".8125rem"
    "captionSize": ".8125rem",
    // 作用: 元信息字号（--typography-metaSize;文章日期/作者行消费）
    // 类型: string(CSS 长度) | 可填: 任意合法 font-size（建议 .75–1rem） | 不可填: 空串或非法值（回退内置） | 推荐/默认: ".875rem"
    "metaSize": ".875rem",
    // 作用: 导语字号（--typography-leadSize;文章首段;黄金比例 √φ）
    // 类型: string(CSS 长度) | 可填: 任意合法 font-size（建议 1.1–1.4em） | 不可填: 空串或非法值（回退内置） | 推荐/默认: "1.272em"
    "leadSize": "1.272em",
  },

  // ---------- 布局系统（14 项） ----------
  "layout": {
    // 作用: 文章正文卡片内边距（--layout-articlePadding;.post-article/page-pad/author-section 左右/内消费）
    // 类型: string(CSS 长度) | 可填: 任意合法 padding 值（建议 1.5–3rem;窄屏由响应式规则另行收窄） | 不可填: 空串或负值（回退内置） | 推荐/默认: "2rem"
    "articlePadding": "2rem",
    // 作用: 内容区最大宽度（--layout-containerWidth;主容器布局消费）
    // 类型: string(CSS 长度) | 可填: 任意合法 max-width（建议 1080–1440px） | 不可填: 空串或小于内容可用宽度的值（会导致布局挤压） | 推荐/默认: "1250px"
    "containerWidth": "1250px",
    // 作用: 桌面端左侧目录栏宽度（--layout-tocWidth）
    // 类型: string(CSS 长度) | 可填: 任意合法宽度（建议 160–280px;须小于 containerWidth/3） | 不可填: 空串或负值 | 推荐/默认: "200px"
    "tocWidth": "200px",
    // 作用: 模块间距;黄金比例 φ（--layout-gap;卡片/区块栅格间距消费）
    // 类型: string(CSS 长度) | 可填: 任意合法间距（建议 .75–2.5rem） | 不可填: 空串或负值 | 推荐/默认: "1.618rem"
    "gap": "1.618rem",
    // 作用: 页面级内边距;黄金比例 φ²（--layout-padding;主区域留白消费）
    // 类型: string(CSS 长度) | 可填: 任意合法 padding（建议 1.5–4rem;窄屏由响应式规则收窄） | 不可填: 空串或负值 | 推荐/默认: "2.618rem"
    "padding": "2.618rem",
    // 作用: 内容区水平微调偏移（--layout-contentOffset;用于视觉对齐修正）
    // 类型: string(CSS 长度) | 可填: 正负小值（建议 -20–20px;0 = 不偏移） | 不可填: 大值（≥1rem,会破坏居中） | 推荐/默认: "-10px"
    "contentOffset": "-10px",
    // 作用: 页面标题与正文区之间的间距（--layout-headerContentGap）
    // 类型: string(CSS 长度) | 可填: 任意合法间距（建议 24–80px） | 不可填: 空串或负值 | 推荐/默认: "48px"
    "headerContentGap": "48px",
    // 作用: 目录距屏幕左缘的最小距离（--layout-tocMinLeft;宽屏目录定位保底）
    // 类型: string(CSS 长度) | 可填: 任意合法间距（建议 0–40px） | 不可填: 空串或负值 | 推荐/默认: "10px"
    "tocMinLeft": "10px",
    // 作用: 右侧栏距屏幕右缘的最小距离（--layout-sidebarMinRight;宽屏侧栏定位保底）
    // 类型: string(CSS 长度) | 可填: 任意合法间距（建议 0–40px） | 不可填: 空串或负值 | 推荐/默认: "10px"
    "sidebarMinRight": "10px",
    // 作用: 移动端断点（--layout-mobileBreakpoint;≤ 该宽度应用移动端布局/组件）
    // 类型: string(CSS 长度) | 可填: 320–1024px（须小于 tabletBreakpoint） | 不可填: 非法值或大于平板断点（断点顺序会倒置） | 推荐/默认: "768px"
    "mobileBreakpoint": "768px",
    // 作用: 目录隐藏断点（--layout-tocHideBreakpoint;窄于该宽度隐藏桌面目录）
    // 类型: string(CSS 长度) | 可填: 768–1280px（须介于移动端与平板断点之间） | 不可填: 非法值（回退内置） | 推荐/默认: "900px"
    "tocHideBreakpoint": "900px",
    // 作用: 平板断点（--layout-tabletBreakpoint;≤ 该宽度应用平板布局）
    // 类型: string(CSS 长度) | 可填: 768–1600px（须大于移动端断点） | 不可填: 非法值（回退内置） | 推荐/默认: "1024px"
    "tabletBreakpoint": "1024px",
    // 作用: 超宽屏内容上限（--layout-maxContentWidth;超宽屏时限制正文换行跨度）
    // 类型: string(CSS 长度) | 可填: ≥ containerWidth（建议 1440–1920px） | 不可填: 小于 containerWidth（无实际效果） | 推荐/默认: "1600px"
    "maxContentWidth": "1600px",
    // 作用: 文章网格单列折叠断点（--layout-gridCollapseBreakpoint;低于该宽度 blog-grid 变 1 列）
    // 类型: string(CSS 长度) | 可填: 480–900px（建议小于 mobileBreakpoint） | 不可填: 非法值（回退内置） | 推荐/默认: "640px"
    "gridCollapseBreakpoint": "640px",
  },

  // ---------- 圆角系统（7 项） ----------
  "radius": {
    // 作用: 全局默认圆角;黄金比例（--radius-default;卡片/面板等通用消费）
    // 类型: string(CSS 长度) | 可填: 任意合法 border-radius（建议 .25–1rem;0 = 直角） | 不可填: 空串或负值（回退内置） | 推荐/默认: "0.618rem"
    "default": "0.618rem",
    // 作用: 大圆角;黄金比例 φ（--radius-large;大面板/弹窗消费）
    // 类型: string(CSS 长度) | 可填: 任意合法 border-radius（建议 .75–2.5rem;不应小于 default） | 不可填: 空串或负值 | 推荐/默认: "1.618rem"
    "large": "1.618rem",
    // 作用: 按钮圆角（--radius-button）
    // 类型: string(CSS 长度) | 可填: 任意合法 border-radius（建议 0–.75rem;999px = 胶囊） | 不可填: 空串或负值 | 推荐/默认: "0.382rem"
    "button": "0.382rem",
    // 作用: 图片圆角（--radius-image;正文/卡片图片消费）
    // 类型: string(CSS 长度) | 可填: 任意合法 border-radius（建议 0–1rem） | 不可填: 空串或负值 | 推荐/默认: "0.618rem"
    "image": "0.618rem",
    // 作用: 头像圆角（--radius-avatar;50% = 圆形）
    // 类型: string(CSS 长度/百分比) | 可填: 任意合法 border-radius（50% 圆形;1rem 方形圆角） | 不可填: 空串或负值 | 推荐/默认: "50%"
    "avatar": "50%",
    // 作用: 徽章圆角（--radius-badge;标签/徽标消费）
    // 类型: string(CSS 长度) | 可填: 任意合法 border-radius（1rem 圆润;999px = 胶囊） | 不可填: 空串或负值 | 推荐/默认: "1rem"
    "badge": "1rem",
    // 作用: 输入框圆角（--radius-input）
    // 类型: string(CSS 长度) | 可填: 任意合法 border-radius（建议 0–.75rem） | 不可填: 空串或负值 | 推荐/默认: "0.382rem"
    "input": "0.382rem",
  },

  // ---------- 动效系统（11 项） ----------
  "motion": {
    // 作用: 卡片悬停上浮距离（--motion-hoverLiftPx;translateY 消费）
    // 类型: string(number,单位由消费规则补 px) | 可填: 0–12（0 = 不上浮） | 不可填: 负值或带单位值（会拼接出非法 CSS） | 推荐/默认: "4"
    "hoverLiftPx": "4",
    // 作用: 卡片悬停缩放倍数（--motion-hoverScale）
    // 类型: string(无单位倍数) | 可填: 1–1.1（1 = 不缩放;建议 ≤1.03 防抖动） | 不可填: 0/负值或带单位值 | 推荐/默认: "1.02"
    "hoverScale": "1.02",
    // 作用: 链接下划线粗细（--motion-underlineThickness）
    // 类型: string(CSS 长度) | 可填: 1–4px（0 = 不显示下划线） | 不可填: 空串或负值 | 推荐/默认: "2px"
    "underlineThickness": "2px",
    // 作用: 链接下划线相对文字的偏移（--motion-underlineOffset）
    // 类型: string(CSS 长度) | 可填: 任意合法偏移（建议 1–6px） | 不可填: 空串或非法值 | 推荐/默认: "3px"
    "underlineOffset": "3px",
    // 作用: 按钮点击涟漪扩散时长（--motion-rippleDurationMs）
    // 类型: string(number,ms) | 可填: 200–1000;系统减少动效时自动禁用 | 不可填: 负值或带单位值 | 推荐/默认: "500"
    "rippleDurationMs": "500",
    // 作用: 滚动渐入动画时长（--motion-revealDurationMs）
    // 类型: string(number,ms) | 可填: 100–600（建议 200–350） | 不可填: 负值或带单位值 | 推荐/默认: "250"
    "revealDurationMs": "250",
    // 作用: 滚动渐入起点位移（--motion-revealOffset;translateY 起点）
    // 类型: string(CSS 长度) | 可填: 0–40px（0 = 仅淡入不移位） | 不可填: 空串或非法值 | 推荐/默认: "10px"
    "revealOffset": "10px",
    // 作用: 同屏元素渐入错峰延迟（--motion-staggerDelayMs）
    // 类型: string(number,ms) | 可填: 0–300（0 = 不延迟;建议 ≤100） | 不可填: 负值或带单位值 | 推荐/默认: "60"
    "staggerDelayMs": "60",
    // 作用: 按钮按压缩放倍数（--motion-buttonPressScale）
    // 类型: string(无单位倍数) | 可填: 0.9–1（1 = 不缩放） | 不可填: >1 或负值（按下反而放大属反直觉） | 推荐/默认: "0.97"
    "buttonPressScale": "0.97",
    // 作用: 通用过渡时长（--motion-transitionDuration;悬停/显隐等消费）
    // 类型: string(CSS 时间) | 可填: .1–.5s（建议 .2–.35s） | 不可填: 空串或非法时间（回退内置） | 推荐/默认: "0.3s"
    "transitionDuration": "0.3s",
    // 作用: 通用过渡缓动曲线（--motion-transitionTiming;弹簧感 out 型）
    // 类型: string(CSS timing-function) | 可填: 合法 cubic-bezier()/ease 关键字 | 不可填: 空串或非法函数（回退内置） | 推荐/默认: "cubic-bezier(0.22, 1, 0.36, 1)"
    "transitionTiming": "cubic-bezier(0.22, 1, 0.36, 1)",
  },

  // ---------- 首屏 Hero（9 项） ----------
  "hero": {
    // 作用: Hero 主标题字号;黄金比例 φ²（--hero-titleSize）
    // 类型: string(CSS 长度) | 可填: 任意合法 font-size（建议 2–3.5em;窄屏由响应式规则收窄） | 不可填: 空串或非法值 | 推荐/默认: "2.618em"
    "titleSize": "2.618em",
    // 作用: Hero 副标题字号（--hero-subSize）
    // 类型: string(CSS 长度) | 可填: 任意合法 font-size（建议 1–1.3em） | 不可填: 空串或非法值 | 推荐/默认: "1.05em"
    "subSize": "1.05em",
    // 作用: Hero 内容区最大宽度（--hero-maxWidth）
    // 类型: string(CSS 长度) | 可填: 任意合法 max-width（建议 600–900px） | 不可填: 空串或负值 | 推荐/默认: "760px"
    "maxWidth": "760px",
    // 作用: Hero 操作区（按钮组）间距（--hero-actionsGap）
    // 类型: string(CSS 长度) | 可填: 任意合法 gap（建议 .5–1.5rem） | 不可填: 空串或负值 | 推荐/默认: ".75rem"
    "actionsGap": ".75rem",
    // 作用: Hero 标签区间距（--hero-tagGap）
    // 类型: string(CSS 长度) | 可填: 任意合法 gap（建议 .25–1rem） | 不可填: 空串或负值 | 推荐/默认: ".5rem"
    "tagGap": ".5rem",
    // 作用: Hero CTA 按钮圆角（--hero-ctaRadius）
    // 类型: string(CSS 长度) | 可填: 任意合法 border-radius（0 = 直角;999px = 胶囊） | 不可填: 空串或负值 | 推荐/默认: "0.382rem"
    "ctaRadius": "0.382rem",
    // 作用: Hero 顶部内边距（--hero-paddingTop）
    // 类型: string(CSS 长度) | 可填: 任意合法 padding（建议 0–3rem） | 不可填: 空串或负值 | 推荐/默认: "1rem"
    "paddingTop": "1rem",
    // 作用: Hero 底部内边距（--hero-paddingBottom）
    // 类型: string(CSS 长度) | 可填: 任意合法 padding（建议 1–4rem） | 不可填: 空串或负值 | 推荐/默认: "2rem"
    "paddingBottom": "2rem",
    // 作用: Hero 日期行字号（--hero-dateSize）
    // 类型: string(CSS 长度) | 可填: 任意合法 font-size（建议 .8–1.1rem） | 不可填: 空串或非法值 | 推荐/默认: ".9375rem"
    "dateSize": ".9375rem",
  },

  // ---------- 文章卡片（12 项） ----------
  "card": {
    // 作用: 列表卡片封面宽高比（--card-imageAspect;aspect-ratio 消费;≈φ）
    // 类型: string(W:H 比例) | 可填: 任意合法宽高比（如 "16/10"/"16/9"/"4/3"） | 不可填: 0/负值或非比例写法（回退内置） | 推荐/默认: "16/10"
    "imageAspect": "16/10",
    // 作用: 卡片圆角（--card-radius）
    // 类型: string(CSS 长度) | 可填: 任意合法 border-radius（0 = 直角） | 不可填: 空串或负值 | 推荐/默认: "0.618rem"
    "radius": "0.618rem",
    // 作用: 卡片内容区内边距（--card-padding）
    // 类型: string(CSS 长度) | 可填: 任意合法 padding（建议 1–2.5rem） | 不可填: 空串或负值 | 推荐/默认: "1.5rem"
    "padding": "1.5rem",
    // 作用: 卡片标题字号（--card-titleSize）
    // 类型: string(CSS 长度) | 可填: 任意合法 font-size（建议 1.05–1.5rem） | 不可填: 空串或非法值 | 推荐/默认: "1.272rem"
    "titleSize": "1.272rem",
    // 作用: 卡片摘要最大行数（--card-excerptLines;-webkit-line-clamp 消费）
    // 类型: string(整数) | 可填: 1–6（越界由浏览器钳制） | 不可填: 0/负数或小数（回退内置） | 推荐/默认: "3"
    "excerptLines": "3",
    // 作用: 卡片元信息字号（--card-metaSize）
    // 类型: string(CSS 长度) | 可填: 任意合法 font-size（建议 .75–.9rem） | 不可填: 空串或非法值 | 推荐/默认: ".8125rem"
    "metaSize": ".8125rem",
    // 作用: 无封面卡片占位文字字号下限（--card-nocoverMinSize;随容器宽度自适应）
    // 类型: string(CSS 长度) | 可填: 任意合法 font-size（须 ≤ nocoverMaxSize） | 不可填: 大于上限（区间倒置） | 推荐/默认: "1.272rem"
    "nocoverMinSize": "1.272rem",
    // 作用: 无封面卡片占位文字字号上限（--card-nocoverMaxSize）
    // 类型: string(CSS 长度) | 可填: 任意合法 font-size（须 ≥ nocoverMinSize） | 不可填: 小于下限（区间倒置） | 推荐/默认: "1.618rem"
    "nocoverMaxSize": "1.618rem",
    // 作用: 首页/列表卡片栅格间距（--card-gridGap）
    // 类型: string(CSS 长度) | 可填: 任意合法 gap（建议 1–2.5rem） | 不可填: 空串或负值 | 推荐/默认: "1.618rem"
    "gridGap": "1.618rem",
    // 作用: 卡片封面悬停缩放倍数（--card-imageHoverScale;1 = 不缩放）
    // 类型: string(无单位倍数) | 可填: 1–1.1（建议 ≤1.05） | 不可填: 0/负值或带单位值 | 推荐/默认: "1.02"
    "imageHoverScale": "1.02",
    // 作用: 首页首篇大卡（Bento 布局）开关（--card-bentoFeatured;构建期类名门控）
    // 类型: boolean | 可填: true（首篇大卡）/false（全部等宽卡片） | 不可填: 非布尔值 | 推荐/默认: true
    "bentoFeatured": true,
    // 作用: 首篇大卡封面宽高比（--card-bentoAspect;仅 bentoFeatured=true 生效）
    // 类型: string(W:H 比例) | 可填: 任意合法宽高比（建议 16/9–21/9） | 不可填: 0/负值或非比例写法 | 推荐/默认: "21/10"
    "bentoAspect": "21/10",
  },

  // ---------- 目录侧栏（9 项） ----------
  "toc": {
    // 作用: 目录项正文字号（--toc-fontSize）
    // 类型: string(CSS 长度) | 可填: 任意合法 font-size（建议 .75–.9rem） | 不可填: 空串或非法值 | 推荐/默认: ".8125rem"
    "fontSize": ".8125rem",
    // 作用: 目录标题（"目录"标签）字号（--toc-labelSize）
    // 类型: string(CSS 长度) | 可填: 任意合法 font-size（建议 .65–.8rem） | 不可填: 空串或非法值 | 推荐/默认: ".6875rem"
    "labelSize": ".6875rem",
    // 作用: 二级目录项缩进（--toc-indentL2）
    // 类型: string(CSS 长度) | 可填: 任意合法 padding-left（建议 .25–1rem） | 不可填: 空串或负值 | 推荐/默认: ".5rem"
    "indentL2": ".5rem",
    // 作用: 三级目录项缩进（--toc-indentL3;须大于二级缩进）
    // 类型: string(CSS 长度) | 可填: 任意合法 padding-left（建议 .75–1.75rem） | 不可填: 小于 indentL2 | 推荐/默认: "1.2rem"
    "indentL3": "1.2rem",
    // 作用: 四级目录项缩进（--toc-indentL4;须大于三级缩进）
    // 类型: string(CSS 长度) | 可填: 任意合法 padding-left（建议 1.25–2.5rem） | 不可填: 小于 indentL3 | 推荐/默认: "1.9rem"
    "indentL4": "1.9rem",
    // 作用: 目录顶部阅读进度线高度（--toc-progressHeight）
    // 类型: string(CSS 长度) | 可填: 0–8px（0 = 不显示） | 不可填: 负值 | 推荐/默认: "3px"
    "progressHeight": "3px",
    // 作用: 目录吸顶偏移（--toc-stickyTop;滚动时目录距视口顶部的距离）
    // 类型: string(CSS 长度) | 可填: 任意合法偏移（建议 ≥ 导航栏高度;当前 80px） | 不可填: 空串或负值 | 推荐/默认: "80px"
    "stickyTop": "80px",
    // 作用: 滚动高亮判定偏移（--toc-scrollOffset;章节进入视口该距离后高亮）
    // 类型: string(number,px) | 可填: 0–300（建议 60–150） | 不可填: 负值或带单位值 | 推荐/默认: "80"
    "scrollOffset": "80",
    // 作用: 目录默认折叠状态（--toc-collapsedByDefault;"true" = 初始全折叠）
    // 类型: string(布尔字面量) | 可填: "true"/"false" | 不可填: 布尔 true/false 真值（此处按 CSS 变量消费,须带引号） | 推荐/默认: "false"
    "collapsedByDefault": "false",
  },

  // ---------- 搜索弹层（20 项） ----------
  "search": {
    // 作用: 搜索遮罩内边距（--search-overlayPadding;上/左右/下;12vh 视觉重心偏上）
    // 类型: string(CSS padding 简写) | 可填: 1–3 个合法长度值（建议顶部 8–20vh） | 不可填: 空串或负值 | 推荐/默认: "12vh 1rem 2rem"
    "overlayPadding": "12vh 1rem 2rem",
    // 作用: 遮罩底色（写入 --search-overlayBackdrop;搜索弹层 .search-overlay 背景消费）
    // 类型: string(CSS 颜色) | 可填: rgba()/hex/颜色关键字 | 不可填: 空串（回退内置默认底） | 推荐/默认: "rgba(0,0,0,.55)"
    "overlayBackdrop": "rgba(0,0,0,.55)",
    // 作用: 搜索弹层内边距（--search-modalPadding）
    // 类型: string(CSS padding 简写) | 可填: 1–4 个合法长度值（建议 1.5–3rem） | 不可填: 空串或负值 | 推荐/默认: "2.5rem 2.5rem 2rem"
    "modalPadding": "2.5rem 2.5rem 2rem",
    // 作用: 搜索弹层最大高度（--search-modalMaxHeight;超出内部滚动）
    // 类型: string(CSS 长度) | 可填: 50–95vh（建议 70–85vh） | 不可填: 0/负值或非法单位 | 推荐/默认: "78vh"
    "modalMaxHeight": "78vh",
    // 作用: 弹层关闭按钮尺寸（--search-closeBtnSize;圆形按钮宽=高）
    // 类型: string(CSS 长度) | 可填: 28–48px（建议 ≥ 32px 便于点按） | 不可填: 负值或非法值 | 推荐/默认: "36px"
    "closeBtnSize": "36px",
    // 作用: 搜索弹层宽度（--search-modalWidth;窄屏由响应式规则收窄）
    // 类型: string(CSS 长度) | 可填: 任意合法宽度（建议 560–900px） | 不可填: 空串或负值 | 推荐/默认: "760px"
    "modalWidth": "760px",
    // 作用: 搜索输入框高度（--search-inputHeight）
    // 类型: string(CSS 长度) | 可填: 任意合法高度（建议 44–64px） | 不可填: 负值或非法值 | 推荐/默认: "56px"
    "inputHeight": "56px",
    // 作用: 搜索输入框字号（--search-inputFontSize）
    // 类型: string(CSS 长度) | 可填: 任意合法 font-size（建议 1–1.75rem） | 不可填: 负值或非法值 | 推荐/默认: "1.375rem"
    "inputFontSize": "1.375rem",
    // 作用: 搜索历史最多保留条数（--search-historyCount;localStorage 消费）
    // 类型: string(整数) | 可填: 0–20（0 = 不显示历史） | 不可填: 负数或小数（回退内置） | 推荐/默认: "5"
    "historyCount": "5",
    // 作用: 热门搜索显示条数（--search-hotCount;下拉到热门词条数）
    // 类型: string(整数) | 可填: 0–20（0 = 不显示热门） | 不可填: 负数或小数 | 推荐/默认: "5"
    "hotCount": "5",
    // 作用: 搜索输入防抖间隔（--search-debounceMs;停止输入后触发检索）
    // 类型: string(number,ms) | 可填: 0–500（0 = 不防抖;建议 80–200） | 不可填: 负值或带单位值 | 推荐/默认: "120"
    "debounceMs": "120",
    // 作用: 触发检索的最小查询长度（--search-minQueryLength;按字符计）
    // 类型: string(整数) | 可填: 1–3（0 = 空输入也检索,通常不推荐） | 不可填: 负数或小数 | 推荐/默认: "1"
    "minQueryLength": "1",
    // 作用: 结果摘要截断长度（--search-excerptLength;字符）
    // 类型: string(整数) | 可填: 40–300（建议 80–160） | 不可填: 负数或小数 | 推荐/默认: "120"
    "excerptLength": "120",
    // 作用: 搜索结果最大条数（--search-resultLimit）
    // 类型: string(整数) | 可填: 5–100（建议 20–50;过大影响渲染） | 不可填: 0/负数（回退内置） | 推荐/默认: "30"
    "resultLimit": "30",
    // 作用: 空结果文案（--search-emptyText;中文站;空 = 回退内置文案链）
    // 类型: string | 可填: 任意短文本（建议 ≤ 20 字） | 不可填: HTML 标签（按纯文本渲染,会被转义显示） | 推荐/默认: "未找到匹配内容"
    "emptyText": "未找到匹配内容",
    // 作用: 空结果文案英文（--search-emptyTextEn;en 站使用;空 = 回退中文值）
    // 类型: string | 可填: 任意短文本 | 不可填: HTML 标签 | 推荐/默认: "No matching content"
    "emptyTextEn": "No matching content",
    // 作用: 搜索索引加载超时（--search-indexTimeoutMs;超时按失败处理并允许重试）
    // 类型: number(ms) | 可填: 1000–30000（建议 3000–8000） | 不可填: 0/负数（回退内置 5000） | 推荐/默认: 5000
    "indexTimeoutMs": 5000,
    // 作用: 索引加载失败后的额外重试次数（--search-indexRetry;合计请求 = 1 + 本值）
    // 类型: number(整数) | 可填: 0–3（0 = 不重试;过大拖慢失败反馈） | 不可填: 负数或小数（回退内置 1） | 推荐/默认: 1
    "indexRetry": 1,
    // 作用: 索引加载失败提示文案（--search-errorText;中文;空 = 回退内置 i18n 文案）
    // 类型: string | 可填: 任意短文本或 "" | 不可填: HTML 标签（纯文本渲染） | 推荐/默认: ""（用内置双语兜底）
    "errorText": "",
    // 作用: 索引加载失败提示文案英文（--search-errorTextEn;en 站使用;空 = 回退内置 i18n 文案）
    // 类型: string | 可填: 任意短文本或 "" | 不可填: HTML 标签 | 推荐/默认: ""（用内置双语兜底）
    "errorTextEn": "",
  },

  // ---------- 阅读体验（21 项） ----------
  "reading": {
    // 作用: 顶部阅读进度条高度（--reading-progressHeight）
    // 类型: string(CSS 长度) | 可填: 0–8px（0 = 不显示） | 不可填: 负值或非法值 | 推荐/默认: "3px"
    "progressHeight": "3px",
    // 作用: 阅读坞距底边的偏移（--reading-dockBottom;宽屏）
    // 类型: string(CSS 长度) | 可填: 任意合法偏移（建议 3–8rem;需避开底部其他浮层） | 不可填: 空串或负值 | 推荐/默认: "5.6rem"
    "dockBottom": "5.6rem",
    // 作用: 阅读坞距右边的偏移（--reading-dockRight;宽屏）
    // 类型: string(CSS 长度) | 可填: 任意合法偏移（建议 .75–2rem） | 不可填: 空串或负值 | 推荐/默认: "1.35rem"
    "dockRight": "1.35rem",
    // 作用: 阅读坞进度环按钮尺寸（--reading-dockBtnSize;宽=高）
    // 类型: string(CSS 长度) | 可填: 32–56px（建议 ≥ 40px 便于点按） | 不可填: 负值或非法值 | 推荐/默认: "40px"
    "dockBtnSize": "40px",
    // 作用: 阅读坞距右边的偏移（--reading-dockRightTablet;≤平板断点生效）
    // 类型: string(CSS 长度) | 可填: 任意合法偏移（建议 .5–1.5rem） | 不可填: 空串或负值 | 推荐/默认: "1rem"
    "dockRightTablet": "1rem",
    // 作用: 阅读坞距底边的偏移（--reading-dockBottomTablet;≤平板断点生效）
    // 类型: string(CSS 长度) | 可填: 任意合法偏移（建议 4–9rem） | 不可填: 空串或负值 | 推荐/默认: "6.4rem"
    "dockBottomTablet": "6.4rem",
    // 作用: 阅读设置齿轮按钮距底边的偏移（--reading-gearBottom;宽屏;须高于阅读坞）
    // 类型: string(CSS 长度) | 可填: 任意合法偏移（建议 8–18rem） | 不可填: 小于 dockBottom（会与阅读坞重叠） | 推荐/默认: "14.6rem"
    "gearBottom": "14.6rem",
    // 作用: 阅读设置齿轮按钮距底边的偏移（--reading-gearMobileBottom;≤移动端断点）
    // 类型: string(CSS 长度) | 可填: 任意合法偏移（建议 6–14rem） | 不可填: 负值 | 推荐/默认: "10.8rem"
    "gearMobileBottom": "10.8rem",
    // 作用: 阅读设置面板距底边的偏移（--reading-panelBottom;宽屏;须高于齿轮按钮）
    // 类型: string(CSS 长度) | 可填: 任意合法偏移（建议 10–16rem） | 不可填: 小于 gearBottom（会与齿轮重叠） | 推荐/默认: "13.2rem"
    "panelBottom": "13.2rem",
    // 作用: 阅读设置面板宽度（--reading-panelWidth）
    // 类型: string(CSS 长度) | 可填: 220–420px（建议 260–320px） | 不可填: 负值或非法值 | 推荐/默认: "280px"
    "panelWidth": "280px",
    // 作用: 阅读坞距底边的偏移（--reading-dockMobileBottom;≤移动端断点;须避开底部导航）
    // 类型: string(CSS 长度) | 可填: 任意合法偏移（建议 8–18rem） | 不可填: 负值 | 推荐/默认: "14.2rem"
    "dockMobileBottom": "14.2rem",
    // 作用: TTS 朗读语速（--reading-ttsRate;SpeechSynthesisUtterance.rate 消费）
    // 类型: string(number 倍数) | 可填: 0.1–10（1 = 正常;建议 0.5–2 保可懂度） | 不可填: 0/负数或带单位值 | 推荐/默认: "1"
    "ttsRate": "1",
    // 作用: TTS 朗读音调（--reading-ttsPitch;SpeechSynthesisUtterance.pitch 消费）
    // 类型: string(number 倍数) | 可填: 0–2（1 = 正常;建议 .8–1.2） | 不可填: 负数或带单位值 | 推荐/默认: "1"
    "ttsPitch": "1",
    // 作用: 阅读设置面板字号调节步长（--reading-fontSizeStep;px）
    // 类型: string(整数,px) | 可填: 1–4（过大手感跳跃） | 不可填: 0/负数（无法调节） | 推荐/默认: "1"
    "fontSizeStep": "1",
    // 作用: 阅读设置面板行高调节步长（--reading-lineHeightStep;倍数）
    // 类型: string(number 倍数) | 可填: .05–.3（建议 .1） | 不可填: 0/负数（无法调节） | 推荐/默认: "0.1"
    "lineHeightStep": "0.1",
    // 作用: 阅读模式正文最大宽度（--reading-readingMaxWidth;ch = 字符宽）
    // 类型: string(CSS 长度) | 可填: 45–100ch（建议 60–80ch 保可读性） | 不可填: 空串或非法值 | 推荐/默认: "72ch"
    "readingMaxWidth": "72ch",
    // 作用: 引用块主色底纹强度（--reading-quoteTint;主色按比例混合到透明底）
    // 类型: string(CSS 百分比) | 可填: 0%–15%（0% = 无底纹;建议 4%–8%） | 不可填: 空串或裸数字（须带 %） | 推荐/默认: "6%"
    "quoteTint": "6%",
    // 作用: 正文图片悬停缩放倍数（--reading-imageHoverScale;1 = 不缩放）
    // 类型: string(无单位倍数) | 可填: 1–1.05（建议 ≤1.02 防抖动） | 不可填: 0/负值或带单位值 | 推荐/默认: "1.01"
    "imageHoverScale": "1.01",
    // 作用: h2 前置短竖线宽度（--reading-h2AccentWidth）
    // 类型: string(CSS 长度) | 可填: 0–.5rem（0 = 不显示竖线） | 不可填: 负值 | 推荐/默认: ".25rem"
    "h2AccentWidth": ".25rem",
    // 作用: h2 前置短竖线高度（--reading-h2AccentHeight）
    // 类型: string(CSS 长度) | 可填: 任意合法高度（建议 .8–1.4em） | 不可填: 负值或非法值 | 推荐/默认: "1em"
    "h2AccentHeight": "1em",
    // 作用: h2 前置短竖线颜色（--reading-h2AccentColor）
    // 类型: string(CSS 颜色) | 可填: 颜色关键字/hex/rgb()/var(--color-*) | 不可填: 空串（回退主题色） | 推荐/默认: "var(--color-s)"
    "h2AccentColor": "var(--color-s)",
  },

  // ---------- 评论区（5 项） ----------
  "comments": {
    // 作用: 评论区头像尺寸（--comments-avatarSize;评论组件内标记头像）
    // 类型: string(CSS 长度) | 可填: 24–80px（建议 32–48px） | 不可填: 负值或非法值 | 推荐/默认: "40px"
    "avatarSize": "40px",
    // 作用: 评论区上边距（--comments-marginTop）
    // 类型: string(CSS 长度) | 可填: 任意合法 margin（建议 1–4rem） | 不可填: 空串或非法值 | 推荐/默认: "2rem"
    "marginTop": "2rem",
    // 作用: 评论区最大宽度（--comments-width;居中显示）
    // 类型: string(CSS 长度/百分比) | 可填: 60%–100%（建议 100%） | 不可填: 0/负值 | 推荐/默认: "100%"
    "width": "100%",
    // 作用: 评论 iframe 外框圆角（--comments-borderRadius）
    // 类型: string(CSS 长度) | 可填: 任意合法 border-radius（0 = 直角） | 不可填: 空串或负值 | 推荐/默认: "0.618rem"
    "borderRadius": "0.618rem",
    // 作用: 评论区顶部细分隔线开关（--comments-dividerShow;"true" = 显示）
    // 类型: string(布尔字面量) | 可填: "true"/"false" | 不可填: 布尔真值（按 CSS 变量消费,须带引号） | 推荐/默认: "true"
    "dividerShow": "true",
  },

  // ---------- 导航栏（7 项） ----------
  "header": {
    // 作用: 顶部导航栏高度（--header-height）
    // 类型: string(CSS 长度) | 可填: 任意合法高度（建议 48–80px） | 不可填: 负值或非法值 | 推荐/默认: "60px"
    "height": "60px",
    // 作用: 导航 Logo 字号（--header-logoSize）
    // 类型: string(CSS 长度) | 可填: 任意合法 font-size（建议 1–1.6em） | 不可填: 负值或非法值 | 推荐/默认: "1.272em"
    "logoSize": "1.272em",
    // 作用: 导航图标尺寸（--header-iconSize;宽=高）
    // 类型: string(CSS 长度) | 可填: 14–28px（建议 16–20px） | 不可填: 负值或非法值 | 推荐/默认: "18px"
    "iconSize": "18px",
    // 作用: 导航栏滚动收缩后的高度（--header-scrolledHeight;须 ≤ height）
    // 类型: string(CSS 长度) | 可填: 任意合法高度（建议 40–70px） | 不可填: 大于 height（无收缩效果） | 推荐/默认: "56px"
    "scrolledHeight": "56px",
    // 作用: 滚动收缩效果开关（--header-scrollShrink;构建期类名门控）
    // 类型: boolean | 可填: true（滚动收缩）/false（恒高） | 不可填: 非布尔值 | 推荐/默认: true
    "scrollShrink": true,
    // 作用: 触发收缩的滚动距离（--header-scrollThresholdPx;px）
    // 类型: string(number,px) | 可填: 0–100（0 = 一滚动即收缩;建议 4–20） | 不可填: 负值或带单位值 | 推荐/默认: "8"
    "scrollThresholdPx": "8",
    // 作用: 顶栏底部渐变发丝线强度（--header-hairlineStrength;辅色混合比例,0% = 关闭）
    // 类型: string(CSS 百分比) | 可填: 0%–100%（建议 15%–50%） | 不可填: 空串或裸数字（须带 %） | 推荐/默认: "30%"
    "hairlineStrength": "30%",
  },

  // ---------- 分页（6 项） ----------
  "pagination": {
    // 作用: 页码按钮最小宽度（--pagination-btnMinWidth;宽=高时同时决定按钮高度）
    // 类型: string(CSS 长度) | 可填: 28–56px（建议 36–44px 便于点按） | 不可填: 负值或非法值 | 推荐/默认: "40px"
    "btnMinWidth": "40px",
    // 作用: 页码按钮高度（--pagination-btnHeight）
    // 类型: string(CSS 长度) | 可填: 28–56px（建议 36–44px） | 不可填: 负值或非法值 | 推荐/默认: "40px"
    "btnHeight": "40px",
    // 作用: 最大可见页数（--pagination-maxVisible;超出显示省略号;下限 3）
    // 类型: string(整数) | 可填: 3–9（<3 由构建/运行时钳制为 3;建议 5–7） | 不可填: 负数或小数 | 推荐/默认: "5"
    "maxVisible": "5",
    // 作用: 页码按钮间距（--pagination-gap）
    // 类型: string(CSS 长度) | 可填: 任意合法 gap（建议 .25–1rem） | 不可填: 空串或负值 | 推荐/默认: ".5rem"
    "gap": ".5rem",
    // 作用: 当前页按钮缩放倍数（--pagination-activeScale）
    // 类型: string(无单位倍数) | 可填: 1–1.2（1 = 不缩放;建议 ≤1.1 防布局抖动） | 不可填: 0/负值或带单位值 | 推荐/默认: "1.05"
    "activeScale": "1.05",
    // 作用: 页码按钮圆角（--pagination-radius）
    // 类型: string(CSS 长度) | 可填: 任意合法 border-radius（0 = 直角;999px = 胶囊） | 不可填: 空串或负值 | 推荐/默认: "0.618rem"
    "radius": "0.618rem",
  },

  // ---------- 统计卡片（5 项） ----------
  "stats": {
    // 作用: 统计数值字号（--stats-numberSize）
    // 类型: string(CSS 长度) | 可填: 任意合法 font-size（建议 1.25–2em） | 不可填: 负值或非法值 | 推荐/默认: "1.5rem"
    "numberSize": "1.5rem",
    // 作用: 统计标签字号（--stats-labelSize）
    // 类型: string(CSS 长度) | 可填: 任意合法 font-size（建议 .75–.9rem） | 不可填: 负值或非法值 | 推荐/默认: ".8125rem"
    "labelSize": ".8125rem",
    // 作用: 统计卡片内边距（--stats-cardPadding）
    // 类型: string(CSS padding 简写) | 可填: 1–4 个合法长度值（建议 .75–1.5rem） | 不可填: 空串或负值 | 推荐/默认: "1rem 1.25rem"
    "cardPadding": "1rem 1.25rem",
    // 作用: 统计卡片间距（--stats-gap）
    // 类型: string(CSS 长度) | 可填: 任意合法 gap（建议 .5–2rem） | 不可填: 空串或负值 | 推荐/默认: "1rem"
    "gap": "1rem",
    // 作用: 统计卡片悬停上浮距离（--stats-hoverLiftPx;单位必须随值给出）
    // 类型: string(CSS 长度) | 可填: 0–8px（0 = 不上浮） | 不可填: 裸数字（消费端不再拼接单位,将失效） | 推荐/默认: "2px"
    "hoverLiftPx": "2px",
  },

  // ---------- 面包屑（4 项） ----------
  "breadcrumb": {
    // 作用: 面包屑字号（--breadcrumb-fontSize）
    // 类型: string(CSS 长度) | 可填: 任意合法 font-size（建议 .75–.9rem） | 不可填: 负值或非法值 | 推荐/默认: ".8125rem"
    "fontSize": ".8125rem",
    // 作用: 面包屑项间距（--breadcrumb-gap）
    // 类型: string(CSS 长度) | 可填: 任意合法 gap（建议 .25–.75rem） | 不可填: 空串或负值 | 推荐/默认: ".4rem"
    "gap": ".4rem",
    // 作用: 面包屑下边距（--breadcrumb-marginBottom）
    // 类型: string(CSS 长度) | 可填: 任意合法 margin（建议 .5–2rem） | 不可填: 空串或负值 | 推荐/默认: "1rem"
    "marginBottom": "1rem",
    // 作用: 当前项字重（--breadcrumb-currentWeight）
    // 类型: string(number 字重) | 可填: 400–700（建议 600） | 不可填: 非数字（部分字体解析失败） | 推荐/默认: "600"
    "currentWeight": "600",
  },

  // ---------- 分享按钮（4 项） ----------
  "share": {
    // 作用: 分享按钮尺寸（--share-btnSize;宽=高）
    // 类型: string(CSS 长度) | 可填: 24–48px（建议 ≥ 28px 保点按） | 不可填: 负值或非法值 | 推荐/默认: "32px"
    "btnSize": "32px",
    // 作用: 分享按钮间距（--share-gap）
    // 类型: string(CSS 长度) | 可填: 任意合法 gap（建议 .2–.75rem） | 不可填: 空串或负值 | 推荐/默认: ".35rem"
    "gap": ".35rem",
    // 作用: 分享图标尺寸（--share-iconSize;宽=高）
    // 类型: string(CSS 长度) | 可填: 12–28px（建议 14–20px） | 不可填: 负值或非法值 | 推荐/默认: "16px"
    "iconSize": "16px",
    // 作用: 分享按钮圆角（--share-radius）
    // 类型: string(CSS 长度) | 可填: 任意合法 border-radius（0 = 直角;999px = 胶囊） | 不可填: 空串或负值 | 推荐/默认: ".375rem"
    "radius": ".375rem",
  },

  // ---------- 上下篇导航（5 项） ----------
  "prevNext": {
    // 作用: 上下篇导航缩略图宽度（--prevNext-thumbSize）
    // 类型: string(CSS 长度) | 可填: 40–120px（建议 56–80px） | 不可填: 负值或非法值 | 推荐/默认: "64px"
    "thumbSize": "64px",
    // 作用: 上下篇导航缩略图高度（--prevNext-thumbHeight）
    // 类型: string(CSS 长度) | 可填: 32–90px（建议 36–60px） | 不可填: 负值或非法值 | 推荐/默认: "44px"
    "thumbHeight": "44px",
    // 作用: 上下篇卡片间距（--prevNext-gap）
    // 类型: string(CSS 长度) | 可填: 任意合法 gap（建议 .5–2rem） | 不可填: 空串或负值 | 推荐/默认: "1rem"
    "gap": "1rem",
    // 作用: 上下篇区块上边距（--prevNext-marginTop）
    // 类型: string(CSS 长度) | 可填: 任意合法 margin（建议 1–4rem） | 不可填: 空串或负值 | 推荐/默认: "2rem"
    "marginTop": "2rem",
    // 作用: 上下篇标题最大行数（--prevNext-titleLines;-webkit-line-clamp 消费）
    // 类型: string(整数) | 可填: 1–4（建议 1–2） | 不可填: 0/负数或小数 | 推荐/默认: "1"
    "titleLines": "1",
  },

  // ---------- 联系弹窗（4 项） ----------
  "contactPopup": {
    // 作用: 联系弹窗图标尺寸（--contactPopup-iconSize;宽=高）
    // 类型: string(CSS 长度) | 可填: 20–64px（建议 24–36px） | 不可填: 负值或非法值 | 推荐/默认: "30px"
    "iconSize": "30px",
    // 作用: 联系弹窗圆角（--contactPopup-radius）
    // 类型: string(CSS 长度) | 可填: 任意合法 border-radius（0 = 直角） | 不可填: 空串或负值 | 推荐/默认: "1.618rem"
    "radius": "1.618rem",
    // 作用: 联系条目字号（--contactPopup-valueFontSize）
    // 类型: string(CSS 长度) | 可填: 任意合法 font-size（建议 1–1.5rem） | 不可填: 负值或非法值 | 推荐/默认: "1.25rem"
    "valueFontSize": "1.25rem",
    // 作用: 联系弹窗标题字号（--contactPopup-titleSize）
    // 类型: string(CSS 长度) | 可填: 任意合法 font-size（建议 1–1.5rem） | 不可填: 负值或非法值 | 推荐/默认: "1.25rem"
    "titleSize": "1.25rem",
  },

  // ---------- 赞赏（3 项） ----------
  "reward": {
    // 作用: 赞赏按钮字号（--reward-btnFontSize）
    // 类型: string(CSS 长度) | 可填: 任意合法 font-size（建议 .75–1rem） | 不可填: 负值或非法值 | 推荐/默认: ".8125rem"
    "btnFontSize": ".8125rem",
    // 作用: 打赏弹窗圆角（--reward-popupRadius）
    // 类型: string(CSS 长度) | 可填: 任意合法 border-radius（0 = 直角） | 不可填: 空串或负值 | 推荐/默认: "0.618rem"
    "popupRadius": "0.618rem",
    // 作用: 打赏条目间距（--reward-entryGap）
    // 类型: string(CSS 长度) | 可填: 任意合法 gap（建议 .5–1.5rem） | 不可填: 空串或负值 | 推荐/默认: ".75rem"
    "entryGap": ".75rem",
  },

  // ---------- 每日一句（5 项） ----------
  "dailyQuote": {
    // 作用: 每日一句是否显示作者（--dailyQuote-showAuthor;"true" = 显示）
    // 类型: string(布尔字面量) | 可填: "true"/"false" | 不可填: 布尔真值（按 CSS 变量消费,须带引号） | 推荐/默认: "true"
    "showAuthor": "true",
    // 作用: 引文字号（--dailyQuote-quoteFontSize）
    // 类型: string(CSS 长度) | 可填: 任意合法 font-size（建议 .85–1.15rem） | 不可填: 负值或非法值 | 推荐/默认: ".95rem"
    "quoteFontSize": ".95rem",
    // 作用: 作者字号（--dailyQuote-authorFontSize）
    // 类型: string(CSS 长度) | 可填: 任意合法 font-size（建议 .7–.95rem） | 不可填: 负值或非法值 | 推荐/默认: ".8rem"
    "authorFontSize": ".8rem",
    // 作用: 引号装饰尺寸（--dailyQuote-markSize）
    // 类型: string(CSS 长度) | 可填: 1–4rem（0 = 不显示装饰） | 不可填: 负值或非法值 | 推荐/默认: "2rem"
    "markSize": "2rem",
    // 作用: 每日一句每天自动刷新（--dailyQuote-refreshDaily;"true" = 按天换句）
    // 类型: string(布尔字面量) | 可填: "true"/"false" | 不可填: 布尔真值（按 CSS 变量消费,须带引号） | 推荐/默认: "true"
    "refreshDaily": "true",
  },

  // ---------- 标签云（5 项） ----------
  "tags": {
    // 作用: 标签云冷门标签最小字号（--tags-cloudMinSize）
    // 类型: string(CSS 长度) | 可填: 任意合法 font-size（建议 .7–.9rem;须 ≤ cloudMaxSize） | 不可填: 大于最大字号 | 推荐/默认: ".75rem"
    "cloudMinSize": ".75rem",
    // 作用: 标签云最热标签最大字号（--tags-cloudMaxSize）
    // 类型: string(CSS 长度) | 可填: 任意合法 font-size（建议 1.1–1.5rem;须 ≥ cloudMinSize） | 不可填: 小于最小字号 | 推荐/默认: "1.25rem"
    "cloudMaxSize": "1.25rem",
    // 作用: 标签云标签间距（--tags-cloudGap）
    // 类型: string(CSS 长度) | 可填: 任意合法 gap（建议 .25–1rem） | 不可填: 空串或负值 | 推荐/默认: ".5rem"
    "cloudGap": ".5rem",
    // 作用: 标签云是否显示计数（--tags-showCount;"true" = 显示）
    // 类型: string(布尔字面量) | 可填: "true"/"false" | 不可填: 布尔真值（按 CSS 变量消费,须带引号） | 推荐/默认: "true"
    "showCount": "true",
    // 作用: 标签悬停缩放倍数（--tags-hoverScale）
    // 类型: string(无单位倍数) | 可填: 1–1.15（1 = 不缩放;建议 ≤1.08） | 不可填: 0/负值或带单位值 | 推荐/默认: "1.05"
    "hoverScale": "1.05",
  },

  // ---------- 系列文章（4 项） ----------
  "series": {
    // 作用: 系列面板圆角（--series-panelRadius）
    // 类型: string(CSS 长度) | 可填: 任意合法 border-radius（0 = 直角） | 不可填: 空串或负值 | 推荐/默认: "0.618rem"
    "panelRadius": "0.618rem",
    // 作用: 系列文章进度条高度（--series-progressHeight）
    // 类型: string(CSS 长度) | 可填: 0–8px（0 = 不显示） | 不可填: 负值或非法值 | 推荐/默认: "4px"
    "progressHeight": "4px",
    // 作用: 系列徽章颜色（--series-badgeColor）
    // 类型: string(CSS 颜色) | 可填: 颜色关键字/hex/rgb()/var(--color-*) | 不可填: 空串（回退主题色） | 推荐/默认: "var(--color-s)"
    "badgeColor": "var(--color-s)",
    // 作用: 系列面板内边距（--series-panelPadding）
    // 类型: string(CSS padding 简写) | 可填: 1–4 个合法长度值（建议 .75–1.5rem） | 不可填: 空串或负值 | 推荐/默认: "1rem 1.25rem"
    "panelPadding": "1rem 1.25rem",
  },

  // ---------- 返回顶部（3 项） ----------
  "backToTop": {
    // 作用: 返回顶部按钮隐藏态下移距离（--backToTop-hiddenOffset;渐显动画起点;0 = 不位移）
    // 类型: string(CSS 长度) | 可填: 0–60px（建议 10–30px） | 不可填: 空串或负值 | 推荐/默认: "20px"
    "hiddenOffset": "20px",
    // 作用: 返回顶部按钮距底边偏移（--backToTop-offsetBottom）
    // 类型: string(CSS 长度) | 可填: 任意合法偏移（建议 1–4rem;须避开底部导航） | 不可填: 空串或负值 | 推荐/默认: "2rem"
    "offsetBottom": "2rem",
    // 作用: 返回顶部按钮距侧边偏移（--backToTop-offsetSide;features.backToTop 消费同一基准）
    // 类型: string(CSS 长度) | 可填: 任意合法偏移（建议 1–4rem） | 不可填: 空串或负值 | 推荐/默认: "2rem"
    "offsetSide": "2rem",
  },

  // ---------- 纹理（噪点，3 项） ----------
  "texture": {
    // 作用: 噪点颗粒密度（--texture-noiseBaseFrequency;SVG fractalNoise baseFrequency,越大颗粒越细）
    // 类型: string(number) | 可填: 0.3–2（建议 0.5–1.2;过大会呈现砂纸感） | 不可填: 0/负数（纹理不可见或异常） | 推荐/默认: "0.8"
    "noiseBaseFrequency": "0.8",
    // 作用: 浅色模式全局噪点透明度（--texture-noiseOpacity;0 = 关闭颗粒层）
    // 类型: string(number) | 可填: 0–1（建议 0.015–0.04;越大噪点越明显） | 不可填: 负数或 >1（CSS 无效） | 推荐/默认: "0.025"
    "noiseOpacity": "0.025",
    // 作用: 深色模式噪点透明度（--texture-noiseOpacityDark;深色下可略高以保留质感）
    // 类型: string(number) | 可填: 0–1（建议为浅色值的 1.2–1.6 倍） | 不可填: 负数或 >1 | 推荐/默认: "0.035"
    "noiseOpacityDark": "0.035",
  },

  // ---------- 光晕（2 项） ----------
  "glow": {
    // 作用: 首页 Hero 径向光晕强度（--glow-heroStrength;浅色模式,基于辅色混合;0% = 关闭）
    // 类型: string(CSS 百分比) | 可填: 0%–30%（建议 5%–15%） | 不可填: 空串或裸数字（须带 %） | 推荐/默认: "8%"
    "heroStrength": "8%",
    // 作用: 深色模式 Hero 光晕强度（--glow-heroStrengthDark;深色下可略高）
    // 类型: string(CSS 百分比) | 可填: 0%–40%（建议为浅色值的 1.2–1.8 倍） | 不可填: 空串或裸数字 | 推荐/默认: "12%"
    "heroStrengthDark": "12%",
  },

  // ---------- 代码块（12 项） ----------
  "code": {
    // 作用: 代码窗口栏三圆点直径（--code-windowDotSize;macOS 风格装饰点）
    // 类型: string(CSS 长度) | 可填: 6–16px（建议 9–13px） | 不可填: 负值或非法值 | 推荐/默认: "11px"
    "windowDotSize": "11px",
    // 作用: 代码块描边宽度（--code-borderWidth;0 = 关闭描边;token 配色见 theme.json5 codeHighlight.palette）
    // 类型: string(CSS 长度) | 可填: 0–3px（0 = 无描边） | 不可填: 负值或非法值 | 推荐/默认: "1px"
    "borderWidth": "1px",
    // 作用: 代码块描边颜色混合比例（--code-borderMix;页面边框色 × 该比例;0% = 透明）
    // 类型: string(CSS 百分比) | 可填: 0%–100%（建议 50%–80%） | 不可填: 空串或裸数字 | 推荐/默认: "65%"
    "borderMix": "65%",
    // 作用: 行号文字颜色（--code-lineNumberColor）
    // 类型: string(CSS 颜色) | 可填: 颜色关键字/hex/rgb()/var(--color-*) | 不可填: 空串（回退内置） | 推荐/默认: "var(--color-tl)"
    "lineNumberColor": "var(--color-tl)",
    // 作用: 行号不透明度（--code-lineNumberOpacity）
    // 类型: string(number) | 可填: 0–1（建议 .3–.7） | 不可填: 负数或 >1（CSS 无效） | 推荐/默认: ".5"
    "lineNumberOpacity": ".5",
    // 作用: 悬停描边中辅色占比（--code-hoverBorderMix;0% = 悬停不变色）
    // 类型: string(CSS 百分比) | 可填: 0%–100%（建议 20%–50%） | 不可填: 空串或裸数字 | 推荐/默认: "35%"
    "hoverBorderMix": "35%",
    // 作用: 悬停阴影中辅色占比（--code-hoverShadowMix;0% = 无阴影）
    // 类型: string(CSS 百分比) | 可填: 0%–100%（建议 15%–40%） | 不可填: 空串或裸数字 | 推荐/默认: "25%"
    "hoverShadowMix": "25%",
    // 作用: 悬停背景中高亮底色占比（--code-hoverBgMix;100% = 完全使用 features 的 highlightBackground）
    // 类型: string(CSS 百分比) | 可填: 0%–100%（建议 85%–100%） | 不可填: 空串或裸数字 | 推荐/默认: "92%"
    "hoverBgMix": "92%",
    // 作用: 内联代码圆角（--code-inlineRadius）
    // 类型: string(CSS 长度) | 可填: 任意合法 border-radius（0 = 直角） | 不可填: 空串或负值 | 推荐/默认: "4px"
    "inlineRadius": "4px",
    // 作用: 内联代码细描边颜色混合比例（--code-inlineHairlineMix;边框色 × 该比例;0% = 透明）
    // 类型: string(CSS 百分比) | 可填: 0%–100%（建议 50%–85%） | 不可填: 空串或裸数字 | 推荐/默认: "70%"
    "inlineHairlineMix": "70%",
    // 作用: diff 新增行背景浓度（--code-diffAddMix;随明暗自动适配色相）
    // 类型: string(CSS 百分比) | 可填: 0%–30%（0% = 无底色;建议 8%–16%） | 不可填: 空串或裸数字 | 推荐/默认: "12%"
    "diffAddMix": "12%",
    // 作用: diff 删除行背景浓度（--code-diffDelMix;随明暗自动适配色相）
    // 类型: string(CSS 百分比) | 可填: 0%–30%（0% = 无底色;建议 8%–16%） | 不可填: 空串或裸数字 | 推荐/默认: "12%"
    "diffDelMix": "12%",
  },

  // ---------- 图标（2 项） ----------
  "icons": {
    // 作用: UI 图标统一描边宽度（--icons-strokeWidth;1.5 极细/1.75 轻盈/2 标准）
    // 类型: string(number,px 由 SVG 属性消费) | 可填: 1–2.5（建议 1.5–2） | 不可填: 0/负数或带单位值 | 推荐/默认: "1.75"
    "strokeWidth": "1.75",
    // 作用: 图标悬停上移动画距离（--icons-hoverLift;0 = 关闭）
    // 类型: string(CSS 长度) | 可填: 0–4px（0 = 不位移） | 不可填: 负值或非法值 | 推荐/默认: "1px"
    "hoverLift": "1px",
  },

  // ---------- 图标变形动画（4 项） ----------
  "morphicons": {
    // 作用: 弹簧刚度（--morphicons-stiffness;morphicons 运行时消费;越大越快收尾）
    // 类型: number | 可填: 100–1200（snappy 预设 420;bouncy 200–300;smooth 500–800） | 不可填: 0/负数（无运动） | 推荐/默认: 420
    "stiffness": 420,
    // 作用: 弹簧阻尼（--morphicons-damping;越小回弹越明显）
    // 类型: number | 可填: 10–60（snappy 预设 30;smooth 40+;bouncy 15 附近） | 不可填: 0/负数 | 推荐/默认: 30
    "damping": 30,
    // 作用: 轻量版弹簧刚度（--morphicons-reducedStiffness;系统"减少动态效果"且策略 light 时使用;900 ≈ 0.15s 内收尾）
    // 类型: number | 可填: 600–1500（须 ≥ stiffness） | 不可填: 小于常规刚度（轻量版反而更慢） | 推荐/默认: 900
    "reducedStiffness": 900,
    // 作用: 轻量版弹簧阻尼（--morphicons-reducedDamping;55 ≈ 无回弹快速收尾）
    // 类型: number | 可填: 40–80（建议 50–60） | 不可填: 0/负数 | 推荐/默认: 55
    "reducedDamping": 55,
  },

  // ---------- 杂志排版（6 项） ----------
  "magazine": {
    // 作用: 首字下沉字号（--magazine-dropCapSize;3.4em 醒目;0px = 关闭）
    // 类型: string(CSS 长度) | 可填: 0 或 2–4.5em（0 = 关闭首字下沉） | 不可填: 负值或非法值 | 推荐/默认: "3.4em"
    "dropCapSize": "3.4em",
    // 作用: 首字颜色（--magazine-dropCapColor）
    // 类型: string(CSS 颜色) | 可填: 颜色关键字/hex/rgb()/var(--color-*) | 不可填: 空串（回退主题色） | 推荐/默认: "var(--color-s)"
    "dropCapColor": "var(--color-s)",
    // 作用: 首字字重（--magazine-dropCapWeight;400 常规/600 半粗/700 加重）
    // 类型: string(number 字重) | 可填: 400–700（建议 600） | 不可填: 非数字（部分字体解析失败） | 推荐/默认: "600"
    "dropCapWeight": "600",
    // 作用: 图片出血宽度（--magazine-bleedWidth;向两侧各扩展一半;0 = 关闭）
    // 类型: string(CSS 长度) | 可填: 0 或 1–6rem（建议 3–5rem） | 不可填: 负值或非法值 | 推荐/默认: "4rem"
    "bleedWidth": "4rem",
    // 作用: 表格行悬停底色混合比例（--magazine-tableHoverMix;0% = 关闭）
    // 类型: string(CSS 百分比) | 可填: 0%–20%（建议 4%–10%） | 不可填: 空串或裸数字 | 推荐/默认: "6%"
    "tableHoverMix": "6%",
    // 作用: h2 编号颜色（--magazine-headingNumberColor;默认 55% 次级文字色）
    // 类型: string(CSS 颜色) | 可填: 颜色关键字/hex/rgb()/color-mix()/var(--color-*) | 不可填: 空串（回退内置） | 推荐/默认: "color-mix(in srgb, var(--color-ts) 55%, transparent)"
    "headingNumberColor": "color-mix(in srgb, var(--color-ts) 55%, transparent)",
  },

  // ---------------------------------------------------------------------------
  // commandPalette：命令面板（Ctrl/Cmd+K）
  // ---------------------------------------------------------------------------
  "commandPalette": {
    // 作用: 命令面板宽度（--commandPalette-width;窄屏自动收缩为 min(92vw)）
    // 类型: string(CSS 长度) | 可填: 任意合法宽度（建议 480–720px） | 不可填: 空串或负值 | 推荐/默认: "560px"
    "width": "560px",
    // 作用: 命令面板结果列表最大高度（--commandPalette-listMaxHeight;与 46vh 取最小值,超出滚动）
    // 类型: string(CSS 长度) | 可填: 240–600px（建议 320–480px） | 不可填: 空串或负值 | 推荐/默认: "420px"
    "listMaxHeight": "420px",
    // 作用: 命令面板距顶部距离（--commandPalette-topOffset;12vh 更靠上,16vh 视觉重心适中）
    // 类型: string(CSS 长度) | 可填: 8–30vh（建议 12–20vh） | 不可填: 空串或负值 | 推荐/默认: "16vh"
    "topOffset": "16vh",
    // 作用: 命令面板背板混合比例（--commandPalette-backdropMix;55% = 底色混合 + 6px 模糊;越大越暗）
    // 类型: string(CSS 百分比) | 可填: 0%–95%（建议 40%–70%） | 不可填: 空串或裸数字 | 推荐/默认: "55%"
    "backdropMix": "55%",
  },

  // ---------------------------------------------------------------------------
  // announcement：公告条（顶部固定）
  // ---------------------------------------------------------------------------
  "announcement": {
    // 作用: 公告条字号（--announcement-fontSize;0.8125rem=13px 紧凑;0.875rem 更醒目）
    // 类型: string(CSS 长度) | 可填: 任意合法 font-size（建议 .75–.95rem） | 不可填: 负值或非法值 | 推荐/默认: "0.8125rem"
    "fontSize": "0.8125rem",
    // 作用: 公告条字距（--announcement-letterSpacing;0.015em 舒展;0 默认）
    // 类型: string(CSS 长度) | 可填: 0–0.05em（建议 0–0.02em） | 不可填: 空串或非法值 | 推荐/默认: "0.015em"
    "letterSpacing": "0.015em",
    // 作用: 公告条高度（--announcement-height;同时决定头部内容下移量 --annH;改大需确认双行文案不溢出）
    // 类型: string(CSS 长度) | 可填: 28–56px（建议 30–40px;须容纳行高与内边距） | 不可填: 小于行高（文字溢出） | 推荐/默认: "34px"
    "height": "34px",
  },

  // ---------------------------------------------------------------------------
  // guard：防护与交互控制（右键菜单等；guard.json5 中留空的视觉值走这里）
  // ---------------------------------------------------------------------------
  "guard": {
    // 作用: 自定义右键菜单宽度上限（--guard-menuWidth;guard.json5 style.width 可覆盖）
    // 类型: string(CSS 长度) | 可填: 160–360px（建议 200–280px） | 不可填: 空串或负值 | 推荐/默认: "232px"
    "menuWidth": "232px",
    // 作用: 右键菜单圆角（--guard-menuRadius;0 = 直角）
    // 类型: string(CSS 长度) | 可填: 任意合法 border-radius（建议 .25–1rem） | 不可填: 空串或负值 | 推荐/默认: "0.618rem"
    "menuRadius": "0.618rem",
    // 作用: 右键菜单毛玻璃模糊（--guard-menuBlur;仅 guard.json5 style.blur=true 时生效）
    // 类型: string(CSS 长度) | 可填: 0–24px（0 = 关闭模糊;建议 8–16px） | 不可填: 负值或非法值 | 推荐/默认: "10px"
    "menuBlur": "10px",
    // 作用: 右键菜单项圆角（--guard-itemRadius;0.382rem 内缩同心;0 = 直角）
    // 类型: string(CSS 长度) | 可填: 任意合法 border-radius（建议 ≤ menuRadius） | 不可填: 空串或负值 | 推荐/默认: "0.382rem"
    "itemRadius": "0.382rem",
    // 作用: 右键菜单项间距（--guard-itemGap;2px 紧凑;6px 松弛）
    // 类型: string(CSS 长度) | 可填: 0–10px（0 = 项紧贴） | 不可填: 负值或非法值 | 推荐/默认: "2px"
    "itemGap": "2px",
    // 作用: 右键菜单最大高度（--guard-menuMaxHeight;超长自动滚动;100vh 不限制）
    // 类型: string(CSS 长度) | 可填: 40–100vh（建议 60–80vh） | 不可填: 空串或负值 | 推荐/默认: "70vh"
    "menuMaxHeight": "70vh",
  },

  // ---------------------------------------------------------------------------
  // loading：加载遮罩（引导画面；防闪参数在 features.loading）
  // ---------------------------------------------------------------------------
  "loading": {
    // 作用: 加载遮罩圆点直径（--loading-dotSize;0.55rem 精致;0.75rem 醒目）
    // 类型: string(CSS 长度) | 可填: .3–1rem（建议 .45–.65rem） | 不可填: 负值或非法值 | 推荐/默认: "0.55rem"
    "dotSize": "0.55rem",
    // 作用: 加载遮罩圆点间距（--loading-dotGap）
    // 类型: string(CSS 长度) | 可填: .2–1rem（建议 .35–.6rem） | 不可填: 负值或非法值 | 推荐/默认: "0.45rem"
    "dotGap": "0.45rem",
    // 作用: 圆点跳动高度（--loading-dotLift;6px 轻盈;10px 活泼）
    // 类型: string(CSS 长度) | 可填: 0–16px（0 = 不跳动） | 不可填: 负值或非法值 | 推荐/默认: "6px"
    "dotLift": "6px",
    // 作用: 加载遮罩文案字号（--loading-textSize）
    // 类型: string(CSS 长度) | 可填: 任意合法 font-size（建议 .75–.95rem） | 不可填: 负值或非法值 | 推荐/默认: "0.8125rem"
    "textSize": "0.8125rem",
    // 作用: 遮罩底色不透明度（--loading-overlayAlpha;92% 几乎不透视;80% 更透）
    // 类型: string(CSS 百分比) | 可填: 60%–100%（建议 85%–95%） | 不可填: 空串或裸数字 | 推荐/默认: "92%"
    "overlayAlpha": "92%",
    // 作用: 遮罩毛玻璃模糊（--loading-blurPx;0 = 关闭模糊）
    // 类型: string(CSS 长度) | 可填: 0–24px（建议 4–10px） | 不可填: 负值或非法值 | 推荐/默认: "6px"
    "blurPx": "6px",
    // 作用: 单环转圈器尺寸（--loading-ringSize;features.loading.spinnerStyle='ring' 时生效）
    // 类型: string(CSS 长度) | 可填: 1–4rem（建议 1.5–2.5rem） | 不可填: 负值或非法值 | 推荐/默认: "2rem"
    "ringSize": "2rem",
    // 作用: 站点名标题字号（--loading-titleSize;features.loading.showTitle=true 时生效）
    // 类型: string(CSS 长度) | 可填: 任意合法 font-size（建议 .9–1.3rem） | 不可填: 负值或非法值 | 推荐/默认: "1rem"
    "titleSize": "1rem",
  },

  // ---------------------------------------------------------------------------
  // mobileToc：移动端目录胶囊按钮与抽屉（窄屏 ≤ mobileBreakpoint 时可见）
  // ---------------------------------------------------------------------------
  "mobileToc": {
    // 作用: 移动端目录胶囊按钮距底边偏移（--mobileToc-btnBottom;宽屏）
    // 类型: string(CSS 长度) | 可填: 任意合法偏移（建议 3–9rem） | 不可填: 空串或负值 | 推荐/默认: "6rem"
    "btnBottom": "6rem",
    // 作用: 移动端目录胶囊按钮距右边偏移（--mobileToc-btnRight;宽屏）
    // 类型: string(CSS 长度) | 可填: 任意合法偏移（建议 1–3rem） | 不可填: 空串或负值 | 推荐/默认: "2rem"
    "btnRight": "2rem",
    // 作用: 移动端目录胶囊按钮距底边偏移（--mobileToc-btnMobileBottom;≤移动端断点;需高于底部导航与返回顶部）
    // 类型: string(CSS 长度) | 可填: 任意合法偏移（建议 5–12rem） | 不可填: 小于底部导航高度（被遮挡） | 推荐/默认: "7.4rem"
    "btnMobileBottom": "7.4rem",
    // 作用: 移动端目录胶囊按钮最大宽度（--mobileToc-btnMaxWidth;与 62vw 取最小值）
    // 类型: string(CSS 长度) | 可填: 220–420px（建议 280–360px） | 不可填: 空串或负值 | 推荐/默认: "340px"
    "btnMaxWidth": "340px",
    // 作用: 胶囊内当前章节名最大宽度（--mobileToc-labelMaxWidth;超出省略号）
    // 类型: string(CSS 长度) | 可填: 任意合法宽度（建议 6–12rem） | 不可填: 空串或负值 | 推荐/默认: "9.5rem"
    "labelMaxWidth": "9.5rem",
  },

  // ---------------------------------------------------------------------------
  // ui：跨模块通用界面元素（错误页等；不属于单一组件分类）
  // ---------------------------------------------------------------------------
  "ui": {
    // 作用: 错误页插图最大宽度（--ui-errorSvgMaxWidth;SVG 自适应缩放）
    // 类型: string(CSS 长度) | 可填: 240–720px（建议 360–520px） | 不可填: 空串或负值 | 推荐/默认: "460px"
    "errorSvgMaxWidth": "460px",
    // 作用: 错误页「推荐阅读」区块最大宽度（--ui-errorSuggestMaxWidth）
    // 类型: string(CSS 长度) | 可填: 320–900px（建议 480–640px） | 不可填: 空串或负值 | 推荐/默认: "560px"
    "errorSuggestMaxWidth": "560px",
    // 作用: 错误码字号（--ui-errorCodeFontSize;单行 800 字重等宽字体）
    // 类型: string(CSS 长度) | 可填: 3–12rem（建议 5–9rem;窄屏由响应式规则收窄） | 不可填: 负值或非法值 | 推荐/默认: "7rem"
    "errorCodeFontSize": "7rem",
  },

  // ---------------------------------------------------------------------------
  // lightbox：图片灯箱（尺寸;行为开关见 features.lightbox）
  // ---------------------------------------------------------------------------
  "lightbox": {
    // 作用: 灯箱控制按钮尺寸（--lightbox-btnSize;翻页/关闭/放大/缩小/旋转/重置;宽=高）
    // 类型: string(CSS 长度) | 可填: 32–64px（建议 ≥ 40px 保点按区） | 不可填: 负值或非法值 | 推荐/默认: "44px"
    "btnSize": "44px",
    // 作用: 灯箱控制按钮贴边偏移（--lightbox-btnOffset;翻页左右、关闭上右）
    // 类型: string(CSS 长度) | 可填: 8–32px（建议 12–20px） | 不可填: 负值或非法值 | 推荐/默认: "14px"
    "btnOffset": "14px",
  },

  // ---------------------------------------------------------------------------
  // toast：统一轻提示（位置由 features.toast.position 控制）
  // ---------------------------------------------------------------------------
  "toast": {
    // 作用: 单条提示最大宽度（--toast-maxWidth;与 90vw 取最小值;过长自动换行）
    // 类型: string(CSS 长度) | 可填: 240–640px（建议 360–480px） | 不可填: 空串或负值 | 推荐/默认: "420px"
    "maxWidth": "420px",
    // 作用: 提示圆角（--toast-radius;999px = 胶囊形;0 = 直角）
    // 类型: string(CSS 长度) | 可填: 0–999px（建议 0.5rem 或 999px） | 不可填: 负值或非法值 | 推荐/默认: "999px"
    "radius": "999px",
    // 作用: 贴底位置系列提示的底部偏移（--toast-offsetBottom;features.toast.position 为 bottom-* 时生效）
    // 类型: string(CSS 长度) | 可填: 任意合法偏移（建议 1–4rem） | 不可填: 空串或负值 | 推荐/默认: "2rem"
    "offsetBottom": "2rem",
  },

  // ---------------------------------------------------------------------------
  // zIndex：全站浮层层级（30 项）
  // 作用：统一管理各浮层与固定元素的 z-index，避免组件间层级冲突；
  //       构建时注入为 CSS 变量 --zIndex-{键}，模板以 var(--zIndex-键, 原值) 消费。
  // 调整建议：仅需高于/低于相邻浮层时微调；保持"内容 < 导航 < 弹层 < 遮罩类工具"的大序。
  // ---------------------------------------------------------------------------
  "zIndex": {
    // 作用: 站点顶部导航栏（滚动吸顶）
    // 类型: string(整数,z-index) | 可填: 0–99999（越大越靠前;须与相邻浮层保持相对序） | 不可填: 负数（部分浏览器忽略） | 推荐/默认: "1000"
    "header": "1000",
    // 作用: 移动端展开的主导航抽屉（低于 header 以免盖住顶栏）
    // 类型: string(整数,z-index) | 可填: 0–99999 | 不可填: 负数 | 推荐/默认: "999"
    "mobileNav": "999",
    // 作用: 顶部公告条（低于 header,随 header 一起固定）
    // 类型: string(整数,z-index) | 可填: 0–99999 | 不可填: 负数 | 推荐/默认: "999"
    "announcement": "999",
    // 作用: 移动端底部导航条
    // 类型: string(整数,z-index) | 可填: 0–99999 | 不可填: 负数 | 推荐/默认: "1200"
    "mobileBottomNav": "1200",
    // 作用: 阅读工具栏（进度环 + 回到目录）
    // 类型: string(整数,z-index) | 可填: 0–99999 | 不可填: 负数 | 推荐/默认: "990"
    "readingDock": "990",
    // 作用: 阅读面板设置齿轮按钮
    // 类型: string(整数,z-index) | 可填: 0–99999 | 不可填: 负数 | 推荐/默认: "998"
    "readingGear": "998",
    // 作用: 阅读面板弹层（字号/行高/宽幅）
    // 类型: string(整数,z-index) | 可填: 0–99999 | 不可填: 负数 | 推荐/默认: "1500"
    "readerPanel": "1500",
    // 作用: 移动端文章目录按钮
    // 类型: string(整数,z-index) | 可填: 0–99999 | 不可填: 负数 | 推荐/默认: "999"
    "mobileToc": "999",
    // 作用: 移动端目录底部抽屉
    // 类型: string(整数,z-index) | 可填: 0–99999 | 不可填: 负数 | 推荐/默认: "1500"
    "mobileTocDrawer": "1500",
    // 作用: 键盘快捷键帮助浮窗
    // 类型: string(整数,z-index) | 可填: 0–99999 | 不可填: 负数 | 推荐/默认: "1500"
    "kbdHelp": "1500",
    // 作用: 站内搜索遮罩层
    // 类型: string(整数,z-index) | 可填: 0–99999 | 不可填: 负数 | 推荐/默认: "2000"
    "searchOverlay": "2000",
    // 作用: 顶部"页面加速设置"下拉面板
    // 类型: string(整数,z-index) | 可填: 0–99999 | 不可填: 负数 | 推荐/默认: "1200"
    "navBoostPanel": "1200",
    // 作用: 主题预设选择弹层
    // 类型: string(整数,z-index) | 可填: 0–99999 | 不可填: 负数 | 推荐/默认: "1600"
    "presetPop": "1600",
    // 作用: 统一 toast 通知容器
    // 类型: string(整数,z-index) | 可填: 0–99999 | 不可填: 负数 | 推荐/默认: "1200"
    "toast": "1200",
    // 作用: 阅读进度条
    // 类型: string(整数,z-index) | 可填: 0–99999 | 不可填: 负数 | 推荐/默认: "1100"
    "scrollIndicator": "1100",
    // 作用: 阅读进度条的刻度提示气泡（需高于几乎所有内容）
    // 类型: string(整数,z-index) | 可填: 0–99999 | 不可填: 负数 | 推荐/默认: "10000"
    "readingTip": "10000",
    // 作用: 灯箱查看器
    // 类型: string(整数,z-index) | 可填: 0–99999 | 不可填: 负数 | 推荐/默认: "2000"
    "lightbox": "2000",
    // 作用: 赞赏/打赏弹层
    // 类型: string(整数,z-index) | 可填: 0–99999 | 不可填: 负数 | 推荐/默认: "1900"
    "reward": "1900",
    // 作用: 外链跳转安全提醒遮罩
    // 类型: string(整数,z-index) | 可填: 0–99999 | 不可填: 负数 | 推荐/默认: "3000"
    "linkWarning": "3000",
    // 作用: 联系方式复制弹窗遮罩
    // 类型: string(整数,z-index) | 可填: 0–99999 | 不可填: 负数 | 推荐/默认: "4000"
    "contactPopup": "4000",
    // 作用: PWA「安装到桌面」悬浮按钮
    // 类型: string(整数,z-index) | 可填: 0–99999 | 不可填: 负数 | 推荐/默认: "1050"
    "pwaInstall": "1050",
    // 作用: 软导航进行中的顶部脉冲条
    // 类型: string(整数,z-index) | 可填: 0–99999 | 不可填: 负数 | 推荐/默认: "2000"
    "softnavBusy": "2000",
    // 作用: 全局颗粒纹理覆盖层（纯装饰,位于内容之上）
    // 类型: string(整数,z-index) | 可填: 0–99999 | 不可填: 负数 | 推荐/默认: "2000"
    "grain": "2000",
    // 作用: guard 自定义右键菜单
    // 类型: string(整数,z-index) | 可填: 0–99999 | 不可填: 负数 | 推荐/默认: "1900"
    "guardMenu": "1900",
    // 作用: guard 复制/篡改告警闪烁边框
    // 类型: string(整数,z-index) | 可填: 0–99999 | 不可填: 负数 | 推荐/默认: "1890"
    "guardFlash": "1890",
    // 作用: guard 隐私幕布遮罩
    // 类型: string(整数,z-index) | 可填: 0–99999 | 不可填: 负数 | 推荐/默认: "1880"
    "guardCurtain": "1880",
    // 作用: guard 开发者工具锁定遮罩
    // 类型: string(整数,z-index) | 可填: 0–99999 | 不可填: 负数 | 推荐/默认: "1895"
    "guardLock": "1895",
    // 作用: guard 访问门（密码/准入）遮罩
    // 类型: string(整数,z-index) | 可填: 0–99999 | 不可填: 负数 | 推荐/默认: "1898"
    "guardGate": "1898",
    // 作用: guard 水印在灯箱之上的层级
    // 类型: string(整数,z-index) | 可填: 0–99999 | 不可填: 负数 | 推荐/默认: "1700"
    "guardWmOverLightbox": "1700",
    // 作用: 弹窗公告（popupNotice）遮罩
    // 类型: string(整数,z-index) | 可填: 0–99999 | 不可填: 负数 | 推荐/默认: "2100"
    "popupNotice": "2100",
  },

}
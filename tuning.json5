{
  // ==================== S-ynapse UI 精细调节（tuning.json5） ====================
  // 说明: 每个参数对应一个 UI 数值，构建时注入为 CSS 变量（--{分类}-{参数}）。
  //       修改后重新构建生效；变量可在浏览器 DevTools 或 customCSS 中覆盖。
  //       所有数值均为默认值，删除某项即回退到模板内置 fallback。

  // ---------- 排版系统（18 项） ----------
  "typography": {
    // 正文字号
    "bodySize": "1.0625rem",
    // 一级标题字号（黄金 φ²）
    "h1Size": "2.058em",
    // 二级标题字号（黄金 φ）
    "h2Size": "1.618em",
    // 三级标题字号（黄金 √φ）
    "h3Size": "1.272em",
    // 四级标题字号
    "h4Size": "1em",
    // 五级标题字号
    "h5Size": ".875em",
    // 六级标题字号
    "h6Size": ".8125em",
    // 小号文字（辅助信息）
    "smallSize": ".875em",
    // 极小文字（标签/日期）
    "tinySize": ".75em",
    // 正文行高
    "lineHeight": "1.8",
    // 标题行高
    "headingLineHeight": "1.3",
    // 字间距
    "letterSpacing": "0.02em",
    // 标题字重
    "headingWeight": "700",
    // 代码字号
    "monoSize": ".875em",
    // 引用块字号
    "quoteSize": "1.05em",
    // 图注字号
    "captionSize": ".8125rem",
    // 元信息字号
    "metaSize": ".875rem",
    // 导语字号（黄金 √φ）（待实现：导语段落样式暂无目标）
    "leadSize": "1.272em",
  },

  // ---------- 布局系统（12 项） ----------
  "layout": {
    // 内容区最大宽度
    "containerWidth": "1250px",
    // 左侧目录宽度
    "tocWidth": "200px",
    // 模块间距（黄金 φ）
    "gap": "1.618rem",
    // 页面内边距（黄金 φ²）
    "padding": "2.618rem",
    // 内容区水平偏移
    "contentOffset": "-10px",
    // 标题与内容区间距
    "headerContentGap": "48px",
    // 目录离屏幕左缘最小距离
    "tocMinLeft": "10px",
    // 侧栏离屏幕右缘最小距离
    "sidebarMinRight": "10px",
    // 移动端断点
    "mobileBreakpoint": "768px",
    // 目录隐藏断点
    "tocHideBreakpoint": "900px",
    // 平板断点
    "tabletBreakpoint": "1024px",
    // 超宽屏内容上限
    "maxContentWidth": "1600px",
  },

  // ---------- 圆角系统（7 项） ----------
  "radius": {
    // 默认圆角（黄金）
    "default": "0.618rem",
    // 大圆角（黄金 φ）
    "large": "1.618rem",
    // 按钮圆角
    "button": "0.382rem",
    // 图片圆角
    "image": "0.618rem",
    // 头像圆角
    "avatar": "50%",
    // 徽章圆角
    "badge": "1rem",
    // 输入框圆角
    "input": "0.382rem",
  },

  // ---------- 动效系统（11 项） ----------
  "motion": {
    // 卡片悬停上浮距离（px）
    "hoverLiftPx": "4",
    // 卡片悬停缩放
    "hoverScale": "1.02",
    // 链接下划线粗细
    "underlineThickness": "2px",
    // 链接下划线偏移
    "underlineOffset": "3px",
    // 按钮波纹时长
    "rippleDurationMs": "500",
    // 滚动渐入时长
    "revealDurationMs": "250",
    // 滚动渐入位移
    "revealOffset": "10px",
    // 渐入错峰延迟
    "staggerDelayMs": "60",
    // 按钮按压缩放
    "buttonPressScale": "0.97",
    // 通用过渡时长
    "transitionDuration": "0.3s",
    // 通用过渡缓动曲线（弹簧感，out 型）
    "transitionTiming": "cubic-bezier(0.22, 1, 0.36, 1)",
  },

  // ---------- 首屏 Hero（9 项） ----------
  "hero": {
    // Hero 标题字号（黄金 φ²）
    "titleSize": "2.618em",
    // Hero 副标题字号
    "subSize": "1.05em",
    // Hero 内容最大宽度
    "maxWidth": "760px",
    // 操作区间距
    "actionsGap": ".75rem",
    // 标签区间距
    "tagGap": ".5rem",
    // CTA 按钮圆角
    "ctaRadius": "0.382rem",
    // 顶部内边距
    "paddingTop": "1rem",
    // 底部内边距
    "paddingBottom": "2rem",
    // 日期字号
    "dateSize": ".9375rem",
  },

  // ---------- 文章卡片（10 项） ----------
  "card": {
    // 封面图宽高比（≈φ）
    "imageAspect": "16/10",
    // 卡片圆角
    "radius": "0.618rem",
    // 文章容器内边距
    "padding": "1.5rem",
    // 卡片标题字号
    "titleSize": "1.272rem",
    // 摘要最大行数
    "excerptLines": "3",
    // 元信息字号
    "metaSize": ".8125rem",
    // 无封面占位字号下限
    "nocoverMinSize": "1.272rem",
    // 无封面占位字号上限
    "nocoverMaxSize": "1.618rem",
    // 卡片栅格间距
    "gridGap": "1.618rem",
    // 封面图悬停缩放（1 = 不缩放）
    "imageHoverScale": "1.02",
  },

  // ---------- 目录侧栏（9 项） ----------
  "toc": {
    // 目录正文字号
    "fontSize": ".8125rem",
    // 目录标题字号
    "labelSize": ".6875rem",
    // 二级缩进
    "indentL2": ".5rem",
    // 三级缩进
    "indentL3": "1.2rem",
    // 四级缩进
    "indentL4": "1.9rem",
    // 进度线高度
    "progressHeight": "3px",
    // 吸顶偏移
    "stickyTop": "80px",
    // 滚动高亮偏移
    "scrollOffset": "80",
    // 默认折叠
    "collapsedByDefault": "false",
  },

  // ---------- 搜索弹层（10 项） ----------
  "search": {
    // 弹层宽度
    "modalWidth": "760px",
    // 输入框高度
    "inputHeight": "56px",
    // 输入字号
    "inputFontSize": "1.375rem",
    // 历史记录条数
    "historyCount": "5",
    // 热门搜索条数
    "hotCount": "5",
    // 输入防抖（ms）
    "debounceMs": "120",
    // 最小查询长度
    "minQueryLength": "1",
    // 结果摘要长度
    "excerptLength": "120",
    // 结果最大条数
    "resultLimit": "30",
    // 空结果文案
    "emptyText": "未找到匹配内容",
  },

  // ---------- 阅读体验（12 项） ----------
  "reading": {
    // 阅读进度条高度
    "progressHeight": "3px",
    // 阅读坞底部偏移
    "dockBottom": "5.6rem",
    // TTS 语速
    "ttsRate": "1",
    // TTS 音调
    "ttsPitch": "1",
    // 字号调节步长
    "fontSizeStep": "1",
    // 行高调节步长
    "lineHeightStep": "0.1",
    // 阅读模式最大宽度
    "readingMaxWidth": "72ch",
    // 引用块主色底纹强度（0% = 无底纹）
    "quoteTint": "6%",
    // 正文图片悬停缩放（1 = 不缩放）
    "imageHoverScale": "1.01",
    // h2 前置短竖线宽度
    "h2AccentWidth": ".25rem",
    // h2 前置短竖线高度
    "h2AccentHeight": "1em",
    // h2 前置短竖线颜色
    "h2AccentColor": "var(--color-s)",
  },

  // ---------- 评论区（5 项） ----------
  "comments": {
    // 头像尺寸（待实现：评论为第三方 iframe (giscus)，内部样式无法注入）
    "avatarSize": "40px",
    // 区域上边距
    "marginTop": "2rem",
    // 区域宽度（待实现：评论容器样式预留）
    "width": "100%",
    // 区域圆角（待实现：评论为第三方 iframe (giscus)，内部样式无法注入）
    "borderRadius": "0.618rem",
    // 显示分隔线（待实现：评论为第三方 iframe (giscus)，内部样式无法注入）
    "dividerShow": "true",
  },

  // ---------- 导航栏（7 项） ----------
  "header": {
    // 导航栏高度
    "height": "60px",
    // Logo 字号
    "logoSize": "1.272em",
    // 图标尺寸
    "iconSize": "18px",
    // 滚动收缩后高度（滚动超过 scrollThresholdPx 时收缩到该高度）
    "scrolledHeight": "56px",
    // 是否启用滚动收缩效果（true = 启用，false = 关闭）
    "scrollShrink": true,
    // 触发收缩的滚动距离（px）
    "scrollThresholdPx": "8",
    // 顶栏底部渐变发丝线强度（基于辅色的混合比例，0% = 关闭）
    "hairlineStrength": "30%",
  },

  // ---------- 分页（4 项） ----------
  "pagination": {
    // 最大可见页数（待实现：分页窗口省略逻辑需实现）
    "maxVisible": "5",
    // 按钮间距
    "gap": ".5rem",
    // 当前页缩放
    "activeScale": "1.05",
    // 按钮圆角
    "radius": "0.618rem",
  },

  // ---------- 统计卡片（5 项） ----------
  "stats": {
    // 数值字号
    "numberSize": "1.5rem",
    // 标签字号
    "labelSize": ".8125rem",
    // 卡片内边距
    "cardPadding": "1rem 1.25rem",
    // 卡片间距
    "gap": "1rem",
    // 悬停上浮（px，需带单位）
    "hoverLiftPx": "2px",
  },

  // ---------- 面包屑（4 项） ----------
  "breadcrumb": {
    // 字号
    "fontSize": ".8125rem",
    // 项间距
    "gap": ".4rem",
    // 下边距
    "marginBottom": "1rem",
    // 当前项字重
    "currentWeight": "600",
  },

  // ---------- 分享按钮（4 项） ----------
  "share": {
    // 按钮尺寸
    "btnSize": "32px",
    // 按钮间距
    "gap": ".35rem",
    // 图标尺寸
    "iconSize": "16px",
    // 按钮圆角
    "radius": ".375rem",
  },

  // ---------- 上下篇导航（5 项） ----------
  "prevNext": {
    // 缩略图宽
    "thumbSize": "64px",
    // 缩略图高
    "thumbHeight": "44px",
    // 间距
    "gap": "1rem",
    // 上边距
    "marginTop": "2rem",
    // 标题最大行数
    "titleLines": "1",
  },

  // ---------- 联系弹窗（4 项） ----------
  "contactPopup": {
    // 图标尺寸
    "iconSize": "30px",
    // 圆角
    "radius": "1.618rem",
    // 条目字号
    "valueFontSize": "1.25rem",
    // 标题字号
    "titleSize": "1.25rem",
  },

  // ---------- 赞赏（3 项） ----------
  "reward": {
    // 按钮字号
    "btnFontSize": ".8125rem",
    // 弹窗圆角（待实现：红包弹窗样式需实现）
    "popupRadius": "0.618rem",
    // 条目间距
    "entryGap": ".75rem",
  },

  // ---------- 每日一句（5 项） ----------
  "dailyQuote": {
    // 显示作者
    "showAuthor": "true",
    // 引文字号
    "quoteFontSize": ".95rem",
    // 作者字号
    "authorFontSize": ".8rem",
    // 引号装饰尺寸
    "markSize": "2rem",
    // 每日刷新
    "refreshDaily": "true",
  },

  // ---------- 标签云（5 项） ----------
  "tags": {
    // 最小字号（待实现：标签云字号梯度需按热度算法实现）
    "cloudMinSize": ".75rem",
    // 最大字号（待实现：标签云字号梯度需按热度算法实现）
    "cloudMaxSize": "1.25rem",
    // 标签间距
    "cloudGap": ".5rem",
    // 显示计数
    "showCount": "true",
    // 悬停缩放
    "hoverScale": "1.05",
  },

  // ---------- 系列文章（4 项） ----------
  "series": {
    // 面板圆角
    "panelRadius": "0.618rem",
    // 进度条高度（待实现：系列进度条元素需实现）
    "progressHeight": "4px",
    // 徽章颜色
    "badgeColor": "var(--color-s)",
    // 面板内边距
    "panelPadding": "1rem 1.25rem",
  },

  // ---------- 返回顶部（2 项） ----------
  "backToTop": {
    // 底部偏移
    "offsetBottom": "2rem",
    // 侧边偏移
    "offsetSide": "2rem",
  },

  // ---------- 纹理（噪点，2 项） ----------
  "texture": {
    // 噪点颗粒密度（fractalNoise baseFrequency，越大颗粒越细；建议 0.5 ~ 1.2）
    "noiseBaseFrequency": "0.8",
    // 全局噪点纹理透明度（浅色模式，0 = 关闭；建议 0.015 ~ 0.04）
    "noiseOpacity": "0.025",
    // 深色模式噪点透明度（深色下可略高以保留质感）
    "noiseOpacityDark": "0.035",
  },

  // ---------- 光晕（2 项） ----------
  "glow": {
    // 首页 Hero 径向光晕强度（浅色模式，基于辅色混合；0% = 关闭）
    "heroStrength": "8%",
    // 深色模式光晕强度（深色下可略高）
    "heroStrengthDark": "12%",
  },

  // ---------- 代码块（2 项） ----------
  "code": {
    // 代码块描边宽度（0 = 关闭；token 配色见 theme.json 的 codeHighlight.palette）
    "borderWidth": "1px",
    // 代码块描边颜色 = 页面边框色 × 此比例（0% = 透明）
    "borderMix": "65%",
  },

}
{
  // ==================== S-ynapse UI 精细调节（tuning.json5） ====================
  // 作用     : UI 数值集中层;每个参数对应一个数值,构建时注入为 CSS 变量
  //            （--{分类}-{参数},如 --typography-h1Size）。
  // 生效方式 : ① CSS 变量由模板 var(--…) 消费并带回退;
  //            ② 行为参数由 window.__TUNING__ 供 JS 运行时优先读取
  //            （搜索/目录/TTS/阅读面板/每日一言等,缺省回退 features 同名值）。
  // 覆盖链   : 本文件 > 模板/模块内置 fallback;与 features 重叠的键以本文件优先。
  // 编写规范 : 值型参数用 CSS 长度/颜色;行为参数用数字/字符串/布尔;
  //            删除某项即回退内置值;修改后需重新构建。
  // 注意     : 所有参数均有消费点;字符串/布尔型行为参数以引号书写。
  // =============================================================================

  // ---------- 排版系统（18 项） ----------
  "typography": {
    // 正文字号
    "bodySize": "1.0625rem",
    // 一级标题字号（黄金 φ²）
    "h1Size": "2.058em",
    // 二级标题字号（黄金 φ）
    "h2Size": "1.618em",
    // 三级标题字号（黄金 √φ）
    "h3Size": "1.272em",
    // 四级标题字号
    "h4Size": "1em",
    // 五级标题字号
    "h5Size": ".875em",
    // 六级标题字号
    "h6Size": ".8125em",
    // 小号文字（辅助信息）
    "smallSize": ".875em",
    // 极小文字（标签/日期）
    "tinySize": ".75em",
    // 正文行高
    "lineHeight": "1.8",
    // 标题行高
    "headingLineHeight": "1.3",
    // 字间距
    "letterSpacing": "0.02em",
    // 标题字重
    "headingWeight": "700",
    // 代码字号
    "monoSize": ".875em",
    // 引用块字号
    "quoteSize": "1.05em",
    // 图注字号
    "captionSize": ".8125rem",
    // 元信息字号
    "metaSize": ".875rem",
    // 导语字号（黄金 √φ；应用于文章首个段落）
    "leadSize": "1.272em",
  },

  // ---------- 布局系统（12 项） ----------
  "layout": {
    // 内容区最大宽度
    "containerWidth": "1250px",
    // 左侧目录宽度
    "tocWidth": "200px",
    // 模块间距（黄金 φ）
    "gap": "1.618rem",
    // 页面内边距（黄金 φ²）
    "padding": "2.618rem",
    // 内容区水平偏移
    "contentOffset": "-10px",
    // 标题与内容区间距
    "headerContentGap": "48px",
    // 目录离屏幕左缘最小距离
    "tocMinLeft": "10px",
    // 侧栏离屏幕右缘最小距离
    "sidebarMinRight": "10px",
    // 移动端断点
    "mobileBreakpoint": "768px",
    // 目录隐藏断点
    "tocHideBreakpoint": "900px",
    // 平板断点
    "tabletBreakpoint": "1024px",
    // 超宽屏内容上限
    "maxContentWidth": "1600px",
  },

  // ---------- 圆角系统（7 项） ----------
  "radius": {
    // 默认圆角（黄金）
    "default": "0.618rem",
    // 大圆角（黄金 φ）
    "large": "1.618rem",
    // 按钮圆角
    "button": "0.382rem",
    // 图片圆角
    "image": "0.618rem",
    // 头像圆角
    "avatar": "50%",
    // 徽章圆角
    "badge": "1rem",
    // 输入框圆角
    "input": "0.382rem",
  },

  // ---------- 动效系统（11 项） ----------
  "motion": {
    // 卡片悬停上浮距离（px）
    "hoverLiftPx": "4",
    // 卡片悬停缩放
    "hoverScale": "1.02",
    // 链接下划线粗细
    "underlineThickness": "2px",
    // 链接下划线偏移
    "underlineOffset": "3px",
    // 按钮波纹时长
    "rippleDurationMs": "500",
    // 滚动渐入时长
    "revealDurationMs": "250",
    // 滚动渐入位移
    "revealOffset": "10px",
    // 渐入错峰延迟
    "staggerDelayMs": "60",
    // 按钮按压缩放
    "buttonPressScale": "0.97",
    // 通用过渡时长
    "transitionDuration": "0.3s",
    // 通用过渡缓动曲线（弹簧感，out 型）
    "transitionTiming": "cubic-bezier(0.22, 1, 0.36, 1)",
  },

  // ---------- 首屏 Hero（9 项） ----------
  "hero": {
    // Hero 标题字号（黄金 φ²）
    "titleSize": "2.618em",
    // Hero 副标题字号
    "subSize": "1.05em",
    // Hero 内容最大宽度
    "maxWidth": "760px",
    // 操作区间距
    "actionsGap": ".75rem",
    // 标签区间距
    "tagGap": ".5rem",
    // CTA 按钮圆角
    "ctaRadius": "0.382rem",
    // 顶部内边距
    "paddingTop": "1rem",
    // 底部内边距
    "paddingBottom": "2rem",
    // 日期字号
    "dateSize": ".9375rem",
  },

  // ---------- 文章卡片（10 项） ----------
  "card": {
    // 封面图宽高比（≈φ）
    "imageAspect": "16/10",
    // 卡片圆角
    "radius": "0.618rem",
    // 文章容器内边距
    "padding": "1.5rem",
    // 卡片标题字号
    "titleSize": "1.272rem",
    // 摘要最大行数
    "excerptLines": "3",
    // 元信息字号
    "metaSize": ".8125rem",
    // 无封面占位字号下限
    "nocoverMinSize": "1.272rem",
    // 无封面占位字号上限
    "nocoverMaxSize": "1.618rem",
    // 卡片栅格间距
    "gridGap": "1.618rem",
    // 封面图悬停缩放（1 = 不缩放）
    "imageHoverScale": "1.02",
    // 首页首篇大卡（Bento 布局；false = 全部等宽卡片）
    "bentoFeatured": true,
    // 首篇大卡封面宽高比
    "bentoAspect": "21/10",
  },

  // ---------- 目录侧栏（9 项） ----------
  "toc": {
    // 目录正文字号
    "fontSize": ".8125rem",
    // 目录标题字号
    "labelSize": ".6875rem",
    // 二级缩进
    "indentL2": ".5rem",
    // 三级缩进
    "indentL3": "1.2rem",
    // 四级缩进
    "indentL4": "1.9rem",
    // 进度线高度
    "progressHeight": "3px",
    // 吸顶偏移
    "stickyTop": "80px",
    // 滚动高亮偏移
    "scrollOffset": "80",
    // 默认折叠
    "collapsedByDefault": "false",
  },

  // ---------- 搜索弹层（10 项） ----------
  "search": {
    // 弹层宽度
    "modalWidth": "760px",
    // 输入框高度
    "inputHeight": "56px",
    // 输入字号
    "inputFontSize": "1.375rem",
    // 历史记录条数
    "historyCount": "5",
    // 热门搜索条数
    "hotCount": "5",
    // 输入防抖（ms）
    "debounceMs": "120",
    // 最小查询长度
    "minQueryLength": "1",
    // 结果摘要长度
    "excerptLength": "120",
    // 结果最大条数
    "resultLimit": "30",
    // 空结果文案（中文）
    "emptyText": "未找到匹配内容",
    // 空结果文案（英文;en 站使用,空 = 回退中文）
    "emptyTextEn": "No matching content",
  },

  // ---------- 阅读体验（12 项） ----------
  "reading": {
    // 阅读进度条高度
    "progressHeight": "3px",
    // 阅读坞底部偏移
    "dockBottom": "5.6rem",
    // TTS 语速
    "ttsRate": "1",
    // TTS 音调
    "ttsPitch": "1",
    // 字号调节步长
    "fontSizeStep": "1",
    // 行高调节步长
    "lineHeightStep": "0.1",
    // 阅读模式最大宽度
    "readingMaxWidth": "72ch",
    // 引用块主色底纹强度（0% = 无底纹）
    "quoteTint": "6%",
    // 正文图片悬停缩放（1 = 不缩放）
    "imageHoverScale": "1.01",
    // h2 前置短竖线宽度
    "h2AccentWidth": ".25rem",
    // h2 前置短竖线高度
    "h2AccentHeight": "1em",
    // h2 前置短竖线颜色
    "h2AccentColor": "var(--color-s)",
  },

  // ---------- 评论区（5 项） ----------
  "comments": {
    // 头像尺寸（评论区标记头像）
    "avatarSize": "40px",
    // 区域上边距
    "marginTop": "2rem",
    // 区域宽度（评论区最大宽度，居中）
    "width": "100%",
    // 区域圆角（评论 iframe 外框圆角）
    "borderRadius": "0.618rem",
    // 显示分隔线（评论区顶部细分隔线；"false" 关闭）
    "dividerShow": "true",
  },

  // ---------- 导航栏（7 项） ----------
  "header": {
    // 导航栏高度
    "height": "60px",
    // Logo 字号
    "logoSize": "1.272em",
    // 图标尺寸
    "iconSize": "18px",
    // 滚动收缩后高度（滚动超过 scrollThresholdPx 时收缩到该高度）
    "scrolledHeight": "56px",
    // 是否启用滚动收缩效果（true = 启用，false = 关闭）
    "scrollShrink": true,
    // 触发收缩的滚动距离（px）
    "scrollThresholdPx": "8",
    // 顶栏底部渐变发丝线强度（基于辅色的混合比例，0% = 关闭）
    "hairlineStrength": "30%",
  },

  // ---------- 分页（4 项） ----------
  "pagination": {
    // 最大可见页数（超出显示省略号；下限 3）
    "maxVisible": "5",
    // 按钮间距
    "gap": ".5rem",
    // 当前页缩放
    "activeScale": "1.05",
    // 按钮圆角
    "radius": "0.618rem",
  },

  // ---------- 统计卡片（5 项） ----------
  "stats": {
    // 数值字号
    "numberSize": "1.5rem",
    // 标签字号
    "labelSize": ".8125rem",
    // 卡片内边距
    "cardPadding": "1rem 1.25rem",
    // 卡片间距
    "gap": "1rem",
    // 悬停上浮（px，需带单位）
    "hoverLiftPx": "2px",
  },

  // ---------- 面包屑（4 项） ----------
  "breadcrumb": {
    // 字号
    "fontSize": ".8125rem",
    // 项间距
    "gap": ".4rem",
    // 下边距
    "marginBottom": "1rem",
    // 当前项字重
    "currentWeight": "600",
  },

  // ---------- 分享按钮（4 项） ----------
  "share": {
    // 按钮尺寸
    "btnSize": "32px",
    // 按钮间距
    "gap": ".35rem",
    // 图标尺寸
    "iconSize": "16px",
    // 按钮圆角
    "radius": ".375rem",
  },

  // ---------- 上下篇导航（5 项） ----------
  "prevNext": {
    // 缩略图宽
    "thumbSize": "64px",
    // 缩略图高
    "thumbHeight": "44px",
    // 间距
    "gap": "1rem",
    // 上边距
    "marginTop": "2rem",
    // 标题最大行数
    "titleLines": "1",
  },

  // ---------- 联系弹窗（4 项） ----------
  "contactPopup": {
    // 图标尺寸
    "iconSize": "30px",
    // 圆角
    "radius": "1.618rem",
    // 条目字号
    "valueFontSize": "1.25rem",
    // 标题字号
    "titleSize": "1.25rem",
  },

  // ---------- 赞赏（3 项） ----------
  "reward": {
    // 按钮字号
    "btnFontSize": ".8125rem",
    // 弹窗圆角（打赏弹窗）
    "popupRadius": "0.618rem",
    // 条目间距
    "entryGap": ".75rem",
  },

  // ---------- 每日一句（5 项） ----------
  "dailyQuote": {
    // 显示作者
    "showAuthor": "true",
    // 引文字号
    "quoteFontSize": ".95rem",
    // 作者字号
    "authorFontSize": ".8rem",
    // 引号装饰尺寸
    "markSize": "2rem",
    // 每日刷新
    "refreshDaily": "true",
  },

  // ---------- 标签云（5 项） ----------
  "tags": {
    // 最小字号（标签云冷门标签）
    "cloudMinSize": ".75rem",
    // 最大字号（标签云最热标签）
    "cloudMaxSize": "1.25rem",
    // 标签间距
    "cloudGap": ".5rem",
    // 显示计数
    "showCount": "true",
    // 悬停缩放
    "hoverScale": "1.05",
  },

  // ---------- 系列文章（4 项） ----------
  "series": {
    // 面板圆角
    "panelRadius": "0.618rem",
    // 进度条高度（系列文章进度条）
    "progressHeight": "4px",
    // 徽章颜色
    "badgeColor": "var(--color-s)",
    // 面板内边距
    "panelPadding": "1rem 1.25rem",
  },

  // ---------- 返回顶部（2 项） ----------
  "backToTop": {
    // 底部偏移
    "offsetBottom": "2rem",
    // 侧边偏移
    "offsetSide": "2rem",
  },

  // ---------- 纹理（噪点，2 项） ----------
  "texture": {
    // 噪点颗粒密度（fractalNoise baseFrequency，越大颗粒越细；建议 0.5 ~ 1.2）
    "noiseBaseFrequency": "0.8",
    // 全局噪点纹理透明度（浅色模式，0 = 关闭；建议 0.015 ~ 0.04）
    "noiseOpacity": "0.025",
    // 深色模式噪点透明度（深色下可略高以保留质感）
    "noiseOpacityDark": "0.035",
  },

  // ---------- 光晕（2 项） ----------
  "glow": {
    // 首页 Hero 径向光晕强度（浅色模式，基于辅色混合；0% = 关闭）
    "heroStrength": "8%",
    // 深色模式光晕强度（深色下可略高）
    "heroStrengthDark": "12%",
  },

  // ---------- 代码块（11 项） ----------
  "code": {
    // 代码块描边宽度（0 = 关闭；token 配色见 theme.json5 的 codeHighlight.palette）
    "borderWidth": "1px",
    // 代码块描边颜色 = 页面边框色 × 此比例（0% = 透明）
    "borderMix": "65%",
    // 行号文字颜色
    "lineNumberColor": "var(--color-tl)",
    // 行号不透明度（0~1）
    "lineNumberOpacity": ".5",
    // 悬停描边中辅色占比（0% = 不变色）
    "hoverBorderMix": "35%",
    // 悬停阴影中辅色占比（0% = 无阴影）
    "hoverShadowMix": "25%",
    // 悬停背景中高亮底色占比（100% = 完全使用 highlightBackground）
    "hoverBgMix": "92%",
    // 内联代码圆角
    "inlineRadius": "4px",
    // 内联代码细描边颜色 = 边框色 × 此比例（0% = 透明）
    "inlineHairlineMix": "70%",
    // diff 新增行背景浓度（随明暗自动适配色相）
    "diffAddMix": "12%",
    // diff 删除行背景浓度
    "diffDelMix": "12%",
  },

  // ---------- 图标（2 项） ----------
  "icons": {
    // 统一描边宽度（UI 图标;1.75 轻盈精致,2 为标准,1.5 极细）
    "strokeWidth": "1.75",
    // 悬停上移动画距离（0px = 关闭）
    "hoverLift": "1px",
  },

  // ---------- 图标变形动画（4 项） ----------
  "morphicons": {
    // 弹簧刚度（越大越快速；420 为 snappy 预设值）
    "stiffness": 420,
    // 弹簧阻尼（越小回弹越明显；30 为 snappy 预设值）
    "damping": 30,
    // 轻量版弹簧刚度（系统"减少动态效果"且策略 light 时使用；900 ≈ 0.15s 内收尾）
    "reducedStiffness": 900,
    // 轻量版弹簧阻尼（55 ≈ 无回弹快速收尾）
    "reducedDamping": 55,
  },

  // ---------- 杂志排版（6 项） ----------
  "magazine": {
    // 首字下沉字号（3.4em 醒目大气;2.5em 内敛;0px = 关闭）
    "dropCapSize": "3.4em",
    // 首字颜色（var(--color-s) 跟随主题色;任何合法 CSS 颜色均可）
    "dropCapColor": "var(--color-s)",
    // 首字字重（600 半粗;400 常规;700 加重）
    "dropCapWeight": "600",
    // 图片出血宽度（向两侧各扩展一半;4rem 适中;0 = 关闭）
    "bleedWidth": "4rem",
    // 表格悬停底色混合比例（6% 轻微;10% 明显;0% = 关闭）
    "tableHoverMix": "6%",
    // h2 编号颜色（默认 55% 次级文字色）
    "headingNumberColor": "color-mix(in srgb, var(--color-ts) 55%, transparent)",
  },

  // ---------------------------------------------------------------------------
  // commandPalette：命令面板（Ctrl/Cmd+K）
  // ---------------------------------------------------------------------------
  "commandPalette": {
    // 面板宽度（560px 适中；窄屏自动收缩为 min(92vw)）
    "width": "560px",
    // 面板距顶部距离（16vh 视觉重心偏上；12vh 更靠上）
    "topOffset": "16vh",
    // 背板混合比例（55% = 底色混合 + 6px 模糊；数值越大越暗）
    "backdropMix": "55%",
  },

  // ---------------------------------------------------------------------------
  // announcement：公告条（顶部固定）
  // ---------------------------------------------------------------------------
  "announcement": {
    // 字号（0.8125rem = 13px 紧凑；0.875rem 更醒目）
    "fontSize": "0.8125rem",
    // 字距（0.015em 舒展；0 默认）
    "letterSpacing": "0.015em",
  },

  // ---------------------------------------------------------------------------
  // guard：防护与交互控制（右键菜单等；guard.json5 中留空的视觉值走这里）
  // ---------------------------------------------------------------------------
  "guard": {
    // 菜单宽度上限（232px 适中；200px 紧凑；guard.json5 style.width 可覆盖）
    "menuWidth": "232px",
    // 菜单圆角（0.618rem 黄金分割；0 = 直角）
    "menuRadius": "0.618rem",
    // 菜单毛玻璃模糊（10px 清透；16px 更重；仅在 style.blur=true 时生效）
    "menuBlur": "10px",
    // 菜单项圆角（0.382rem 内缩同心；0 = 直角）
    "itemRadius": "0.382rem",
    // 菜单项间距（2px 紧凑；6px 松弛）
    "itemGap": "2px",
    // 菜单最大高度（70vh 超长自动滚动；100vh 不限制）
    "menuMaxHeight": "70vh",
  },

  // ---------------------------------------------------------------------------
  // loading：加载遮罩（引导画面；防闪参数在 features.loading）
  // ---------------------------------------------------------------------------
  "loading": {
    // 圆点直径（0.55rem 精致；0.75rem 更醒目）
    "dotSize": "0.55rem",
    // 圆点间距（0.45rem 适中）
    "dotGap": "0.45rem",
    // 圆点跳动高度（6px 轻盈；10px 活泼）
    "dotLift": "6px",
    // 文案字号（0.8125rem 紧凑；0.9rem 醒目）
    "textSize": "0.8125rem",
    // 遮罩底色不透明度（92% 几乎不透视；80% 更透）
    "overlayAlpha": "92%",
    // 遮罩毛玻璃模糊（6px 清透；0 = 关闭模糊）
    "blurPx": "6px",
    // 单环转圈器尺寸（spinnerStyle: 'ring' 时生效；2rem 适中）
    "ringSize": "2rem",
    // 站点名标题字号（showTitle: true 时生效；1rem 适中）
    "titleSize": "1rem",
  },

}
// =============================================================================
// ui-strings.json5 —— 界面文案集中配置(功能18)
// -----------------------------------------------------------------------------
// 所有用户可见的界面文案集中于此,便于统一改写/本地化。
// 缺省项回退到模板内建文案;这里只写需要自定义的项。
// 结构: ui-blog 域,各子节按组件分组。
// =============================================================================
{
  // 搜索
  search: {
    placeholder: '搜索...',
    emptyHint: '输入关键词开始搜索',
    noResult: '未找到相关文章',
    resultCount: '共 {count} 条结果',
    openHint: '按 / 或 Ctrl+K 打开搜索'
  },

  // 导航
  nav: {
    menu: '菜单',
    home: '首页',
    archive: '归档',
    tags: '标签',
    categories: '分类',
    about: '关于',
    friends: '友情链接'
  },

  // 侧边栏
  sidebar: {
    aboutMe: '关于我',
    latest: '最新文章',
    tagCloud: '标签云',
    archives: '归档',
    categories: '分类',
    search: '搜索',
    stats: '站点统计',
    toc: '目录'
  },

  // 卡片与列表
  card: {
    wordUnit: '{count} 字',
    minute: '{minutes} 分钟阅读',
    readMore: '阅读全文',
    empty: '暂无文章',
    pinned: '置顶',
    series: '系列'
  },

  // 文章页
  post: {
    prev: '上一篇',
    next: '下一篇',
    related: '相关推荐',
    tocTitle: '目录',
    readingMode: '阅读模式',
    ttsLabel: '朗读',
    share: '分享文章'
  },

  // 顶栏/底部
  toolbar: {
    backToTop: '返回顶部',
    openSearchLabel: '搜索',
    darkLabel: '切换暗色模式',
    searchPlaceholder: '搜索文章…'
  },

  // 归档页
  archive: {
    statPosts: '文章总数',
    statDays: '发文天数',
    statWords: '总字数',
    statAvg: '日均篇数',
    statTags: '标签数',
    statCats: '分类数'
  },

  // 图库
  gallery: {
    title: '图库',
    desc: '站内图片集，点击查看大图。',
    empty: '暂无图片',
    count: '共 {count} 张图片'
  },

  // 404
  notFound: {
    title: '页面未找到',
    desc: '您访问的页面不存在或已被移动。',
    backHome: '返回首页'
  },

  // 分页
  pagination: {
    label: '分页导航',
    prev: '上一页',
    next: '下一页'
  }
,
